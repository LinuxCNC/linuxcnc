#!/usr/bin/env bash
# realtime-config-kernel — config kernel command line and sysctl for this machine
#
# Rules
#   - isolate the highest logical CPU and it's SMT sibling if SMT is active
#   - irqaffinity on all remaining CPU's
#   - rcu_nocbs / nohz_full on the isolated CPU
#   - SMT state from smt/control:
#       notsupported -> no SMT hardware, no 'nosmt', no question
#       on / off     -> SMT hardware exists -> ASK whether to add 'nosmt'
#   - intel_idle.max_cstate=1 and processor.max_cstate=1 to work on both AMD and Intel
#
# Copyright: 2026 Hannes Diethelm <hannes.diethelm@gmail.com>
# License: GPL Version 2

set -euo pipefail
trap 'echo "ERROR: line $LINENO: $BASH_COMMAND" >&2' ERR

# --- CPU detection -------------------------------------------
N_ALL="$(nproc --all)" #All CPU's including SMT's even if SMT is off
if (( N_ALL < 2 )); then
    echo "error: need at least 2 logical CPUs (got $N_ALL)" >&2
    exit 1
fi

# --- Kernel detection ----------------------------------------
kernel_type=UNKNOWN
if [[ -c /dev/evl/control ]]; then
    kernel_type=EVL
    echo "Xenomai4 EVL kernel detected"
elif uname -v | grep -q PREEMPT_RT; then
    kernel_type=PREEMPT_RT
    echo "PreemptRT kernel detected"
else
    echo "WARNING: Please install PreemptRT or Xenomai4 EVL Kernel"
fi

# --- SMT detection -------------------------------------------
# SMT hardware state from smt/active: none (notsupported) / on / off
smtcontrol="$(cat "/sys/devices/system/cpu/smt/control" 2>/dev/null || echo "")"
if [[ -z "$smtcontrol" ]]; then
    echo "Error, could not determine SMT state, assuming on"
    smtstate=on
else
    case "$smtcontrol" in
        notsupported) smtstate=none ;;
        off|forceoff) smtstate=off ;;
        on)           smtstate=on ;;
        *)            echo "Error, could not determine SMT state, assuming on"; smtstate=on ;;
    esac
fi

nosmt=""
if [[ "$smtstate" != "none" ]]; then
    read -r -p "SMT hardware present (currently: $smtstate). Add 'nosmt' (run without SMT)? [Y/n] " ans
    ans="${ans:-y}"
    case "$ans" in
        y|Y) nosmt="nosmt" ;;
        n|N) ;;
        *) echo "y or n"; exit 1;;
    esac
    if [[ "$smtstate" != "on" && -z "$nosmt" ]]; then
        echo "Can not determine SMT sibling, run \"echo on | sudo tee /sys/devices/system/cpu/smt/control\" to enable SMT and try again"
        exit 1
    fi
fi

if [[ "$smtstate" != "none" && -n "$nosmt" ]]; then
    N=$((N_ALL / 2)) #When disabling SMT, we have halve the CPU's
else
    N=$N_ALL
fi
isolated_main=$((N - 1))
isolated=$((N - 1))
nonisolated=0-$((N - 2))

sibling=""
if [[ "$smtstate" != "none" && -z "$nosmt" ]]; then
    # sibling of the isolated CPU needs to be isolated too if we don't disable SMT
    sibs_last="$(cat "/sys/devices/system/cpu/cpu$isolated/topology/thread_siblings_list" 2>/dev/null || echo "")"
    for c in ${sibs_last//,/ }; do
        if [[ "$c" != "$isolated" ]]; then sibling="$c"; break; fi
    done
    if [[ -z "$sibling" ]]; then
        echo "ERROR: SMT sibling not detected, select yes when asked for nosmt"
    fi
    isolated=$sibling,$isolated
    nonisolated=0-$((sibling-1)),$((sibling+1))-$((N - 2))
fi

# --- commandline ---------------------------------------------

cmdline="isolcpus=managed_irq,domain,$isolated irqaffinity=$nonisolated rcu_nocbs=$isolated rcu_nocb_poll"
if [[ "$kernel_type" != "EVL" ]]; then
    #evl has issues with nohz
    cmdline="$cmdline nohz=on nohz_full=$isolated"
fi
cmdline="$cmdline intel_idle.max_cstate=1 processor.max_cstate=1 cpufreq.off=1 nosoftlockup nowatchdog"
if [[ -n "$nosmt" ]]; then
    cmdline="$cmdline nosmt"
fi
if [[ "$kernel_type" == "EVL" ]]; then
    #evl needs evl.oobcpus, so the network card tasks run on the correct CPU
    cmdline="$cmdline evl.oobcpus=$isolated_main"
fi

#Contains all set or unset parameters for merge with existing cmdline
cmdline_parameters=("isolcpus" "irqaffinity" "rcu_nocbs" "rcu_nocb_poll"
    "nohz" "nohz_full"
    "intel_idle.max_cstate" "processor.max_cstate" "cpufreq.off" "nosoftlockup" "nowatchdog"
    "nosmt"
    "evl.oobcpus")

# --- report --------------------------------------------------
echo "Logical CPUs     : $N_ALL"
echo "Available CPUs   : $N"
echo "SMT              : $smtstate"
echo "Isolated CPU     : $isolated_main"
if [[ -n "$sibling" ]]; then
    echo "Sibling of CPU $isolated_main: $sibling (also isolated)"
fi
echo
echo Recommended kernel command line:
echo "$cmdline"
echo

# --- add to grub ---------------------------------------------

merge_cmdline() {
    local existing="$1"
    local new="$2"
    local -a param_list
    read -r -a param_list <<< "$3"
    local token key opt
    local -a result=()

    # Keep existing parameters not overridden by the new ones,
    # except options in param_list.
    for token in $existing; do
        key=${token%%=*}

        # Skip options that should be removed unless explicitly set in new.
        for opt in "${param_list[@]}"; do
            [[ "$key" == "$opt" ]] && continue 2
        done

        result+=("$token")
    done

    # Append the new parameters.
    for token in $new; do
        result+=("$token")
    done

    printf '%s' "${result[*]}"
}

grub_confg="/etc/default/grub"

change_grub=false
if [[ ! -f "$grub_confg" ]]; then
    echo "$grub_confg not found, edit your bootloader configuration by hand"
else
    tmpfile=$(mktemp /tmp/grub.XXXXXX)
    source <(grep '^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=' $grub_confg)
    cp "$grub_confg" "$tmpfile"
    existing=$GRUB_CMDLINE_LINUX_DEFAULT
    if [[ "$cmdline" = "$existing" ]]; then
        echo "Configured kernel command line is equal to recommended: nothing to do"
    elif [[ -n "$existing" ]]; then
        merged=$(merge_cmdline "$existing" "$cmdline" "${cmdline_parameters[*]}")
        echo "Existing command line:"
        echo "$existing"
        echo
        echo "Merged command line:"
        echo "$merged"
        echo
        read -r -p "Use recommended, merged or abort? [r,m,A] " ans
        ans="${ans:-a}"
        case "$ans" in
            r|R) change_grub=true;;
            m|M) cmdline=$merged; change_grub=true ;;
            a|A) echo "Edit /etc/default/grub manually";;
            *) echo "r, m or a"; exit 1;;
        esac
    else
        change_grub=true
    fi
fi

if [[ "$change_grub" == "true" ]]; then
    sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"$cmdline\"|" "$tmpfile"

    echo Diff existing vs. new $grub_confg:
    diff -u "$grub_confg" "$tmpfile" || true

    read -r -p "Apply changes and update grub? [y/N] " ans
    ans="${ans:-n}"
    case "$ans" in
        y|Y) sudo cp "$tmpfile" "$grub_confg" ; sudo update-grub;;
        n|N) ;;
        *) echo "y or n"; exit 1;;
    esac
fi
rm "$tmpfile"
echo

# --- sysctl --------------------------------------------------

sysctl="/etc/sysctl.d/50-linuxcnc-rt.conf"
tmpfile=$(mktemp /tmp/50-linuxcnc-rt.XXXXXX)
chmod go+r "$tmpfile"

cat > "$tmpfile" <<'EOF'
kernel.sched_rt_runtime_us=-1
kernel.timer_migration=0
EOF

if cmp -s "$sysctl" "$tmpfile" ; then
    echo "$sysctl is ok: nothing to do"
else
    if [[ ! -f "$sysctl" ]]; then
        echo "$sysctl does not exist. Recommended:"
        cat "$tmpfile"
        read -r -p "Create this file? [y/N] " ans
    else
        echo "$sysctl does not contain recommended content:"
        diff -u "$sysctl" "$tmpfile" || true
        read -r -p "Replace this file? [y/N] " ans
    fi
    ans="${ans:-n}"
    case "$ans" in
        y|Y) sudo cp "$tmpfile" "$sysctl" ;;
        n|N) ;;
        *) echo "y or n"; exit 1;;
    esac
fi
rm "$tmpfile"
