"    #1 = 3 (asigne el valor de 3 al parámetro #1)\n"
"    (msg, #1 se le ha asignado el valor de 3)\n"
"    o100 continue (saltar al inicio del bucle)\n"
"  o110 endif\n"
"  (algún código aquí)\n"
