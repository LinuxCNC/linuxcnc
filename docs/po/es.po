#. type: Plain text
#: man/man9/pid.9:70
#, fuzzy
msgid "B<deadband> Amount of error that will be ignored"
msgstr "'(float) pid.<loopnum>.deadband' - Cantidad de error que se ignorará"

#. type: Plain text
#: man/man9/pid.9:72
#, fuzzy
msgid "B<maxerror> Limit on error"
msgstr "'(float) pid.<loopnum>.maxerror' - Límite de error"

#. type: Plain text
#: man/man9/pid.9:74
#, fuzzy
msgid "B<maxerrorI> Limit on error integrator"
msgstr "'(float) pid.<loopnum>.maxerrorI' - Limite en error integrador"

