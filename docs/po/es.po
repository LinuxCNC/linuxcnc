msgid ""
"rtapi_shmem, rtapi_shmem_new, rtapi_shmem_delete, rtapi_shmem_getptr - "
"Functions for managing shared memory blocks"
msgstr ""

#. type: delimited block -
#: src/man/man3/rtapi_shmem.3.adoc:16
#, no-wrap
msgid ""
