#, fuzzy, no-wrap
msgid ""
"N10 G91\n"
"N20 G0 X10 Y-5 Z20\n"
"N30 G38.3 Z-10\n"
"N40 O100 if [#5070 EQ 0]\n"
"N50    G1 Y20 Z-5\n"
"N60 O100 else\n"
"N70    G0 Z30\n"
"N80 O100 endif\n"
"N90 G1 Z10\n"
"N95 M2\n"
