#, no-wrap
msgid "n Code = toggle-halpin the-hal-pin-name\n"
msgstr ""

#. type: Plain text
#: src/plasma/qtplasmac.adoc:3387 src/plasma/qtplasmac.adoc:3450
msgid ""
"This code is required to be used as a single command and may only control "
"one HAL bit pin per button."
