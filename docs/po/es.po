#: man/man9/mux16.9:35
msgid "B<loadrt mux16> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt mux16> [B<count>=I<N>|B<names>=I<nombre1>[,I<nombre2>\\&...]]"

