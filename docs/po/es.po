"'M7' - activa el refrigerante de niebla. M7 controla el pin "
"iocontrol.0.coolant-mist."

#. type: WARNING
#: src/gcode/m-code.adoc:204
#, fuzzy
msgid ""
"'M8' - turn flood coolant on. M8 controls iocontrol.0.coolant-flood pin."
msgstr ""
"'M8' - activa el refrigerante de inundación. M8 controla el pin "
"iocontrol.0.coolant-flood iocontrol.0."

#. type: WARNING
#: src/gcode/m-code.adoc:205
#, fuzzy
msgid "'M9' - turn both M7 and M8 off."
