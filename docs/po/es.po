msgstr "Menú Ayuda"

#. type: Plain text
#: src/gui/axis.adoc:280
msgid "'About AXIS' - We all know what this is."
msgstr "'Acerca de AXIS' - Todos sabemos lo que es esto."

#. type: Plain text
#: src/gui/axis.adoc:281
