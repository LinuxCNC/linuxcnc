#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:567
msgid ""
"This example sets an `isHomed` property based on LinuxCNC's homed state and "
"in turn uses it to change stylesheet properties:"
msgstr ""

#. type: Block title
#: src/gui/qtvcp-custom-widgets.adoc:568
#, no-wrap
msgid "This example will set the property isHomed based on LinuxCNC's homed state."
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:577
#, no-wrap
msgid ""
"class HomeLabel(QLabel, _HalWidgetBase):\n"
"    def __init__(self, parent=None):\n"
"        super(HomeLabel, self).__init__(parent)\n"
"        self.joint_number = 0\n"
"        # for stylesheet reading\n"
"        self._isHomed = False\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:582
#, no-wrap
msgid ""
"    def _hal_init(self):\n"
"        super(HomeLabel, self)._hal_init()\n"
"        STATUS.connect('homed', lambda w,d: self._home_status_polish(int(d), True))\n"
"        STATUS.connect('unhomed', lambda w,d: self._home_status_polish(int(d), False))\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:591
#, no-wrap
msgid ""
"    # update ishomed property\n"
"    # polish widget so stylesheet sees the property change\n"
"    # some stylesheets color the text on home/unhome\n"
"    def _home_status_polish(self, d, state):\n"
"        if self.joint_number = d:\n"
"            self.setProperty('isHomed', state)\n"
"            self.style().unpolish(self)\n"
"            self.style().polish(self)\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:597
#, no-wrap
msgid ""
"    # Qproperty getter and setter\n"
"    def getisHomed(self):\n"
"        return self._isHomed\n"
"    def setisHomed(self, data):\n"
"        self._isHomed = data\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:600
#, no-wrap
msgid ""
"    # Qproperty\n"
"    isHomed = QtCore.pyqtProperty(bool, getisHomed, setisHomed)\n"
msgstr ""

