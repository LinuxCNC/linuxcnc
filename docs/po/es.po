#. type: Labeled list
#: src/man/man9/hal_parport.9.adoc:87
#, no-wrap
msgid "**parport**.__p__.**pin-<n>-out-reset** (bit)"
msgstr "**parport**.__p__.**pin-<n>-out-reset** (bit)"

#. type: Plain text
#: src/man/man9/hal_parport.9.adoc:90
#, fuzzy
msgid ""
"(only for out pins) TRUE if this pin should be reset when the .reset "
