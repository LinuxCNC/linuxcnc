#: src/gui/gladevcp.adoc:550
#, fuzzy, no-wrap
msgid "images/hal-pin-change-66.png"
msgstr "images/manual-tool-change_es.png"

#. type: Plain text
#: src/gui/gladevcp.adoc:553
msgid ""
