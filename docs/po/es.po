#. type: Plain text
#: src/gui/axis.adoc:289
msgid "image:images/tool_open.png[\"Open G Code file\"] Open G Code file [O]"
msgstr ""
"image:images/tool_open.png[\"Abrir archivo de código G\"] Abrir archivo de "
