msgstr ""
"; nota: no se necesita M72 aquí - el siguiente endsub o un\n"
"; 'return' explícito restaurará el estado del llamador\n"
"O<imperialsub> endsub\n"

#. type: delimited block -
#: src/gcode/m-code.adoc:662
#, fuzzy, no-wrap
msgid ""
"; main program\n"
"g21 (metric)\n"
"g90 (absolute)\n"
"f200 (fast speed)\n"
