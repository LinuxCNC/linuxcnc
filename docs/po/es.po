"pos->a      = joints[3];\n"
"pos->b      = joints[4];\n"
"pos->c      = joints[5];\n"
"pos->u      = joints[6];\n"
"pos->v      = joints[7];\n"
"pos->w      = joints[8];\n"
msgstr ""
"pos->tran.x = joints[0];\n"
"pos->tran.y = joints[1];\n"
"pos->tran.z = joints[2];\n"
"pos->a      = joints[3];\n"
"pos->b      = joints[4];\n"
"pos->c      = joints[5];\n"
"pos->u      = joints[6];\n"
"pos->v      = joints[7];\n"
