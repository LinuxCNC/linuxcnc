msgstr ""

#. type: Plain text
#: man/man9/comp.9:65
msgid "B<comp>\\&.I<N>\\&.B<equal> bit out"
msgstr "B<comp>\\&.I<N>\\&.B<equal> bit out"

#. type: Plain text
#: man/man9/comp.9:72
msgid ""
