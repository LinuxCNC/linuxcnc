#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:19
#, no-wrap
msgid "With -- --enablepw _<password>_"
msgstr ""

#. type: Plain text
#: src/man/man1/schedrmt.1.adoc:21
msgid "Sets the enable password to _password_. Default 'EMCTOO'."
msgstr ""

#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:21
#, no-wrap
msgid "With -- --sessions <max sessions>"
msgstr ""

#. type: Plain text
#: src/man/man1/schedrmt.1.adoc:24
msgid ""
"Sets the maximum number of simultaneous connextions to max sessions.  "
"Default is no limit (-1)."
msgstr ""

#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:24
#, no-wrap
msgid "With -- --path"
msgstr ""

#. type: Plain text
#: src/man/man1/schedrmt.1.adoc:26
msgid ""
"Sets the base path to program (G-Code) files, default is \"../../nc_files/"
"\". Make sure to include the final slash (/)."
msgstr ""

#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:26
#, fuzzy, no-wrap
msgid "With -- -ini _<INI file>_"
msgstr "Archivos"

#. type: Plain text
#: src/man/man1/schedrmt.1.adoc:28
msgid "Uses specified _INI file_ instead of default 'emc.ini'."
