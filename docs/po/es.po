#. type: Plain text
#: man/man9/pid.9:32
msgid ""
"pid - proportional/integral/derivative controller with automatic tuning "
"support"
msgstr ""
"pid - Controlador proporcional/integral/derivativo con ajuste automático"

#. type: Plain text
#: man/man9/pid.9:35
msgid ""
"B<loadrt pid> [B<num_chan=>I<num> | B<names=>I<name1>[,I<name2>\\&...I<]] "
