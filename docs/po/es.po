#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:15
#, no-wrap
msgid "With -- --name _<server name>_"
msgstr "Con -- --name _<nombre-del-servidor>_"

#. type: Labeled list
#: src/man/man1/schedrmt.1.adoc:17
#, no-wrap
msgid "With -- --connectpw _<password>_"
msgstr ""

#. type: Plain text
#: src/man/man1/schedrmt.1.adoc:19
