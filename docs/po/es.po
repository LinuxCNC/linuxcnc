#. FIXME Shouldn't it be Keylookup ?!
#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:770
msgid ""
"*`Keylookup`* module is used to *allow keypresses to control behaviors* such "
"as jogging."
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:772
msgid ""
"It's used inside the handler file to facilitate creation of *key bindings* "
"such as keyboard jogging, etc."
msgstr ""

#. type: Block title
#: src/gui/qtvcp-libraries.adoc:775
#, fuzzy, no-wrap
msgid "Import `Keylookup` module"
msgstr "importar el módulo `linuxcnc`"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:786
#, no-wrap
msgid "from qtvcp.lib.keybindings import Keylookup\n"
msgstr ""

#. type: Block title
#: src/gui/qtvcp-libraries.adoc:788
#, no-wrap
msgid "Instantiate `Keylookup` module"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:791
#, fuzzy
msgid ""
"To instantiate `Keylookup` module* so you can use it, add this Python code "
"to your instantiate section:"
msgstr "Uno debe importar el módulo y el módulo hal:"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:799
#, no-wrap
msgid "KEYBIND = Keylookup()\n"
msgstr ""

#. type: Block title
#: src/gui/qtvcp-libraries.adoc:801
#, fuzzy, no-wrap
msgid "Add Key Bindings"
msgstr "`keybindings`"

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:805
#, no-wrap
msgid ""
"`Keylookup` requires code under the `processed_key_event` function to call `KEYBIND.call()`.\n"
"Most handler files already have this code."
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:807
msgid ""
"In the handler file, under the _initialized function_ use this general "
"syntax to *create keybindings*:"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:811
#, no-wrap
msgid "KEYBIND.add_call(\"DEFINED_KEY\",\"FUNCTION TO CALL\", USER DATA)\n"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:814
msgid "Here we add a keybinding for `F10`, `F11` and `F12`:"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:828
#, no-wrap
msgid ""
"# at this point:\n"
"# the widgets are instantiated.\n"
"# the HAL pins are built but HAL is not set ready\n"
"def initialized__(self):\n"
"    KEYBIND.add_call('Key_F10','on_keycall_F10',None)\n"
"    KEYBIND.add_call('Key_F11','on_keycall_override',10)\n"
"    KEYBIND.add_call('Key_F12','on_keycall_override',20)\n"
msgstr ""
"# en este punto:\n"
"# los widgets se han instanciado.\n"
"# los pines HAL se han construido pero HAL no esta listo\n"
"def initialized__(self):\n"
"    KEYBIND.add_call('Key_F10','on_keycall_F10',None)\n"
"    KEYBIND.add_call('Key_F11','on_keycall_override',10)\n"
"    KEYBIND.add_call('Key_F12','on_keycall_override',20)\n"

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:832
#, no-wrap
msgid ""
"And then we need to *add the functions that get called*.\n"
"In the handler file, under the `KEY BINDING CALLS` section, add this:"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:838
#, no-wrap
msgid ""
"#####################\n"
"# KEY BINDING CALLS #\n"
"#####################\n"
msgstr ""
"#####################\n"
"# KEY BINDING CALLS #\n"
"#####################\n"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:842
#, no-wrap
msgid ""
"def on_keycall_F12(self,event,state,shift,cntrl,value):\n"
"    if state:\n"
"        print('F12 pressed')\n"
msgstr ""
"def on_keycall_F12(self,event,state,shift,cntrl,value):\n"
"    if state:\n"
"        print('F12 presionado')\n"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:846
#, no-wrap
msgid ""
"def on_keycall_override(self,event,state,shift,cntrl,value):\n"
"    if state:\n"
"        print('value = {}'.format(value))\n"
msgstr ""
"def on_keycall_override(self,event,state,shift,cntrl,value):\n"
"    if state:\n"
"        print('valor = {}'.format(value))\n"

