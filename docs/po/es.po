msgstr ""

#. type: Plain text
#: src/man/man1/inivar.1.adoc:8
msgid "inivar - Query an INI file"
msgstr ""

#. type: Plain text
#: src/man/man1/inivar.1.adoc:12
msgid ""
"*inivar* *-var* _variable_ [*-sec* _section_] [*-num* _occurrence_number_] "
"[*-tildeexpand*] [*-ini* _FILE_]"
msgstr ""

#. type: Plain text
#: src/man/man1/inivar.1.adoc:17
msgid ""
"Prints to stdout the INI file result of a variable-in-section search, useful "
"for scripts that want to pick things out of INI files."
msgstr ""

#. type: Plain text
#: src/man/man1/inivar.1.adoc:21
msgid ""
"Uses _emc.ini_ as default filename. _variable_ needs to be supplied. If "
"_section_ is omitted, first instance of _variable_ will be looked for in any "
"section. Otherwise, only a match of the variable in _section_ will be "
"returned."
msgstr ""

#. type: Labeled list
#: src/man/man1/inivar.1.adoc:24
#, fuzzy, no-wrap
msgid "*-var* _variable_"
msgstr "-Wn<nombre>"

#. type: Plain text
#: src/man/man1/inivar.1.adoc:27
msgid ""
"The variable to search for, if multiple matches exists and *-num* is not "
"specified, the first match is returned."
msgstr ""

#. type: Labeled list
#: src/man/man1/inivar.1.adoc:28
#, fuzzy, no-wrap
msgid "*-sec* _section_"
msgstr "Inifile"

#. type: Plain text
#: src/man/man1/inivar.1.adoc:30
msgid "The section to search in, if omitted, all sections are searched."
msgstr ""

#. type: Labeled list
#: src/man/man1/inivar.1.adoc:31
#, fuzzy, no-wrap
msgid "*-num* _occurrence_number_"
msgstr "Inifile"

#. type: Plain text
#: src/man/man1/inivar.1.adoc:34
msgid ""
"The occurrence number specifies which instance of the variable within the "
"_FILE_, and _section_ if provided, should be returned. If omitted, the first "
"matching occurrence is returned."
msgstr ""

#. type: Labeled list
#: src/man/man1/inivar.1.adoc:35
#, no-wrap
msgid "*-tildeexpand*"
msgstr ""

#. type: Plain text
#: src/man/man1/inivar.1.adoc:38
msgid ""
"Replace the tilde (~) with the home directory path (equivalent to *$(HOME)*) "
"in the value obtained from _variable_ in _FILE_."
msgstr ""

#. type: Labeled list
#: src/man/man1/inivar.1.adoc:39
#, fuzzy, no-wrap
msgid "*-ini* _FILE_"
msgstr "-Wn<nombre>"

#. type: Plain text
#: src/man/man1/inivar.1.adoc:41
msgid "The INI file to search in, defaults to _emc.ini_."
