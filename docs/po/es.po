"You would usually pick specific widgets using `HomeLabel #specific_widget_name[homed=true]`:"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:615
#, no-wrap
msgid ""
"HomeLabel[homed=true] {\n"
"    color: green;\n"
"}\n"
"HomeLabel[homed=false] {\n"
"    color: red;\n"
"}\n"
msgstr ""

