#. type: delimited block -
#: src/gui/qtdragon.adoc:802
#, no-wrap
msgid ""
"# load components\n"
"########################################################################\n"
msgstr ""
"# load components\n"
"########################################################################\n"

#. type: delimited block -
#: src/gui/qtdragon.adoc:805
#, no-wrap
msgid ""
"loadrt logic names=logic-and personality=0x102\n"
"addf logic-and servo-thread\n"
msgstr ""
"loadrt logic names=logic-and personality=0x102\n"
"addf logic-and servo-thread\n"

#. type: delimited block -
#: src/gui/qtdragon.adoc:809
#, no-wrap
msgid ""
"# load a summing component for adding spindle lift and Z compensation\n"
"loadrt scaled_s32_sums\n"
"addf scaled-s32-sums.0 servo-thread\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtdragon.adoc:814
#, no-wrap
msgid ""
"loadusr -Wn z_level_compensation z_level_compensation\n"
"# method parameter must be one of nearest(2), linear(1), cubic (0)\n"
"setp z_level_compensation.fade-height 0.0\n"
"setp z_level_compensation.method 1\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtdragon.adoc:817
#, no-wrap
msgid ""
"# connect signals to LinuxCNC's motion component\n"
"########################################################################\n"
msgstr ""
"# conecta señales al componente de movimiento de Linux CNC\n"
"########################################################################\n"

#. type: delimited block -
#: src/gui/qtdragon.adoc:823
#, no-wrap
msgid ""
"net eoffset-clear    axis.z.eoffset-clear\n"
"net eoffset-counts   axis.z.eoffset-counts\n"
"setp axis.z.eoffset-scale .001\n"
"net eoffset-total          axis.z.eoffset\n"
"setp axis.z.eoffset-enable True\n"
