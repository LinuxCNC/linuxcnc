#: man/man9/corexy_by_hal.9:93
#, no-wrap
msgid ""
".ie  n \\{\\\n"
"\\h'-04' 3.\\h'+01'\\c\n"
".\\}\n"
".el \\{\\\n"
".sp -1\n"
".IP \"  3.\" 4.2\n"
".\\}\n"
msgstr ""

#. type: Plain text
