#. type: Title ==
#: src/drivers/gm.adoc:451
#, no-wrap
msgid "Watchdog timer"
msgstr "Temporizador de perro guardián"

#. type: Plain text
#: src/drivers/gm.adoc:454
msgid "Watchdog timer resets at function:"
msgstr "El temporizador del perro guardián se reinicia con la función:"

#. type: Block title
#: src/drivers/gm.adoc:461
#, no-wrap
msgid "Watchdog pins"
msgstr "Pines del perro guardián"

#. type: Table
#: src/drivers/gm.adoc:465
#, no-wrap
msgid "gm._<card_no>_.watchdog-expired"
msgstr "gm._<número_de_tarjeta>_.watchdog-expired"

#. type: Table
#: src/drivers/gm.adoc:466
#, no-wrap
msgid "Indicates that watchdog timer is expired."
msgstr "Indica el temporizador del perro guardián ha expirado."

#. type: Plain text
#: src/drivers/gm.adoc:469
msgid ""
"Watchdog timer overrun causes the set of power-enable to low in hardware."
msgstr ""
"Si se sobrepasa el temporizador del perro guardián se establece .power-"
"enable en bajo en el hardware."

#. type: Block title
#: src/drivers/gm.adoc:472
#, no-wrap
msgid "Watchdog parameters"
msgstr "Parámetros del perro guardián"

#. type: Table
#: src/drivers/gm.adoc:476
#, no-wrap
msgid "gm._<card_no>_.watchdog-enable"
msgstr "gm._<número_de_tarjeta>_.watchdog-enable"

#. type: Table
#: src/drivers/gm.adoc:480
#, no-wrap
msgid ""
"Enables watchdog timer. +\n"
"It is strongly recommended to enable the watchdog timer,\n"
"because it can disable all the servo amplifiers by pulling down all enable signals in case of a PC error."
msgstr ""
"Activa el temporizador del perro guardián. +\n"
"Se recomienda encarecidamente activar el temporizador del perro guardián,\n"
"porque puede desactivar todos los servoamplificadores bajando todas las "
"señales de activación en caso de un error en la PC."

#. type: Table
#: src/drivers/gm.adoc:480
#, no-wrap
msgid "gm._<card_no>_.watchdog-timeout-ns"
msgstr "gm._<número_de_tarjeta>_.watchdog-timeout-ns"

#. type: Table
#: src/drivers/gm.adoc:484
#, no-wrap
msgid ""
"Time interval in within the gm._<card_no>_.read function must be executed.\n"
"The gm._<card_no>_.read is typically added to servo-thread,\n"
"so watch timeout is typically set to 3 times of the servo period."
msgstr ""
"Intervalo de tiempo dentro del cual se debe ejecutar la función "
"gm,_<número_de_tarjeta>_.read.\n"
"Típicamente se agrega gm._<número_de_tarjeta>_.read al servo-hilo,\n"
"por lo que el tiempo de espera a procurar es típicamente 3 veces el período "
"del servo."

