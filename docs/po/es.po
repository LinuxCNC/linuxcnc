"Loaded HAL Components:\n"
"ID Type        Name\n"
"10 User halcmd29800\n"
"09 User halcmd29374\n"
"08   RT         ddt\n"
"06   RT hal_parport\n"
"05   RT    scope_rt\n"
"04   RT     stepgen\n"
"03   RT      motmod\n"
"02 User   iocontrol\n"
msgstr ""
"Loaded HAL Components:\n"
"ID Type        Name\n"
"10 User halcmd29800\n"
"09 User halcmd29374\n"
"08   RT         ddt\n"
"06   RT hal_parport\n"
"05   RT    scope_rt\n"
"04   RT     stepgen\n"
"03   RT      motmod\n"
"02 User   iocontrol\n"

#. type: Plain text
