msgstr "'(float) pid.<loopnum>.Pgain' - Ganancia proporcional"

#. type: Plain text
#: man/man9/pid.9:56
msgid "B<Igain> Integral gain"
msgstr ""

#. type: Plain text
#: man/man9/pid.9:58
#, fuzzy
msgid "B<Dgain> Derivative gain"
msgstr "'(float) pid.<loopnum>.Dgain' - Ganancia derivativa"

#. type: Plain text
#: man/man9/pid.9:60
#, fuzzy
msgid "B<bias> Constant offset on output"
msgstr "'(float) pid.<loopnum>.bias' - Offset constante en la salida"

#. type: Plain text
#: man/man9/pid.9:62
msgid "B<FF0> Zeroth order Feedforward gain"
msgstr ""

#. type: Plain text
#: man/man9/pid.9:64
