#, no-wrap
msgid "Compensation End Point(((Compensation End Point)))"
msgstr "Punto final de compensación(((Punto final de compensación)))"

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gcode/tool-compensation.adoc:295
#, no-wrap
msgid "Compensation End Point"
msgstr "Punto final de compensación"

