#: man/man9/corexy_by_hal.9:59
#, no-wrap
msgid ""
".ie  n \\{\\\n"
"\\h'-04' 1.\\h'+01'\\c\n"
".\\}\n"
".el \\{\\\n"
".sp -1\n"
".IP \"  1.\" 4.2\n"
".\\}\n"
msgstr ""

#. type: Plain text
#: man/man9/corexy_by_hal.9:71
