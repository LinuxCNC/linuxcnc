#. type: Block title
#: src/gui/pyvcp.adoc:468
#, no-wrap
msgid "Text Button"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:473
msgid ""
"A text button controls a 'bit' halpin.  The halpin is false until the button "
"is pressed then it is true.  The button is a momentary button."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:475
msgid ""
"The text button has an optional disable pin that is created when you add "
"<disable_pin>True</disable_pin>."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp.adoc:486
#, no-wrap
msgid ""
"<button>\n"
"    <halpin>\"ok-button\"</halpin>\n"
"    <text>\"OK\"</text>\n"
"</button>\n"
"<button>\n"
"    <halpin>\"abort-button\"</halpin>\n"
"    <text>\"Abort\"</text>\n"
"</button>\n"
msgstr ""
"<button>\n"
"    <halpin>\"ok-button\"</halpin>\n"
"    <text>\"OK\"</text>\n"
"</button>\n"
"<button>\n"
"    <halpin>\"abort-button\"</halpin>\n"
"    <text>\"Abort\"</text>\n"
"</button>\n"

