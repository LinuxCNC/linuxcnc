msgstr "*iocontrol.0.tool-from-pocket*"

#. type: Title ====
#: src/gcode/tool-compensation.adoc:173
#, no-wrap
msgid "IO for non-random toolchanger"
msgstr "E/S para un cambiador de herramienta no aleatorio"

#. type: NOTE
#: src/gcode/tool-compensation.adoc:176
msgid "Tool number _n_==0 indicates no tool."
msgstr "Número de herramienta _n_==0 indica sin herramienta."

#. type: NOTE
#: src/gcode/tool-compensation.adoc:177
msgid ""
"The pocket number for a tool is set when tooldata is loaded/reloaded from "
"its data source ([EMCIO]TOOL_TABLE or [EMCIO]DB_PROGRAM)."
msgstr ""
"El número de ranura de una herramienta se asigna cuando se cargan/recargan "
"los datos de herramienta desde su fuente de datos ([EMCIO]TOOL_TABLE o "
"[EMCIO]DB_PROGRAM)."

#. type: NOTE
#: src/gcode/tool-compensation.adoc:178
msgid "At G-code *T__n__* (_n_ != 0) command:"
msgstr "En el comando de código G *T__n__* (_n_ != 0):"

#. type: NOTE
#: src/gcode/tool-compensation.adoc:179
msgid ""
"*iocontrol.0.tool-prep-index* = _idx_ (index based on tooldata load sequence)"
msgstr ""
"*iocontrol.0.tool-prep-index* = _idx_ (índice basado en la secuencia de "
"carga de datos de la herramienta)"

#. type: NOTE
#: src/gcode/tool-compensation.adoc:180 src/gcode/tool-compensation.adoc:196
msgid "*iocontrol.0.tool-prep-number* = _n_"
msgstr "*iocontrol.0.tool-prep-number* = _n_"

#. type: NOTE
#: src/gcode/tool-compensation.adoc:181
msgid "*iocontrol.0.tool-prep-pocket* = the pocket number for _n_"
msgstr "*iocontrol.0.tool-prep-pocket* = el número de ranura para _n_"

#. type: NOTE
#: src/gcode/tool-compensation.adoc:182
msgid "At G-code *T0* (_n_ == 0 remove) command:"
msgstr "En el comando de código G *T0* (_n_ == 0 quitar):"

