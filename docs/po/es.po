#. type: Title =
#: src/man/man1/gs2_vfd.1.adoc:1
#, no-wrap
msgid "gs2_vfd(1)"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:6
msgid "gs2_vfd - HAL non-realtime component for Automation Direct GS2 VFDs"
msgstr ""
"gs2_vfd - Componente HAL en tiempo diferido para VDFs Automation Direct GS2"

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:10
msgid "*gs2_vfd* [OPTIONS]"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:15
msgid ""
"This manual page explains the *gs2_vfd* component. This component reads and "
"writes to the GS2 via a modbus connection."
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:17
msgid "*gs2_vfd* is for use with LinuxCNC."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:20 src/man/man1/hy_vfd.1.adoc:98
#, no-wrap
msgid "-b, --bits _n_"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:22
#, fuzzy
msgid ""
"Set number of data bits to _n_, where _n_ must be from 5 to 8 inclusive "
"(default 8)."
msgstr "El número L no está en el rango de 0 a 9 inclusive."

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:23
#, no-wrap
msgid "-d, --device _path_"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:25
msgid ""
"Set the path to the file representing the serial device to use (default /dev/"
"ttyS0)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:26
#, no-wrap
msgid "-v, --verbose"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:28 src/man/man1/hy_gt_vfd.1.adoc:122
#: src/man/man1/svd-ps_vfd.1.adoc:67
msgid "Turn on verbose mode."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:29 src/man/man1/hy_vfd.1.adoc:86
#, no-wrap
msgid "-g, --debug"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:32
msgid ""
"Turn on debug messages. Note that if there are serial errors, this may "
"become annoying.  Debug mode will cause all modbus messages to be printed in "
"hex on the terminal."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:33 src/man/man1/hy_vfd.1.adoc:94
#, no-wrap
msgid "-n, --name _string_"
msgstr "-n, --name _string_"

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:36
msgid ""
"Set the name of the HAL module. The HAL comp name will be set to _string_, "
"and all pin and parameter names will begin with _string_ (default gs2_vfd)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:37 src/man/man1/hy_vfd.1.adoc:102
#, no-wrap
msgid "-p, --parity [even,odd,none]"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:39
msgid "Set serial parity to even, odd, or none (default odd)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:40 src/man/man1/hy_vfd.1.adoc:106
#, no-wrap
msgid "-r, --rate _n_"
msgstr "-r, --rate _n_"

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:44
msgid ""
"Set baud rate to _n_. It is an error if the rate is not one of the "
"following: 110, 300, 600, 1200, 2400, 4800, 9600, 19200, 38400, 57600, "
"115200 (default 38400)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:45 src/man/man1/hy_vfd.1.adoc:112
#, no-wrap
msgid "-s, --stopbits [1,2]"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:47
msgid "Set serial stop bits to 1 or 2 (default 1)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:48 src/man/man1/hy_vfd.1.adoc:116
#, no-wrap
msgid "-t, --target _n_"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:51
msgid ""
"Set MODBUS target (slave) number.  This must match the device number you set "
"on the GS2 (default 1)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:52
#, no-wrap
msgid "-A, --accel-seconds _n_"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:54
msgid "Seconds to accelerate the spindle from 0 to Max RPM (default 10.0)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:55
#, no-wrap
msgid "-D, --decel-seconds _n_"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:59
msgid ""
"Seconds to decelerate the spindle from Max RPM to 0.  If set to 0.0 the "
"spindle will be allowed to coast to a stop without controlled deceleration "
"(default 0.0)."
msgstr ""

#. type: Labeled list
#: src/man/man1/gs2_vfd.1.adoc:60
#, no-wrap
msgid "-R, --braking-resistor"
msgstr ""

#. type: Plain text
#: src/man/man1/gs2_vfd.1.adoc:66
msgid ""
"This argument should be used when a braking resistor is installed on the GS2 "
"VFD (see Appendix A of the GS2 manual).  It disables deceleration over-"
"voltage stall prevention (see GS2 modbus Parameter 6.05), allowing the VFD "
"to keep braking even in situations where the motor is regenerating high "
"voltage.  The regenerated voltage gets safely dumped into the braking "
"resistor."
msgstr ""

