#. type: delimited block -
#: src/gui/qtvcp.adoc:496 src/gui/qtvcp-vcp-panels.adoc:415
#, no-wrap
msgid "net s32-in1        test_panel.doublescale_1-s   classicladder.0.s32in-00\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp.adoc:499 src/gui/qtvcp-vcp-panels.adoc:418
#, fuzzy, no-wrap
msgid ""
"# start thread\n"
"start\n"
msgstr ""
"# démarre les threads\n"
"start\n"

