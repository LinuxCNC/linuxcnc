"add the handle patch file there, named like so <ORIGINAL PANEL NAME>_handler.py,\n"
"i.e. for cam_align the file would be called 'cam_align_handler.py'."
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-vcp-panels.adoc:506
msgid "Here is a sample to change the circle color in cam_align: +"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:514
#, no-wrap
msgid ""
"import sys\n"
"import os\n"
"import importlib\n"
"from PyQt5.QtCore import Qt\n"
"from qtvcp.core import Path\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:525
#, no-wrap
msgid ""
"# get reference to original handler file so we can subclass it\n"
"sys.path.insert(0, PATH.PANELDIR)\n"
"panel = os.path.splitext(os.path.basename(os.path.basename(__file__)))[0]\n"
"base = panel.replace('_handler','')\n"
"module = \"{}.{}\".format(base,panel)\n"
"mod = importlib.import_module(module, PATH.PANELDIR)\n"
"sys.path.remove(PATH.PANELDIR)\n"
"HandlerClass = mod.HandlerClass\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:529
#, fuzzy, no-wrap
msgid ""
"# return our subclassed handler object to Qtvcp\n"
"def get_handlers(halcomp, widgets, paths):\n"
"    return [UserHandlerClass(halcomp, widgets, paths)]\n"
msgstr ""
"def get_handlers(halcomp,builder,useropts):\n"
"    return [HandlerClass(halcomp,builder,useropts)]\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:533
#, no-wrap
msgid ""
"# subclassed from HandlerClass which was imported above\n"
"class UserHandlerClass(HandlerClass):\n"
"    print('Custom subclassed panel handler loaded\\n')\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:537
#, no-wrap
msgid ""
"    def initialized__(self):\n"
"        # call original handler initialized function\n"
"        super().initialized__()\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:540
#, no-wrap
msgid ""
"        # add our customization\n"
"        self.w.camview.circle_color = Qt.green\n"
msgstr ""

