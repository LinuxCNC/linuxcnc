#. type: Title ====
#: src/code/code-notes.adoc:1312
#, no-wrap
msgid "interp"
msgstr "interp"

#. type: NOTE
#: src/code/code-notes.adoc:1315
msgid ""
"+settings+ is of type +settings+, defined as +struct setup_struct+ in +src/"
"emc/rs274ngc/interp_internal.hh+."
msgstr ""

#. type: Labeled list
#: src/code/code-notes.adoc:1316
#, no-wrap
msgid "settings.selected_pocket"
msgstr ""

#. type: NOTE
#: src/code/code-notes.adoc:1318
msgid "Tooldata index of the tool most recently selected by +Txxx+."
msgstr ""

#. type: Labeled list
#: src/code/code-notes.adoc:1319
#, no-wrap
msgid "settings.current_pocket"
msgstr ""

#. type: NOTE
#: src/code/code-notes.adoc:1322
msgid ""
"Original tooldata index of the tool currently in the spindle.  In other "
"words: which tooldata index the tool that's currently in the spindle was "
"loaded from."
