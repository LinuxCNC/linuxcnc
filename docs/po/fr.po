msgid "The actual (feedback) value, from some sensor such as an encoder\\&."
msgstr ""

#. type: Plain text
#: man/man9/pid.9:175
#, fuzzy
msgid "B<pid\\&.>I<N>B<\\&.output> float out"
msgstr ""
"_encoder.<chan>.position-latched_ (float, Out) -- Non utilisé à ce moment."

#. type: Plain text
#: man/man9/pid.9:177
msgid ""
