"    <halpin>\"my-radio\"</halpin>\n"
"    <initval>0</initval>\n"
"</radiobutton>\n"
msgstr ""
"<radiobutton>\n"
"    <choices>[\"un\",\"deux\",\"trois\"]</choices>\n"
"    <halpin>\"mon-radiobtn\"</halpin>\n"
