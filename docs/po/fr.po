"    <text>\"Dial\"</text>\n"
"    <initval>0</initval>\n"
"    <resolution>0.001</resolution>\n"
"    <halpin>\"anaout\"</halpin>\n"
"    <dialcolor>\"yellow\"</dialcolor>\n"
"    <edgecolor>\"green\"</edgecolor>\n"
"    <dotcolor>\"black\"</dotcolor>\n"
"    <param_pin>1</param_pin>\n"
"</dial>\n"
msgstr ""
