#. type: Plain text
#: src/hal/halui-examples.adoc:60
msgid ""
"This example was developed to allow LinuxCNC to move a rotary axis on a "
"signal from an external machine.  The coordination between the two systems "
"will be provided by two Halui components:"
msgstr ""

#. type: Plain text
#: src/hal/halui-examples.adoc:62
#, fuzzy
msgid "`halui.program.is-paused`"
msgstr "halui.program.pause (bit, in) - pin pour passer un programme en pause"

#. type: Plain text
#: src/hal/halui-examples.adoc:63
#, fuzzy
