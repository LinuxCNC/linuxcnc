#. type: Plain text
#: src/hal/comp.adoc:367
#, fuzzy, no-wrap
msgid ""
"'option homemod yes' - (default: no)\n"
"Module is a custom Homing module loaded using `[EMCMOT]HOMEMOD=`__modulename__ ."
msgstr "'option homemod yes' - (default: no)  Module is a custom Homing module loaded using [EMCMOT]HOMEMOD=modulename"

#. type: Plain text
#: src/hal/comp.adoc:370
#, fuzzy, no-wrap
