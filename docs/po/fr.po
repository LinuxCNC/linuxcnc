msgstr ""

#. type: Plain text
#: src/man/man3/rtapi_shmem.3.adoc:23
msgid ""
"Identifies the memory block. Key must be nonzero.  All modules wishing to "
"use the same memory must use the same key."
msgstr ""

#. type: Plain text
#: src/man/man3/rtapi_shmem.3.adoc:25
msgid "Module identifier returned by a prior call to *rtapi_init*."
msgstr ""

#. type: Plain text
#: src/man/man3/rtapi_shmem.3.adoc:27
