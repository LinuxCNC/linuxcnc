msgid "MAX VELOCITY"
msgstr "MAX_VELOCITY to fast - (MAX_VELOCITY trop rapide)"

#. type: Plain text
#: src/config/ini-config.adoc:862
#, fuzzy
#| msgid ""
#| "`MAX_LINEAR_VELOCITY = 5.0` - (((MAX VELOCITY))) The maximum velocity for "
#| "any axis or coordinated move, in 'machine units' per second.  The value "
