"    <max_>33</max_>\n"
"    <initval>0</initval>\n"
"    <resolution>0.1</resolution>\n"
"    <format>\"2.3f\"</format>\n"
"    <font>(\"Arial\",30)</font>\n"
"    <param_pin>1</param_pin>\n"
"</spinbox>\n"
