msgstr "halcmd: loadrt sim-encoder num_chan=<number>\n"

#. type: Plain text
#: src/hal/rtcomps.adoc:488
#, fuzzy
msgid ""
"_<number>_ is the number of encoders that you want to simulate If not "
"specified, one encoder will be installed.  The maximum number is 8 (as "
"defined by MAX_CHAN in sim_encoder.c)."
msgstr ""
"_<number>_ est le nombre de canaux à simuler. Si rien n'est spécifié, un "
"seul canal sera installé. Le nombre maximum de canaux est de 8 (comme défini "
"par MAX_CHAN dans sim_encoder.c)."

