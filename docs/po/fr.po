msgstr "FILTER_PROGRESS=%d\n"

#. type: Plain text
#: src/gui/filter-programs.adoc:64
#, fuzzy
msgid ""
"It will set the screens progress bar to the given (10 in this case) "
"percentage.  This feature should be used by any filter that runs for a long "
"time."
msgstr ""
"AXIS fixera la barre de progression selon le pourcentage donné. Cette "
"fonction devrait être utilisée pour un filtre qui fonctionne suffisamment "
"longtemps."

#. type: Title ==
#: src/gui/filter-programs.adoc:65
#, no-wrap
msgid "Making Python Based Filter Programs"
msgstr ""

#. type: Plain text
#: src/gui/filter-programs.adoc:72
msgid ""
"Here is a very basic example of the filtering mechanics: When run through a "
"Linucnc screen that offers program filtering, it will produce and write a "
"line of G-code every 100^th^ of a second to standard output.  It also sends "
"a progress message out to the UNIX standard error stream.  If there was an "
"error it would post an error message and exit with an exitcode of 1."
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:77
#, fuzzy, no-wrap
msgid ""
"import time\n"
"import sys\n"
msgstr ""
"import hal_glib\n"
"import hal\n"

#. type: delimited block -
#: src/gui/filter-programs.adoc:82
#, no-wrap
msgid ""
"for i in range(0,100):\n"
"    try:\n"
"        # simulate calculation time\n"
"        time.sleep(.1)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:85
#, no-wrap
msgid ""
"        # output a line of G-code\n"
"        print('G0 X1', file=sys.stdout)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:92
#, no-wrap
msgid ""
"        # update progress\n"
"        print('FILTER_PROGRESS={}'.format(i), file=sys.stderr)\n"
"    except:\n"
"        # This causes an error message\n"
"        print('Error; But this was only a test', file=sys.stderr)\n"
"        raise SystemExit(1)\n"
msgstr ""

#. type: Plain text
#: src/gui/filter-programs.adoc:98
msgid ""
"Here is a similar program but it actually could filter.  It puts up a PyQt5 "
"dialog with a cancel button.  Then it reads the program line by line and "
"passes it to standard output.  As it goes along, it updates any process "
"listening to standard error output."
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:106
#, fuzzy, no-wrap
msgid ""
"import sys\n"
"import os\n"
"import time\n"
msgstr ""
"import linuxcnc\n"
"import os\n"
"import hal\n"
"import hal_glib\n"

#. type: delimited block -
#: src/gui/filter-programs.adoc:110
#, no-wrap
msgid ""
"from PyQt5.QtWidgets import (QApplication, QDialog, QDialogButtonBox,\n"
"                            QVBoxLayout,QDialogButtonBox)\n"
"from PyQt5.QtCore import QTimer, Qt\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:112
#, no-wrap
msgid "class CustomDialog(QDialog):\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:117
#, no-wrap
msgid ""
"    def __init__(self, path):\n"
"        super(CustomDialog, self).__init__(None)\n"
"        self.setWindowFlags(self.windowFlags() | Qt.WindowStaysOnTopHint)\n"
"        self.setWindowTitle(\"Filter-with-GUI Test\")\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:119
#, no-wrap
msgid "        QBtn = QDialogButtonBox.Cancel\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:122
#, no-wrap
msgid ""
"        self.buttonBox = QDialogButtonBox(QBtn)\n"
"        self.buttonBox.rejected.connect(self.reject)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:126
#, no-wrap
msgid ""
"        self.layout = QVBoxLayout()\n"
"        self.layout.addWidget(self.buttonBox)\n"
"        self.setLayout(self.layout)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:129
#, no-wrap
msgid ""
"        self.line = 0\n"
"        self._percentDone = 0\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:133
#, no-wrap
msgid ""
"        if not os.path.exists(path):\n"
"            print(\"Path: '{}' doesn't exist:\".format(path), file=sys.stderr)\n"
"            raise SystemExit(1)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:136
#, no-wrap
msgid ""
"        self.infile = open(path, \"r\")\n"
"        self.temp = self.infile.readlines()\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:139
#, no-wrap
msgid ""
"        # calculate percent update interval\n"
"        self.bump = 100/float(len(self.temp))\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:143
#, no-wrap
msgid ""
"        self._timer = QTimer()\n"
"        self._timer.timeout.connect(self.process)\n"
"        self._timer.start(100)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:148
#, no-wrap
msgid ""
"    def reject(self):\n"
"        # This provides an error message\n"
"        print('You asked to cancel before finished.', file=sys.stderr)\n"
"        raise SystemExit(1)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:153
#, no-wrap
msgid ""
"    def process(self):\n"
"        try:\n"
"            # get next line of code\n"
"            codeLine = self.temp[self.line]\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:155
#, no-wrap
msgid "            # process the line somehow\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:159
#, no-wrap
msgid ""
"            # push out processed code\n"
"            print(codeLine, file=sys.stdout)\n"
"            self.line +=1\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:163
#, no-wrap
msgid ""
"            # update progress\n"
"            self._percentDone += self.bump\n"
"            print('FILTER_PROGRESS={}'.format(int(self._percentDone)), file=sys.stderr)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:169
#, no-wrap
msgid ""
"            # if done end with no error/error message\n"
"            if self._percentDone >= 99:\n"
"                print('FILTER_PROGRESS=-1', file=sys.stderr)\n"
"                self.infile.close()\n"
"                raise SystemExit(0)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:175
#, no-wrap
msgid ""
"        except Exception as e:\n"
"            # This provides an error message\n"
"            print(('Something bad happened:',e), file=sys.stderr)\n"
"            # this signals the error message should be shown\n"
"            raise SystemExit(1)\n"
msgstr ""

#. type: delimited block -
#: src/gui/filter-programs.adoc:185
#, no-wrap
msgid ""
"if __name__ == \"__main__\":\n"
"    if (len(sys.argv)>1):\n"
"        path = sys.argv[1]\n"
"    else:\n"
"        path = None\n"
"    app = QApplication(sys.argv)\n"
"    w = CustomDialog(path=path)\n"
"    w.show()\n"
"    sys.exit( app.exec_() )\n"
msgstr ""

