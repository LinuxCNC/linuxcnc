"MDI_COMMAND = G28\n"
"MDI_COMMAND = o<mysub>call\n"
"...\n"
msgstr ""
"[HALUI]\n"
"MDI_COMMAND = G0 X0\n"
"MDI_COMMAND = G0 G53 Z0\n"
"MDI_COMMAND = G28\n"
"MDI_COMMAND = o<mysub>call\n"
"...\n"

#. type: Plain text
#: src/gui/halui.adoc:59
#, fuzzy
