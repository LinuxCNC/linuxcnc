#, no-wrap
msgid "ESTOP_LATCH"
msgstr ""

#. type: Plain text
#: man/man9/estop_latch.9:32
#, fuzzy
msgid "estop_latch - Software ESTOP latch"
msgstr "(((estop_latch))) Verrou d'Arrêt d'Urgence."

