#. type: delimited block -
#: src/man/man3/rtapi_atomic.3.adoc:55
#, no-wrap
msgid ""
"// consumer\n"
"while(atomic_load_explicit(message_ready, memory_order_acquire) == 0) sched_yield();\n"
"printf(\"message was %d\\n\", *message); // must print 42\n"
msgstr ""

