#, fuzzy, no-wrap
msgid "*halui.max-velocity.count-enable* bit in (default: *TRUE*)"
msgstr "'halui.rapid-override.count-enable' (bit in (default: TRUE)) - When TRUE, modify Rapid Override when counts changes."

#. type: Plain text
#: src/man/man1/halui.1.adoc:188
msgid "When True, modify max velocity when halui.max-velocity.counts changes."
msgstr ""

#. type: Labeled list
