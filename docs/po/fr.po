#. type: Plain text
#: src/gui/gstat.adoc:522
#, fuzzy
msgid "An example of the listening object:"
msgstr "Exemple de G-Code avec G76"

#. type: delimited block -
#: src/gui/gstat.adoc:527
#, no-wrap
msgid ""
"# tell STATUS we want to respond to any sent 'status-message' messages.\n"
"STATUS.connect('status-message', lambda w, d, o: self.add_external_status(m,o))\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:529
#, no-wrap
msgid "    def add_external_status(self, message, option):\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:536
#, no-wrap
msgid ""
"        # extract and trap errors for expected entries\n"
"        level = option.get('LEVEL', STATUS.DEFAULT) \n"
"        log = option.get(\"LOG\", True)\n"
"        title = message.get('TITLE', '')\n"
"        mess = message.get('SHORTTEXT', '')\n"
"        logtext = message.get('DETAILS', '')\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:539
#, no-wrap
msgid ""
"        # call a function to print the message on a statusbar:\n"
"        self.add_status(mess, level, noLog=True)\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:543
#, no-wrap
msgid ""
"        # request a log file update\n"
"        if log:\n"
"            STATUS.emit('update-machine-log', \"{}\\n{}\".format(title, logtext), 'TIME')\n"
msgstr ""

