#: src/man/man3/rtapi_parport.3.adoc:73
msgid "*rtapi_parport_release* does not return a value. It always succeeds."
msgstr ""

#. type: Plain text
#: src/man/man3/rtapi_parport.3.adoc:76
msgid "In new code, prefer use of rtapi_parport to rtapi_parport."
msgstr ""

