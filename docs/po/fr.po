msgstr "_<name>.at-speed_ (bit, out) Quand la consigne vitesse est atteinte."

#. type: NOTE
#: src/drivers/vfs11.adoc:59
#, fuzzy
msgid "'<n>.current-load-percentage' (float, out)  reported from the VFD"
msgstr "_<name>.load-percentage_ (float, out) envoyé par le variateur."

#. type: NOTE
