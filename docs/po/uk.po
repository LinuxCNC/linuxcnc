"#<отворів> = 1-4."

#. type: Table
#: src/plasma/qtplasmac.adoc:4389
#, no-wrap
msgid ""
"`#<h_velocity> =` _n_ +\n"
"(_n_ is the percentage, set the percentage of the current feed rate)"
msgstr ""
"`#<h_velocity> =` _n_ +\n"
"(_n_ це відсоток, встановіть відсоток поточної швидкості подачі)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4389
#, no-wrap
