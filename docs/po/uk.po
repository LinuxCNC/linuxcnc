msgstr "*поточний стан кнопки*, або"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:3054
msgid "the *state of a HAL pin*, or"
msgstr "*стан виводу HAL*, або"

#. type: Plain text
