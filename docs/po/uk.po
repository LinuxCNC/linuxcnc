#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:40
#, no-wrap
msgid ""
"; G-code highlighting stresstest - useless otherwise\n"
";\n"
"#<tool_change_at_g30> = 0\n"
"G0 (Rapid to start) X1 Y1\n"
"G0 X1 Y1 (Rapid to start; but don't forget the coolant)\n"
"M2 ; End of program.\n"
"M66 P1 L3 Q[#<timeout>]\n"
"M66 P1 L3 Q[#<timeout> + [#4711]]\n"
"M66 P1 L3 Q#<timeout>\n"
"M66 P1 L3 Q#3\n"
"M66 P1 L3 Q#5999\n"
"G5  X23.5 a 19.2\n"
"(debug, foo!)\n"
"(Debug, some text and a substitution: #23 and some more thereafter)\n"
"(DEBUG, #<_a_param>)\n"
"(DEBUG, #<xxx>)\n"
msgstr ""
"; Підсвічування G-коду стрес-тест - в іншому випадку марне\n"
";\n"
"#<tool_change_at_g30> = 0\n"
"G0 (Швидкий старт) X1 Y1\n"
"G0 X1 Y1 (Швидкий старт; але не забудьте про охолоджуючу рідину)\n"
"M2 ; Кінець програми.\n"
"M66 P1 L3 Q[#<timeout>]\n"
"M66 P1 L3 Q[#<timeout> + [#4711]]\n"
"M66 P1 L3 Q#<timeout>\n"
"M66 P1 L3 Q#3\n"
"M66 P1 L3 Q#5999\n"
"G5  X23.5 a 19.2\n"
"(debug, foo!)\n"
"(Debug, деякий текст і заміна: #23 і ще дещо після цього)\n"
"(DEBUG, #<_a_param>)\n"
"(DEBUG, #<xxx>)\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:68
#, no-wrap
msgid ""
"G0 G53 Z0 X[#19]\n"
"G 3 0\n"
"G00\n"
"G01\n"
"G 0 1\n"
"G3 0\n"
"G30\n"
"G53\n"
"G5 3\n"
"G 5 3\n"
"G0\n"
"G1\n"
";\n"
"; To activate, incantate as follows in the INI file:\n"
";\n"
"; [RS274NGC]\n"
"; # Remap M6 to a named O-word subroutine.\n"
"; # The tool number currently loaded (in spindle) is passed as parameter #1\n"
"; M6_COMMAND=o<m6demo>call\n"
";\n"
";\n"
"N4711 O<m6demo> sub\n"
";\n"
";\n"
"N 0815 #<tool_change_with_spindle_on> = 0\n"
"#<tool_change_quill_up> = 0\n"
"#<tool_change_at_g30> = 0\n"
msgstr ""
"G0 G53 Z0 X[#19]\n"
"G 3 0\n"
"G00\n"
"G01\n"
"G 0 1\n"
"G3 0\n"
"G30\n"
"G53\n"
"G5 3\n"
"G 5 3\n"
"G0\n"
"G1\n"
";\n"
"; Для активації виконайте наступні дії в файлі INI:\n"
";\n"
"; [RS274NGC]\n"
"; # Перепризначити M6 на підпрограму з іменем O-word.\n"
"; # Номер інструменту, який зараз завантажений (у шпинделі), передається як параметр #1.\n"
"; M6_COMMAND=o<m6demo>call\n"
";\n"
";\n"
"N4711 O<m6demo> sub\n"
";\n"
";\n"
"N 0815 #<tool_change_with_spindle_on> = 0\n"
"#<tool_change_quill_up> = 0\n"
"#<tool_change_at_g30> = 0\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:70
#, no-wrap
msgid "#4711 = 8.15\n"
msgstr "#4711 = 8.15\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:79
#, no-wrap
msgid ""
"; number of seconds to wait for 'tool-changed' equivalent\n"
"#<timeout> = 9999\n"
";\n"
"(DEBUG, executing M6 O-word sub, tool=#1)\n"
";\n"
"O<m6demo_spindle_off> if [#<tool_change_with_spindle_on>] EQ 0\n"
"    M5\n"
"O<m6demo_spindle_off> endif\n"
msgstr ""
"; кількість секунд очікування еквівалента «заміни інструменту»\n"
"#<timeout> = 9999\n"
";\n"
"(DEBUG, executing M6 O-word sub, tool=#1)\n"
";\n"
"O<m6demo_spindle_off> if [#<tool_change_with_spindle_on>] EQ 0\n"
"    M5\n"
"O<m6demo_spindle_off> endif\n"

