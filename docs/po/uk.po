msgstr "B<oneshot>\\&.I<N>\\&.B<width> float in (за замовчуванням: I<0>)"

#. type: Plain text
#: man/man9/oneshot.9:69
msgid "Pulse width in seconds"
msgstr "Ширина імпульсу в секундах"

#. type: Plain text
#: man/man9/oneshot.9:72
