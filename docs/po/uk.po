msgstr "B<logic>\\&.I<N>\\&.B<and> bit out [якщо особистість & 0x100]"

#. type: Plain text
#: man/man9/logic.9:140
msgid "B<logic>\\&.I<N>\\&.B<or> bit out [if personality & 0x200]"
msgstr "B<logic>\\&.I<N>\\&.B<or> bit out [якщо особистість & 0x200]"

#. type: Plain text
#: man/man9/logic.9:144
msgid "B<logic>\\&.I<N>\\&.B<xor> bit out [if personality & 0x400]"
msgstr "B<logic>\\&.I<N>\\&.B<xor> bit out [якщо особистість & 0x400]"

#. type: Plain text
#: man/man9/logic.9:148
msgid "B<logic>\\&.I<N>\\&.B<nand> bit out [if personality & 0x800]"
msgstr "B<logic>\\&.I<N>\\&.B<nand> bit out [якщо особистість & 0x800]"

#. type: Plain text
