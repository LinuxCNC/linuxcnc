msgstr "Мінімальний інтервал вибірки (у секундах) для нової точки маршруту"

#. type: Plain text
#: man/man9/moveoff.9:116
msgid "B<moveoff>\\&.I<N>\\&.B<warning> bit out"
msgstr "B<moveoff>\\&.I<N>\\&.B<warning> bit out"

#. type: Plain text
#: man/man9/moveoff.9:118
msgid ""
"Set TRUE if apply-offsets is deasserted while offset-applied is TRUE\\&."
msgstr ""
"Встановіть значення TRUE, якщо значення apply-offsets скасовано, а значення "
"offset-applied має значення TRUE."

#. type: Plain text
