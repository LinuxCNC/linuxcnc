msgstr ""
"B<sim-home-switch>\\&.I<N>\\&.B<home-pos> float in (за замовчуванням: I<1>)"

#. type: Plain text
#: man/man9/sim_home_switch.9:53
msgid "Home switch position"
msgstr "Положення перемикача «Головний»"

