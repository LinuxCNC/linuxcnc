#. type: Title ==
#: src/gui/qtvcp-custom-widgets.adoc:446
#, no-wrap
msgid "Custom Controller Widgets with Actions"
msgstr "Віджети налаштованого контролера з діями"

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:449
msgid "Here is an example of a widget that sets the user reference system."
msgstr "Ось приклад віджета, який встановлює систему відліку користувача."

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:451
msgid "It changes:"
msgstr "Це змінюється:"

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:453
msgid "the machine controller state using the `ACTION` library,"
msgstr "стан контролера машини за допомогою бібліотеки `ACTION`,"

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:454
msgid "whether the button can be clicked or not using the `STATUS` library."
msgstr "чи можна натиснути кнопку, використовуючи бібліотеку `STATUS`."

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:459
#, no-wrap
msgid ""
"import os\n"
"import hal\n"
msgstr ""
"import os\n"
"import hal\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:463
#, no-wrap
msgid ""
"from PyQt5.QtWidgets import QWidget, QToolButton, QMenu, QAction\n"
"from PyQt5.QtCore import Qt, QEvent, pyqtProperty, QBasicTimer, pyqtSignal\n"
"from PyQt5.QtGui import QIcon\n"
msgstr ""
"from PyQt5.QtWidgets import QWidget, QToolButton, QMenu, QAction\n"
"from PyQt5.QtCore import Qt, QEvent, pyqtProperty, QBasicTimer, pyqtSignal\n"
"from PyQt5.QtGui import QIcon\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:467
#, no-wrap
msgid ""
"from qtvcp.widgets.widget_baseclass import _HalWidgetBase\n"
"from qtvcp.widgets.dialog_widget import EntryDialog\n"
"from qtvcp.core import Status, Action, Info\n"
msgstr ""
"from qtvcp.widgets.widget_baseclass import _HalWidgetBase\n"
"from qtvcp.widgets.dialog_widget import EntryDialog\n"
"from qtvcp.core import Status, Action, Info\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:475
#, no-wrap
msgid ""
"# Instantiate the libraries with global reference\n"
"# STATUS gives us status messages from LinuxCNC\n"
"# INFO holds INI details\n"
"# ACTION gives commands to LinuxCNC\n"
"STATUS = Status()\n"
"INFO = Info()\n"
"ACTION = Action()\n"
msgstr ""
"# Інстанціювання бібліотек із глобальним посиланням\n"
"# STATUS надає нам повідомлення про стан від LinuxCNC\n"
"# INFO містить деталі INI\n"
"# ACTION надає команди LinuxCNC\n"
"STATUS = Status()\n"
"INFO = Info()\n"
"ACTION = Action()\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:485
#, no-wrap
msgid ""
"class SystemToolButton(QToolButton, _HalWidgetBase):\n"
"    def __init__(self, parent=None):\n"
"        super(SystemToolButton, self).__init__(parent)\n"
"        self._joint = 0\n"
"        self._last = 0\n"
"        self._block_signal = False\n"
"        self._auto_label_flag = True\n"
"        SettingMenu = QMenu()\n"
"        for system in('G54', 'G55', 'G56', 'G57', 'G58', 'G59', 'G59.1', 'G59.2', 'G59.3'):\n"
msgstr ""
"class SystemToolButton(QToolButton, _HalWidgetBase):\n"
"    def __init__(self, parent=None):\n"
"        super(SystemToolButton, self).__init__(parent)\n"
"        self._joint = 0\n"
"        self._last = 0\n"
"        self._block_signal = False\n"
"        self._auto_label_flag = True\n"
"        SettingMenu = QMenu()\n"
"        for system in('G54', 'G55', 'G56', 'G57', 'G58', 'G59', 'G59.1', 'G59.2', 'G59.3'):\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:489
#, no-wrap
msgid ""
"            Button = QAction(QIcon('exit24.png'), system, self)\n"
"            Button.triggered.connect(self[system.replace('.','_')])\n"
"            SettingMenu.addAction(Button)\n"
msgstr ""
"            Button = QAction(QIcon('exit24.png'), system, self)\n"
"            Button.triggered.connect(self[system.replace('.','_')])\n"
"            SettingMenu.addAction(Button)\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:492
#, no-wrap
msgid ""
"        self.setMenu(SettingMenu)\n"
"        self.dialog = EntryDialog()\n"
msgstr ""
"        self.setMenu(SettingMenu)\n"
"        self.dialog = EntryDialog()\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:499
#, no-wrap
msgid ""
"    def _hal_init(self):\n"
"        if not self.text() == '':\n"
"            self._auto_label_flag = False\n"
"        def homed_on_test():\n"
"            return (STATUS.machine_is_on()\n"
"                    and (STATUS.is_all_homed() or INFO.NO_HOME_REQUIRED))\n"
msgstr ""
"    def _hal_init(self):\n"
"        if not self.text() == '':\n"
"            self._auto_label_flag = False\n"
"        def homed_on_test():\n"
"            return (STATUS.machine_is_on()\n"
"                    and (STATUS.is_all_homed() or INFO.NO_HOME_REQUIRED))\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:508
#, no-wrap
msgid ""
"        STATUS.connect('state-off', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('state-estop', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('interp-idle', lambda w: self.setEnabled(homed_on_test()))\n"
"        STATUS.connect('interp-run', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('all-homed', lambda w: self.setEnabled(True))\n"
"        STATUS.connect('not-all-homed', lambda w, data: self.setEnabled(False))\n"
"        STATUS.connect('interp-paused', lambda w: self.setEnabled(True))\n"
"        STATUS.connect('user-system-changed', self._set_user_system_text)\n"
msgstr ""
"        STATUS.connect('state-off', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('state-estop', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('interp-idle', lambda w: self.setEnabled(homed_on_test()))\n"
"        STATUS.connect('interp-run', lambda w: self.setEnabled(False))\n"
"        STATUS.connect('all-homed', lambda w: self.setEnabled(True))\n"
"        STATUS.connect('not-all-homed', lambda w, data: self.setEnabled(False))\n"
"        STATUS.connect('interp-paused', lambda w: self.setEnabled(True))\n"
"        STATUS.connect('user-system-changed', self._set_user_system_text)\n"

