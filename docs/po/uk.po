msgstr ""
"[JOINT_0]HOME_SEQUENCE =  0\n"
"[JOINT_1]HOME_SEQUENCE = -1\n"
"[JOINT_2]HOME_SEQUENCE =  1\n"

#. type: Plain text
#: src/config/ini-homing.adoc:303
