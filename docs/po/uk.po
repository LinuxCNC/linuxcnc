msgstr "B<biquad>\\&.I<N>\\&.B<d1> float rw (за замовчуванням: I<0\\&.0>)"

#. type: Plain text
#: man/man9/biquad.9:109
msgid "1st-delayed denominator coef"
msgstr "Коефіцієнт знаменника з 1-ю затримкою"

#. type: Plain text
#: man/man9/biquad.9:112
msgid "B<biquad>\\&.I<N>\\&.B<d2> float rw (default: I<0\\&.0>)"
msgstr "B<biquad>\\&.I<N>\\&.B<d2> float rw (за замовчуванням: I<0\\&.0>)"

#. type: Plain text
#: man/man9/biquad.9:114
msgid "2nd-delayed denominator coef"
msgstr "Коефіцієнт знаменника з затримкою 2-го рівня"

#. type: Plain text
#: man/man9/biquad.9:117
msgid "B<biquad>\\&.I<N>\\&.B<n0> float rw (default: I<1\\&.0>)"
msgstr "B<biquad>\\&.I<N>\\&.B<n0> float rw (за замовчуванням: I<1\\&.0>)"

#. type: Plain text
#: man/man9/biquad.9:119
msgid "non-delayed numerator coef"
msgstr "коефіцієнт чисельника без затримки"

#. type: Plain text
#: man/man9/biquad.9:122
msgid "B<biquad>\\&.I<N>\\&.B<n1> float rw (default: I<0\\&.0>)"
msgstr "B<biquad>\\&.I<N>\\&.B<n1> float rw (за замовчуванням: I<0\\&.0>)"

#. type: Plain text
#: man/man9/biquad.9:124
msgid "1st-delayed numerator coef"
msgstr "Коефіцієнт чисельника з 1-ю затримкою"

#. type: Plain text
#: man/man9/biquad.9:127
