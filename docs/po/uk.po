msgstr "Кріс С. Морлі"

#. type: TH
#: man/man9/mux2.9:10
#, no-wrap
msgid "MUX2"
msgstr "MUX2"

#. type: Plain text
#: man/man9/mux2.9:32
msgid "mux2 - Select from one of two input values"
msgstr "mux2 - Виберіть одне з двох вхідних значень"

#. type: Plain text
#: man/man9/mux2.9:35
msgid "B<loadrt mux2> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt mux2> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/mux2.9:38
msgid "B<mux2>\\&.I<N> (requires a floating-point thread)"
msgstr "B<mux2>\\&.I<N> (вимагає потоку з плаваючою комою)"

#. type: Plain text
#: man/man9/mux2.9:43
msgid "B<mux2>\\&.I<N>\\&.B<sel> bit in"
msgstr "B<mux2>\\&.I<N>\\&.B<sel> bit in"

#. type: Plain text
#: man/man9/mux2.9:47
msgid "B<mux2>\\&.I<N>\\&.B<out> float out"
msgstr "B<mux2>\\&.I<N>\\&.B<out> float out"

#. type: Plain text
#: man/man9/mux2.9:57
msgid ""
"Follows the value of B<in0> if B<sel> is FALSE, or B<in1> if B<sel> is TRUE"
msgstr ""
"Слідує за значенням B<in0>, якщо B<sel> має значення FALSE, або B<in1>, якщо "
"B<sel> має значення TRUE"

#. type: Plain text
#: man/man9/mux2.9:60
msgid "B<mux2>\\&.I<N>\\&.B<in1> float in"
msgstr "B<mux2>\\&.I<N>\\&.B<in1> float in"

#. type: Plain text
#: man/man9/mux2.9:64
msgid "B<mux2>\\&.I<N>\\&.B<in0> float in"
msgstr "B<mux2>\\&.I<N>\\&.B<in0> float in"

#. type: Plain text
#: man/man9/mux2.9:69
msgid "mux4(9), mux8(9), mux16(9), mux_generic(9)\\&."
msgstr "mux4(9), mux8(9), mux16(9), mux_generic(9)\\&."

#. type: TH
#: man/man9/mux4.9:10
#, no-wrap
msgid "MUX4"
msgstr "MUX4"

#. type: Plain text
#: man/man9/mux4.9:32
msgid "mux4 - Select from one of four input values"
msgstr "mux4 - Виберіть одне з чотирьох вхідних значень"

#. type: Plain text
#: man/man9/mux4.9:35
msgid "B<loadrt mux4> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt mux4> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/mux4.9:38
msgid "B<mux4>\\&.I<N> (requires a floating-point thread)"
msgstr "B<mux4>\\&.I<N> (вимагає потоку з плаваючою комою)"

#. type: Plain text
