msgid "Should be driven TRUE if the home switch for this joint is closed."
msgstr ""
"Має бути встановлене на TRUE, якщо початковий перемикач для цього з'єднання "
"замкнутий."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:359
#, no-wrap
msgid "**joint.**_N_**.homed** OUT BIT *(DEBUG)*"
msgstr "**joint.**_N_**.homed** OUT BIT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:361
msgid "TRUE if the joint has been homed."
msgstr "TRUE, якщо з'єднання було переведено в основну точку."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:361
#, no-wrap
