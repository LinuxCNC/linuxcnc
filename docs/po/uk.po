"ROW 2\n"
"    (bit out) xhc-hb04.button-goto-zero\n"
"    (bit out) xhc-hb04.button-rewind\n"
"    (bit out) xhc-hb04.button-start-pause\n"
"    (bit out) xhc-hb04.button-probe-z\n"
msgstr ""
"ROW 2\n"
"    (bit out) xhc-hb04.button-goto-zero\n"
"    (bit out) xhc-hb04.button-rewind\n"
"    (bit out) xhc-hb04.button-start-pause\n"
"    (bit out) xhc-hb04.button-probe-z\n"

