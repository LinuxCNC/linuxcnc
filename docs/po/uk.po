msgstr "_<name>_.spindle-speed-fb (float, out)"

#. type: Plain text
#: src/man/man1/hy_vfd.1.adoc:218
msgid "Current spindle speed as reported by Huanyang VFD (rpm)."
msgstr ""
"Поточна швидкість шпинделя, згідно з даними частотного перетворювача "
