#, no-wrap
msgid ""
"`#<holes> = 1` +\n"
"for holes less than 32 mm (1.26\") diameter"
msgstr ""
"`#<holes> = 1` +\n"
"для отворів діаметром менше 32 мм (1,26 дюйма)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4373
#, no-wrap
