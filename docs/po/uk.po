#, no-wrap
msgid "*`invert_state_status`*"
msgstr "*`invert_state_status`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2312
msgid "Invert the LED state compared to the LinuxCNC state."
msgstr "Інвертувати стан світлодіода порівняно зі станом LinuxCNC."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2314
msgid "Diameter of the LED."
msgstr "Діаметр світлодіода."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2316
msgid "Color of the LED when on."
msgstr "Колір світлодіода у ввімкненому стані."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2318
msgid "Color of the LED when off."
msgstr "Колір світлодіода у вимкненому стані."

#. type: Plain text
