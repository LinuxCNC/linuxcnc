#: src/man/man1/moveoff_gui.1.adoc:35
#, no-wrap
msgid ""
"Letters from set of \\{x y z a b c u v w}.\n"
"Examples: -axes x, -axes xyz, -axes xz (no spaces)\n"
"Default: *xyz*"
msgstr ""
"Літери з набору \\{x y z a b c u v w}.\n"
"Приклади: -axes x, -axes xyz, -axes xz (без пробілів)\n"
"За замовчуванням: *xyz*"

