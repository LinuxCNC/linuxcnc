#~ msgid "Transfer a translated file to po4a"
#~ msgstr "Перенесіть перекладений файл на po4a"

#~ msgid ""
#~ "If there is a pre-existing translation of the file to your language, "
#~ "create a .po translation database seeded by the old translation."
#~ msgstr ""
#~ "Якщо вже існує переклад файлу вашою мовою, створіть базу даних "
#~ "перекладів .po, заповнену старим перекладом."

#~ msgid ""
#~ "If the english file is called \"file.adoc\" then the old pre-existing "
#~ "translated file is probably called \"file_fr.adoc\" (for the french "
#~ "translation, as an example), and the translation database should be "
#~ "called \"file.fr.po\". Creating PO file from adoc can be done by running "
#~ "this command:"
#~ msgstr ""
#~ "Якщо англійський файл називається «file.adoc», тоді старий уже існуючий "
#~ "перекладений файл, ймовірно, називається «file_fr.adoc» (для французького "
#~ "перекладу, як приклад), а база даних перекладу має називатися «file.fr. "
#~ "po\". Створити файл PO з adoc можна за допомогою цієї команди:"

#, no-wrap
#~ msgid ""
#~ "```\n"
#~ "(f=getting-linuxcnc; l=cn; po4a-gettextize \\\n"
#~ "  > --format asciidoc \\\n"
#~ "  > -m ${f}.adoc -M utf8 \\\n"
#~ "  > -l ${f}_${l}.adoc -L utf8 \\\n"
#~ "  > -p ${f}.${l}.po)\n"
#~ "```\n"
#~ msgstr ""
#~ "```\n"
#~ "(f=getting-linuxcnc; l=cn; po4a-gettextize \\\n"
#~ "  > --format asciidoc \\\n"
#~ "  > -m ${f}.adoc -M utf8 \\\n"
#~ "  > -l ${f}_${l}.adoc -L utf8 \\\n"
#~ "  > -p ${f}.${l}.po)\n"
#~ "```\n"

#~ msgid "Similarly, for translated manual pages:"
#~ msgstr "Подібним чином для перекладених сторінок посібника:"

#, no-wrap
#~ msgid ""
#~ "```\n"
#~ "(f=elbpcom.1; l=es; po4a-gettextize \\\n"
#~ "  > --format asciidoc \\\n"
#~ "  > -m man/man1/${f} -M utf8 \\\n"
#~ "  > -l man/${l}/man1/${f} -L utf8 \\\n"
#~ "  -p ${f}.${l}.po)\n"
#~ "```\n"
#~ msgstr ""
#~ "```\n"
#~ "(f=elbpcom.1; l=es; po4a-gettextize \\\n"
#~ "  > --format asciidoc \\\n"
#~ "  > -m man/man1/${f} -M utf8 \\\n"
#~ "  > -l man/${l}/man1/${f} -L utf8 \\\n"
#~ "  -p ${f}.${l}.po)\n"
#~ "```\n"

#~ msgid ""
#~ "To append the extracted translations to the combined PO file, do "
#~ "something like this:"
#~ msgstr ""
#~ "Щоб додати витягнуті переклади до об’єднаного файлу PO, виконайте щось на "
#~ "зразок цього:"

#, no-wrap
#~ msgid ""
#~ "```\n"
#~ "msgcat --use-first po/documentation.es.po \\\n"
#~ "  > elbpcom.1.es.po \\\n"
#~ "  > po/documentation.es.po\n"
#~ "```\n"
#~ msgstr ""
