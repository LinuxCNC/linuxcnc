#. type: TH
#: man/man9/axistest.9:10
#, no-wrap
msgid "AXISTEST"
msgstr "AXISTEST"

#. type: Plain text
#: man/man9/axistest.9:32
msgid "axistest - Used to allow testing of an axis\\&. Used IN PnCconf\\&."
msgstr ""
"axistest - Використовується для тестування осі. Використовується В PnCconf."

#. type: Plain text
#: man/man9/axistest.9:35
msgid "B<loadrt axistest> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt axistest> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/axistest.9:38
msgid "B<axistest>\\&.I<N>\\&.B<update> (requires a floating-point thread)"
msgstr "B<axistest>\\&.I<N>\\&.B<update> (потрібен потік з плаваючою комою)"

#. type: Plain text
#: man/man9/axistest.9:43
msgid "B<axistest>\\&.I<N>\\&.B<jog-minus> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<jog-minus> bit in"

#. type: Plain text
#: man/man9/axistest.9:45
msgid "Drive TRUE to jog the axis in its negative (I<minus>) direction\\&."
msgstr ""
"Встановіть значення TRUE, щоб перемістити вісь у негативному (I<мінус>) "
"напрямку."

#. type: Plain text
#: man/man9/axistest.9:48
msgid "B<axistest>\\&.I<N>\\&.B<jog-plus> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<jog-plus> bit in"

#. type: Plain text
#: man/man9/axistest.9:50
msgid "Drive TRUE to jog the axis in its positive direction\\&."
msgstr "Встановіть значення TRUE, щоб перемістити вісь у позитивному напрямку."

#. type: Plain text
#: man/man9/axistest.9:53
msgid "B<axistest>\\&.I<N>\\&.B<run> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<run> bit in"

#. type: Plain text
#: man/man9/axistest.9:55
msgid ""
"Drive TRUE to run the axis near its current position_fb with a trapezoidal "
"velocity profile\\&."
msgstr ""
"Встановіть значення TRUE, щоб перемістити вісь поблизу її поточної позиції "
"position_fb з трапецієподібним профілем швидкості."

#. type: Plain text
#: man/man9/axistest.9:58
msgid "B<axistest>\\&.I<N>\\&.B<maxvel> float in"
msgstr "B<axistest>\\&.I<N>\\&.B<maxvel> float in"

#. type: Plain text
#: man/man9/axistest.9:60 man/man9/simple_tp.9:50 man/man9/steptest.9:60
msgid "Maximum velocity"
msgstr "Максимальна швидкість"

#. type: Plain text
#: man/man9/axistest.9:63
msgid "B<axistest>\\&.I<N>\\&.B<amplitude> float in"
msgstr "B<axistest>\\&.I<N>\\&.B<amplitude> float in"

#. type: Plain text
#: man/man9/axistest.9:66 man/man9/steptest.9:71
msgid "Approximate amplitude of positions to command during I<run>"
msgstr "Приблизна амплітуда позицій для керування під час I<run>"

#. type: Plain text
#: man/man9/axistest.9:69
msgid "B<axistest>\\&.I<N>\\&.B<dir> s32 in"
msgstr "B<axistest>\\&.I<N>\\&.B<dir> s32 in"

#. type: Plain text
#: man/man9/axistest.9:71 man/man9/steptest.9:76
msgid ""
"Direction from central point to test: 0 = both, 1 = positive, 2 = negative"
msgstr ""
"Напрямок від центральної точки до тесту: 0 = обидва, 1 = позитивний, 2 = "
"негативний"

#. type: Plain text
#: man/man9/axistest.9:74
msgid "B<axistest>\\&.I<N>\\&.B<position-cmd> float out"
msgstr "B<axistest>\\&.I<N>\\&.B<position-cmd> float out"

#. type: Plain text
#: man/man9/axistest.9:78
msgid "B<axistest>\\&.I<N>\\&.B<position-fb> float in"
msgstr "B<axistest>\\&.I<N>\\&.B<position-fb> float in"

#. type: Plain text
#: man/man9/axistest.9:82
msgid "B<axistest>\\&.I<N>\\&.B<running> bit out"
msgstr "B<axistest>\\&.I<N>\\&.B<running> bit out"

#. type: Plain text
#: man/man9/axistest.9:86
msgid "B<axistest>\\&.I<N>\\&.B<run-target> float out"
msgstr "B<axistest>\\&.I<N>\\&.B<run-target> float out"

#. type: Plain text
#: man/man9/axistest.9:90
msgid "B<axistest>\\&.I<N>\\&.B<run-start> float out"
msgstr "B<axistest>\\&.I<N>\\&.B<run-start> float out"

#. type: Plain text
#: man/man9/axistest.9:94
msgid "B<axistest>\\&.I<N>\\&.B<run-low> float out"
msgstr "B<axistest>\\&.I<N>\\&.B<run-low> float out"

#. type: Plain text
#: man/man9/axistest.9:98
msgid "B<axistest>\\&.I<N>\\&.B<run-high> float out"
msgstr "B<axistest>\\&.I<N>\\&.B<run-high> float out"

#. type: Plain text
#: man/man9/axistest.9:102
msgid "B<axistest>\\&.I<N>\\&.B<pause> s32 in (default: I<0>)"
msgstr "B<axistest>\\&.I<N>\\&.B<pause> s32 in (за замовчуванням: I<0>)"

#. type: Plain text
#: man/man9/axistest.9:104
msgid "Pause time for each end of run in seconds"
msgstr "Час паузи для кожного кінця пробігу в секундах"

#. type: Plain text
#: man/man9/axistest.9:108
msgid "B<axistest>\\&.I<N>\\&.B<epsilon> float rw (default: I<\\&.001>)"
msgstr ""
"B<axistest>\\&.I<N>\\&.B<epsilon> float rw (за замовчуванням: I<\\&.001>)"

#. type: Plain text
#: man/man9/axistest.9:112
msgid "B<axistest>\\&.I<N>\\&.B<elapsed> float r"
msgstr "B<axistest>\\&.I<N>\\&.B<elapsed> float r"

#. type: Plain text
#: man/man9/axistest.9:114 man/man9/steptest.9:119 man/man9/timedelay.9:83
msgid "Current value of the internal timer"
msgstr "Поточне значення внутрішнього таймера"

