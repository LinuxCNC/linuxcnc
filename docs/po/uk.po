msgid "SERIAL_BAUD"
msgstr "SERIAL_BAUD"

#. type: Table
#: src/drivers/mb2hal.adoc:86
#, no-wrap
msgid "The baud rate.  Ignored if `LINK_TYPE=tcp`."
msgstr "Швидкість передачі даних. Ігнорується, якщо `LINK_TYPE=tcp`."

#. type: Table
#: src/drivers/mb2hal.adoc:86
#, no-wrap
msgid "SERIAL_BITS"
msgstr "SERIAL_BITS"

#. type: Table
#: src/drivers/mb2hal.adoc:87
#, no-wrap
msgid "Data bits.  One of 5, 6, 7, 8. Ignored if `LINK_TYPE=tcp`."
msgstr "Біти даних. Один з 5, 6, 7, 8. Ігнорується, якщо `LINK_TYPE=tcp`."

#. type: Table
#: src/drivers/mb2hal.adoc:87
#, no-wrap
msgid "SERIAL_PARITY"
msgstr "SERIAL_PARITY"

#. type: Table
#: src/drivers/mb2hal.adoc:88
