msgstr "'motion.debug-bit-1' - (bit, RO) Це використовується для налагодження."

#. type: Plain text
#: src/config/core-components.adoc:174
msgid ""
"'motion.debug-float-0' - (float, RO) This is used for debugging purposes."
msgstr ""
"'motion.debug-float-0' - (float, RO) Це використовується для налагодження."

#. type: Plain text
#: src/config/core-components.adoc:175
msgid ""
"'motion.debug-float-1' - (float, RO) This is used for debugging purposes."
msgstr ""
"'motion.debug-float-1' - (float, RO) Це використовується для налагодження."

#. type: Plain text
#: src/config/core-components.adoc:176
msgid ""
"'motion.debug-float-2' - (float, RO) This is used for debugging purposes."
msgstr ""
"'motion.debug-float-2' - (float, RO) Це використовується для налагодження."

#. type: Plain text
#: src/config/core-components.adoc:177
