msgid "TRISTATE_BIT"
msgstr "TRISTATE_BIT"

#. type: Plain text
#: man/man9/tristate_bit.9:32
msgid ""
"tristate_bit - Place a signal on an I/O pin only when enabled, similar to a "
"tristate buffer in electronics"
msgstr ""
"tristate_bit - Розміщувати сигнал на контакті вводу/виводу лише тоді, коли "
"він увімкнений, подібно до тристабільного буфера в електроніці"

#. type: Plain text
#: man/man9/tristate_bit.9:35
msgid ""
"B<loadrt tristate_bit> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr ""
"B<loadrt tristate_bit> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/tristate_bit.9:38
msgid "B<tristate-bit>\\&.I<N>"
msgstr "B<tristate-bit>\\&.I<N>"

#. type: Plain text
#: man/man9/tristate_bit.9:45 man/man9/tristate_float.9:45
msgid "If B<enable> is TRUE, copy B<in> to B<out>\\&."
msgstr "If B<enable> is TRUE, copy B<in> to B<out>\\&."

#. type: Plain text
#: man/man9/tristate_bit.9:49
msgid "B<tristate-bit>\\&.I<N>\\&.B<in-> bit in"
msgstr "B<tristate-bit>\\&.I<N>\\&.B<in-> bit in"

#. type: Plain text
#: man/man9/tristate_bit.9:51 man/man9/tristate_float.9:51
msgid "Input value"
msgstr "Вхідне значення"

#. type: Plain text
#: man/man9/tristate_bit.9:54
msgid "B<tristate-bit>\\&.I<N>\\&.B<out> bit io"
msgstr "B<tristate-bit>\\&.I<N>\\&.B<out> bit io"

#. type: Plain text
#: man/man9/tristate_bit.9:59
msgid "B<tristate-bit>\\&.I<N>\\&.B<enable> bit in"
msgstr "B<tristate-bit>\\&.I<N>\\&.B<enable> bit in"

#. type: Plain text
#: man/man9/tristate_bit.9:61 man/man9/tristate_float.9:61
msgid "When TRUE, copy in to out"
msgstr "Якщо TRUE, копіювати вхідні дані у вихідні дані"

#. type: TH
#: man/man9/tristate_float.9:10
#, no-wrap
msgid "TRISTATE_FLOAT"
msgstr "TRISTATE_FLOAT"

#. type: Plain text
#: man/man9/tristate_float.9:32
msgid ""
"tristate_float - Place a signal on an I/O pin only when enabled, similar to "
"a tristate buffer in electronics"
msgstr ""
"tristate_float - Розміщувати сигнал на контакті вводу/виводу лише тоді, коли "
"він увімкнений, подібно до тристабільного буфера в електроніці"

