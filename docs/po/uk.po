"`#<holes> = 2` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"over cut length = 4 mm (0.157\")"
msgstr ""
"`#<holes> = 2` +\n"
"для отворів діаметром менше 32 мм (1,26 дюйма) +\n"
"надлишкова довжина різу = 4 мм (0,157 дюйма)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4376
#, no-wrap
msgid "Cut <<plasma:hole-cutting,holes>> and arcs at 60% feed rate."
msgstr "Різання <<plasma:hole-cutting,отвори>> та дуги зі швидкістю подачі 60%."

#. type: Table
#: src/plasma/qtplasmac.adoc:4379
#, no-wrap
msgid ""
"`#<holes> = 3` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"for arcs less than 16 mm (0.63\") radius"
msgstr ""
"`#<holes> = 3` +\n"
"для отворів діаметром менше 32 мм (1,26 дюйма) +\n"
"для дуг радіусом менше 16 мм (0,63 дюйма)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4379
#, no-wrap
msgid "Cut <<plasma:hole-cutting,holes>> and arcs at 60% feed rate, turn torch off at hole end, continue hole path for over cut."
msgstr "Вирізати <<plasma:hole-cutting,отвори>> та дуги зі швидкістю подачі 60%, вимкнути пальник на кінці отвору, продовжити траєкторію отвору для нарізання."

#. type: Table
#: src/plasma/qtplasmac.adoc:4383
#, no-wrap
msgid ""
"`#<holes> = 4` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"for arcs less than 16 mm (0.63\") radius +\n"
"over cut length = 4 mm (0.157\")"
msgstr ""
"`#<holes> = 4` +\n"
"для отворів діаметром менше 32 мм (1,26 дюйма) +\n"
"для дуг радіусом менше 16 мм (0,63 дюйма) +\n"
"над довжиною різу = 4 мм (0,157 дюйма)"

#. type: Table
