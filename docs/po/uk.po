"M66 P3 L3 Q1 +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"M3 $0 S1 +\n"
". +\n"
". +\n"
"M5 $0"

#. type: Table
#: src/plasma/qtplasmac.adoc:4417
#, no-wrap
msgid "Set velocity to 100% of CutFeedRate"
msgstr "Встановити швидкість на 100% від CutFeedRate"

#. type: Table
#: src/plasma/qtplasmac.adoc:4418
#, no-wrap
msgid "M67 E3 Q0 or M67 E3 Q100"
msgstr "M67 E3 Q0 або M67 E3 Q100"

#. type: Table
#: src/plasma/qtplasmac.adoc:4418
#, no-wrap
msgid "Set velocity to 60% of CutFeedRate"
msgstr "Встановити швидкість на 60% від CutFeedRate"

#. type: Table
#: src/plasma/qtplasmac.adoc:4419
#, no-wrap
msgid "M67 E3 Q60"
msgstr "M67 E3 Q60"

#. type: Table
#: src/plasma/qtplasmac.adoc:4419
#, no-wrap
msgid "Set velocity to 40% of CutFeedRate"
msgstr "Встановити швидкість на 40% від CutFeedRate"

#. type: Table
#: src/plasma/qtplasmac.adoc:4420
#, no-wrap
msgid "M67 E3 Q40"
msgstr "M67 E3 Q40"

#. type: Table
#: src/plasma/qtplasmac.adoc:4420
#, no-wrap
msgid "Cut a hole with 60% reduced speed using velocity setting"
msgstr "Вирізання отвору зі зниженою на 60% швидкістю за допомогою налаштування швидкості"

#. type: Table
#: src/plasma/qtplasmac.adoc:4433
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (reduce feed rate to 60%) +\n"
"G3 I10 (the hole) +\n"
"M67 E3 Q100 (restore feed rate to 100%) +\n"
"M5 $0 (end cut) +\n"
"G0 X0 Y0 +\n"
"M2 (end job)"
msgstr ""
"G21 (метричний) +\n"
"G64 P0.05 +\n"
"M52 P1 (увімкнути адаптивну подачу) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (почати різання) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (зменшити швидкість подачі до 60%) +\n"
"G3 I10 (отвір) +\n"
"M67 E3 Q100 (відновити швидкість подачі до 100%) +\n"
"M5 $0 (закінчити різання) +\n"
"G0 X0 Y0 +\n"
"M2 (закінчити роботу)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4433
#, no-wrap
msgid "Cut a hole with 60% reduced speed using the #<holes> command"
msgstr "Вирізання отвору зі зниженою на 60% швидкістю за допомогою команди #<отвори>"

#. type: Table
#: src/plasma/qtplasmac.adoc:4445
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"\\#<holes> = 1 (velocity reduction for holes) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"G3 I10 (the hole) +\n"
"M5 $0 (end cut) +\n"
"G0 X0 Y0 +\n"
"M2 (end job)"
msgstr ""
"G21 (метрична) +\n"
"G64 P0.05 +\n"
"M52 P1 (увімкнути адаптивну подачу) +\n"
"\\#<отвори> = 1 (зниження швидкості для отворів) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (початок різання) +\n"
"G1 X0 +\n"
"G3 I10 (отвір) +\n"
"M5 $0 (закінчення різання) +\n"
"G0 X0 Y0 +\n"
"M2 (закінчення роботи)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4445
#, no-wrap
msgid "Cut a hole with over cut using torch disable"
msgstr "Вирізати отвір з перерізом за допомогою відключення пальника"

#. type: Table
#: src/plasma/qtplasmac.adoc:4461
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (reduce feed rate to 60%) +\n"
"G3 I10 (the hole) +\n"
"M62 P3 (turn torch off) +\n"
"G3 X0.8 Y6.081 I10 (continue motion for 4 mm) +\n"
"M63 P3 (allow torch to be turned on) +\n"
"M67 E3 Q0 (restore feed rate to 100%) +\n"
"M5 $0 (end cut) +\n"
"G0 X0 Y0 +\n"
"M2 (end job)"
msgstr ""
"G21 (метрична) +\n"
"G64 P0.05 +\n"
"M52 P1 (увімкнути адаптивну подачу) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (почати різання) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (зменшити швидкість подачі до 60%) +\n"
"G3 I10 (отвір) +\n"
"M62 P3 (вимкнути пальник) +\n"
"G3 X0.8 Y6.081 I10 (продовжити рух на 4 мм) +\n"
"M63 P3 (дозволити увімкнути пальник) +\n"
"M67 E3 Q0 (відновити швидкість подачі до 100%) +\n"
"M5 $0 (закінчити різання) +\n"
"G0 X0 Y0 +\n"
"M2 (закінчити роботу)"

#. type: Table
#: src/plasma/qtplasmac.adoc:4461
#, no-wrap
msgid "Cut a hole with over cut using the #<holes> command"
msgstr "Вирізання отвору з перекриттям за допомогою команди #<отвори>"

#. type: Table
#: src/plasma/qtplasmac.adoc:4473
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"\\#<holes> = 2 (over cut for holes) +\n"
