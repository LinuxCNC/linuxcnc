"   (bit out) xhc-hb04.button-home\n"
"   (bit out) xhc-hb04.button-macro-1\n"
"   (bit out) xhc-hb04.button-macro-2\n"
"   (bit out) xhc-hb04.button-macro-3\n"
msgstr ""
