msgstr "B<time>\\&.I<N>\\&.B<pause> bit in (за замовчуванням: I<0>)"

#. type: Plain text
#: man/man9/time.9:151
msgid "Pause"
msgstr "Пауза"

#. type: Plain text
#: man/man9/time.9:154
msgid "B<time>\\&.I<N>\\&.B<seconds> u32 out"
msgstr "B<time>\\&.I<N>\\&.B<seconds> u32 out"

#. type: Plain text
#: man/man9/time.9:156
msgid "Seconds"
msgstr "Секунди"

#. type: Plain text
#: man/man9/time.9:159
msgid "B<time>\\&.I<N>\\&.B<minutes> u32 out"
msgstr "B<time>\\&.I<N>\\&.B<minutes> u32 out"

#. type: Plain text
#: man/man9/time.9:161
msgid "Minutes"
msgstr "Хвилини"

#. type: Plain text
#: man/man9/time.9:164
msgid "B<time>\\&.I<N>\\&.B<hours> u32 out"
msgstr "B<time>\\&.I<N>\\&.B<hours> u32 out"

