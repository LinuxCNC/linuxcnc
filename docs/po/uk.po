#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:561
#, no-wrap
msgid "*`Camview dialog`*"
msgstr "*`Діалогове вікно перегляду камери`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:562
msgid "Requires `camview` dialog widget present."
msgstr "Потрібна наявність віджета діалогового вікна `camview`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:562
#, no-wrap
msgid "*`origin offset dialog`*"
msgstr "*`діалогове вікно зміщення походження`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:563
msgid "Requires origin offset dialog widget present."
msgstr "Потрібно наявність віджета діалогового вікна зміщення походження."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:563
#, no-wrap
msgid "*`macro dialog`*"
msgstr "*`діалогове вікно макросу`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:564
msgid "Requires macro dialog widget present."
msgstr "Потрібна наявність віджета діалогового вікна макросів."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:564
#, no-wrap
msgid "*`Launch Halmeter`*"
msgstr "*`Запуск Халметра`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:565
#, no-wrap
msgid "*`Launch Status`*"
msgstr "*`Стан запуску`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:566
#, no-wrap
msgid "*`Launch Halshow`*"
msgstr "*`Запуск Halshow`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:567
#, no-wrap
msgid "*`Home`*"
msgstr "*`Головна сторінка`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:568
msgid "Set the joint number to -1 for `all-home`."
msgstr "Встановіть номер суглоба на -1 для `all-home`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:568
#, no-wrap
msgid "*`Unhome`*"
msgstr "*`Ви бездомні`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:569
msgid "Set the joint number to -1 for `all-unhome`."
msgstr "Встановіть номер суглоба на -1 для `all-unhome`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:569
#, no-wrap
msgid "*`Home Selected`*"
msgstr "*`Вибрано для дому`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:570
msgid "Homes the joint/axis selected by `STATUS`."
msgstr ""
"Встановлює опорну точку для з'єднання/вісі, вибраної за допомогою `STATUS`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:570
#, no-wrap
msgid "*`Unhome Selected`*"
msgstr "*`Вибрано`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:571
msgid "Unhomes the joint/axis selected by `STATUS`."
msgstr ""
"Знімає з початкового положення з'єднання/вісь, вибрану за допомогою `STATUS`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:571
#, no-wrap
msgid "*`zero axis`*"
msgstr "*`нульова вісь`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:572
#, no-wrap
msgid "*`zero G5X`*"
msgstr "*`нуль G5X`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:573
msgid "Zeros the current user coordinate system offsets."
msgstr "Обнуляє поточні зміщення системи координат користувача."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:573
#, no-wrap
msgid "*`zero G92`*"
msgstr "*`нуль G92`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:574
msgid "Zeros the optional `G92` offsets."
msgstr "Обнуляє додаткові зміщення `G92`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:574
#, no-wrap
msgid "*`zero Z rotational`*"
msgstr "*`нульовий поворотний момент Z`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:575
msgid "Zeros the rotation offset."
msgstr "Обнуляє зміщення обертання."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:575
#, no-wrap
msgid "*`jog joint positive`*"
msgstr "*`позитивний суглоб підтюпцем`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:576 src/gui/qtvcp-widgets.adoc:577
msgid "Set the joint number."
msgstr "Встановіть номер суглоба."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:576
#, no-wrap
msgid "*`jog joint negative`*"
msgstr "*`поштовховий суглоб негативний`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:577
#, no-wrap
msgid "*`jog selected positive`*"
msgstr "*`пробіжка вибрана позитивною`*"

#. type: NOTE
#: src/gui/qtvcp-widgets.adoc:578 src/gui/qtvcp-widgets.adoc:579
msgid "Selected with a different widget or `STATUS`."
msgstr "Вибрано за допомогою іншого віджета або `СТАТУСУ`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:578
#, no-wrap
msgid "*`jog selected negative`*"
msgstr "*`поштовх вибрано негативне`*"

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:579
#, no-wrap
msgid "*`jog increment`*"
