"  </rectled>\n"
"  </hbox>\n"
"  </vbox>\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:417
#, no-wrap
msgid ""
"  <!-- the FWD Led -->\n"
"  <vbox>\n"
"    <relief>RAISED</relief>\n"
"    <bd>2</bd>\n"
"    <label>\n"
"      <text>\"FWD\"</text>\n"
"      <font>(\"Helvetica\",18)</font>\n"
"      <width>5</width>\n"
"    </label>\n"
