"файли:"

#. type: Table
#: src/plasma/qtplasmac.adoc:501 src/plasma/qtplasmac.adoc:523
#, no-wrap
msgid "Filename"
msgstr "Ім'я файлу"

#. type: Table
#: src/plasma/qtplasmac.adoc:502
#, no-wrap
msgid "_<machine_name>_.ini"
msgstr "_<machine_name>_.ini"

#. type: Table
#: src/plasma/qtplasmac.adoc:503
#, no-wrap
msgid "Configuration file for the machine."
msgstr "Файл конфігурації для машини."

#. type: Table
#: src/plasma/qtplasmac.adoc:503
#, no-wrap
msgid "_<machine_name>_.hal"
msgstr "_<machine_name>_.hal"

#. type: Table
#: src/plasma/qtplasmac.adoc:504
#, no-wrap
msgid "HAL for the machine."
msgstr "HAL для машини."

#. type: Table
#: src/plasma/qtplasmac.adoc:504
#, no-wrap
msgid "_<machine_name>_.prefs"
msgstr "_<machine_name>_.prefs"

#. type: Table
#: src/plasma/qtplasmac.adoc:505
#, no-wrap
msgid "Configuration file for QtPlasmaC specific parameters and preferences."
msgstr "Файл конфігурації для специфічних параметрів та налаштувань QtPlasmaC."

#. type: Table
#: src/plasma/qtplasmac.adoc:505
#, no-wrap
msgid "custom.hal"
msgstr "custom.hal"

#. type: Table
#: src/plasma/qtplasmac.adoc:506
#, no-wrap
msgid "HAL file for user customization."
msgstr "HAL-файл для налаштування користувачем."

#. type: Table
#: src/plasma/qtplasmac.adoc:506
#, no-wrap
msgid "custom_postgui.hal"
msgstr "custom_postgui.hal"

#. type: Table
#: src/plasma/qtplasmac.adoc:507
#, no-wrap
msgid "HAL file for user customization which is run after the GUI has initialized."
msgstr "HAL-файл для налаштування користувача, який запускається після ініціалізації графічного інтерфейсу."

#. type: Table
#: src/plasma/qtplasmac.adoc:507
