#: man/man9/integ.9:32
msgid "integ - Integrator with gain pin and windup limits"
msgstr "integ - Інтегратор з виводом посилення та обмеженнями намотування"

#. type: Plain text
#: man/man9/integ.9:35
msgid "B<loadrt integ> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt integ> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/integ.9:38
