#: src/man/man1/moveoff_gui.1.adoc:38
#, no-wrap
msgid "*-size* _integer_"
msgstr "*-size* _integer_"

#. type: Plain text
#: src/man/man1/moveoff_gui.1.adoc:41
#, no-wrap
msgid ""
"Overall gui size is based on font size, typically 8 - 20.\n"
"Default: *14*"
msgstr ""
