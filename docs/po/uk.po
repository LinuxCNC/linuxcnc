#. type: Plain text
#: src/man/man1/modcompile.1.adoc:6
msgid "modcompile - Utility for compiling Modbus drivers"
msgstr "modcompile - Утиліта для компіляції драйверів Modbus"

#. type: Plain text
#: src/man/man1/modcompile.1.adoc:10
msgid "*modcompile -h*"
msgstr "*modcompile -h*"

#. type: Plain text
#: src/man/man1/modcompile.1.adoc:12
msgid "*modcompile* [*-k*] [*-n*] [*-v*] all"
msgstr "*modcompile* [*-k*] [*-n*] [*-v*] all"

