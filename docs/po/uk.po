#. type: Plain text
#: src/gcode/overview.adoc:528
msgid "'#<_metric>' - Return 1 if G21 is on, else 0."
msgstr "'#<_metric>' - Повертає 1, якщо G21 увімкнено, інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:529
msgid "'#<_imperial>' - Return 1 if G20 is on, else 0."
msgstr "'#<_imperial>' - Повертає 1, якщо G20 увімкнено, інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:530
msgid "'#<_absolute>' - Return 1 if G90 is on, else 0."
msgstr "'#<_absolute>' - Повертає 1, якщо G90 увімкнено, інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:531
msgid "'#<_incremental>' - Return 1 if G91 is on, else 0."
msgstr "'#<_incremental>' - Повертає 1, якщо G91 увімкнено, інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:532
msgid "'#<_inverse_time>' - Return 1 if inverse feed mode (G93) is on, else 0."
msgstr ""
"'#<_inverse_time>' - Повертає 1, якщо увімкнено режим зворотної подачі "
"(G93), інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:533
msgid ""
"'#<_units_per_minute>' - Return 1 if Units/minute feed mode (G94) is on, "
"else 0."
msgstr ""
"'#<_units_per_minute>' - Повертає 1, якщо увімкнено режим подачі в одиницях/"
"хвилину (G94), інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:534
msgid ""
"'#<_units_per_rev>' - Return 1 if Units/revolution mode (G95) is on, else 0."
msgstr ""
"'#<_units_per_rev>' - Повертає 1, якщо увімкнено режим одиниць/обертання "
"(G95), інакше 0."

#. type: Plain text
#: src/gcode/overview.adoc:537
msgid ""
"'#<_coord_system>' - Return a float of the current coordinate system name "
"(G54..G59.3).  For example if your in G55 coordinate system the return value "
"is 550.000000 and if your in G59.1 the return value is 591.000000."
msgstr ""
"'#<_coord_system>' - Повертає число з плаваючою комою, що відповідає імені "
"поточної системи координат (G54..G59.3).  Наприклад, якщо ви використовуєте "
"систему координат G55, то значення, що повертається, буде 550.000000, а якщо "
"ви використовуєте G59.1, то значення, що повертається, буде 591.000000."

