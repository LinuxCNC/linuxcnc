#, no-wrap
msgid "GS2 RPM Meter"
msgstr "Вимірювач обертів GS2"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:350
msgid ""
"The following example uses the Automation Direct GS2 VDF driver and displays "
"the RPM and other info in a PyVCP panel. This example is based on the GS2 "
"example in the Hardware Examples section this manual."
msgstr ""
"У наведеному нижче прикладі використовується драйвер Automation Direct GS2 "
"VDF і відображаються оберти за хвилину та інша інформація на панелі PyVCP. "
"Цей приклад базується на прикладі GS2 у розділі «Приклади апаратного "
"забезпечення» цього посібника."

#. type: Title ===
#: src/gui/pyvcp-examples.adoc:351
#, no-wrap
msgid "The Panel"
msgstr "Панель"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:354
msgid "To create the panel we add the following to the XML file."
msgstr "Щоб створити панель, ми додаємо наступний код до XML-файлу."

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:357
#, no-wrap
msgid "<pyvcp>\n"
msgstr "<pyvcp>\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:374
#, no-wrap
msgid ""
"  <!-- the RPM meter -->\n"
"  <hbox>\n"
"    <relief>RAISED</relief>\n"
"    <bd>3</bd>\n"
"    <meter>\n"
"      <halpin>\"spindle_rpm\"</halpin>\n"
"      <text>\"Spindle\"</text>\n"
"      <subtext>\"RPM\"</subtext>\n"
"      <size>200</size>\n"
"      <min_>0</min_>\n"
"      <max_>3000</max_>\n"
"      <majorscale>500</majorscale>\n"
"      <minorscale>100</minorscale>\n"
"      <region1>0,10,\"yellow\"</region1>\n"
"    </meter>\n"
"  </hbox>\n"
msgstr ""
"  <!-- the RPM meter -->\n"
"  <hbox>\n"
"    <relief>RAISED</relief>\n"
"    <bd>3</bd>\n"
"    <meter>\n"
"      <halpin>\"spindle_rpm\"</halpin>\n"
"      <text>\"Spindle\"</text>\n"
"      <subtext>\"RPM\"</subtext>\n"
"      <size>200</size>\n"
