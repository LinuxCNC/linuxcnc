msgstr "B<moveoff>\\&.I<N>\\&.B<offset-applied> bit out"

#. type: Plain text
#: man/man9/moveoff.9:123
msgid "TRUE if one or more offsets are applied\\&."
msgstr "TRUE, якщо застосовано одне або декілька зміщень\\&."

#. type: Plain text
#: man/man9/moveoff.9:126
msgid "B<moveoff>\\&.I<N>\\&.B<waypoint-limit> bit out (default: I<0>)"
msgstr ""
"B<moveoff>\\&.I<N>\\&.B<waypoint-limit> bit out (за замовчуванням: I<0>)"

#. type: Plain text
#: man/man9/moveoff.9:128
msgid ""
"Indicates waypoint limit reached (motion ceases), an enabling pin must be "
