#. type: Title ==
#: src/drivers/gm.adoc:451
#, no-wrap
msgid "Watchdog timer"
msgstr "Сторожовий таймер"

#. type: Plain text
#: src/drivers/gm.adoc:454
msgid "Watchdog timer resets at function:"
msgstr "Сторожовий таймер скидається при виконанні функції:"

#. type: Block title
#: src/drivers/gm.adoc:461
#, no-wrap
msgid "Watchdog pins"
msgstr "Піни сторожового таймера"

