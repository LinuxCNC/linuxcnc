msgid "tooledit - tool table editor"
msgstr "tooledit - редактор таблиці інструментів"

#. type: Plain text
#: src/man/man1/tooledit.1.adoc:10
msgid "*tooledit*"
msgstr "*tooledit*"

#. type: Plain text
