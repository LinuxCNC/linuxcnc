#: src/gui/qtvcp-libraries.adoc:441
msgid "*<Pin object>.get()* returns the current value of the pin object"
msgstr "*<Pin object>.get()* повертає поточне значення об'єкта pin"

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:442
msgid "*<Pin object>.set(X)* sets the value of the pin object to the value X"
msgstr "*<Pin object>.set(X)* встановлює значення об'єкта pin на значення X"

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:443
msgid "*<Pin object>.text()* returns the pin name string"
msgstr "*<Pin object>.text()* повертає рядок назви піна"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:456
#, no-wrap
msgid ""
"from qtvcp.core import Qhal\n"
"QHAL = Qhal()\n"
msgstr ""
"з qtvcp.core імпорт Qhal\n"
"QHAL = Qhal()\n"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:468
#, no-wrap
msgid ""
"# at this point:\n"
"# the widgets are instantiated.\n"
"# the HAL pins are built but HAL is not set ready\n"
"def initialized__(self):\n"
"    self.pin_button_in = QHAL.newpin('cycle-start-in',QHAL.HAL_BIT, QHAL.HAL_IN)\n"
"    self.pin_button_in.pinValuechanged.connect(self.buttonChanged)\n"
"    self.pin_button_in.isDrivenChanged.connect(lambda p,s: self.buttonDriven(p,s))\n"
msgstr ""
"# на цьому етапі:\n"
"# екземпляри віджетів створено.\n"
"# піни HAL зібрано, але HAL ще не готовий\n"
"def initialized__(self):\n"
"    self.pin_button_in = QHAL.newpin('cycle-start-in',QHAL.HAL_BIT, QHAL.HAL_IN)\n"
"    self.pin_button_in.pinValuechanged.connect(self.buttonChanged)\n"
"    self.pin_button_in.isDrivenChanged.connect(lambda p,s: self.buttonDriven(p,s))\n"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:471
#, no-wrap
msgid ""
"def buttonChanged(self, pinObject, value):\n"
"    print('Pin name:{} changed value to {}'.format(pinObject.text(), value))\n"
msgstr ""
"def buttonChanged(self, pinObject, value):\n"
"    print('Pin name:{} changed value to {}'.format(pinObject.text(), value))\n"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:477
#, no-wrap
msgid ""
"def buttonDriven(self, pinObject, state):\n"
"    message = 'not driven by an output pin'\n"
"    if state:\n"
"        message = 'is driven by an output pin'\n"
"    print('Pin name:{} is {}'.format(pinObject.text(), message))\n"
msgstr ""
"def buttonDriven(self, pinObject, state):\n"
"    message = 'not driven by an output pin'\n"
"    if state:\n"
"        message = 'is driven by an output pin'\n"
"    print('Pin name:{} is {}'.format(pinObject.text(), message))\n"

