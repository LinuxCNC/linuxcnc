msgstr "B<sim-home-switch>\\&.I<N>\\&.B<index-enable> bit io"

#. type: Plain text
#: man/man9/sim_home_switch.9:68
msgid "typ: connect to joint\\&.N\\&.index-enable"
msgstr "тип: з'єднання з суглобом\\&.N\\&.index-enable"

#. type: Plain text
#: man/man9/sim_home_switch.9:71
