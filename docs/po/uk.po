msgid "B<sim-home-switch>\\&.I<N>\\&.B<home-sw> bit out"
msgstr "B<sim-home-switch>\\&.I<N>\\&.B<home-sw> bit out"

#. type: Plain text
#: man/man9/sim_home_switch.9:63
msgid "Home switch activated"
msgstr "Активовано домашній перемикач"

#. type: Plain text
#: man/man9/sim_home_switch.9:66
