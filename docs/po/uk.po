#: src/drivers/gm.adoc:649 src/drivers/gm.adoc:691 src/drivers/gm.adoc:727
msgid "where _<module ID>_ is from 00 to 15."
msgstr "де _<ідентифікатор модуля>_ має значення від 00 до 15."

