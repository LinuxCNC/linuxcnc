#. type: Plain text
#: man/man1/pi500_vfd.1:32
msgid "pi500_vfd - Powtran PI500 Modbus driver"
msgstr "pi500_vfd - Драйвер Modbus Powtran PI500"

#. type: Plain text
#: man/man1/pi500_vfd.1:35
msgid "B<pi500_vfd>"
msgstr "B<pi500_vfd>"

#. type: Plain text
#: man/man1/pi500_vfd.1:38
msgid "B<pi500-vfd>\\&.I<N>\\&.B<commanded-frequency> float in"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<commanded-frequency> float in"

#. type: Plain text
#: man/man1/pi500_vfd.1:40
msgid "Frequency of vfd"
msgstr "Частота частотного перетворювача частоти"

#. type: Plain text
#: man/man1/pi500_vfd.1:43
msgid "B<pi500-vfd>\\&.I<N>\\&.B<run> bit in"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<run> bit in"

#. type: Plain text
#: man/man1/pi500_vfd.1:45 man/man1/wj200_vfd.1:60
msgid "run the vfd"
msgstr "запустити частотний перетворювач"

#. type: Plain text
#: man/man1/pi500_vfd.1:48
msgid "B<pi500-vfd>\\&.I<N>\\&.B<enable> bit in"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<enable> bit in"

#. type: Plain text
#: man/man1/pi500_vfd.1:50 man/man1/wj200_vfd.1:65
msgid ""
"1 to enable the vfd\\&. 0 will remote trip the vfd, thereby disabling it\\&."
msgstr ""
"1 для ввімкнення частотного перетворювача. 0 дистанційно вимкне частотний "
"перетворювач, тим самим вимкнувши його."

#. type: Plain text
#: man/man1/pi500_vfd.1:53
msgid "B<pi500-vfd>\\&.I<N>\\&.B<is-running> bit out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<is-running> bit out"

#. type: Plain text
#: man/man1/pi500_vfd.1:55 man/man1/wj200_vfd.1:70
msgid "1 when running"
msgstr "1 під час бігу"

#. type: Plain text
#: man/man1/pi500_vfd.1:58
msgid "B<pi500-vfd>\\&.I<N>\\&.B<is-at-speed> bit out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<is-at-speed> bit out"

#. type: Plain text
#: man/man1/pi500_vfd.1:60 man/man1/wj200_vfd.1:75
msgid "1 when running at assigned frequency"
msgstr "1 під час роботи на заданій частоті"

#. type: Plain text
#: man/man1/pi500_vfd.1:63
msgid "B<pi500-vfd>\\&.I<N>\\&.B<is-ready> bit out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<is-ready> bit out"

#. type: Plain text
#: man/man1/pi500_vfd.1:65 man/man1/wj200_vfd.1:85
msgid "1 when vfd is ready to run"
msgstr "1, коли частотний перетворювач готовий до роботи"

#. type: Plain text
#: man/man1/pi500_vfd.1:68
msgid "B<pi500-vfd>\\&.I<N>\\&.B<is-alarm> bit out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<is-alarm> bit out"

#. type: Plain text
#: man/man1/pi500_vfd.1:70 man/man1/wj200_vfd.1:90
msgid "1 when vfd alarm is set"
msgstr ""
"1 коли встановлено сигналізацію частотно-регульованого перетворювача (ЧРП)"

#. type: Plain text
#: man/man1/pi500_vfd.1:73
msgid "B<pi500-vfd>\\&.I<N>\\&.B<motor-current> float out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<motor-current> float out"

#. type: Plain text
#: man/man1/pi500_vfd.1:75 man/man1/wj200_vfd.1:95
msgid "Output current in amps"
msgstr "Вихідний струм в амперах"

#. type: Plain text
#: man/man1/pi500_vfd.1:78
msgid "B<pi500-vfd>\\&.I<N>\\&.B<heatsink-temp> float out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<heatsink-temp> float out"

#. type: Plain text
#: man/man1/pi500_vfd.1:80 man/man1/wj200_vfd.1:100
msgid "Temperature of drive heatsink"
msgstr "Температура радіатора приводу"

#. type: Plain text
#: man/man1/pi500_vfd.1:83
msgid "B<pi500-vfd>\\&.I<N>\\&.B<watchdog-out> bit out"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<watchdog-out> bit out"

#. type: Plain text
#: man/man1/pi500_vfd.1:85 man/man1/wj200_vfd.1:105
msgid ""
"Alternates between 1 and 0 after every update cycle\\&. Feed into a watchdog "
"component to ensure vfd driver is communicating with the vfd properly\\&."
msgstr ""
"Змінює значення між 1 та 0 після кожного циклу оновлення. Подається на "
"компонент сторожового таймера, щоб переконатися, що драйвер частотного "
"перетворювача правильно взаємодіє з частотним перетворювачем."

#. type: Plain text
#: man/man1/pi500_vfd.1:89
msgid "B<pi500-vfd>\\&.I<N>\\&.B<mbslaveaddr> u32 rw"
msgstr "B<pi500-vfd>\\&.I<N>\\&.B<mbslaveaddr> u32 rw"

#. type: Plain text
#: man/man1/pi500_vfd.1:91 man/man1/wj200_vfd.1:111
msgid "Modbus slave address"
msgstr "Адреса веденого Modbus"

