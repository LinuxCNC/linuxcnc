msgstr "#ff0000"

#. type: Table
#: src/gui/gmoccapy.adoc:1574
#, no-wrap
msgid "Success: this color indicates \"success\" (usually something green'ish)."
msgstr "Успіх: цей колір вказує на «успіх» (зазвичай щось зелене)."

#. type: Table
#: src/gui/gmoccapy.adoc:1574
#, no-wrap
