"   (bit out) xhc-hb04.button-spindle\n"
"   (bit out) xhc-hb04.button-half\n"
"   (bit out) xhc-hb04.button-zero\n"
"   (bit out) xhc-hb04.button-safe-z\n"

#. type: delimited block .
