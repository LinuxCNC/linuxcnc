#. type: Title ===
#: src/gui/halui.adoc:104 src/gui/tklinuxcnc.adoc:86
#: src/man/man1/halui.1.adoc:34
#, no-wrap
msgid "Abort"
msgstr "Перервати"

#. type: Plain text
#: src/gui/halui.adoc:107
msgid ""
"'halui.abort' (bit, in) - pin to send an abort message (clears out most "
"errors)"
msgstr ""
"'halui.abort' (bit, in) - PIN-код для надсилання повідомлення про "
"переривання (виправляє більшість помилок)"

#. type: Title ===
#: src/gui/halui.adoc:108
#, no-wrap
msgid "E-Stop"
msgstr "E-Стій"

#. type: Plain text
#: src/gui/halui.adoc:111
msgid "'halui.estop.activate' (bit, in) - pin for requesting E-Stop"
msgstr ""
"'halui.estop.activate' (bit, in) - PIN-код для запиту аварійної зупинки"

#. type: Plain text
#: src/gui/halui.adoc:112
msgid "'halui.estop.is-activated' (bit, out) - indicates E-stop reset"
msgstr ""
"'halui.estop.is-activated' (bit, out) - вказує на скидання аварійної зупинки"

#. type: Plain text
#: src/gui/halui.adoc:113
msgid "'halui.estop.reset' (bit, in) - pin for requesting E-Stop reset"
msgstr ""
"'halui.estop.reset' (bit, in) - PIN-код для запиту скидання аварійної зупинки"

#. type: Plain text
#: src/gui/halui.adoc:117
msgid ""
"'halui.feed-override.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr ""
"'halui.feed-override.count-enable' (bit, in) - має бути істинним, щоб "
"«підрахунки» або «пряме значення» працювали."

#. type: Plain text
#: src/gui/halui.adoc:118
msgid ""
"'halui.feed-override.counts' (s32, in) - counts * scale = FO percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'halui.feed-override.counts' (s32, in) - кількість * шкала = відсоток FO. "
"Можна використовувати з енкодером або «прямим значенням»."

#. type: Plain text
#: src/gui/halui.adoc:119
msgid ""
"'halui.feed-override.decrease' (bit, in) - pin for decreasing the FO (-"
"=scale)"
msgstr ""
"'halui.feed-override.decrease' (bit, in) - штифт для зменшення FO (-=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:120
msgid ""
"'halui.feed-override.increase' (bit, in) - pin for increasing the FO "
"(+=scale)"
msgstr ""
"'halui.feed-override.increase' (bit, in) - штифт для збільшення FO "
"(+=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:121
msgid ""
"'halui.feed-override.reset' (bit, in) - pin for resetting the FO (scale=1.0)"
msgstr ""
"'halui.feed-override.reset' (bit, in) - контакт для скидання оптоволоконного "
"виводу (масштаб=1.0)"

#. type: Plain text
#: src/gui/halui.adoc:122
msgid ""
"'halui.feed-override.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.feed-override.direct-value' (bit, in) - false під час використання "
"енкодера для зміни лічильників, true під час безпосереднього встановлення "
"лічильників."

#. type: Plain text
#: src/gui/halui.adoc:123
msgid ""
"'halui.feed-override.scale' (float, in) - pin for setting the scale for "
"increase and decrease of 'feed-override'."
msgstr ""
"'halui.feed-override.scale' (float, in) - штифт для налаштування шкали "
"збільшення та зменшення «корекції подачі»."

#. type: Plain text
#: src/gui/halui.adoc:124
msgid "'halui.feed-override.value' (float, out) - current FO value"
msgstr "'halui.feed-override.value' (float, out) - поточне значення FO"

#. type: Title ===
#: src/gui/halui.adoc:125
#, no-wrap
msgid "Mist"
msgstr "Туман"

#. type: Plain text
#: src/gui/halui.adoc:128
msgid "'halui.mist.is-on' (bit, out) - indicates mist is on"
msgstr "'halui.mist.is-on' (bit, out) - вказує на туман"

#. type: Plain text
#: src/gui/halui.adoc:129
msgid "'halui.mist.off' (bit, in) - pin for requesting mist off"
msgstr "'halui.mist.off' (bit, in) - шпилька для запиту на вимкнення туману"

#. type: Plain text
#: src/gui/halui.adoc:130
msgid "'halui.mist.on' (bit, in) - pin for requesting mist on"
msgstr "'halui.mist.on' (bit, in) - шпилька для запиту на туман"

#. type: Title ===
#: src/gui/halui.adoc:131
#, no-wrap
msgid "Flood"
msgstr "Повінь"

#. type: Plain text
#: src/gui/halui.adoc:134
msgid "'halui.flood.is-on' (bit, out) - indicates flood is on"
msgstr "'halui.flood.is-on' (bit, out) - вказує на початок повені"

#. type: Plain text
#: src/gui/halui.adoc:135
msgid "'halui.flood.off' (bit, in) - pin for requesting flood off"
msgstr "'halui.flood.off' (bit, in) - PIN-код для запиту на відключення флуду"

#. type: Plain text
#: src/gui/halui.adoc:136
msgid "'halui.flood.on' (bit, in) - pin for requesting flood on"
msgstr "'halui.flood.on' (bit, in) - PIN-код для запиту на флуд"

#. type: Plain text
#: src/gui/halui.adoc:141
msgid ""
"'halui.home-all' (bit, in) - pin for requesting all axis to home. This pin "
"will only be there if HOME_SEQUENCE is set in the INI file."
msgstr ""
"'halui.home-all' (bit, in) - PIN-код для запиту переведення всіх осей у "
"початкове положення. Цей PIN-код буде присутній лише тоді, коли у файлі INI "
"встановлено HOME_SEQUENCE."

#. type: Title ====
#: src/gui/halui.adoc:142 src/man/man1/halui.1.adoc:214
#: src/man/man1/xhc-whb04b-6.1.adoc:150
#, no-wrap
msgid "Machine"
msgstr "Машина"

#. type: Plain text
#: src/gui/halui.adoc:146
msgid ""
"'halui.machine.units-per-mm' (float out) - pin for machine units-per-mm "
"(inch:1/25.4, mm:1) according to inifile setting: [TRAJ]LINEAR_UNITS"
msgstr ""
"'halui.machine.units-per-mm' (float out) - штифт для машинних одиниць "
"вимірювання на мм (дюйм:1/25,4, мм:1) відповідно до налаштування inifile: "
"[TRAJ]LINEAR_UNITS"

#. type: Plain text
#: src/gui/halui.adoc:147
msgid "'halui.machine.is-on' (bit, out) - indicates machine on"
msgstr "'halui.machine.is-on' (bit, out) - вказує на увімкнення машини"

#. type: Plain text
#: src/gui/halui.adoc:148
msgid "'halui.machine.off' (bit, in) - pin for requesting machine off"
msgstr "'halui.machine.off' (bit, in) - PIN-код для запиту на вимкнення машини"

#. type: Plain text
#: src/gui/halui.adoc:149
msgid "'halui.machine.on' (bit, in) - pin for requesting machine on"
msgstr "'halui.machine.on' (bit, in) - PIN-код для запиту на ввімкнення машини"

#. type: Plain text
#: src/gui/halui.adoc:154
msgid ""
"The maximum linear velocity can be adjusted from 0 to the MAX_VELOCITY that "
"is set in the [TRAJ] section of the INI file."
msgstr ""
"Максимальну лінійну швидкість можна налаштувати від 0 до MAX_VELOCITY, "
"встановленого в розділі [TRAJ] INI-файлу."

#. type: Plain text
#: src/gui/halui.adoc:156
msgid ""
"'halui.max-velocity.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr ""
"'halui.max-velocity.count-enable' (bit, in) - має бути істинним, щоб "
"«підрахунки» або «пряме значення» працювали."

#. type: Plain text
#: src/gui/halui.adoc:157
msgid ""
"'halui.max-velocity.counts' (s32, in) - counts * scale = MV percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'halui.max-velocity.counts' (s32, in) - counts * шкала = відсоток MV. Може "
"використовуватися з енкодером або «прямим значенням»."

#. type: Plain text
#: src/gui/halui.adoc:158
msgid ""
"'halui.max-velocity.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.max-velocity.direct-value' (bit, in) - false під час використання "
"енкодера для зміни лічильників, true під час безпосереднього встановлення "
"лічильників."

#. type: Plain text
#: src/gui/halui.adoc:159
msgid ""
"'halui.max-velocity.decrease' (bit, in) - pin for decreasing max velocity"
msgstr ""
"'halui.max-velocity.decrease' (bit, in) - штифт для зменшення максимальної "
"швидкості"

#. type: Plain text
#: src/gui/halui.adoc:160
msgid ""
"'halui.max-velocity.increase' (bit, in) - pin for increasing max velocity"
msgstr ""
"'halui.max-velocity.increase' (bit, in) - штифт для збільшення максимальної "
"швидкості"

#. type: Plain text
#: src/gui/halui.adoc:161
msgid ""
"'halui.max-velocity.scale' (float, in) - the amount applied to the current "
"maximum velocity with each transition from off to on of the increase or "
"decrease pin in machine units per second."
msgstr ""
"'halui.max-velocity.scale' (float, in) - величина, що застосовується до "
"поточної максимальної швидкості з кожним переходом від вимкненого до "
"ввімкненого положення штифта збільшення або зменшення в машинних одиницях за "
"секунду."

#. type: Plain text
#: src/gui/halui.adoc:162
msgid ""
"'halui.max-velocity.value' (float, out) - is the maximum linear velocity in "
"machine units per second."
msgstr ""
"'halui.max-velocity.value' (float, out) - — максимальна лінійна швидкість у "
"машинних одиницях за секунду."

#. type: Plain text
#: src/gui/halui.adoc:170
#, no-wrap
msgid ""
"'halui.mdi-command-_<nn>_' (bit, in) - halui will try to send the MDI command defined in the INI. _<nn>_ is a two  digit number  starting  at 00.\n"
"If the command succeeds then it will place LinuxCNC in the MDI mode and then back to Manual mode.\n"
"If no [HALUI]MDI_COMMAND variables are set in the  ini  file, no halui.mdi-command-<nn> pins will be exported by halui."
msgstr ""
"'halui.mdi-command-_<nn>_' (біт, вхід) - halui спробує надіслати команду MDI, визначену в INI. _<nn>_ - це двозначне число, що починається з 00.\n"
"Якщо команда виконана успішно, LinuxCNC перейде в режим MDI, а потім повернеться в ручний режим.\n"
"Якщо в файлі ini не встановлено змінних [HALUI]MDI_COMMAND, halui не експортуватиме контакти halui.mdi-command-<nn>."

#. type: Plain text
#: src/gui/halui.adoc:173
msgid ""
"'halui.halui-mdi-is-running' (bit, out) - execution status of MDI commands "
"sent by halui. The status is active even during mode switching.  If no "
"[HALUI]MDI_COMMAND variables are set in the ini file, this pins will not be "
"exported by halui."
msgstr ""
"'halui.halui-mdi-is-running' (bit, out) - Стан виконання команд MDI, "
"надісланих halui. Стан активний навіть під час перемикання режимів. Якщо в "
"ini-файлі не встановлено змінні [HALUI]MDI_COMMAND, halui не експортуватиме "
"ці виводи."

#. type: Title ===
#: src/gui/halui.adoc:174 src/man/man1/halui.1.adoc:225
#, no-wrap
msgid "Joint"
msgstr "Суглоб"

#. type: Plain text
#: src/gui/halui.adoc:178
#, no-wrap
msgid ""
"_N_ = joint number (0 ... num_joints-1)\n"
"Example:"
msgstr ""
"_N_ = joint number (0 ... num_joints-1)\n"
"Приклад:"

#. type: Plain text
#: src/gui/halui.adoc:180
msgid "'halui.joint._N_.select' (bit in) - pin for selecting joint _N_"
msgstr "'halui.joint._N_.select' (bit in) - штифт для вибору з'єднання _N_"

#. type: Plain text
#: src/gui/halui.adoc:181
msgid ""
"'halui.joint._N_.is-selected' (bit out) - status pin that joint _N_ is "
"selected"
msgstr ""
"'halui.joint._N_.is-selected' (bit out) - PIN-код стану, на якому вибрано "
"суглоб _N_"

#. type: Plain text
#: src/gui/halui.adoc:182
msgid ""
"'halui.joint._N_.has-fault' (bit out) - status pin telling that joint _N_ "
"has a fault"
msgstr ""
"'halui.joint._N_.has-fault' (bit out) - контактний індикатор стану, що "
"вказує на несправність з'єднання _N_"

#. type: Plain text
#: src/gui/halui.adoc:183
msgid "'halui.joint._N_.home' (bit in) - pin for homing joint _N_"
msgstr "'halui.joint._N_.home' (bit in) - штифт для опорного шарніра _N_"

#. type: Plain text
#: src/gui/halui.adoc:184
msgid ""
"'halui.joint._N_.is-homed' (bit out) - status pin telling that joint _N_ is "
"homed"
msgstr ""
"'halui.joint._N_.is-homed' (bit out) - PIN-код стану, що вказує на те, що "
"шарнір _N_ знаходиться вдома"

#. type: Plain text
#: src/gui/halui.adoc:185
msgid ""
"'halui.joint._N_.on-hard-max-limit' (bit out) - status pin telling that "
"joint _N_ is on the positive hardware limit"
msgstr ""
"'halui.joint._N_.on-hard-max-limit' (bit out) - контакт стану, що вказує, що "
"з'єднання _N_ знаходиться на позитивній апаратній межі"

#. type: Plain text
#: src/gui/halui.adoc:186
msgid ""
"'halui.joint._N_.on-hard-min-limit' (bit out) - status pin telling that "
"joint _N_ is on the negative hardware limit"
msgstr ""
"'halui.joint._N_.on-hard-min-limit' (bit out) - контакт стану, що вказує, що "
"з'єднання _N_ знаходиться на негативній апаратній межі"

#. type: Plain text
#: src/gui/halui.adoc:187
msgid ""
"'halui.joint._N_.on-soft-max-limit' (bit out) - status pin telling that "
"joint _N_ is on the positive software limit"
msgstr ""
"'halui.joint._N_.on-soft-max-limit' (bit out) - контакт стану, що вказує, що "
"з'єднання _N_ знаходиться на додатній програмній межі"

#. type: Plain text
#: src/gui/halui.adoc:188
msgid ""
"'halui.joint._N_.on-soft-min-limit' (bit out) - status pin telling that "
"joint _N_ is on the negative software limit"
msgstr ""
"'halui.joint._N_.on-soft-min-limit' (bit out) - контакт стану, що вказує, що "
"шарнір _N_ знаходиться на негативній програмній межі"

#. type: Plain text
#: src/gui/halui.adoc:189
msgid ""
"'halui.joint._N_.override-limits' (bit out) - status pin telling that joint "
"_N_'s limits are temporarily overridden"
msgstr ""
"'halui.joint._N_.override-limits' (bit out) - PIN-код стану, що вказує на "
"тимчасове перевизначення обмежень суглоба _N_"

#. type: Plain text
#: src/gui/halui.adoc:190
msgid "'halui.joint._N_.unhome' (bit in) - pin for unhoming joint _N_"
msgstr ""
"'halui.joint._N_.unhome' (bit in) - штифт для з'єднання з від'єднанням _N_"

#. type: Plain text
#: src/gui/halui.adoc:191
msgid ""
"'halui.joint.selected' (u32 out) - selected joint number (0 ... num_joints-1)"
msgstr ""
"'halui.joint.selected' (u32 out) - вибраний номер суглоба (0 ... "
"кількість_суглобів-1)"

#. type: Plain text
#: src/gui/halui.adoc:192
msgid ""
"'halui.joint.selected.has-fault' (bit out) - status pin selected joint is "
"faulted"
msgstr ""
"'halui.joint.selected.has-fault' (bit out) - Вибраний з'єднання має "
"пошкодження"

#. type: Plain text
#: src/gui/halui.adoc:193
msgid ""
"'halui.joint.selected.home' (bit in) - pin for homing the selected joint"
msgstr ""
"'halui.joint.selected.home' (bit in) - штифт для наведення вибраного "
"з'єднання в початкове положення"

#. type: Plain text
#: src/gui/halui.adoc:194
msgid ""
"'halui.joint.selected.is-homed' (bit out) - status pin telling that the "
"selected joint is homed"
msgstr ""
"'halui.joint.selected.is-homed' (bit out) - PIN-код стану, що вказує на те, "
"що вибране з'єднання перебуває в головному положенні"

#. type: Plain text
#: src/gui/halui.adoc:195
msgid ""
"'halui.joint.selected.on-hard-max-limit' (bit out) - status pin telling that "
"the selected joint is on the positive hardware limit"
msgstr ""
"'halui.joint.selected.on-hard-max-limit' (bit out) - контактний індикатор "
"стану, який вказує, що вибране з'єднання знаходиться на позитивній апаратній "
"межі"

#. type: Plain text
#: src/gui/halui.adoc:196
msgid ""
"'halui.joint.selected.on-hard-min-limit' (bit out) - status pin telling that "
"the selected joint is on the negative hardware limit"
msgstr ""
"'halui.joint.selected.on-hard-min-limit' (bit out) - контактний індикатор "
"стану, який вказує, що вибраний з'єднання знаходиться на негативній межі "
"обладнання"

#. type: Plain text
#: src/gui/halui.adoc:197
msgid ""
"'halui.joint.selected.on-soft-max-limit' (bit out) - status pin telling that "
"the selected joint is on the positive software limit"
msgstr ""
"'halui.joint.selected.on-soft-max-limit' (bit out) - контактний індикатор "
"стану, який вказує, що вибраний шарнір знаходиться на додатній програмній "
"межі"

#. type: Plain text
#: src/gui/halui.adoc:198
msgid ""
"'halui.joint.selected.on-soft-min-limit' (bit out) - status pin telling that "
"the selected joint is on the negative software limit"
msgstr ""
"'halui.joint.selected.on-soft-min-limit' (bit out) - контактний індикатор "
"стану, який вказує, що вибраний шарнір знаходиться на негативній програмній "
"межі"

#. type: Plain text
#: src/gui/halui.adoc:199
msgid ""
"'halui.joint.selected.override-limits' (bit out) - status pin telling that "
"the selected joint's limits are temporarily overridden"
msgstr ""
"'halui.joint.selected.override-limits' (bit out) - PIN-код стану, що вказує "
"на тимчасове перевизначення обмежень вибраного суглоба"

#. type: Plain text
#: src/gui/halui.adoc:200
msgid ""
"'halui.joint.selected.unhome' (bit in) - pin for unhoming the selected joint"
msgstr ""
"'halui.joint.selected.unhome' (bit in) - штифт для зняття з початкового "
"положення вибраного з'єднання"

#. type: Title ===
#: src/gui/halui.adoc:201
#, no-wrap
msgid "Joint Jogging"
msgstr "Суглобовий біг"

#. type: Plain text
#: src/gui/halui.adoc:204 src/man/man1/halui.1.adoc:228
msgid "_N_ = joint number (0 ... num_joints-1)"
msgstr "_N_ = номер суглоба (0 ... кількість_суглобів-1)"

#. type: Plain text
#: src/gui/halui.adoc:206
msgid ""
"'halui.joint.jog-deadband' (float in) - pin for setting jog analog deadband "
"(jog analog inputs smaller/slower than this - in absolute value - are "
"ignored)"
msgstr ""
"'halui.joint.jog-deadband' (float in) - контакт для налаштування зони "
"нечутливості аналогового режиму поштовху (аналогові входи поштовху, менші/"
"повільніші за цю зону - за абсолютним значенням - ігноруються)"

#. type: Plain text
#: src/gui/halui.adoc:207
msgid ""
"'halui.joint.jog-speed' (float in) - pin for setting jog speed for plus/"
"minus jogging."
msgstr ""
"'halui.joint.jog-speed' (float in) - штифт для налаштування швидкості "
"штовхання для плюс/мінус штовхання."

#. type: Plain text
#: src/gui/halui.adoc:208
msgid ""
"'halui.joint._N_.analog' (float in) - pin for jogging the joint _N_ using a "
"float value (e.g.  joy-stick).  The value, typically set between 0.0 and "
"±1.0, is used as a jog-speed multiplier."
msgstr ""
"'halui.joint._N_.analog' (float in) - штифт для штовхання шарніра _N_ за "
"допомогою значення з плаваючою комою (наприклад, джойстика). Значення, яке "
"зазвичай встановлюється між 0,0 та ±1,0, використовується як множник "
"швидкості штовхання."

#. type: Plain text
#: src/gui/halui.adoc:209
msgid ""
"'halui.joint._N_.increment' (float in) - pin for setting the jog increment "
"for joint _N_ when using increment-plus/minus"
msgstr ""
"'halui.joint._N_.increment' (float in) - штифт для встановлення кроку "
"поперечного переміщення для з'єднання _N_ при використанні кроку плюс/мінус"

#. type: Plain text
#: src/gui/halui.adoc:210
msgid ""
"'halui.joint._N_.increment-minus' (bit in) - a rising edge will will make "
"joint _N_ jog in the negative direction by the increment amount"
msgstr ""
"'halui.joint._N_.increment-minus' (bit in) - Наростаючий фронт змусить "
"з'єднання _N_ зміщуватися в негативному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:211
msgid ""
"'halui.joint._N_.increment-plus' (bit in) - a rising edge will will make "
"joint _N_ jog in the positive direction by the increment amount"
msgstr ""
"'halui.joint._N_.increment-plus' (bit in) - Наростаючий фронт змусить "
"з'єднання _N_ рухатися в позитивному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:212
msgid ""
"'halui.joint._N_.minus' (bit in) - pin for jogging joint _N_ in negative "
"direction at the halui.joint.jog-speed velocity"
msgstr ""
"'halui.joint._N_.minus' (bit in) - штифт для штовхаючого з'єднання _N_ у "
"негативному напрямку зі швидкістю halui.joint.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:213
msgid ""
"'halui.joint._N_.plus' (bit in) - pin for jogging joint _N_ in positive "
"direction at the halui.joint.jog-speed velocity"
msgstr ""
"'halui.joint._N_.plus' (bit in) - штифт для штовхаючого з'єднання _N_ у "
"позитивному напрямку зі швидкістю halui.joint.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:214
msgid ""
"'halui.joint.selected.increment' (float in) - pin for setting the jog "
"increment for the selected joint when using increment-plus/minus"
msgstr ""
"'halui.joint.selected.increment' (float in) - штифт для встановлення кроку "
"поперечного переміщення для вибраного з'єднання при використанні приросту "
"плюс/мінус"

#. type: Plain text
#: src/gui/halui.adoc:215
msgid ""
"'halui.joint.selected.increment-minus' (bit in) - a rising edge will will "
"make the selected joint jog in the negative direction by the increment amount"
msgstr ""
"'halui.joint.selected.increment-minus' (bit in) - Наростаючий фронт призведе "
"до зміщення вибраного з'єднання у негативному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:216
msgid ""
"'halui.joint.selected.increment-plus' (bit in) - a rising edge will will "
"make the selected joint jog in the positive direction by the increment amount"
msgstr ""
"'halui.joint.selected.increment-plus' (bit in) - Наростаючий фронт призведе "
"до того, що вибраний з'єднання зміститься в позитивному напрямку на величину "
"приросту"

#. type: Plain text
#: src/gui/halui.adoc:217
msgid ""
"'halui.joint.selected.minus' (bit in) - pin for jogging the selected joint "
"in negative direction at the halui.joint.jog-speed velocity"
msgstr ""
"'halui.joint.selected.minus' (bit in) - штифт для штурхового переміщення "
"вибраного з'єднання у негативному напрямку зі швидкістю halui.joint.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:218
msgid ""
"'halui.joint.selected.plus' (bit in) - pin for jogging the selected joint in "
"positive direction at the halui.joint.jog-speed velocity"
msgstr ""
"'halui.joint.selected.plus' (bit in) - штифт для штовхання вибраного "
"з'єднання в позитивному напрямку зі швидкістю halui.joint.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:222 src/gui/halui.adoc:232 src/man/man1/halui.1.adoc:314
#: src/man/man1/halui.1.adoc:329
msgid "_L_ = axis letter (xyzabcuvw)"
msgstr "_L_ = axis letter (xyzabcuvw)"

#. type: Plain text
#: src/gui/halui.adoc:224
msgid "'halui.axis._L_.select' (bit) - pin for selecting axis by letter"
msgstr "'halui.axis._L_.select' (bit) - штифт для вибору осі за літерою"

#. type: Plain text
#: src/gui/halui.adoc:225
msgid ""
"'halui.axis._L_.is-selected' (bit out) - status pin that axis _L_ is selected"
msgstr ""
"'halui.axis._L_.is-selected' (bit out) - контакт стану, на якому вибрано "
"вісь _L_"

#. type: Plain text
#: src/gui/halui.adoc:226
msgid ""
"'halui.axis._L_.pos-commanded' (float out) - Commanded axis position in "
"machine coordinates"
msgstr ""
"'halui.axis._L_.pos-commanded' (float out) - Задане положення осі в "
"координатах машини"

#. type: Plain text
#: src/gui/halui.adoc:227
msgid ""
"'halui.axis._L_.pos-feedback' float out) - Feedback axis position in machine "
"coordinates"
msgstr ""
"'halui.axis._L_.pos-feedback' float out) - Положення осі зворотного зв'язку "
"в координатах машини"

#. type: Plain text
#: src/gui/halui.adoc:228
msgid ""
"'halui.axis._L_.pos-relative' (float out) - Feedback axis position in "
"relative coordinates"
msgstr ""
"'halui.axis._L_.pos-relative' (float out) - Положення осі зворотного зв'язку "
"у відносних координатах"

#. type: Title ===
#: src/gui/halui.adoc:229 src/man/man1/halui.1.adoc:326
#, no-wrap
msgid "Axis Jogging"
msgstr "Біг по осі"

#. type: Plain text
#: src/gui/halui.adoc:234
msgid ""
"'halui.axis.jog-deadband' (float in) - pin for setting jog analog deadband "
"(jog analog inputs smaller/slower than this (in absolute value) are ignored)"
msgstr ""
"'halui.axis.jog-deadband' (float in) - контакт для налаштування зони "
"нечутливості аналогового режиму поштовху (аналогові входи поштовху, менші/"
"повільніші за цю зону (за абсолютним значенням), ігноруються)"

#. type: Plain text
#: src/gui/halui.adoc:235
msgid ""
"'halui.axis.jog-speed' (float in) - pin for setting jog speed for plus/minus "
"jogging."
msgstr ""
"'halui.axis.jog-speed' (float in) - штифт для налаштування швидкості "
"штовхання для плюс/мінус штовхання."

#. type: Plain text
#: src/gui/halui.adoc:236
msgid ""
"'halui.axis._L_.analog' (float in) - pin for jogging the axis _L_ using an "
"float value (e.g. joystick). The value, typically set between 0.0 and ±1.0, "
"is used as a jog-speed multiplier."
msgstr ""
"'halui.axis._L_.analog' (float in) - штифт для штовхання осі _L_ за "
"допомогою значення з плаваючою комою (наприклад, джойстика). Значення, яке "
"зазвичай встановлюється між 0,0 та ±1,0, використовується як множник "
"швидкості штовхання."

#. type: Plain text
#: src/gui/halui.adoc:237
msgid ""
"'halui.axis._L_.increment' (float in) - pin for setting the jog increment "
"for axis _L_ when using increment-plus/minus"
msgstr ""
"'halui.axis._L_.increment' (float in) - штифт для встановлення приросту "
"поштовху для осі _L_ при використанні приросту плюс/мінус"

#. type: Plain text
#: src/gui/halui.adoc:238
msgid ""
"'halui.axis._L_.increment-minus' (bit in) - a rising edge will will make "
"axis _L_ jog in the negative direction by the increment amount"
msgstr ""
"'halui.axis._L_.increment-minus' (bit in) - Наростаючий фронт змусить вісь "
"_L_ рухатися в негативному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:239
msgid ""
"'halui.axis._L_.increment-plus' (bit in) - a rising edge will will make axis "
"_L_ jog in the positive direction by the increment amount"
msgstr ""
"'halui.axis._L_.increment-plus' (bit in) - Наростаючий фронт змусить вісь "
"_L_ рухатися в позитивному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:240
msgid ""
"'halui.axis._L_.minus' (bit in) - pin for jogging axis _L_ in negative "
"direction at the halui.axis.jog-speed velocity"
msgstr ""
"'halui.axis._L_.minus' (bit in) - штифт для осі штовхання _L_ у негативному "
"напрямку зі швидкістю halui.axis.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:241
msgid ""
"'halui.axis._L_.plus' (bit in) - pin for jogging axis _L_ in positive "
"direction at the halui.axis.jog-speed velocity"
msgstr ""
"'halui.axis._L_.plus' (bit in) - штифт для осі штовхання _L_ у позитивному "
"напрямку зі швидкістю halui.axis.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:242
msgid ""
"'halui.axis.selected' (u32 out) - selected axis (by index: 0:x 1:y 2:z 3:a "
"4:b 5:cr 6:u 7:v 8:w)"
msgstr ""
"'halui.axis.selected' (u32 out) - вибрана вісь (за індексом: 0:x 1:y 2:z 3:a "
"4:b 5:cr 6:u 7:v 8:w)"

#. type: Plain text
#: src/gui/halui.adoc:243
msgid ""
"'halui.axis.selected.increment' (float in) - pin for setting the jog "
"increment for the selected axis when using increment-plus/minus"
msgstr ""
"'halui.axis.selected.increment' (float in) - штифт для встановлення приросту "
"подачі для вибраної осі при використанні приросту плюс/мінус"

#. type: Plain text
#: src/gui/halui.adoc:244
msgid ""
"'halui.axis.selected.increment-minus' (bit in) - a rising edge will will "
"make the selected axis jog in the negative direction by the increment amount"
msgstr ""
"'halui.axis.selected.increment-minus' (bit in) - Наростаючий фронт змусить "
"вибрану вісь рухатися в негативному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:245
msgid ""
"'halui.axis.selected.increment-plus' (bit in) - a rising edge will will make "
"the selected axis jog in the positive direction by the increment amount"
msgstr ""
"'halui.axis.selected.increment-plus' (bit in) - Наростаючий фронт змусить "
"вибрану вісь рухатися в позитивному напрямку на величину приросту"

#. type: Plain text
#: src/gui/halui.adoc:246
msgid ""
"'halui.axis.selected.minus' (bit in) - pin for jogging the selected axis in "
"negative direction at the halui.axis.jog-speed velocity"
msgstr ""
"'halui.axis.selected.minus' (bit in) - штифт для штовхання вибраної осі в "
"негативному напрямку зі швидкістю halui.axis.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:247
msgid ""
"'halui.axis.selected.plus' (pin in) - for jogging the selected axis bit in "
"in positive direction at the halui.axis.jog-speed velocity"
msgstr ""
"'halui.axis.selected.plus' (pin in) - для штовхання вибраного осьового біта "
"в позитивному напрямку зі швидкістю halui.axis.jog-speed"

#. type: Plain text
#: src/gui/halui.adoc:251
msgid "'halui.mode.auto' (bit, in) - pin for requesting auto mode"
msgstr "'halui.mode.auto' (bit, in) - PIN-код для запиту автоматичного режиму"

#. type: Plain text
#: src/gui/halui.adoc:252
msgid "'halui.mode.is-auto' (bit, out) - indicates auto mode is on"
msgstr ""
"'halui.mode.is-auto' (bit, out) - вказує на те, що автоматичний режим "
"увімкнено"

#. type: Plain text
#: src/gui/halui.adoc:253
msgid ""
"'halui.mode.is-joint' (bit, out) - indicates joint by joint jog mode is on"
msgstr ""
"'halui.mode.is-joint' (bit, out) - вказує на те, що ввімкнено режим "
"поштовхового переміщення з'єднання за з'єднанням"

#. type: Plain text
#: src/gui/halui.adoc:254
msgid "'halui.mode.is-manual' (bit, out) - indicates manual mode is on"
msgstr ""
"'halui.mode.is-manual' (bit, out) - вказує на те, що ручний режим увімкнено"

#. type: Plain text
#: src/gui/halui.adoc:255
msgid "'halui.mode.is-mdi' (bit, out) - indicates MDI mode is on"
msgstr "'halui.mode.is-mdi' (bit, out) - вказує на те, що режим MDI увімкнено"

#. type: Plain text
#: src/gui/halui.adoc:256
msgid ""
"'halui.mode.is-teleop' (bit, out) - indicates coordinated jog mode is on"
msgstr ""
"'halui.mode.is-teleop' (bit, out) - вказує на те, що увімкнено режим "
"скоординованого поштовху"

#. type: Plain text
#: src/gui/halui.adoc:257
msgid ""
"'halui.mode.joint' (bit, in) - pin for requesting joint by joint jog mode"
msgstr ""
"'halui.mode.joint' (bit, in) - контакт для запиту режиму поштовху з'єднання "
"за з'єднанням"

#. type: Plain text
#: src/gui/halui.adoc:258
msgid "'halui.mode.manual' (bit, in) - pin for requesting manual mode"
msgstr "'halui.mode.manual' (bit, in) - PIN-код для виклику ручного режиму"

#. type: Plain text
#: src/gui/halui.adoc:259
msgid "'halui.mode.mdi' (bit, in) - pin for requesting MDI mode"
msgstr "'halui.mode.mdi' (bit, in) - PIN-код для запиту режиму MDI"

#. type: Plain text
#: src/gui/halui.adoc:260
msgid "'halui.mode.teleop' (bit, in) - pin for requesting coordinated jog mode"
msgstr ""
"'halui.mode.teleop' (bit, in) - контакт для запиту скоординованого режиму "
"поштовху"

#. type: Title ====
#: src/gui/halui.adoc:261 src/man/man1/halui.1.adoc:111
#: src/man/man1/xhc-whb04b-6.1.adoc:222
#, no-wrap
msgid "Program"
msgstr "Програма"

#. type: Plain text
#: src/gui/halui.adoc:264
msgid ""
"'halui.program.block-delete.is-on' (bit, out) - status pin telling that "
"block delete is on"
msgstr ""
"'halui.program.block-delete.is-on' (bit, out) - PIN-код стану, що вказує на "
"те, що видалення блоку ввімкнено"

#. type: Plain text
#: src/gui/halui.adoc:265
msgid ""
"'halui.program.block-delete.off' (bit, in) - pin for requesting that block "
"delete is off"
msgstr ""
"'halui.program.block-delete.off' (bit, in) - PIN-код для запиту на видалення "
"блоку вимкнено"

#. type: Plain text
#: src/gui/halui.adoc:266
msgid ""
"'halui.program.block-delete.on' (bit, in) - pin for requesting that block "
"delete is on"
msgstr ""
"'halui.program.block-delete.on' (bit, in) - PIN-код для запиту на видалення "
"блоку ввімкнено"

#. type: Plain text
#: src/gui/halui.adoc:267
msgid ""
"'halui.program.is-idle' (bit, out) - status pin telling that no program is "
"running"
msgstr ""
"'halui.program.is-idle' (bit, out) - PIN-код стану, що вказує на те, що "
"жодна програма не запущена"

#. type: Plain text
#: src/gui/halui.adoc:268
msgid ""
"'halui.program.is-paused' (bit, out) - status pin telling that a program is "
"paused"
msgstr ""
"'halui.program.is-paused' (bit, out) - PIN-код стану, що вказує на те, що "
"програма призупинена"

#. type: Plain text
#: src/gui/halui.adoc:269
msgid ""
"'halui.program.is-running' (bit, out) - status pin telling that a program is "
"running"
msgstr ""
"'halui.program.is-running' (bit, out) - PIN-код стану, що вказує на те, що "
"програма запущена"

#. type: Plain text
#: src/gui/halui.adoc:270
msgid ""
"'halui.program.optional-stop.is-on' (bit, out) - status pin telling that the "
"optional stop is on"
msgstr ""
"'halui.program.optional-stop.is-on' (bit, out) - PIN-код стану, що вказує на "
"увімкнення додаткової зупинки"

#. type: Plain text
#: src/gui/halui.adoc:271
msgid ""
"'halui.program.optional-stop.off' (bit, in) - pin requesting that the "
"optional stop is off"
msgstr ""
"'halui.program.optional-stop.off' (bit, in) - шпилька із запитом на "
"вимкнення додаткової зупинки"

#. type: Plain text
#: src/gui/halui.adoc:272
msgid ""
"'halui.program.optional-stop.on' (bit, in) - pin requesting that the "
"optional stop is on"
msgstr ""
"'halui.program.optional-stop.on' (bit, in) - шпилька із запитом на включення "
"додаткової зупинки"

#. type: Plain text
#: src/gui/halui.adoc:273
msgid "'halui.program.pause' (bit, in) - pin for pausing a program"
msgstr "'halui.program.pause' (bit, in) - PIN-код для призупинення програми"

#. type: Plain text
#: src/gui/halui.adoc:274
msgid "'halui.program.resume' (bit, in) - pin for resuming a paused program"
msgstr ""
"'halui.program.resume' (bit, in) - PIN-код для відновлення призупиненої "
"програми"

#. type: Plain text
#: src/gui/halui.adoc:275
msgid "'halui.program.run' (bit, in) - pin for running a program"
msgstr "'halui.program.run' (bit, in) - PIN-код для запуску програми"

#. type: Plain text
#: src/gui/halui.adoc:276
msgid "'halui.program.step' (bit, in) - pin for stepping in a program"
msgstr ""
"'halui.program.step' (bit, in) - PIN-код для поетапного входу в програму"

#. type: Plain text
#: src/gui/halui.adoc:277
msgid "'halui.program.stop' (bit, in) - pin for stopping a program"
msgstr "'halui.program.stop' (bit, in) - PIN-код для зупинки програми"

#. type: Title ===
#: src/gui/halui.adoc:278 src/man/man1/halui.1.adoc:397
#, no-wrap
msgid "Rapid Override"
msgstr "Швидке перевизначення"

#. type: Plain text
#: src/gui/halui.adoc:281
msgid ""
"'halui.rapid-override.count-enable' (bit in (default: TRUE)) - When TRUE, "
"modify Rapid Override when counts changes."
msgstr ""
"'halui.rapid-override.count-enable' (bit in (за замовчуванням: TRUE)) - Якщо "
"значення TRUE, змінювати швидке перевизначення при зміні підрахунку."

#. type: Plain text
#: src/gui/halui.adoc:282
msgid ""
"'halui.rapid-override.counts' (s32 in) - counts X scale = Rapid Override "
"percentage. Can be used with an encoder or 'direct-value'."
msgstr ""
"'halui.rapid-override.counts' (s32 in) - counts X scale = Відсоток швидкого "
"перевизначення. Може використовуватися з енкодером або «прямим значенням»."

#. type: Plain text
#: src/gui/halui.adoc:283
msgid ""
"'halui.rapid-override.decrease' (bit in) - pin for decreasing the Rapid "
"Override (-=scale)"
msgstr ""
"'halui.rapid-override.decrease' (bit in) - штифт для зменшення швидкого "
"керування (-=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:284
msgid ""
"'halui.rapid-override.direct-value' (bit in) - pin to enable direct value "
"Rapid Override input"
msgstr ""
"'halui.rapid-override.direct-value' (bit in) - контакт для активації входу "
"швидкого керування прямим значенням"

#. type: Plain text
#: src/gui/halui.adoc:285
msgid ""
"'halui.rapid-override.increase' (bit in) - pin for increasing the Rapid "
"Override (+=scale)"
msgstr ""
"'halui.rapid-override.increase' (bit in) - штифт для збільшення швидкого "
"керування (+=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:286
msgid ""
"'halui.rapid-override.scale' (float in) - pin for setting the scale on "
"changing the Rapid Override"
msgstr ""
"'halui.rapid-override.scale' (float in) - штифт для налаштування шкали при "
"зміні швидкого керування"

#. type: Plain text
#: src/gui/halui.adoc:287
msgid "'halui.rapid-override.value' (float out) - current Rapid Override value"
msgstr ""
"'halui.rapid-override.value' (float out) - поточне значення швидкого "
"перемикання"

#. type: Plain text
#: src/gui/halui.adoc:288
msgid ""
"'halui.rapid-override.reset' (bit, in) - pin for resetting the Rapid "
"Override value (scale=1.0)"
msgstr ""
"'halui.rapid-override.reset' (bit, in) - контакт для скидання значення "
"швидкого керування (масштаб=1.0)"

#. type: Title ===
#: src/gui/halui.adoc:289 src/man/man1/halui.1.adoc:91
#, no-wrap
msgid "Spindle Override"
msgstr "Корекції шпинделя"

#. type: Plain text
#: src/gui/halui.adoc:292
msgid ""
"'halui.spindle._N_.override.count-enable' (bit, in) - must be true for "
"'counts' or 'direct-value' to work."
msgstr ""
"'halui.spindle._N_.override.count-enable' (bit, in) - має бути істинним, щоб "
"«підрахунки» або «пряме значення» працювали."

#. type: Plain text
#: src/gui/halui.adoc:293
msgid ""
"'halui.spindle._N_.override.counts' (s32, in) - counts * scale = SO "
"percentage.  Can be used with an encoder or 'direct-value'."
msgstr ""
"'halui.spindle._N_.override.counts' (s32, in) - counts * scale = SO "
"відсоток. Може використовуватися з енкодером або «прямим значенням»."

#. type: Plain text
#: src/gui/halui.adoc:294
msgid ""
"'halui.spindle._N_.override.decrease' (bit, in) - pin for decreasing the SO "
"(-=scale)"
msgstr ""
"'halui.spindle._N_.override.decrease' (bit, in) - штифт для зменшення SO (-"
"=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:295
msgid ""
"'halui.spindle._N_.override.direct-value' (bit, in) - false when using "
"encoder to change counts, true when setting counts directly."
msgstr ""
"'halui.spindle._N_.override.direct-value' (bit, in) - false під час "
"використання енкодера для зміни лічильників, true під час безпосереднього "
"встановлення лічильників."

#. type: Plain text
#: src/gui/halui.adoc:296
msgid ""
"'halui.spindle._N_.override.increase' (bit, in) - pin for increasing the SO "
"(+=scale)"
msgstr ""
"'halui.spindle._N_.override.increase' (bit, in) - штифт для збільшення SO "
"(+=масштаб)"

#. type: Plain text
#: src/gui/halui.adoc:297
msgid ""
"'halui.spindle._N_.override.scale' (float, in) - pin for setting the scale "
"on changing the SO"
msgstr ""
"'halui.spindle._N_.override.scale' (float, in) - штифт для налаштування "
"шкали при зміні SO"

#. type: Plain text
#: src/gui/halui.adoc:298
msgid "'halui.spindle._N_.override.value' (float, out) - current SO value"
msgstr "'halui.spindle._N_.override.value' (float, out) - поточне значення SO"

#. type: Plain text
#: src/gui/halui.adoc:299
msgid ""
"'halui.spindle._N_.override.reset' (bit, in) - pin for resetting the SO "
"value (scale=1.0)"
msgstr ""
"'halui.spindle._N_.override.reset' (bit, in) - контакт для скидання значення "
"SO (масштаб=1.0)"

#. type: Plain text
#: src/gui/halui.adoc:303
msgid "'halui.spindle._N_.brake-is-on' (bit, out) - indicates brake is on"
msgstr ""
"'halui.spindle._N_.brake-is-on' (bit, out) - вказує на те, що гальмо "
"увімкнено"

#. type: Plain text
#: src/gui/halui.adoc:304
msgid ""
"'halui.spindle._N_.brake-off' (bit, in) - pin for deactivating spindle/brake"
msgstr ""
"'halui.spindle._N_.brake-off' (bit, in) - штифт для деактивації шпинделя/"
"гальма"

#. type: Plain text
#: src/gui/halui.adoc:305
msgid ""
"'halui.spindle._N_.brake-on' (bit, in) - pin for activating spindle-brake"
msgstr ""
"'halui.spindle._N_.brake-on' (bit, in) - штифт для активації гальма шпинделя"

#. type: Plain text
#: src/gui/halui.adoc:306
msgid "'halui.spindle._N_.decrease' (bit, in) - decreases spindle speed"
msgstr "'halui.spindle._N_.decrease' (bit, in) - зменшує швидкість шпинделя"

#. type: Plain text
#: src/gui/halui.adoc:307
msgid ""
"'halui.spindle._N_.forward' (bit, in) - starts the spindle with CW motion"
msgstr ""
"'halui.spindle._N_.forward' (bit, in) - запускає шпиндель рухом за "
"годинниковою стрілкою"

#. type: Plain text
#: src/gui/halui.adoc:308
msgid "'halui.spindle._N_.increase' (bit, in)- increases spindle speed"
msgstr "'halui.spindle._N_.increase' (bit, in)- збільшує швидкість шпинделя"

#. type: Plain text
#: src/gui/halui.adoc:309
msgid ""
"'halui.spindle._N_.is-on' (bit, out) - indicates spindle is on (either "
"direction)"
msgstr ""
"'halui.spindle._N_.is-on' (bit, out) - вказує на те, що шпиндель увімкнено "
"(в будь-якому напрямку)"

#. type: Plain text
#: src/gui/halui.adoc:310
msgid ""
"'halui.spindle._N_.reverse' (bit, in)- starts the spindle with a CCW motion"
msgstr ""
"'halui.spindle._N_.reverse' (bit, in)- запускає шпиндель рухом проти "
"годинникової стрілки"

#. type: Plain text
#: src/gui/halui.adoc:311
msgid ""
"'halui.spindle._N_.runs-backward' (bit, out) - indicates spindle is on, and "
"in reverse"
msgstr ""
"'halui.spindle._N_.runs-backward' (bit, out) - вказує на те, що шпиндель "
"увімкнено, і обертається у зворотному напрямку"

#. type: Plain text
#: src/gui/halui.adoc:312
msgid ""
"'halui.spindle._N_.runs-forward' (bit, out) - indicates spindle is on, and "
"in forward"
msgstr ""
"'halui.spindle._N_.runs-forward' (bit, out) - вказує на те, що шпиндель "
"увімкнено та обертається вперед"

#. type: Plain text
#: src/gui/halui.adoc:313
msgid "'halui.spindle._N_.start' (bit, in) - starts the spindle"
msgstr "'halui.spindle._N_.start' (bit, in) - запускає шпиндель"

#. type: Plain text
#: src/gui/halui.adoc:314
msgid "'halui.spindle._N_.stop' (bit, in) - stops the spindle"
msgstr "'halui.spindle._N_.stop' (bit, in) - зупиняє шпиндель"

#. type: Title ===
#: src/gui/halui.adoc:315 src/man/man1/halui.1.adoc:39
#, no-wrap
msgid "Tool"
msgstr "Інструмент"

#. type: Plain text
#: src/gui/halui.adoc:318
msgid ""
"'halui.tool.length-offset.a' (float out) - current applied tool length "
"offset for the A axis"
msgstr ""
"'halui.tool.length-offset.a' (float out) - поточне застосоване зміщення "
"довжини інструмента для осі A"

#. type: Plain text
#: src/gui/halui.adoc:319
msgid ""
"'halui.tool.length-offset.b' (float out) - current applied tool length "
"offset for the B axis"
msgstr ""
"'halui.tool.length-offset.b' (float out) - поточне застосоване зміщення "
"довжини інструмента для осі B"

#. type: Plain text
#: src/gui/halui.adoc:320
msgid ""
"'halui.tool.length-offset.c' (float out) - current applied tool length "
"offset for the C axis"
msgstr ""
"'halui.tool.length-offset.c' (float out) - поточне застосоване зміщення "
"довжини інструмента для осі C"

#. type: Plain text
#: src/gui/halui.adoc:321
msgid ""
"'halui.tool.length-offset.u' (float out) - current applied tool length "
