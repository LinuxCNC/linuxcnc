#. type: Title ==
#: src/hal/tools.adoc:218
#, no-wrap
msgid "HAL Histogram"
msgstr "Гістограма HAL"

#. type: Plain text
#: src/hal/tools.adoc:221
msgid ""
"`hal-histogram` is a command line utility to display histograms for HAL pins."
msgstr ""
"`hal-histogram` — це утиліта командного рядка для відображення гістограм для "
"виводів HAL."

#. type: Block title
#: src/hal/tools.adoc:222
#, no-wrap
msgid "hal-histogram Usage"
msgstr "Використання hal-гістограми"

#. type: Plain text
#: src/hal/tools.adoc:223 src/man/man1/xhc-hb04.1.adoc:54
#, no-wrap
msgid "Usage:"
msgstr "Використання:"

#. type: Plain text
#: src/hal/tools.adoc:227
#, no-wrap
msgid ""
"   hal-histogram --help | -?\n"
"or\n"
"   hal-histogram [Options] [pinname]\n"
msgstr ""
"   hal-histogram --help | -?\n"
"or\n"
"   hal-histogram [Options] [pinname]\n"

#. type: Table
#: src/hal/tools.adoc:232 src/plasma/qtplasmac.adoc:1500
#, no-wrap
msgid "Option"
msgstr "Варіант"

#. type: Table
#: src/hal/tools.adoc:233
#, no-wrap
msgid "--minvalue"
msgstr "--minvalue"

#. type: Table
#: src/hal/tools.adoc:233
#, no-wrap
msgid "minvalue"
msgstr "мінімальне значення"

#. type: Table
#: src/hal/tools.adoc:234
#, no-wrap
msgid "minimum bin, default: 0"
msgstr "мінімальний контейнер, за замовчуванням: 0"

#. type: Table
#: src/hal/tools.adoc:234
#, no-wrap
msgid "--binsize"
msgstr "--binsize"

#. type: Table
#: src/hal/tools.adoc:234
