msgstr "Віджет може налаштовувати:"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2213 src/gui/qtvcp-widgets.adoc:2354
msgid "Jog rate"
msgstr "Швидкість штовхання"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2214 src/gui/qtvcp-widgets.adoc:2355
msgid "Angular jog rate"
msgstr "Швидкість кутового поштовху"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2216 src/gui/qtvcp-widgets.adoc:2357
msgid "Spindle override rate"
msgstr "Швидкість корекції шпинделя"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2217 src/gui/qtvcp-widgets.adoc:2358
msgid "Rapid override rate"
msgstr "Швидка швидкість перевизначення"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2221
msgid "`StatusSlider` has the following properties:"
msgstr "`StatusSlider` має такі властивості:"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2224
msgid "Sets option to make a HAL float pin that reflects current value."
msgstr ""
"Встановлює опцію для створення HAL-виведення з плаваючою точкою, яке "
"відображає поточне значення."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2224
#, no-wrap
msgid "*`rapid_rate`*"
msgstr "*`rapid_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2226
msgid "Selects a rapid override rate slider."
msgstr "Вибирає повзунок швидкості швидкого перевизначення."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2226
#, no-wrap
msgid "*`feed_rate`*"
msgstr "*`feed_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2228
msgid "Selects a feed override rate slider."
msgstr "Вибирає повзунок швидкості корекції подачі."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2228
#, no-wrap
msgid "*`spindle_rate`*"
msgstr "*`spindle_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2230
msgid "Selects a spindle override rate slider."
msgstr "Вибирає повзунок швидкості корекції шпинделя."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2230
#, no-wrap
msgid "*`jograte_rate`*"
msgstr "*`jograte_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2232
msgid "Selects a linear jograte slider."
msgstr "Вибирає лінійний повзунок зі змінною довжиною."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2232
#, no-wrap
msgid "*`jograte_angular_rate`*"
msgstr "*`jograte_angular_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2234
msgid "Selects a angular jograte slider."
msgstr "Вибирає повзунок з кутовою візерунчастою решіткою."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2234
#, no-wrap
msgid "*`max_velocity_rate`*"
msgstr "*`max_velocity_rate`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2236
msgid "Selects a maximum velocity rate slider."
msgstr "Вибирає повзунок максимальної швидкості."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2236
#, no-wrap
msgid "*`alertState`*"
msgstr "*`alertState`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2238
msgid ""
"String to define style change: `read-only`, `under`, `over` and `normal`."
msgstr ""
"Рядок для визначення зміни стилю: `read-only`, `under`, `over` та `normal`."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2238
#, no-wrap
msgid "*`alertUnder`*"
msgstr "*`alertUnder`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2240
msgid "Sets the float value that signals the stylesheet for 'under' warning."
msgstr ""
"Встановлює значення числа з плаваючою комою, яке сигналізує таблиці стилів "
"про попередження «менше»."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2240
#, no-wrap
msgid "*`alertOver`*"
msgstr "*`alertOver`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2242
msgid "Sets the float value that signals the stylesheet for 'over' warning."
msgstr ""
"Встановлює значення числа з плаваючою комою, яке сигналізує таблиці стилів "
"про попередження «перевищення»."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2247
msgid "Python handler code,"
msgstr "Код обробника Python,"

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:2253
#, no-wrap
msgid ""
"self.w.status_slider.setProperty('spindle_rate',True)\n"
"self.w.status_slider.setProperty('alertUnder',35)\n"
"self.w.status_slider.setProperty('alertOver',100)\n"
msgstr ""
"self.w.status_slider.setProperty('spindle_rate',True)\n"
"self.w.status_slider.setProperty('alertUnder',35)\n"
"self.w.status_slider.setProperty('alertOver',100)\n"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2256
msgid "Or (if appropriate) in stylesheets."
msgstr "Або (якщо доречно) у таблицях стилів."

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:2261
#, no-wrap
msgid ""
"/* warning colors for overrides if out of normal range*/\n"
"/* widget object name is slider_spindle_ovr */\n"
msgstr ""
"/* кольори попередження для перевизначень, якщо значення виходять за межі нормального діапазону*/\n"
"/* назва об'єкта віджета — slider_spindle_ovr */\n"

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:2268
#, no-wrap
msgid ""
"#slider_spindle_ovr[alertState='over'] {\n"
"    background: red;\n"
"}\n"
"#slider_spindle_ovr[alertState='under'] {\n"
"    background: yellow;\n"
"}\n"
msgstr ""
"#slider_spindle_ovr[alertState='over'] {\n"
"    background: red;\n"
"}\n"
"#slider_spindle_ovr[alertState='under'] {\n"
"    background: yellow;\n"
"}\n"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2271
msgid "It is based on PyQt's _QSlider_."
msgstr "Він базується на _QSlider_ від PyQt."

