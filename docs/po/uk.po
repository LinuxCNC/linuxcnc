msgstr "-L та +L – це точки спрацьовування кінцевих вимикачів"

#. type: NOTE
#: src/config/ini-homing.adoc:69
msgid "A<->B is the negative soft limits (MIN_LIMITS) = -3 units"
msgstr "A<->B – це від’ємні м’які межі (MIN_LIMITS) = -3 одиниці"

#. type: NOTE
#: src/config/ini-homing.adoc:70
msgid "B<->C is the home_offset (HOME_OFFSET) = -2.3 units"
msgstr "B<->C – це домашнє_зміщення (HOME_OFFSET) = -2,3 одиниці"

#. type: NOTE
#: src/config/ini-homing.adoc:71
msgid "B<->D is the positive soft limits (MAX_LIMITS) = 7 units"
msgstr "B<->D – це додатні м’які ліміти (MAX_LIMITS) = 7 одиниць"

#. type: NOTE
#: src/config/ini-homing.adoc:72
msgid "A<->D is the total travel = 10 units"
msgstr "A<->D – загальний пробіг = 10 одиниць"

#. type: NOTE
