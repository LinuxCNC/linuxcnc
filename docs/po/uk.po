"bool hal_stream_readable(hal_stream_t* stream);\n"

#. type: delimited block -
#: src/man/man3/hal_stream.3.adoc:29
#, no-wrap
msgid ""
"int hal_stream_write(hal_stream_t* stream, union hal_stream_data* buf);\n"
