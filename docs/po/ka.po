#. type: Title ===
#: src/gui/gladevcp.adoc:1204
#, no-wrap
msgid "Gremlin tool path preview for NGC files"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1211
msgid ""
"Gremlin is a plot preview widget similar to the AXIS preview window.  It "
"assumes a running LinuxCNC environment like AXIS or Touchy.  To connect to "
"it, inspects the INI_FILE_NAME environment variable.  Gremlin displays the "
"current NGC file - it does monitor for changes and reloads the ngc file if "
"the file name in AXIS/Touchy changes.  If you run it in a GladeVCP "
"application when LinuxCNC is not running, you might get a traceback because "
"the Gremlin widget can't find LinuxCNC status, like the current file name."
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1215
msgid "Gremlin does not export any HAL pins."
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1219
msgid "Gremlin has the following properties:"
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1220 src/gui/gladevcp.adoc:1274
#, no-wrap
msgid "enable_dro"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1223
#, no-wrap
msgid ""
"This displays the dro on the graphics.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1223
#, no-wrap
msgid "show_velocity"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1226
#, no-wrap
msgid ""
"This displays the tool speed.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1226
#, no-wrap
msgid "use_commanded"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1229
#, no-wrap
msgid ""
"This selects the DRO to use: commanded or actual values.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1229 src/gui/gladevcp.adoc:1510
#, no-wrap
msgid "metric_units"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1232
#, no-wrap
msgid ""
"This selects the DRO to use: metric or imperial units.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1232
#, no-wrap
msgid "show_rapids"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1235
#, no-wrap
msgid ""
"This tells the plotter to show the rapid moves.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1235
#, no-wrap
msgid "show_dtg_"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1238
#, no-wrap
msgid ""
"This selects the DRO to display the distance-to-go value.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1238
#, no-wrap
msgid "use_relative"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1241
#, no-wrap
msgid ""
"This selects the DRO to show values relative to user system or machine coordinates.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1241
#, no-wrap
msgid "show_live_plot"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1244
#, no-wrap
msgid ""
"This tells the plotter to draw or not.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1244
#, no-wrap
msgid "show_limits"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1247
#, no-wrap
msgid ""
"This tells the plotter to show the machine's limits.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1247
#, no-wrap
msgid "show_lathe_radius"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1251
#, no-wrap
msgid ""
"This selects the DRO to display the X axis in radius or diameter, if in lathe mode (selectable in the INI file with LATHE = 1).\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1251
#, no-wrap
msgid "show_extents_option"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1254
#, no-wrap
msgid ""
"This tells the plotter to show the machine's extents.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1254
#, no-wrap
msgid "show_tool"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1257
#, no-wrap
msgid ""
"This tells the plotter to draw the tool.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1257
#, no-wrap
msgid "show_program"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1260
#, no-wrap
msgid ""
"Shows the G-code program.\n"
"Default = True"
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1260
#, no-wrap
msgid "use_joints_mode"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1263
#, no-wrap
msgid ""
"Used in non trivialkins machines (e.g., robots).\n"
"Default = false."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1263
#, no-wrap
msgid "grid_size"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1266
#, no-wrap
msgid ""
"Sets the size of the grid (only visible in the X, Y and Z views).\n"
"Defaults to 0"
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1266
#, no-wrap
msgid "use_default_controls"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1271
#, no-wrap
msgid ""
"This disables the default mouse controls.\n"
"This is most useful when using a touchscreen as the default controls do not work well. You can programmatically add controls using Python and the handler file technique.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1271
#, no-wrap
msgid "view"
msgstr "ნახვა"

#. type: Plain text
#: src/gui/gladevcp.adoc:1274
#, no-wrap
msgid ""
"May be any of `x`, `y`, `y2` , `z`, `z2` , `p` (perspective).\n"
"Defaults to `z` view."
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1278
#, no-wrap
msgid ""
"Type = boolean.\n"
"Whether to draw a DRO on the plot or not.\n"
"Default = true."
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1278
#, no-wrap
msgid "mouse_btn_mode"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1281
#, no-wrap
msgid ""
"Type = integer.\n"
"Mouse button handling: leads to different functions of the button:"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1282
msgid "0 = default: left rotate, middle move, right zoom"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1283
msgid "1 = left zoom, middle move, right rotate"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1284
msgid "2 = left move, middle rotate, right zoom"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1285
msgid "3 = left zoom, middle rotate, right move"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1286
msgid "4 = left move, middle zoom, right rotate"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1287
msgid "5 = left rotate, middle zoom, right move"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1288
msgid "6 = left move, middle zoom, right zoom"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:1290
msgid ""
"Mode 6 is recommended for plasmas and lathes, as rotation is not needed for "
"such machines."
msgstr ""

#. type: delimited block -
#: src/gui/gladevcp.adoc:1311
#, no-wrap
msgid ""
"[widget name].set_property('view','P')\n"
"[widget name].set_property('metric_units',False)\n"
"[widget name].set_property('use_default_controls',False)\n"
"[widget name].set_property('enable_dro' False)\n"
"[widget name].set_property('show_program', False)\n"
"[widget name].set_property('show_limits', False)\n"
"[widget name].set_property('show_extents_option', False)\n"
"[widget name].set_property('show_live_plot', False)\n"
"[widget name].set_property('show_tool', False)\n"
"[widget name].set_property('show_lathe_radius',True)\n"
"[widget name].set_property('show_dtg',True)\n"
"[widget name].set_property('show_velocity',False)\n"
"[widget name].set_property('mouse_btn_mode', 4)\n"
msgstr ""

#. type: delimited block -
#: src/gui/gladevcp.adoc:1329
#, no-wrap
msgid ""
"[widget name].show_offsets = True\n"
"[widget name].grid_size = .75\n"
"[widget name].select_fire(event.x,event.y)\n"
"[widget name].select_prime(event.x,event.y)\n"
"[widget name].start_continuous_zoom(event.y)\n"
"[widget name].set_mouse_start(0,0)\n"
"[widget name].gremlin.zoom_in()\n"
"[widget name].gremlin.zoom_out()\n"
"[widget name].get_zoom_distance()\n"
"[widget name].set_zoom_distance(dist)\n"
"[widget name].clear_live_plotter()\n"
"[widget name].rotate_view(x,y)\n"
"[widget name].pan(x,y)\n"
msgstr ""

#. type: Labeled list
#: src/gui/gladevcp.adoc:1331 src/gui/gladevcp.adoc:1418
#, no-wrap
msgid "Hints"
msgstr "მინიშნებები"

#. type: Plain text
#: src/gui/gladevcp.adoc:1333
msgid ""
"If you set all the plotting options false but show_offsets true you get an "
"offsets page instead of a graphics plot."
