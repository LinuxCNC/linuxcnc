msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:88
msgid ""
"'_<name>_.loop-time' (float, RW) how often the modbus is polled (default: "
"0.1)"
msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:89
msgid "'_<name>_.nameplate-HZ' (float, RW) Nameplate Hz of motor (default: 60)"
msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:90
msgid ""
"'_<name>_.nameplate-RPM' (float, RW) Nameplate RPM of motor (default: 1730)"
msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:91
msgid "'_<name>_.retval' (s32, RW) the return value of an error in HAL"
msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:92
msgid "'_<name>_.tolerance' (s32, RW) speed tolerance (default: 0.01)"
msgstr ""

#. type: NOTE
#: src/drivers/gs2.adoc:93
msgid ""
"'_<name>_.ack-delay' (s32, RW) number of read/write cycles before checking "
"at-speed (default 2)"
msgstr ""

