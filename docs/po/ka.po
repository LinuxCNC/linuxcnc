#: src/ladder/classic-ladder.adoc:487
#, no-wrap
msgid "Assignment Expression Example"
msgstr ""

#. type: Target for macro image
#: src/ladder/classic-ladder.adoc:488
#, no-wrap
msgid "images/Assignment_Expression.png"
msgstr ""

#. type: Block title
#: src/ladder/classic-ladder.adoc:490
#, no-wrap
msgid "Comparison Expression Example"
msgstr ""

#. type: Target for macro image
#: src/ladder/classic-ladder.adoc:491
