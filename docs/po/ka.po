#. type: Title ===
#: src/plasma/qtplasmac.adoc:4404
#, no-wrap
msgid "QtPlasmaC G-code Examples"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4410
#, no-wrap
msgid "Select material and do a normal cut"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4417
#, no-wrap
msgid ""
"M190 P3 +\n"
"M66 P3 L3 Q1 +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"M3 $0 S1 +\n"
". +\n"
". +\n"
"M5 $0"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4417
#, no-wrap
msgid "Set velocity to 100% of CutFeedRate"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4418
#, no-wrap
msgid "M67 E3 Q0 or M67 E3 Q100"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4418
#, no-wrap
msgid "Set velocity to 60% of CutFeedRate"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4419
#, no-wrap
msgid "M67 E3 Q60"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4419
#, no-wrap
msgid "Set velocity to 40% of CutFeedRate"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4420
#, no-wrap
msgid "M67 E3 Q40"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4420
#, no-wrap
msgid "Cut a hole with 60% reduced speed using velocity setting"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4433
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (reduce feed rate to 60%) +\n"
"G3 I10 (the hole) +\n"
"M67 E3 Q100 (restore feed rate to 100%) +\n"
"M5 $0 (end cut) +\n"
"G0 X0 Y0 +\n"
"M2 (end job)"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4433
#, no-wrap
msgid "Cut a hole with 60% reduced speed using the #<holes> command"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4445
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"\\#<holes> = 1 (velocity reduction for holes) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
