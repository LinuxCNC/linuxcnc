#, no-wrap
msgid "INVERT"
msgstr ""

#. type: Plain text
#: man/man9/invert.9:32
msgid "invert - Compute the inverse of the input signal"
msgstr ""

#. type: Plain text
#: man/man9/invert.9:35
msgid ""
"The output will be the mathematical inverse of the input, ie B<out> = 1 / "
"B<in>\\&. The parameter B<deadband> can be used to control how close to 0 "
"the denominator can be before the output is clamped to 0\\&. B<deadband> "
"must be at least 1e-8, and must be positive\\&."
msgstr ""

#. type: Plain text
#: man/man9/invert.9:38
msgid "B<invert>\\&.I<N> (requires a floating-point thread)"
msgstr ""

