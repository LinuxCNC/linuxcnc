msgstr ""

#. type: Plain text
#: man/man9/limit3.9:47
msgid "B<limit3>\\&.I<N>\\&.B<enable> bit in (default: I<1>)"
msgstr ""

#. type: Plain text
#: man/man9/limit3.9:49
msgid "1: out follows in, 0: out returns to 0 (always per constraints)"
msgstr ""

#. type: Plain text
#: man/man9/limit3.9:52
msgid "B<limit3>\\&.I<N>\\&.B<out> float out"
