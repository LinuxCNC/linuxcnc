msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:174
#, no-wrap
msgid ""
"    def update_interp_label(self,text):\n"
"        self.winterp_state_label.setText(\"Interpreter State: %s\" % (text))\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:177
