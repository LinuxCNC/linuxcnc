"<tabs>\n"
"    <names> [\"spindle\",\"green eggs\"]</names>\n"
"</tabs>\n"
"<tabs>\n"
"    <names>[\"Spindle\", \"Green Eggs\", \"Ham\"]</names>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"Spindle speed:\"</text>\n"
"        </label>\n"
"        <bar>\n"
"            <halpin>\"spindle-speed\"</halpin>\n"
"            <max_>5000</max_>\n"
"        </bar>\n"
"    </vbox>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"(this is the green eggs tab)\"</text>\n"
"        </label>\n"
"    </vbox>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"(this tab has nothing on it)\"</text>\n"
"        </label>\n"
"    </vbox>\n"
"</tabs>\n"
