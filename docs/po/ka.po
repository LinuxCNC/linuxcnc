#. type: delimited block -
#: src/config/lathe-config.adoc:90
#, no-wrap
msgid ""
"[JOINT_0]\n"
"...\n"
"[JOINT_1]\n"
"...\n"
"[AXIS_X]\n"
"...\n"
"[AXIS_Z]\n"
"...\n"
