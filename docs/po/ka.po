#. type: Plain text
#: src/man/man1/xhc-whb04b-6.1.adoc:267
msgid ""
"For flexibility reasons each button provides an output pin even if no "
"functionality is realized directly with that signal.  The Fn button can be "
"combined with each other push-button.  This includes also RESET, Stop, Start/"
"Pause, Macro-10, and Step|Continuous.  By default the more frequent used "
"orange buttons are executed, whereas blue ones (`whb.button.macro-`__<M>__) "
"by combining them with Fn (press Fn first then button)."
msgstr ""

#. type: Plain text
#: src/man/man1/xhc-whb04b-6.1.adoc:269
msgid ""
"Button macro needs to be added to your INI and needs to be edited for your "
"own use:"
msgstr ""

#. type: delimited block -
#: src/man/man1/xhc-whb04b-6.1.adoc:289
#, no-wrap
msgid ""
"[HALUI]\n"
"MDI_COMMAND=(debug,macro0)  # this one is for numbering but not used by pendant (need 1 to 16)\n"
"MDI_COMMAND=(debug,macro1)\n"
"MDI_COMMAND=(debug,macro2)\n"
"MDI_COMMAND=(debug,macro3)\n"
"MDI_COMMAND=(debug,macro4)\n"
"MDI_COMMAND=(debug,macro5)\n"
"MDI_COMMAND=(debug,macro6)\n"
"MDI_COMMAND=(debug,macro7)\n"
"MDI_COMMAND=(debug,macro8)\n"
"MDI_COMMAND=(debug,macro9)\n"
"MDI_COMMAND=(debug,macro10)\n"
"MDI_COMMAND=(debug,macro11)\n"
"MDI_COMMAND=(debug,macro12)\n"
"MDI_COMMAND=(debug,macro13)\n"
"MDI_COMMAND=(debug,macro14)\n"
"MDI_COMMAND=(debug,macro15)\n"
"MDI_COMMAND=(debug,macro16)\n"
msgstr ""

#. type: Plain text
#: src/man/man1/xhc-whb04b-6.1.adoc:292
msgid ""
"*_<M>_* ... denotes an arbitrary macro number which is of {1, 2, ..., 16}"
msgstr ""

