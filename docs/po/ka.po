msgstr ""

#. type: Labeled list
#: src/man/man9/motion.9.adoc:342
#, no-wrap
msgid "**joint.**_N_**.f-error** OUT FLOAT *(DEBUG)*"
msgstr ""

#. type: Plain text
#: src/man/man9/motion.9.adoc:344
msgid "The actual following error."
msgstr ""

