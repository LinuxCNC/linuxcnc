#. type: NOTE
#: src/hal/basic-hal.adoc:109
msgid "Flags may be one or more of the following:"
msgstr ""

#. type: Labeled list
#: src/hal/basic-hal.adoc:111
#, no-wrap
msgid "-W"
msgstr ""

#. type: horizontal
#: src/hal/basic-hal.adoc:112
msgid ""
"to wait for the component to become ready. The component is assumed to have "
"the same name as the first argument of the command."
msgstr ""

#. type: Labeled list
#: src/hal/basic-hal.adoc:113
#, no-wrap
msgid "-Wn <name>"
msgstr ""

#. type: horizontal
#: src/hal/basic-hal.adoc:114
msgid ""
"to wait for the component, which will have the given <name>.  This only "
"applies if the component has a name option."
msgstr ""

#. type: Labeled list
#: src/hal/basic-hal.adoc:115
#, no-wrap
msgid "-w"
msgstr ""

#. type: horizontal
#: src/hal/basic-hal.adoc:116
msgid "to wait for the program to exit"
msgstr ""

#. type: Labeled list
#: src/hal/basic-hal.adoc:117 src/man/man1/rs274.1.adoc:29
#, no-wrap
msgid "-i"
msgstr ""

#. type: horizontal
#: src/hal/basic-hal.adoc:118
msgid "to ignore the program return value (with -w)"
msgstr ""

#. type: Labeled list
#: src/hal/basic-hal.adoc:119 src/man/man1/rs274.1.adoc:22
#, no-wrap
msgid "-n"
msgstr ""

#. type: horizontal
#: src/hal/basic-hal.adoc:120
msgid "name a component when it is a valid option for that component."
msgstr ""

#. type: Block title
#: src/hal/basic-hal.adoc:121
#, no-wrap
msgid "Syntax and Examples of `loadusr`"
msgstr ""

#. type: delimited block -
#: src/hal/basic-hal.adoc:127
#, no-wrap
msgid ""
"loadusr <component> <options>\n"
"loadusr halui\n"
"loadusr -Wn spindle gs2_vfd -n spindle\n"
