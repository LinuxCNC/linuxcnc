#: man/man9/mesa_pktgyro_test.9:46
#, no-wrap
msgid "loadrt mesa_uart names=hm2_5i25\\&.0\\&.pktuart\\&.0\n"
msgstr ""

#. type: Plain text
#: man/man9/mesa_pktgyro_test.9:52
msgid ""
"The PktUART instance names are printed to the dmesg buffer during the "
"Hostmot2 setup sequence, one for each PktUART instance included in the "
"bitfile loaded to each installed card during the Hostmot2 setup sequence\\&. "
"Type \"dmesg\" at the terminal prompt to view the output\\&. If you want to "
"work with more than one PktUART instance, consult Andy Pugh\\(cqs "
"mesa_uart\\&.comp"
msgstr ""

#. type: Plain text
#: man/man9/mesa_pktgyro_test.9:54
msgid "In order to compile and install do:"
msgstr ""

#. type: Plain text
#: man/man9/mesa_pktgyro_test.9:60
