#. type: Title ==
#: src/gui/pyvcp-examples.adoc:345
#, no-wrap
msgid "GS2 RPM Meter"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:350
msgid ""
"The following example uses the Automation Direct GS2 VDF driver and displays "
"the RPM and other info in a PyVCP panel. This example is based on the GS2 "
"example in the Hardware Examples section this manual."
msgstr ""

#. type: Title ===
#: src/gui/pyvcp-examples.adoc:351
#, no-wrap
msgid "The Panel"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:354
msgid "To create the panel we add the following to the XML file."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:357
#, no-wrap
msgid "<pyvcp>\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:374
#, no-wrap
msgid ""
"  <!-- the RPM meter -->\n"
"  <hbox>\n"
"    <relief>RAISED</relief>\n"
"    <bd>3</bd>\n"
"    <meter>\n"
"      <halpin>\"spindle_rpm\"</halpin>\n"
"      <text>\"Spindle\"</text>\n"
"      <subtext>\"RPM\"</subtext>\n"
"      <size>200</size>\n"
"      <min_>0</min_>\n"
"      <max_>3000</max_>\n"
"      <majorscale>500</majorscale>\n"
"      <minorscale>100</minorscale>\n"
"      <region1>0,10,\"yellow\"</region1>\n"
"    </meter>\n"
"  </hbox>\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:398
#, no-wrap
msgid ""
"  <!-- the On Led -->\n"
"  <hbox>\n"
"  <relief>RAISED</relief>\n"
"  <bd>3</bd>\n"
"  <vbox>\n"
"  <relief>RAISED</relief>\n"
"  <bd>2</bd>\n"
"  <label>\n"
"  <text>\"On\"</text>\n"
"  <font>(\"Helvetica\",18)</font>\n"
"  </label>\n"
"  <width>5</width>\n"
"   <hbox>\n"
"  <label width=\"2\"/> <!-- used to center the led -->\n"
"  <rectled>\n"
"  <halpin>\"on-led\"</halpin>\n"
"  <height>\"30\"</height>\n"
"  <width>\"30\"</width>\n"
"  <on_color>\"green\"</on_color>\n"
"  <off_color>\"red\"</off_color>\n"
"  </rectled>\n"
"  </hbox>\n"
"  </vbox>\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:417
#, no-wrap
msgid ""
"  <!-- the FWD Led -->\n"
"  <vbox>\n"
"    <relief>RAISED</relief>\n"
"    <bd>2</bd>\n"
"    <label>\n"
"      <text>\"FWD\"</text>\n"
"      <font>(\"Helvetica\",18)</font>\n"
"      <width>5</width>\n"
"    </label>\n"
"   <label width=\"2\"/>\n"
"    <rectled>\n"
"      <halpin>\"fwd-led\"</halpin>\n"
"      <height>\"30\"</height>\n"
"      <width>\"30\"</width>\n"
"      <on_color>\"green\"</on_color>\n"
"      <off_color>\"red\"</off_color>\n"
"    </rectled>\n"
"  </vbox>\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:438
#, no-wrap
msgid ""
"  <!-- the REV Led -->\n"
"  <vbox>\n"
"  <relief>RAISED</relief>\n"
"  <bd>2</bd>\n"
"    <label>\n"
"      <text>\"REV\"</text>\n"
"      <font>(\"Helvetica\",18)</font>\n"
"       <width>5</width>\n"
"    </label>\n"
"    <label width=\"2\"/>\n"
"    <rectled>\n"
"      <halpin>\"rev-led\"</halpin>\n"
"      <height>\"30\"</height>\n"
"      <width>\"30\"</width>\n"
"      <on_color>\"red\"</on_color>\n"
"      <off_color>\"green\"</off_color>\n"
"    </rectled>\n"
"  </vbox>\n"
"  </hbox>\n"
"</pyvcp>\n"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:441
msgid "The above gives us a PyVCP panel that looks like the following."
msgstr ""

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/pyvcp-examples.adoc:442
#, no-wrap
msgid "GS2 Panel"
msgstr ""

#. type: Target for macro image
#: src/gui/pyvcp-examples.adoc:442
#, no-wrap
msgid "images/gs2_panel.png"
msgstr ""

#. type: Title ===
#: src/gui/pyvcp-examples.adoc:444
#, no-wrap
msgid "The Connections"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:448
msgid ""
"To make it work we add the following code to the custom_postgui.hal file."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:457
#, no-wrap
msgid ""
"# display the rpm based on freq * rpm per hz\n"
"loadrt mult2\n"
"addf mult2.0 servo-thread\n"
"setp mult2.0.in1 28.75\n"
"net cypher_speed mult2.0.in0 <= spindle-vfd.frequency-out\n"
"net speed_out pyvcp.spindle_rpm <= mult2.0.out\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:460
#, no-wrap
msgid ""
"# run led\n"
"net gs2-run => pyvcp.on-led\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:463
#, no-wrap
msgid ""
"# fwd led\n"
"net gs2-fwd => pyvcp.fwd-led\n"
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:466
#, no-wrap
msgid ""
"# rev led\n"
"net running-rev spindle-vfd.spindle-rev => pyvcp.rev-led\n"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:472
msgid ""
"Some of the lines might need some explanations. The fwd led line uses the "
"signal created in the custom.hal file whereas the rev led needs to use the "
"spindle-rev bit. You can't link the spindle-fwd bit twice so you use the "
"signal that it was linked to."
msgstr ""

#. type: Title ==
#: src/gui/pyvcp-examples.adoc:473
#, no-wrap
msgid "Rapid to Home Button"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:478
msgid ""
"This example creates a button on the PyVCP side panel when pressed will send "
"all the axis back to the home position. This example assumes you don't have "
"a PyVCP panel."
msgstr ""

#. type: Target for macro image
#: src/gui/pyvcp-examples.adoc:479
#, no-wrap
msgid "images/pyvcp-rth.png"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:483
msgid ""
"In your configuration directory create the XML file. In this example it's "
"named 'rth.xml'. In the 'rth.xml' file add the following code to create the "
"button."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:492
#, no-wrap
msgid ""
"<pyvcp>\n"
"<!-- rapid to home button example -->\n"
"<button>\n"
"<halpin>\"rth-button\"</halpin>\n"
"<text>\"Rapid to Home\"</text>\n"
"</button>\n"
"</pyvcp>\n"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:496
msgid ""
"Open your INI file with a text editor and in the [DISPLAY] section add the "
"following line. This is what loads the PyVCP panel."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:500
#, no-wrap
msgid "PYVCP = rth.xml\n"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:504
msgid ""
"If you don't have a [HALUI] section in the INI file create it and add the "
"following MDI command."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:508
#, no-wrap
msgid "MDI_COMMAND = G53 G0 X0 Y0 Z0\n"
msgstr ""

#. type: delimited block =
#: src/gui/pyvcp-examples.adoc:513
msgid "Information about <<gcode:g53,G53>> and <<gcode:g0,G0>> G-codes."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:517
msgid ""
"In the [HAL] section if you don't have a post gui file add the following and "
"create a file called 'postgui.hal'."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:521
#, no-wrap
msgid "POSTGUI_HALFILE = postgui.hal\n"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:525
msgid ""
"In the 'postgui.hal' file add the following code to link the PyVCP button to "
"the MDI command."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:529
#, no-wrap
msgid "net rth halui.mdi-command-00 <= pyvcp.rth-button\n"
msgstr ""

#. type: delimited block =
#: src/gui/pyvcp-examples.adoc:534
msgid "Information about the <<sub:hal-net, net>> command"
msgstr ""

#. type: Title =
#: src/gui/qtdragon.adoc:6
#, no-wrap
msgid "QtDragon GUI"
msgstr ""

#. type: Labeled list
#: src/gui/qtdragon.adoc:24 src/gui/qtdragon.adoc:30
#: src/user/user-intro.adoc:142
#, no-wrap
msgid "QtDragon"
msgstr ""

#. type: Plain text
#: src/gui/qtdragon.adoc:24
msgid ""
"QtDragon and QtDragon_hd are built with the QtVCP framework.  It is the "
"creative vision of forum personality Persei8.  Much of it is based on the "
"excellent work of others in the LinuxCNC community.  LinuxCNC's version is "
"adapted from Persei8's Github versions.  It is primarily meant for 3-5 axes "
"machines such as mills or routers.  It works well with a touchscreen and/or "
"mouse.  QtDragon supports multiple ways to touch off tools and probing work "
"pieces.  You can use LinuxCNC's external offsets capability to automatically "
"raise the spindle during a pause.  If you the VersaProbe option and remap "
"code you can add auto tool length probing at tool changes."
msgstr ""

#. type: NOTE
#: src/gui/qtdragon.adoc:29
msgid ""
"QtDragon and QtVCP are relatively new programs added into LinuxCNC.  Bugs "
"and oddities are possible. Please test carefully when using a dangerous "
"machine.  Please forward reports to the forum or maillist."
msgstr ""

