#. type: Title ===
#: src/hal/comp.adoc:611
#, no-wrap
msgid "hal_loop"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:617
#, no-wrap
msgid ""
"component hal_loop;\n"
"pin out float example;\n"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:620
msgid ""
"This fragment of a component illustrates the use of the 'hal_' prefix in a "
"component name."
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:623
msgid ""
"`loop` is a common name, and the `hal_` prefix avoids potential name "
"collisions with other unrelated software.  For example, on RTAI realtime "
"systems realtime code runs in the kernel, so if the component were named "
"just `loop` it could easily conflict with the standard `loop` kernel module."
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:626
msgid ""
"When loaded, 'halcmd show comp' will show a component called 'hal_loop'.  "
"However, the pin shown by 'halcmd show pin' will be 'loop.0.example', not "
"'hal-loop.0.example'."
msgstr ""

#. type: Title ===
#: src/hal/comp.adoc:627
#, no-wrap
msgid "arraydemo"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:630
msgid "This realtime component illustrates use of fixed-size arrays:"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:643
#, no-wrap
msgid ""
"component arraydemo \"4-bit Shift register\";\n"
"pin in bit in;\n"
"pin out bit out-# [4];\n"
"option period no;\n"
"function _ nofp;\n"
"license \"GPL\"; // indicates GPL v2 or later\n"
";;\n"
"int i;\n"
"for(i=3; i>0; i--) out(i) = out(i-1);\n"
"out(0) = in;\n"
msgstr ""

#. type: Title ===
#: src/hal/comp.adoc:645
#, no-wrap
msgid "rand"
msgstr "რენდი"

#. type: Plain text
#: src/hal/comp.adoc:648
msgid ""
"This non-realtime component changes the value on its output pin to a new "
"random value in the range (0,1) about once every 1&#8239;ms."
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:653
#, no-wrap
msgid ""
"component rand;\n"
"option userspace;\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:658
#, no-wrap
msgid ""
"pin out float out;\n"
"license \"GPL\"; // indicates GPL v2 or later\n"
";;\n"
"#include <unistd.h>\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:665
#, no-wrap
msgid ""
"void user_mainloop(void) {\n"
"    while(1) {\n"
"        usleep(1000);\n"
"        FOR_ALL_INSTS() out = drand48();\n"
"    }\n"
"}\n"
msgstr ""

#. type: Title ===
#: src/hal/comp.adoc:667
#, no-wrap
msgid "logic (using personality)"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:670
msgid ""
"This realtime component shows how to use \"personality\" to create variable-"
"size arrays and optional pins."
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:704
#, no-wrap
msgid ""
"component logic \"LinuxCNC HAL component providing experimental logic functions\";\n"
"pin in bit in-##[16 : personality & 0xff];\n"
"pin out bit and if personality & 0x100;\n"
"pin out bit or if personality & 0x200;\n"
"pin out bit xor if personality & 0x400;\n"
"option period no;\n"
"function _ nofp;\n"
"description \"\"\"\n"
"Experimental general 'logic function' component.  Can perform 'and', 'or'\n"
"and 'xor' of up to 16 inputs.  Determine the proper value for 'personality'\n"
"by adding:\n"
".IP \\\\(bu 4\n"
"The number of input pins, usually from 2 to 16\n"
".IP \\\\(bu\n"
"256 (0x100)  if the 'and' output is desired\n"
".IP \\\\(bu\n"
"512 (0x200)  if the 'or' output is desired\n"
".IP \\\\(bu\n"
"1024 (0x400)  if the 'xor' (exclusive or) output is desired\"\"\";\n"
"license \"GPL\"; // indicates GPL v2 or later\n"
";;\n"
"FUNCTION(_) {\n"
"    int i, a=1, o=0, x=0;\n"
"    for(i=0; i < (personality & 0xff); i++) {\n"
"        if(in(i)) { o = 1; x = !x; }\n"
"        else { a = 0; }\n"
"    }\n"
"    if(personality & 0x100) and = a;\n"
"    if(personality & 0x200) or = o;\n"
"    if(personality & 0x400) xor = x;\n"
"}\n"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:707
msgid "A typical load line for this component might be"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:711
#, no-wrap
msgid "loadrt logic count=3 personality=0x102,0x305,0x503\n"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:714
msgid "which creates the following pins:"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:716
msgid "A 2-input AND gate: `logic.0.and`, `logic.0.in-00`, `logic.0.in-01`"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:717
msgid ""
"5-input AND and OR gates: `logic.1.and`, `logic.1.or`, `logic.1.in-00`, "
"`logic.1.in-01`, `logic.1.in-02`, `logic.1.in-03`, `logic.1.in-04`,"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:718
msgid ""
"3-input AND and XOR gates: `logic.2.and`, `logic.2.xor`, `logic.2.in-00`, "
"`logic.2.in-01`, `logic.2.in-02`"
msgstr ""

#. type: Title ===
#: src/hal/comp.adoc:719
#, no-wrap
msgid "General Functions"
msgstr ""

#. type: Plain text
#: src/hal/comp.adoc:723
msgid ""
"This example shows how to call functions from the main function.  It also "
"shows how to pass reference of HAL pins to those functions."
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:730
#, no-wrap
msgid ""
"component example;\n"
"pin in s32 in;\n"
"pin out bit out1;\n"
"pin out bit out2;\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:735
#, no-wrap
msgid ""
"option period no;\n"
"function _;\n"
"license \"GPL\";\n"
";;\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:740
#, no-wrap
msgid ""
"// general pin set true function\n"
"void set(hal_bit_t *p){\n"
"    *p = 1;\n"
"}\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:745
#, no-wrap
msgid ""
"// general pin set false function\n"
"void unset(hal_bit_t *p){\n"
"    *p = 0;\n"
"}\n"
msgstr ""

#. type: delimited block -
#: src/hal/comp.adoc:759
#, no-wrap
msgid ""
"//main function\n"
"FUNCTION(_) {\n"
"    if (in < 0){\n"
"        set(&out1);\n"
"        unset(&out2);\n"
"    }else if (in >0){\n"
"        unset(&out2);\n"
"        set(&out2);\n"
"    }else{\n"
"        unset(&out1);\n"
"        unset(&out2);\n"
"    }\n"
"}\n"
msgstr ""

