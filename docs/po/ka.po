msgid "halcompile --install src/hal/drivers/mesa_pktgyro_test\\&.comp\n"
msgstr ""

#. type: Plain text
#: man/man9/mesa_pktgyro_test.9:66
msgid ""
"The component exports only one function, namely receive, which needs to be "
"added to a realtime thread\\&. To test this component set DEBUG=5 before and "
"execute this HAL script:"
msgstr ""

#. type: Plain text
#: man/man9/mesa_pktgyro_test.9:77
#, no-wrap
msgid ""
"loadrt hostmot2\n"
"loadrt hm2_pci\n"
"loadrt mesa_pktgyro_test names=hm2_5i25\\&.0\\&.pktuart\\&.0\n"
"loadrt threads name1=test1 period1=10000000\n"
"addf hm2_5i25\\&.0\\&.pktuart\\&.0\\&.receive test1\n"
"start\n"
msgstr ""

