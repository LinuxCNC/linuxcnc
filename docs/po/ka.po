msgstr ""

#. type: Plain text
#: man/man9/bldc.9:235
msgid "B<bldc>\\&.I<N>\\&.B<C8> bit in [if ( personality & 0x10 )]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:237
