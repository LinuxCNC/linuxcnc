#. type: Title ===
#: src/man/man1/halui.1.adoc:184
#, no-wrap
msgid "Max-velocity"
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:186
#, no-wrap
msgid "*halui.max-velocity.count-enable* bit in (default: *TRUE*)"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:188
msgid "When True, modify max velocity when halui.max-velocity.counts changes."
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:188
#, no-wrap
msgid "*halui.max-velocity.counts* s32 in"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:193
msgid ""
"When .count-enable is True, halui changes the max velocity in response to "
"changes to this pin. It's usually connected to an MPG encoder on an "
"operator's panel or jog pendant. When .count-enable is False, halui ignores "
"this pin."
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:193
#, no-wrap
msgid "*halui.max-velocity.direct-value* bit in"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:198
msgid ""
"When this pin is True, halui commands the max velocity directly to (.counts "
"* .scale). When this pin is False, halui commands the max velocity in a "
"relative way: change max velocity by an amount equal to (change in .counts "
"* .scale)."
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:198
#, no-wrap
msgid "*halui.max-velocity.increase* bit in"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:202
msgid ""
"A positive edge (a False to True transition) on this pin increases the max "
"velocity by the value of the .scale pin. (Note that halui always responds to "
"this pin, independent of the .count-enable pin.)"
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:202
#, no-wrap
msgid "*halui.max-velocity.decrease* bit in"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:206
msgid ""
"A positive edge (a False to True transition) on this pin decreases the max "
"velocity by the value of the .scale pin. (Note that halui always responds to "
"this pin, independent of the .count-enable pin.)"
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:206
#, no-wrap
msgid "*halui.max-velocity.scale* float in"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:211
msgid ""
"This pin controls the scale of changes to the max velocity. Each unit change "
"in .counts, and each positive edge on .increase and .decrease, changes the "
"max velocity by .scale. The units of the .scale pin are machine-units per "
"second."
msgstr ""

#. type: Labeled list
#: src/man/man1/halui.1.adoc:211
#, no-wrap
msgid "*halui.max-velocity.value* float out"
msgstr ""

#. type: Plain text
#: src/man/man1/halui.1.adoc:213
msgid "Current value for maximum velocity, in machine-units per second."
msgstr ""

#. type: Labeled list
