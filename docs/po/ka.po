msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4355
#, no-wrap
msgid ""
"`M62 P2` (synchronized with motion) +\n"
"`M64 P2` (immediate)"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4355
#, no-wrap
msgid "Enable <<plasma:thc,THC>>"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4357
#, no-wrap
msgid ""
"`M63 P2` (synchronized with motion) +\n"
"`M65 P2` (immediate)"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4357
#, no-wrap
msgid "Disable <<plasma:overcut,Torch>>"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4359
#, no-wrap
msgid ""
"`M62 P3` (synchronized with motion) +\n"
"`M64 P3` (immediate)"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4359
#, no-wrap
msgid "Enable <<plasma:overcut,Torch>>"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4361
#, no-wrap
msgid ""
"`M63 P3` (synchronized with motion) +\n"
"`M65 P3` (immediate)"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4361
#, no-wrap
msgid "Set <<plasma:velocity_thc,velocity>> to a percentage of feed rate."
