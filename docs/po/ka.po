msgid ""
"to the directory specified as `SUBROUTINE_PATH`, see "
"<<gmocappy:rs274ngc,RS274NGC Section>>."
msgstr ""

#. type: Plain text
#: src/gui/gmoccapy.adoc:1063
msgid ""
"Open `change.ngc` with a editor and uncomment the following lines (49 and "
"50):"
msgstr ""

#. type: delimited block -
