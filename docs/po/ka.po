msgid "EMC_DEBUG_OWORD"
msgstr ""

#. type: Table
#: src/remap/remap.adoc:1715
#, no-wrap
msgid "traces execution of O-word subroutines"
msgstr ""

#. type: Table
#: src/remap/remap.adoc:1715
#, no-wrap
