msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:35
msgid "B<loadrt bin2gray> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:38
msgid "Converts a number into gray-code"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:41
msgid "B<bin2gray>\\&.I<N>"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:46
msgid "B<bin2gray>\\&.I<N>\\&.B<in> u32 in"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:48
msgid "binary code in"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:51
msgid "B<bin2gray>\\&.I<N>\\&.B<out> u32 out"
msgstr ""

#. type: Plain text
#: man/man9/bin2gray.9:53
msgid "gray code out"
msgstr ""

#. type: TH
#: man/man9/biquad.9:10
#, no-wrap
msgid "BIQUAD"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:32
msgid "biquad - Biquad IIR filter"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:35
msgid "B<loadrt biquad> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:38
msgid ""
"Biquad IIR filter\\&. Implements the following transfer function: H(z) = (n0 "
"+ n1z-1 + n2z-2) / (1 + d1z-1 + d2z-2)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:41
msgid "B<biquad>\\&.I<N> (requires a floating-point thread)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:46
msgid "B<biquad>\\&.I<N>\\&.B<in> float in"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:48
msgid "Filter input\\&."
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:51
msgid "B<biquad>\\&.I<N>\\&.B<out> float out"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:53
msgid "Filter output\\&."
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:56
msgid "B<biquad>\\&.I<N>\\&.B<enable> bit in (default: I<0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:66
msgid ""
"Filter enable\\&. When false, the B<in> pin is passed to the B<out> pin "
"without any filtering\\&. A B<transition from false to true> causes filter "
"coefficients to be calculated according to the current B<type> and the "
"describing pin and parameter settings"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:69
msgid "B<biquad>\\&.I<N>\\&.B<valid> bit out (default: I<0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:72
msgid ""
"When false, indicates an error occurred when calculating filter coefficients "
"(require 2E<gt>B<Q>E<gt>0\\&.5 and B<f0>E<gt>sampleRate/2)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:75
msgid "B<biquad>\\&.I<N>\\&.B<type-> u32 in (default: I<0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:83
msgid ""
"Filter type determines the type of filter coefficients calculated\\&. When "
"0, coefficients must be loaded directly from the B<n0,n1,n2,d1> params\\&. "
"When 1, a low pass filter is created specified by the B<f0,Q> pins\\&. When "
"2, a notch filter is created specified by the B<f0,Q> pins\\&."
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:86
msgid "B<biquad>\\&.I<N>\\&.B<f0> float in (default: I<250\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:88
msgid "The corner frequency of the filter\\&."
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:91
msgid "B<biquad>\\&.I<N>\\&.B<Q> float in (default: I<0\\&.7071>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:93
msgid "The Q of the filter\\&."
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:96
msgid "B<biquad>\\&.I<N>\\&.B<s1> float out (default: I<0\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:98
msgid "1st-delayed internal state (for debug only)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:101
msgid "B<biquad>\\&.I<N>\\&.B<s2> float out (default: I<0\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:103
msgid "2nd-delayed internal state (for debug only)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:107
msgid "B<biquad>\\&.I<N>\\&.B<d1> float rw (default: I<0\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:109
msgid "1st-delayed denominator coef"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:112
msgid "B<biquad>\\&.I<N>\\&.B<d2> float rw (default: I<0\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:114
msgid "2nd-delayed denominator coef"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:117
msgid "B<biquad>\\&.I<N>\\&.B<n0> float rw (default: I<1\\&.0>)"
msgstr ""

#. type: Plain text
#: man/man9/biquad.9:119
msgid "non-delayed numerator coef"
msgstr ""

