#. type: Plain text
#: src/gui/gmoccapy.adoc:1278
msgid "material"
msgstr ""

#. type: Plain text
#: src/gui/gmoccapy.adoc:1279
msgid "material light"
msgstr ""

#. type: Plain text
#: src/gui/gmoccapy.adoc:1281
msgid ""
"To create custom icon themes, see section <<gmoccapy:icon-theme-section,Icon "
"Theme>> for details."
