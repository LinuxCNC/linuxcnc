"This string will be added to 'MDI_COMMAND_' to form an entry to look for\n"
"in the INI file, under the heading `[MDI_COMMAND_LIST]`.\n"
"Commands separated by the `;` will be run one after another\n"
"The button label text can be set with any text after a comma, the `\\n` symbol adds a line break."
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:655
#, no-wrap
msgid ""
"[MDI_COMMAND_LIST]\n"
"MDI_COMMAND_MACRO0 = G0 Z25;X0 Y0;Z0, Goto\\nUser\\nZero\n"
"MDI_COMMAND_MACRO1 = G53 G0 Z0;G53 G0 X0 Y0, Goto\\nMachn\\nZero\n"
