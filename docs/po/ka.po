#, no-wrap
msgid "**joint.**_N_**.f-errored** OUT BIT *(DEBUG)*"
msgstr ""

#. type: Plain text
#: src/man/man9/motion.9.adoc:348
msgid "TRUE when this joint has exceeded the following error limit."
msgstr ""

#. type: Labeled list
#: src/man/man9/motion.9.adoc:348
#, no-wrap
msgid "**joint.**_N_**.faulted** OUT BIT *(DEBUG)*"
msgstr ""

#. type: Labeled list
#: src/man/man9/motion.9.adoc:349
#, no-wrap
msgid "**joint.**_N_**.free-pos-cmd** OUT FLOAT *(DEBUG)*"
msgstr ""

#. type: Plain text
#: src/man/man9/motion.9.adoc:351
msgid "The \"free planner\" commanded position for this joint."
msgstr ""

#. type: Labeled list
#: src/man/man9/motion.9.adoc:351
#, no-wrap
