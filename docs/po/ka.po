msgstr "ცვლადები"

#. type: Plain text
#: src/config/ini-config.adoc:90
msgid ""
"A variable line is made up of a variable name, an equals sign (`=`), and a "
"value.  Everything from the first non-white space character after the `=` up "
"to the end of the line is passed as the value, so you can embed spaces in "
"string symbols if you want to or need to.  A variable name is often called a "
"keyword."
msgstr ""

#. type: Block title
#: src/config/ini-config.adoc:91
#, no-wrap
msgid "Variable Example"
msgstr ""

#. type: delimited block -
#: src/config/ini-config.adoc:95
#, no-wrap
msgid "MACHINE = My Machine\n"
msgstr ""

#. type: Plain text
#: src/config/ini-config.adoc:100
msgid ""
"A variable line may be extended to multiple lines with a terminal backslash "
"(\\) character.  A maximum of `MAX_EXTEND_LINES` (==20) are allowed.  There "
"must be no whitespace following the trailing backslash character."
msgstr ""

#. type: Plain text
#: src/config/ini-config.adoc:102
msgid "Section identifiers may not be extended to multiple lines."
msgstr ""

#. type: Block title
#: src/config/ini-config.adoc:103
#, no-wrap
msgid "Variable with Line extends Example"
msgstr ""

#. type: delimited block -
#: src/config/ini-config.adoc:113
#, no-wrap
msgid ""
"APP = sim_pin \\\n"
"ini.0.max_acceleration \\\n"
"ini.1.max_acceleration \\\n"
"ini.2.max_acceleration \\\n"
"ini.0.max_velocity \\\n"
"ini.1.max_velocity \\\n"
"ini.2.max_velocity\n"
msgstr ""

#. type: Block title
#: src/config/ini-config.adoc:115
#, no-wrap
