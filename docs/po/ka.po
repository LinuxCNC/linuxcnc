"This widget is combobox that will allows selection of a pin or signal on the "
"system. +"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3342
#, no-wrap
msgid "from qtvcp.widgets.hal_selectionbox import HALSelectionBox\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3351
#, no-wrap
msgid ""
"    def buildComboBox(self):\n"
"        # combo box for HAL pin selection\n"
"        combobox = HALSelectionBox()\n"
"        combobox.setShowTypes([combobox.PINS,combobox.SIGNALS])\n"
"        combobox.setPinTypes([combobox.HAL_BIT], direction = [combobox.HAL_IN])\n"
"        combobox.setSignalTypes([combobox.HAL_BIT], driven = [False,True])\n"
"        combobox.hal_init()\n"
"        combobox.selectionUpdated.connect(lambda w: self.signalSelected(w))\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3354
#, no-wrap
msgid ""
"    def signalSelected(self, sig):\n"
"        print('Watching:',sig)\n"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:3358
msgid "There are function calls"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3363
#, no-wrap
msgid ""
"# set the list of types to show from: PINS SIGNALS\n"
"combobox.setShowTypes([combobox.PINS])\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3367
#, no-wrap
msgid ""
"# set the pin types to show: HAL_BIT,HAL_FLOAT,HAL_S32,HAL_U32\n"
"# and a list of directions: HAL_IN HAL_OUT\n"
"combobox.setPinTypes(types=[combobox.HAL_BIT], direction = [HAL_IN])\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-widgets.adoc:3371
#, no-wrap
msgid ""
"# set the signal types to show: HAL_BIT,HAL_FLOAT,HAL_S32,HAL_U32\n"
"# and a list of driven/undriven (by a connected pin) to show\n"
"combobox.setSignalTypes( types=[combobox.HAL_BIT], driven = [True,True])\n"
msgstr ""

