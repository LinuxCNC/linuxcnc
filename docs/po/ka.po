#. type: Table
#: src/plasma/qtplasmac.adoc:4345
#, no-wrap
msgid ""
"`M190 P`__n__ +\n"
"_n_ denotes the material number."
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4345
#, no-wrap
msgid "Wait for <<plasma:material-handling,material>> change confirmation."
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4348
#, no-wrap
msgid ""
"`M66 PG L3 Q`__n __+\n"
"_n_ is delay time (in seconds).\n"
"This value may need to be increased for very large material files."
