#: man/man9/bldc.9:202
msgid "Hall sensor signal 1"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:205
msgid "B<bldc>\\&.I<N>\\&.B<hall2> bit in [if personality & 0x01]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:207
msgid "Hall sensor signal 2"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:210
msgid "B<bldc>\\&.I<N>\\&.B<hall3> bit in [if personality & 0x01]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:212
msgid "Hall sensor signal 3"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:215
msgid "B<bldc>\\&.I<N>\\&.B<hall-error> bit out [if personality & 0x01]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:217
msgid ""
"Indicates that the selected hall pattern gives inconsistent rotor position "
"data\\&. This can be due to the pattern being wrong for the motor, or one or "
"more sensors being unconnected or broken\\&. A consistent pattern is not "
"neceesarily valid, but an inconsistent one can never be valid\\&."
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:220
msgid "B<bldc>\\&.I<N>\\&.B<C1> bit in [if ( personality & 0x10 )]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:222
msgid "Fanuc Gray-code bit 0 input"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:225
msgid "B<bldc>\\&.I<N>\\&.B<C2> bit in [if ( personality & 0x10 )]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:227
msgid "Fanuc Gray-code bit 1 input"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:230
msgid "B<bldc>\\&.I<N>\\&.B<C4> bit in [if ( personality & 0x10 )]"
msgstr ""

#. type: Plain text
#: man/man9/bldc.9:232
