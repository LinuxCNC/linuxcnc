#. type: delimited block -
#: src/motion/kinematics.adoc:331
#, no-wrap
msgid ""
"int kinematicsHome(EmcPose *world, double *joint,\n"
"KINEMATICS_FORWARD_FLAGS *fflags,\n"
"KINEMATICS_INVERSE_FLAGS *iflags)\n"
