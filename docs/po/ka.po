#, no-wrap
msgid "*`styleCodeHighlight`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:1711
msgid "Current in-use user system highlight color."
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:1713 src/gui/qtvcp-widgets.adoc:2244
msgid "These can be set in:"
