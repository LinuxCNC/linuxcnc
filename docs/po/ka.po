msgid ""
"Implements the <<sec:Forward-transformation,forward kinematics function>>."
msgstr ""

#. type: delimited block -
#: src/motion/kinematics.adoc:290
#, no-wrap
msgid ""
"int kinematicsInverse(const EmcPose * world, double *joints,\n"
"const KINEMATICS_INVERSE_FLAGS *iflags,\n"
"KINEMATICS_FORWARD_FLAGS *fflags)\n"
msgstr ""

#. type: Plain text
#: src/motion/kinematics.adoc:293
msgid "Implements the inverse kinematics function."
msgstr ""

#. type: delimited block -
#: src/motion/kinematics.adoc:296
