msgid "B<invert>\\&.I<N>\\&.B<deadband> float rw"
msgstr ""

#. type: Plain text
#: man/man9/invert.9:61
msgid ""
"The B<out> will be zero if B<in> is between -B<deadband> and +B<deadband>\\&."
msgstr ""

