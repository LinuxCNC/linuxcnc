#. type: Table
#: src/plasma/qtplasmac.adoc:4338
#, no-wrap
msgid "Begin <<plasma:scribe,scribe>>"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4339
#, no-wrap
msgid "M3 $1 S1"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:4339
#, no-wrap
msgid "End <<plasma:scribe,scribe>>"
