msgstr ""

#. type: Target for macro image
#: src/gui/qtvcp-widgets.adoc:389
#, no-wrap
msgid "images/qtvcp_ledWidget.png"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:392
msgid "A *LED like indicator* that optionally follows a HAL pin's logic."
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:395
msgid "Selects if the LED follows an input HAL pin or program state."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:395 src/gui/qtvcp-widgets.adoc:2312
#, no-wrap
msgid "*`diameter`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:397
msgid "Diameter of the LED (defaults to 15)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:397 src/gui/qtvcp-widgets.adoc:2314
#, no-wrap
msgid "*`color`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:399
msgid "Color of the LED when on (defaults to green)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:399 src/gui/qtvcp-widgets.adoc:2316
#: src/gui/qtvcp-widgets.adoc:3061
#, no-wrap
msgid "*`off_color`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:401
msgid "Color of the LED when off (defaults to black)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:401
#, no-wrap
msgid "*`gradient`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:403
msgid "turns the gradient high light on or off (defaults to on)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:403
#, no-wrap
msgid "*`on_gradient_color`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:405
msgid "Color highlight of the LED when on (defaults to white)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:405
#, no-wrap
msgid "*`off_gradient_color`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:407
msgid "Color highlight of the LED when off (defaults to white)."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:407 src/gui/qtvcp-widgets.adoc:2318
#, no-wrap
msgid "*`alignment`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:409
msgid "Qt alignment hint."
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:409 src/gui/qtvcp-widgets.adoc:2320
#, no-wrap
msgid "*`state`*"
msgstr ""

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:411
msgid "Current state of LED"
msgstr ""

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:411 src/gui/qtvcp-widgets.adoc:2322
#, no-wrap
msgid "*`flashing`*"
