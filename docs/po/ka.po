msgstr ""

#. type: Plain text
#: INSTALL.adoc:112
msgid ""
"Use and save the results of the tests in FILE instead of `./config.cache`.  "
"Set FILE to `/dev/null` to disable caching, for debugging `configure`."
msgstr ""

#. type: Labeled list
#: INSTALL.adoc:113
#, no-wrap
msgid "`--help`"
msgstr ""

#. type: Plain text
#: INSTALL.adoc:115
msgid "Print a summary of the options to `configure`, and exit."
msgstr ""

#. type: Labeled list
#: INSTALL.adoc:116
#, no-wrap
msgid "`--quiet` | `--silent` | `-q`"
msgstr ""

#. type: Plain text
#: INSTALL.adoc:120
