#, no-wrap
msgid "`xhc-whb04b-6 -p`"
msgstr ""

#. type: Plain text
#: src/man/man1/xhc-whb04b-6.1.adoc:89
msgid ""
"Start in simulation mode and prints HAL pin names and events distributed to "
"HAL memory."
msgstr ""

#. type: Labeled list
#: src/man/man1/xhc-whb04b-6.1.adoc:89
#, no-wrap
msgid "`xhc-whb04b-6 -H`"
msgstr ""

#. type: Plain text
#: src/man/man1/xhc-whb04b-6.1.adoc:91
msgid "Start in HAL mode (Normal mode for real machine use)."
msgstr ""

#. type: Labeled list
#: src/man/man1/xhc-whb04b-6.1.adoc:91
#, no-wrap
msgid "`xhc-whb04b-6 -HsfB`"
