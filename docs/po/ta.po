" <அளவு> 200 </size>\n"
" <cpr> 100 </spr>\n"
" <min _>-15 </sim_>\n"
" <xax_> 15 </max_>\n"
" <உரை> \"டயல்\" </text>\n"
" <InitVal> 0 </initval>\n"
