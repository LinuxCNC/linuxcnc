msgstr "நானோ-விநாடிகளில் படி துடிப்பின் நீளம்."

#. type: Table
#: src/drivers/gm.adoc:301
#, no-wrap
msgid ".stepspace"
msgstr ".ச்டெப்ச்பேச்"

#. type: Table
#: src/drivers/gm.adoc:302
#, no-wrap
