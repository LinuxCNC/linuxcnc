#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:19
#, no-wrap
msgid "*-h, --help*"
msgstr "*-h,-உதவி*"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:21
msgid "Show this help message and exit."
msgstr "இந்த உதவி செய்தியைக் காட்டி வெளியேறவும்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:21
#, no-wrap
msgid "*-c* [_<NAME>_]"
msgstr "* -c* [_ <பெயர்> _]"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:23
msgid "Set component name to NAME. Default is basename of UI file."
msgstr ""
"கூறு பெயரை பெயருக்கு அமைக்கவும். இயல்புநிலை என்பது இடைமுகம் கோப்பின் அடிப்படை பெயர்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:23
#, no-wrap
msgid "*-a*"
msgstr "*-a*"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:25
msgid "Set the window to always be on top."
msgstr "சாளரத்தை எப்போதும் மேலே வைக்க அமைக்கவும்."

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:27
msgid "Enable debug output."
msgstr "பிழைத்திருத்த வெளியீட்டை இயக்கவும்."

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:29
msgid "Enable verbose debug output."
msgstr "வாய்மொழி பிழைத்திருத்த வெளியீட்டை இயக்கவும்."

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:31
msgid "Enable only error debug output."
msgstr "பிழை பிழைத்திருத்த வெளியீட்டை மட்டுமே இயக்கவும்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:31
#, no-wrap
msgid "*-g* [_<GEOMETRY>_]"
msgstr "* -g* [_ <வடிவியல்> _]"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:37
msgid ""
"Set geometry WIDTHxHEIGHT+XOFFSET+YOFFSET.  Values are in pixel units, "
"XOFFSET/YOFFSET is referenced from top left of screen.  Use -g WIDTHxHEIGHT "
"for just setting size or -g +XOFFSET+YOFFSET for just position.  + Example: "
"`-g 200x400+0+100`"
msgstr ""
"வடிவவியலை அமைக்கவும் withthxheight+xoffset+yoffset. மதிப்புகள் படப்புள்ளி அலகுகளில் "
"உள்ளன, XOFFSET/YOFFSET திரையின் மேல் இடதுபுறத்தில் இருந்து குறிப்பிடப்படுகிறது. "
"வெறும் அளவை அமைப்பதற்கு -g widthxheight அல்லது -g +Xoffset +yoffset க்கு நியாயமான "
"நிலைக்கு பயன்படுத்தவும். +எடுத்துக்காட்டு: `-g 200x400+0+100`"

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:37
#, no-wrap
msgid "*-H* [_<FILE>_]"
msgstr "* -H* [_ <file> _]"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:39
msgid ""
"Execute HAL statements from _FILE_ with halcmd after the component is set up "
"and ready."
msgstr ""
"கூறு அமைக்கப்பட்டு தயாராக இருந்தபின் HALCMD உடன் _File_ இலிருந்து HAL அறிக்கைகளை "
"இயக்கவும்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:39
#, no-wrap
msgid "*-i*"
msgstr "*-i*"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:41
msgid "Enable info output."
msgstr "செய்தி வெளியீட்டை இயக்கவும்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:41
#, no-wrap
msgid "*-m*"
msgstr "*-m*"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:43
msgid "Force panel window to maximize."
msgstr "அதிகரிக்க பேனல் சாளரத்தை கட்டாயப்படுத்துங்கள்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:43
#, no-wrap
msgid "*-f*"
msgstr "*-f*"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:45
msgid "Force panel window to fullscreen."
msgstr "முழு திரைக்கு குழு சாளரத்தை கட்டாயப்படுத்துங்கள்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:45
#, no-wrap
msgid "*-t* [_<THEME>_]"
msgstr "* -t* [_ <தீம்> _]"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:47
msgid "Set Qt style. Default is system theme."
msgstr "கியுடி பாணியை அமைக்கவும். இயல்புநிலை என்பது கணினி கருப்பொருள்."

#. type: Labeled list
#: src/man/man1/qtvcp.1.adoc:47
#, no-wrap
msgid "*-x* [_<XID>_]"
msgstr "* -x* [_ <xid> _]"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:49
msgid ""
"Reparent QtVCP into an existing window XID instead of creating a new top "
"level window."
msgstr ""
"புதிய உயர்மட்ட சாளரத்தை உருவாக்குவதற்கு பதிலாக ஏற்கனவே இருக்கும் சாளர XID க்குள் மீண்டும் "
