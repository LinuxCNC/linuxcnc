msgstr "'Ngcgui_subfile = \"\"' - தனிப்பயன் தாவலை உருவாக்குகிறது"

#. type: Plain text
#: src/gui/ngcgui.adoc:322
msgid "'#NGCGUI_OPTIONS = opt1 opt2 ...' - NGCGUI options:"
msgstr "'#Ngcgui_options = opt1 opt2 ...' - ngcgui விருப்பங்கள்:"

#. type: Plain text
#: src/gui/ngcgui.adoc:323
#, fuzzy
#| msgid "'nonew'    -- Prohibits creation of new custom tab\n"
