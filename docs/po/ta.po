msgstr "படம்: படங்கள்/கருவி_ரெலோட்."

#. type: Plain text
#: src/gui/axis.adoc:291
msgid ""
"image:images/tool_run.png[\"Begin executing the current file\"] Begin "
"executing the current file [R]"
msgstr "படம்: படங்கள்/கருவி_ரூன்."

#. type: Plain text
#: src/gui/axis.adoc:292
msgid "image:images/tool_step.png[\"Execute next line\"] Execute next line [T]"
msgstr ""
"படம்: படங்கள்/tool_step.png [\"அடுத்த வரியை இயக்கவும்\"] அடுத்த வரியை இயக்கவும் [t]"

#. type: Plain text
#: src/gui/axis.adoc:293
msgid ""
"image:images/tool_pause.png[\"Pause Execution - Resume Execution\"] Pause "
