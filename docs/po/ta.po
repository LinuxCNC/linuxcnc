"# ஃச் PYVCP பொத்தான்களை இணைக்கவும்\n"
" நிகர my-jogxminus halui.axis.x.minus <= pyvcp.x-minus\n"
" வலைமம் my-jogxplus halui.axis.x.plus <= pyvcp.x-plus\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:186
#, no-wrap
msgid ""
"# connect the Y PyVCP buttons\n"
"net my-jogyminus halui.axis.y.minus <= pyvcp.y-minus\n"
"net my-jogyplus halui.axis.y.plus <= pyvcp.y-plus\n"
msgstr ""
"# ஒய் PYVCP பொத்தான்களை இணைக்கவும்\n"
" வலைமம் my-jogyminus halui.axis.y.minus <= pyvcp.y-minus\n"
" வலைமம் my-jogyplus halui.axis.y.plus <= pyvcp.y-plus\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:190
#, no-wrap
