#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:514
#, no-wrap
msgid ""
"import sys\n"
"import os\n"
"import importlib\n"
"from PyQt5.QtCore import Qt\n"
"from qtvcp.core import Path\n"
msgstr ""
"இறக்குமதி sys\n"
" இறக்குமதி os\n"
" இறக்குமதி இறக்குமதி\n"
" Pyqt5.qtcore இறக்குமதி கியுடி இலிருந்து\n"
" Qtvcp.core இறக்குமதி பாதையிலிருந்து\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:525
#, no-wrap
msgid ""
"# get reference to original handler file so we can subclass it\n"
"sys.path.insert(0, PATH.PANELDIR)\n"
"panel = os.path.splitext(os.path.basename(os.path.basename(__file__)))[0]\n"
"base = panel.replace('_handler','')\n"
"module = \"{}.{}\".format(base,panel)\n"
"mod = importlib.import_module(module, PATH.PANELDIR)\n"
"sys.path.remove(PATH.PANELDIR)\n"
"HandlerClass = mod.HandlerClass\n"
msgstr ""
"# அசல் ஏண்ட்லர் கோப்பைப் பற்றிய குறிப்பைப் பெறுங்கள், எனவே அதை துணைக்குழு செய்யலாம்\n"
" sys.path.insert (0, path.paneldir)\n"
" baned = os.path.splitext (os.path.basename (os.path.basename (__ கோப்பு __))) [0]\n"
" காரம் = panel.replace ('_ கையாளுபவர்', '')\n"
" தொகுதி = \"{}. {}\". வடிவம் (அடிப்படை, குழு)\n"
" மோட் = importlib.import_module (தொகுதி, பாதை.பனெல்டிர்)\n"
" sys.path.remove (path.paneldir)\n"
" ஏண்ட்லர் கிளாச் = மோட்.ஆன்ட்லர் கிளாச்\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:529
#, no-wrap
msgid ""
"# return our subclassed handler object to Qtvcp\n"
"def get_handlers(halcomp, widgets, paths):\n"
"    return [UserHandlerClass(halcomp, widgets, paths)]\n"
msgstr ""
"# எங்கள் துணைப்பிரிவு கையாளுதல் பொருளை QTVCP க்கு திருப்பி விடுங்கள்\n"
" DEF GET_HANDLERS (ஆல்காம்ப், விட்செட்டுகள், பாதைகள்):\n"
" திரும்ப [பயனர்ஆன்ட்லர் கிளாச் (ஆல்காம்ப், விட்செட்டுகள், பாதைகள்)]]\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:533
#, fuzzy, no-wrap
msgid ""
"# subclassed from HandlerClass which was imported above\n"
"class UserHandlerClass(HandlerClass):\n"
"    print('Custom subclassed panel handler loaded\\n')\n"
msgstr ""
"# மேலே இறக்குமதி செய்யப்பட்ட ஏண்ட்லர் கிளாசிலிருந்து துணைப்பிரிவு\n"
" வகுப்பு USERHANDLERCLASS (ஏண்ட்லர் கிளாச்):\n"
" அச்சு ('தனிப்பயன் துணைப்பிரிவு குழு கையாளுபவர் ஏற்றப்பட்டது \\ n')\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:537
#, no-wrap
msgid ""
"    def initialized__(self):\n"
"        # call original handler initialized function\n"
"        super().initialized__()\n"
msgstr ""
"DEF துவக்கப்பட்டது __ (சுய):\n"
" # அசல் ஏண்ட்லர் துவக்கப்பட்ட செயல்பாட்டை அழைக்கவும்\n"
" சூப்பர் (). துவக்கப்பட்ட __ ()\n"

#. type: delimited block -
#: src/gui/qtvcp-vcp-panels.adoc:540
#, no-wrap
msgid ""
"        # add our customization\n"
"        self.w.camview.circle_color = Qt.green\n"
msgstr ""
"# எங்கள் தனிப்பயனாக்கத்தைச் சேர்க்கவும்\n"
" self.w.camview.circle_color = qt.green\n"

