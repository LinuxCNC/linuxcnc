msgid "*qtvcp* [_OPTIONS_] myfile.ui"
msgstr "* qtvcp* [_options_] myfile.ui\n"

#. type: Plain text
#: src/man/man1/qtvcp.1.adoc:14
#, fuzzy
#| msgid "*QtVCP* is a system for creating user interfaces for LinuxCNC.\n"
