"வழங்குகிறது.\n"

#. type: Labeled list
#: src/man/man1/linuxcncrsh.1.adoc:337
#, fuzzy, no-wrap
#| msgid "*joint_pos* [{0|1|...}]"
msgid "*joint_fault [{0|1|...}]*"
msgstr "* கூட்டு_போச்* [{0 | 1 | ...}]"

#. type: Plain text
#: src/man/man1/linuxcncrsh.1.adoc:340
#, fuzzy
#| msgid ""
#| "*joint_fault [{0|1|...}]*\n"
#| "  With get, returns the fault status of the specified joint as \"ok\" or "
