#. type: Title ===
#: src/gui/halui.adoc:104 src/gui/tklinuxcnc.adoc:86
#: src/man/man1/halui.1.adoc:34
#, no-wrap
msgid "Abort"
msgstr "கருக்கலைப்பு"

#. type: Plain text
#: src/gui/halui.adoc:107
msgid ""
"'halui.abort' (bit, in) - pin to send an abort message (clears out most "
"errors)"
msgstr ""
"'halui.abort' (பிட், ஐ.என்) - ஒரு கருக்கலைப்பு செய்தியை அனுப்ப முள் (பெரும்பாலான "
"பிழைகளை அழிக்கிறது)"

#. type: Title ===
#: src/gui/halui.adoc:108
#, no-wrap
msgid "E-Stop"
msgstr "மின்-நிறுத்த"

#. type: Plain text
#: src/gui/halui.adoc:111
msgid "'halui.estop.activate' (bit, in) - pin for requesting E-Stop"
msgstr "'halui.estop.activate' (பிட், IN) - மின் -ச்டாப்பைக் கோருவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:112
msgid "'halui.estop.is-activated' (bit, out) - indicates E-stop reset"
msgstr ""
"'halui.estop.is- செயல்படுத்தப்பட்ட' (பிட், அவுட்)-மின்-ச்டாப் மீட்டமைப்பைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:113
msgid "'halui.estop.reset' (bit, in) - pin for requesting E-Stop reset"
msgstr "'halui.estop.reset' (பிட், ஐ.என்) - மின் -ச்டாப் மீட்டமைப்பைக் கோருவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:117
msgid ""
"'halui.feed-override.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr "'ஆலுய்."

#. type: Plain text
#: src/gui/halui.adoc:118
msgid ""
"'halui.feed-override.counts' (s32, in) - counts * scale = FO percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'hailuo.feed -override.count' (S32, IN) - எண்ணிக்கைகள் * அளவு = சதவீதத்திற்கு. ஒரு "
"குறியாக்கி அல்லது 'நேரடி-மதிப்பு' உடன் பயன்படுத்தலாம்."

#. type: Plain text
#: src/gui/halui.adoc:119
msgid ""
"'halui.feed-override.decrease' (bit, in) - pin for decreasing the FO (-"
"=scale)"
msgstr "'ஆலுய்."

#. type: Plain text
#: src/gui/halui.adoc:120
msgid ""
"'halui.feed-override.increase' (bit, in) - pin for increasing the FO "
"(+=scale)"
msgstr ""
"'halui.feed -override.increase' (பிட், IN) - FO ஐ அதிகரிக்க முள் (+= அளவுகோல்)"

#. type: Plain text
#: src/gui/halui.adoc:121
msgid ""
"'halui.feed-override.reset' (bit, in) - pin for resetting the FO (scale=1.0)"
msgstr "'ஆலுய்."

#. type: Plain text
#: src/gui/halui.adoc:122
msgid ""
"'halui.feed-override.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.feed-override.direct-value' (பிட், IN)-எண்ணிக்கையை மாற்ற குறியாக்கியைப் "
"பயன்படுத்தும் போது பொய், எண்ணிக்கையை நேரடியாக அமைக்கும் போது உண்மை."

#. type: Plain text
#: src/gui/halui.adoc:123
msgid ""
"'halui.feed-override.scale' (float, in) - pin for setting the scale for "
"increase and decrease of 'feed-override'."
msgstr ""
"'halui.feed-override.scale' (மிதவை, IN)-'ஃபீட்-ஓவர்ரைடு' அதிகரிப்பதற்கும் "
"குறைப்பதற்கும் அளவை அமைப்பதற்கான முள்."

#. type: Plain text
#: src/gui/halui.adoc:124
msgid "'halui.feed-override.value' (float, out) - current FO value"
msgstr "'halui.feed -override.value' (மிதவை, அவுட்) - தற்போதைய FO மதிப்பு"

#. type: Title ===
#: src/gui/halui.adoc:125
#, no-wrap
msgid "Mist"
msgstr "மூடுபனி"

#. type: Plain text
#: src/gui/halui.adoc:128
msgid "'halui.mist.is-on' (bit, out) - indicates mist is on"
msgstr "'halui.mist.is -on' (பிட், அவுட்) - மூடுபனி இயக்கத்தில் இருப்பதைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:129
msgid "'halui.mist.off' (bit, in) - pin for requesting mist off"
msgstr "'halui.mist.off' (பிட், ஐ.என்) - மூடுபனி கழிப்பதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:130
msgid "'halui.mist.on' (bit, in) - pin for requesting mist on"
msgstr "'halui.mist.on' (பிட், ஐ.என்) - மூடுபனி கோருவதற்கு முள்"

#. type: Title ===
#: src/gui/halui.adoc:131
#, no-wrap
msgid "Flood"
msgstr "வெள்ளம்"

#. type: Plain text
#: src/gui/halui.adoc:134
msgid "'halui.flood.is-on' (bit, out) - indicates flood is on"
msgstr "'halui.flood.is -on' (பிட், அவுட்) - வெள்ளத்தில் இருப்பதைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:135
msgid "'halui.flood.off' (bit, in) - pin for requesting flood off"
msgstr "'halui.flood.off' (பிட், ஐ.என்) - வெள்ளத்தை கோருவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:136
msgid "'halui.flood.on' (bit, in) - pin for requesting flood on"
msgstr "'halui.flood.on' (பிட், ஐ.என்) - வெள்ளம் கோருவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:141
msgid ""
"'halui.home-all' (bit, in) - pin for requesting all axis to home. This pin "
"will only be there if HOME_SEQUENCE is set in the INI file."
msgstr ""
"'halui.home -all' (பிட், IN) - எல்லா அச்சுகளையும் வீட்டிற்கு கோருவதற்கு முள். ஐ.என்.ஐ "
"கோப்பில் முகப்பு_ வரிசை அமைக்கப்பட்டால் மட்டுமே இந்த முள் இருக்கும்."

#. type: Title ====
#: src/gui/halui.adoc:142 src/man/man1/halui.1.adoc:214
#: src/man/man1/xhc-whb04b-6.1.adoc:150
#, no-wrap
msgid "Machine"
msgstr "இயந்திரம்"

#. type: Plain text
#: src/gui/halui.adoc:146
msgid ""
"'halui.machine.units-per-mm' (float out) - pin for machine units-per-mm "
"(inch:1/25.4, mm:1) according to inifile setting: [TRAJ]LINEAR_UNITS"
msgstr ""
"'halui.machine.units-ber-mm' (மிதவை அவுட்)-இயந்திர அலகுகளுக்கு-ஒரு மிமீ (அங்குல: "
"1/25.4, மிமீ: 1) ஐனிஃபைல் அமைப்பின் படி முள்: [டிராச்] லீனியர்_யூனிட்ச்"

#. type: Plain text
#: src/gui/halui.adoc:147
msgid "'halui.machine.is-on' (bit, out) - indicates machine on"
msgstr "'halui.machine.is -on' (பிட், அவுட்) - இயந்திரத்தைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:148
msgid "'halui.machine.off' (bit, in) - pin for requesting machine off"
msgstr "'halui.machine.off' (பிட், IN) - இயந்திரத்தை முடிக்க முள்"

#. type: Plain text
#: src/gui/halui.adoc:149
msgid "'halui.machine.on' (bit, in) - pin for requesting machine on"
msgstr "'halui.machine.on' (பிட், ஐ.என்) - இயந்திரத்தைக் கோருவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:154
msgid ""
"The maximum linear velocity can be adjusted from 0 to the MAX_VELOCITY that "
"is set in the [TRAJ] section of the INI file."
msgstr ""
"ஐ.என்.ஐ கோப்பின் [டிராச்] பிரிவில் அமைக்கப்பட்டிருக்கும் அதிகபட்ச நேரியல் வேகத்தை 0 முதல் "
"அதிகபட்சம்_வெலோசிட்டி வரை சரிசெய்யலாம்."

#. type: Plain text
#: src/gui/halui.adoc:156
msgid ""
"'halui.max-velocity.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr "'ஆலுய்."

#. type: Plain text
#: src/gui/halui.adoc:157
msgid ""
"'halui.max-velocity.counts' (s32, in) - counts * scale = MV percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'halui.max-veacite.counts' (S32, IN) - எண்ணிக்கைகள் * அளவு = mv விழுக்காடு. ஒரு "
"குறியாக்கி அல்லது 'நேரடி-மதிப்பு' உடன் பயன்படுத்தலாம்."

#. type: Plain text
#: src/gui/halui.adoc:158
msgid ""
"'halui.max-velocity.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.max-vealocity.direct-value' (பிட், IN)-எண்ணிக்கையை மாற்ற குறியாக்கியைப் "
"பயன்படுத்தும் போது பொய், எண்ணிக்கையை நேரடியாக அமைக்கும் போது உண்மை."

#. type: Plain text
#: src/gui/halui.adoc:159
msgid ""
"'halui.max-velocity.decrease' (bit, in) - pin for decreasing max velocity"
msgstr "'halui.max- விரைவு"

#. type: Plain text
#: src/gui/halui.adoc:160
msgid ""
"'halui.max-velocity.increase' (bit, in) - pin for increasing max velocity"
msgstr "'halui.max- விரைவு"

#. type: Plain text
#: src/gui/halui.adoc:161
msgid ""
"'halui.max-velocity.scale' (float, in) - the amount applied to the current "
"maximum velocity with each transition from off to on of the increase or "
"decrease pin in machine units per second."
msgstr "'halui.max- விரைவு."

#. type: Plain text
#: src/gui/halui.adoc:162
msgid ""
"'halui.max-velocity.value' (float, out) - is the maximum linear velocity in "
"machine units per second."
msgstr ""
"'halui.max- விரைவு. மதிப்பு' (மிதவை, அவுட்) - ஒரு நொடிக்கு இயந்திர அலகுகளில் "
"அதிகபட்ச நேரியல் விரைவு."

#. type: Plain text
#: src/gui/halui.adoc:170
#, no-wrap
msgid ""
"'halui.mdi-command-_<nn>_' (bit, in) - halui will try to send the MDI command defined in the INI. _<nn>_ is a two  digit number  starting  at 00.\n"
"If the command succeeds then it will place LinuxCNC in the MDI mode and then back to Manual mode.\n"
"If no [HALUI]MDI_COMMAND variables are set in the  ini  file, no halui.mdi-command-<nn> pins will be exported by halui."
msgstr ""
"'ஆலுய். _ <nn> _ என்பது 00 இல் தொடங்கும் இரண்டு இலக்க எண்.\n"
" கட்டளை செய் பெற்றால், அது லினக்ச் சிஎன்சியை எம்.டி.ஐ பயன்முறையில் வைக்கும், பின்னர் கையேடு பயன்முறைக்கு திரும்பும்.\n"
" ஐ.என்.ஐ கோப்பில் [ஆலுய்] எம்.டி.ஐ_ கமாண்ட் மாறிகள் அமைக்கப்பட்டிருந்தால், ஆலூய்-எம்.டி-கமாண்ட்- <nn> ஊசிகளை அலூய் ஏற்றுமதி செய்யாது."

#. type: Plain text
#: src/gui/halui.adoc:173
msgid ""
"'halui.halui-mdi-is-running' (bit, out) - execution status of MDI commands "
"sent by halui. The status is active even during mode switching.  If no "
"[HALUI]MDI_COMMAND variables are set in the ini file, this pins will not be "
"exported by halui."
msgstr ""
"'halui.halui-mdi-is- ரன்னிங்' (பிட், அவுட்)-அலூய் அனுப்பிய MDI கட்டளைகளின் "
"சாவுஒறுப்பு நிலை. பயன்முறை மாறும்போது கூட நிலை செயலில் உள்ளது. ஐ.என்.ஐ கோப்பில் "
"[ஆலுய்] எம்.டி.ஐ_ கமாண்ட் மாறிகள் அமைக்கப்பட்டிருந்தால், இந்த ஊசிகளை அலூய் ஏற்றுமதி "
"செய்யாது."

#. type: Title ===
#: src/gui/halui.adoc:174 src/man/man1/halui.1.adoc:225
#, no-wrap
msgid "Joint"
msgstr "மூட்டு"

#. type: Plain text
#: src/gui/halui.adoc:178
#, no-wrap
msgid ""
"_N_ = joint number (0 ... num_joints-1)\n"
"Example:"
msgstr ""
"_N_ = கூட்டு எண் (0 ... Num_joints-1)\n"
" எடுத்துக்காட்டு:"

#. type: Plain text
#: src/gui/halui.adoc:180
msgid "'halui.joint._N_.select' (bit in) - pin for selecting joint _N_"
msgstr "'halui.joint._n_.select' (பிட் இன்) - கூட்டு _n_ ஐத் தேர்ந்தெடுப்பதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:181
msgid ""
"'halui.joint._N_.is-selected' (bit out) - status pin that joint _N_ is "
"selected"
msgstr ""
"'halui.joint._n_.is- தேர்ந்தெடுக்கப்பட்ட' (பிட் அவுட்) - கூட்டு _n_ தேர்ந்தெடுக்கப்பட்ட "
"நிலை முள்"

#. type: Plain text
#: src/gui/halui.adoc:182
