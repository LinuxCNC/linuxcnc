msgstr "'புதியது' - புதிய தனிப்பயன் தாவலை உருவாக்குவதைத் தடைசெய்கிறது\n"

#. type: Plain text
#: src/gui/ngcgui.adoc:324
#, fuzzy
#| msgid "'noremove' -- Prohibits deleting a tab page\n"
msgid "'noremove' -- Prohibits deleting a tab page"
msgstr "'நோமோவ்' - ஒரு தாவல் பக்கத்தை நீக்குவதை தடைசெய்கிறது\n"

#. type: Plain text
#: src/gui/ngcgui.adoc:325
#, fuzzy
#| msgid "'noauto'   -- Do not run automatically (makeFile, then manual run)\n"
