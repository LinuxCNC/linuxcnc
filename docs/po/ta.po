" வலைமம் pdnt.axis.z.jog-counts whb.axis.z.jog-counts அச்சு\n"

#. type: delimited block -
#: src/man/man1/xhc-whb04b-6.1.adoc:457
#, no-wrap
msgid ""
"net pdnt.axis.x.jog-enable                whb.axis.x.jog-enable                 axis.x.jog-enable\n"
"net pdnt.axis.y.jog-enable                whb.axis.y.jog-enable                 axis.y.jog-enable\n"
"net pdnt.axis.z.jog-enable                whb.axis.z.jog-enable                 axis.z.jog-enable\n"
