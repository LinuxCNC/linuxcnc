#. type: Labeled list
#: src/man/man9/hostmot2.9.adoc:686 src/man/man9/hostmot2.9.adoc:776
#: src/man/man9/hostmot2.9.adoc:975
#, no-wrap
msgid "enable (bit input)"
msgstr "இயக்கு (பிட் உள்ளீடு)"

#. type: Plain text
#: src/man/man9/hostmot2.9.adoc:689
#, fuzzy
#| msgid ""
#| "If True, the pwmgen will set its Not-Enable pin False and output its\n"
#| "pulses. If \"enable\" is False, pwmgen will set its Not-Enable pin True\n"
