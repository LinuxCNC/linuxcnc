msgid "*Circles:*"
msgstr "*வட்டங்கள்:*\n"

#. type: NOTE
#: src/plasma/qtplasmac.adoc:2623
#, fuzzy
#| msgid "If the circle is external then any leadin or leadout will be an arc."
msgid "If the circle is external then any lead-in or lead-out will be an arc."
msgstr "வட்டம் வெளிப்புறமாக இருந்தால், எந்த லீடின் அல்லது லீட்அவுட்டும் ஒரு வளைவாக இருக்கும்."

