"நகர்த்தப்படாது."

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:551
#, no-wrap
msgid "v.model = Collection([origin, model, world])\n"
msgstr "v.model = சேகரிப்பு ([தோற்றம், மாதிரி, உலகம்])\n"

#. type: Plain text
#: src/gui/qtvcp-vismach.adoc:556
msgid ""
"Start from the cutting tip and work your way back.  Add each collection to "
"the model at the origin and run the script to confirm the location, then "
"rotate/translate and run the script to confirm again."
msgstr ""
"வெட்டும் நுனியில் இருந்து தொடங்கி, உங்கள் வழியைச் செய்யுங்கள். ஒவ்வொரு சேகரிப்பையும் "
"தோற்றத்தில் மாதிரியில் சேர்த்து, இருப்பிடத்தை உறுதிப்படுத்த ச்கிரிப்டை இயக்கவும், பின்னர் "
"மீண்டும் உறுதிப்படுத்தவும்/மொழிபெயர்க்கவும் ச்கிரிப்டை இயக்கவும்."

#. type: Title ==
#: src/gui/qtvcp-vismach.adoc:558
#, no-wrap
msgid "Basic structure of a `QtVismach` script"
msgstr "`Qtvismach` ச்கிரிப்ட்டின் அடிப்படை அமைப்பு"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:565
#, no-wrap
msgid ""
"# imports\n"
"import hal\n"
"from qtvcp.lib.qt_vismach.qt_vismach import *\n"
msgstr ""
"# இறக்குமதி\n"
" ஆல் இறக்குமதி\n"
" qtvcp.lib.qt_vismach.qt_vismach இறக்குமதி *\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:569
#, fuzzy, no-wrap
#| msgid ""
#| "from qtvcp.core import Status\n"
#| "STATUS = Status()\n"
msgid ""
"# import Status for motion type messages\n"
"from qtvcp.core import Status\n"
"STATUS = Status()\n"
msgstr ""
"QTVCP.CORE இறக்குமதி நிலையிலிருந்து\n"
" நிலை = நிலை ()\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:573
#, no-wrap
msgid ""
"# create HAL pins here if needed\n"
"#c = hal.component(\"samplegui\")\n"
"#c.newpin(\"joint0\", hal.HAL_FLOAT, hal.HAL_IN)\n"
msgstr ""
"# தேவைப்பட்டால் இங்கே ஆல் ஊசிகளை உருவாக்கவும்\n"
" #C = hal.comPonent (\"மாதிரி குய்\")\n"
" #சி.நியூபின் (\"கூட்டு 0\", hal.hal_float, hal.hal_in)\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:578
#, no-wrap
msgid ""
"# create the floor, tool and work\n"
"floor = Box(-50, -50, -3, 50, 50, 0)\n"
"work = Capture()\n"
"tooltip = Capture()\n"
msgstr ""
"# தளம், கருவி மற்றும் வேலையை உருவாக்கவும்\n"
" மாடி = பெட்டி (-50, -50, -3, 50, 50, 0)\n"
" வேலை = பிடிப்பு ()\n"
" உதவிக்குறிப்பு = பிடிப்பு ()\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:584
#, no-wrap
msgid ""
"# Build and assemble the model\n"
"part1 = Collection([Box(-6,-3,94,6,3,100)])\n"
"part1 = Color([1,1,1,1],[part1])\n"
"part1 = HalRotate([part1],None,\"joint.0.pos-fb\",360,0,0,1)\n"
"part1 = Translate([dogs],-1,49,0)\n"
msgstr ""
"# மாதிரியை உருவாக்கி ஒன்று சேர்த்துக் கொள்ளுங்கள்\n"
" part1 = சேகரிப்பு ([பெட்டி (-6, -3,94,6,3,100)]))\n"
" பகுதி 1 = நிறம் ([1,1,1,1], [பகுதி 1])\n"
" part1 = halrotate ([part1], எதுவுமில்லை, \"கூட்டு .0.pos-fb\", 360,0,0,1)\n"
" part1 = மொழிபெயர்ப்பு ([நாய்கள்],-1,49,0)\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:587
#, no-wrap
msgid ""
"# create a top-level model\n"
"model = Collection([base, saddle, head, carousel])\n"
msgstr ""
"# ஒரு உயர்மட்ட மாதிரியை உருவாக்கவும்\n"
" மாதிரி = சேகரிப்பு ([அடிப்படை, சேணம், தலை, கொணர்வி])\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:590
#, no-wrap
msgid ""
"# we want to either embed into qtvcp or display directly with PyQt5\n"
"# so build a window to display the model\n"
msgstr ""
"# நாங்கள் QTVCP இல் உட்பொதிக்க விரும்புகிறோம் அல்லது PYQT5 உடன் நேரடியாகக் காண்பிக்க விரும்புகிறோம்\n"
" # எனவே மாதிரியைக் காண்பிக்க ஒரு சாளரத்தை உருவாக்குங்கள்\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:592
#, no-wrap
msgid "class Window(QWidget):\n"
msgstr "வகுப்பு சாளரம் (QWIDGET):\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:598
#, no-wrap
msgid ""
"    def __init__(self):\n"
"        super(Window, self).__init__()\n"
"        self.glWidget = GLWidget()\n"
"        v = self.glWidget\n"
"        v.set_latitudelimits(-180, 180)\n"
msgstr ""
"def __init __ (சுய):\n"
" சூப்பர் (சாளரம், சுய) .__ init __ ()\n"
" self.glwidget = glwidget ()\n"
" v = self.glwidget\n"
" v.set_latitudelimits (-180, 180)\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:600
#, no-wrap
msgid "        world = Capture()\n"
msgstr "உலகம் = பிடிப்பு ()\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:605
#, no-wrap
msgid ""
"        # uncomment if there is a HUD\n"
"        # HUD needs to know where to draw\n"
"        #v.hud = myhud\n"
"        #v.hud.app = v\n"
msgstr ""
"# ஒரு HUD இருந்தால் அவிழ்த்து விடுங்கள்\n"
" # HUD எங்கு வரைய வேண்டும் என்பதை அறிந்து கொள்ள வேண்டும்\n"
" #v.hud = myhud\n"
" #v.hud.app = v\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:608
#, no-wrap
msgid ""
"        # update plot color based on motion type\n"
"        STATUS.connect('motion-type-changed', lambda w, data: v.choosePlotColor(data))\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:613
#, no-wrap
msgid ""
"        # uncomment to change feed color\n"
"        #v.setColorsAttribute('FEED',(0,1,0))\n"
"        # and to see all colors printed to the terminal\n"
"        #print(v.colors)\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:622
#, no-wrap
msgid ""
"        v.model = Collection([model, world])\n"
"        size = 600\n"
"        v.distance = size * 3\n"
"        v.near = size * 0.01\n"
"        v.far = size * 10.0\n"
"        v.tool2view = tooltip\n"
"        v.world2view = world\n"
"        v.work2view = work\n"
msgstr ""
"v.model = சேகரிப்பு ([மாதிரி, உலகம்])\n"
" அளவு = 600\n"
" v.distance = அளவு * 3\n"
" v.near = அளவு * 0.01\n"
" v.far = அளவு * 10.0\n"
" v.tool2view = கருவிப்பட்டியல்\n"
" v.world2view = உலகம்\n"
" v.work2view = வேலை\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:626
#, no-wrap
msgid ""
"        mainLayout = QHBoxLayout()\n"
"        mainLayout.addWidget(self.glWidget)\n"
"        self.setLayout(mainLayout)\n"
msgstr ""
"mainlayout = qhboxlayout ()\n"
" mainlayout.addwidget (self.glwidget)\n"
" self.SetLayout (mainlayout)\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:629
#, no-wrap
msgid ""
"# if you call this file directly from python3, it will display a PyQt5 window\n"
"# good for confirming the parts of the assembly.\n"
msgstr ""
"# இந்த கோப்பை பைதான் 3 இலிருந்து நேரடியாக அழைத்தால், அது ஒரு PYQT5 சாளரத்தைக் காண்பிக்கும்\n"
" # சட்டசபையின் பகுதிகளை உறுதிப்படுத்த நல்லது.\n"

#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:632
#, no-wrap
msgid ""
"if __name__ == '__main__':\n"
"    main(model, tooltip, work, size=600, hud=None, lat=-75, lon=215)\n"
msgstr ""
"__name__ == '__main__' என்றால்:\n"
" முதன்மை (மாதிரி, உதவிக்குறிப்பு, வேலை, அளவு = 600, HUD = எதுவுமில்லை, லாட் = -75, லோன் = 215)\n"

