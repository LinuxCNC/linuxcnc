#. type: delimited block -
#: src/config/python-interface.adoc:377
#, no-wrap
msgid ""
"#!/usr/bin/env python3\n"
"# -*- coding: utf-8 -*-\n"
"import linuxcnc\n"
"s = linuxcnc.stat()\n"
"s.poll()\n"
"# to find the loaded tool information it is in tool table index 0\n"
"if s.tool_table[0].id != 0: # a tool is loaded\n"
"    print(s.tool_table[0].zoffset)\n"
"else:\n"
"    print(\"No tool loaded.\")\n"
msgstr ""
"#!/usr/bin/env பைதான் 3\n"
" #-*-குறியீட்டு முறை: யுடிஎஃப் -8-*-\n"
