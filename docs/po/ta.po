" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 4)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 5)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 6)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 7)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 8)\n"
" Mdi_command = (பிழைத்திருத்த, மேக்ரோ 9)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 10)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 11)\n"
" Mdi_command = (பிழைத்திருத்த, மேக்ரோ 12)\n"
" Mdi_command = (பிழைத்திருத்த, மேக்ரோ 13)\n"
" MDI_COMMAND = (பிழைத்திருத்தம், மேக்ரோ 14)\n"
" Mdi_command = (பிழைத்திருத்த, மேக்ரோ 15)\n"
