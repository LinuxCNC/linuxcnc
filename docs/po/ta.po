msgstr "படம்: படங்கள்/கருவி_ச்டாப்."

#. type: Plain text
#: src/gui/axis.adoc:295
msgid ""
"image:images/tool_blockdelete.png[\"Toggle Skip lines\"] Toggle Skip lines "
