#. type: Plain text
#: src/gcode/overview.adoc:553
msgid "'#<_tool_offset>' - Return 1 if tool offset (G43) is on, else 0."
msgstr ""
"'#<_ TOOL_OFFSET>' - கருவி ஆஃப்செட் (G43) இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:554
msgid "'#<_retract_r_plane>' - Return 1 if G98 is set, else 0."
msgstr "'#<_ retact_r_plane>' - g98 அமைக்கப்பட்டால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:555
msgid "'#<_retract_old_z>' - Return 1 if G99 is on, else 0."
msgstr "'#<_ retact_old_z>' - g99 இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Index entry
#: src/gcode/overview.adoc:557 src/gcode/overview.adoc:560
#, fuzzy, no-wrap
#| msgid "Coordinate System Parameters"
msgid "System Parameters"
msgstr "கணினி அளவுருக்களை ஒருங்கிணைத்தல்"

#. type: Plain text
#: src/gcode/overview.adoc:561
msgid ""
"'#<_spindle_rpm_mode>' - Return 1 if spindle rpm mode (G97) is on, else 0."
msgstr ""
"'#<_ ச்பிண்டில்_ஆர்பிஎம்_மோட்>' - சுழல் ஆர்.பி.எம் பயன்முறை (சி 97) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:562
msgid ""
"'#<_spindle_css_mode>' - Return 1 if constant surface speed mode (G96) is "
"on, else 0."
msgstr ""
"'#<_ ச்பிண்டில்_சிஎச்எச்_மோட்>' - திரும்ப 1 நிலையான மேற்பரப்பு வேக பயன்முறை (சி 96) "
"இயக்கப்பட்டிருந்தால், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:563
msgid ""
"'#<_ijk_absolute_mode>' - Return 1 if Absolute Arc distance mode (G90.1) is "
"on, else 0."
msgstr ""
"'#<_ ijk_absolute_mode>' - முழுமையான வில் தூர முறை (G90.1) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:564
msgid ""
"'#<_lathe_diameter_mode>' - Return 1 if this is a lathe configuration and "
"diameter (G7) mode is on, else 0."
msgstr ""
"'#<_ லேத்_டியாமீட்டர்_மோட்>' - திரும்ப 1 இது ஒரு லேத் உள்ளமைவு மற்றும் விட்டம் (சி 7) "
"பயன்முறையாக இருந்தால், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:565
msgid ""
"'#<_lathe_radius_mode>' - Return 1 if this is a lathe configuration and "
"radius (G8) mode is on, else 0."
msgstr ""
"'#<_ லேத்_ராடியச்_மோட்>' - திரும்ப 1 இது ஒரு லேத் உள்ளமைவு மற்றும் ஆரம் (சி 8) "
"பயன்முறை இயக்கத்தில் இருந்தால், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:566
msgid ""
"'#<_spindle_on>' - Return 1 if spindle currently running (M3 or M4) else 0."
msgstr ""
"'#<_ சுழல்_ஆன்>' - சுழல் தற்போது இயங்கினால் 1 திரும்பவும் (M3 அல்லது M4) வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:567
msgid ""
"'#<_spindle_cw>' - Return 1 if spindle direction is clockwise (M3) else 0."
msgstr ""
"'#<_ ச்பிண்டில்_க்வ்>' - சுழல் திசை கடிகார திசையில் இருந்தால் 1 திரும்பவும் (எம் 3) வேறு "
"0."

#. type: Plain text
#: src/gcode/overview.adoc:568
msgid "'#<_mist>' - Return 1 if mist (M7) is on."
msgstr "'#<_ மிச்ட்>' - மூடுபனி (எம் 7) இயக்கப்பட்டிருந்தால் 1 திரும்பவும்."

#. type: Plain text
#: src/gcode/overview.adoc:569
msgid "'#<_flood>' - Return 1 if flood (M8) is on."
msgstr "'#<_ வெள்ளம்>' - வெள்ளம் (எம் 8) இயக்கப்பட்டிருந்தால் 1 திரும்பவும்."

#. type: Plain text
#: src/gcode/overview.adoc:570
msgid ""
"'#<_speed_override>' - Return 1 if feed override (M48 or M50 P1) is on, else "
"0."
msgstr ""
"'#<_ SPEED_OVERRIDE>' - ஊட்டத்தை மீறினால் (M48 அல்லது M50 P1) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:571
msgid ""
"'#<_feed_override>' - Return 1 if feed override (M48 or M51 P1) is on, else "
"0."
msgstr ""
"'#<_ feed_override>' - ஊட்டத்தை மீறினால் (M48 அல்லது M51 P1) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:572
msgid ""
"'#<_adaptive_feed>' - Return 1 if adaptive feed (M52 or M52 P1) is on, else "
"0."
msgstr ""
"'#<_ அடாப்டிவ்_ஃபீட்>' - தகவமைப்பு ஊட்டம் (M52 அல்லது M52 P1) இருந்தால் 1 திரும்பவும், "
"இல்லையெனில் 0."

#. type: Plain text
#: src/gcode/overview.adoc:573
msgid ""
"'#<_feed_hold>' - Return 1 if feed hold switch is enabled (M53 P1), else 0."
msgstr ""
"'#<_ feed_hold>' - ஃபீட் ஓல்ட் சுவிட்ச் இயக்கப்பட்டிருந்தால் 1 திரும்பவும் (M53 P1), வேறு "
"0."

#. type: Plain text
#: src/gcode/overview.adoc:574
msgid "'#<_feed>' - Return the current value of F, not the actual feed rate."
msgstr ""
"'#<_ FEED>' - F இன் தற்போதைய மதிப்பைத் திருப்பி விடுங்கள், உண்மையான தீவன வீதம் அல்ல."

#. type: Plain text
#: src/gcode/overview.adoc:575
msgid ""
"'#<_rpm>' - Return the current value of S, not the actual spindle speed."
msgstr "'#<_ rpm>' - S இன் தற்போதைய மதிப்பைத் தரவும், உண்மையான சுழல் விரைவு அல்ல."

#. type: Plain text
#: src/gcode/overview.adoc:577
msgid ""
"'#<_x>' - Return current relative X coordinate including all offsets. Same "
"as #5420.  In a lathe configuration, it always returns radius."
msgstr ""
"'#<_ x>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் ஃச் ஒருங்கிணைப்பைத் தரவும். "
"#5420 போன்றது. ஒரு லேத் உள்ளமைவில், அது எப்போதும் ஆரம் தருகிறது."

#. type: Plain text
#: src/gcode/overview.adoc:578
msgid ""
"'#<_y>' - Return current relative Y coordinate including all offsets. Same "
"as #5421."
msgstr ""
"'#<_ y>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் ஒய் ஒருங்கிணைப்பைத் தரவும். "
"#5421 அதே."

#. type: Plain text
#: src/gcode/overview.adoc:579
msgid ""
"'#<_z>' - Return current relative Z coordinate including all offsets. Same "
"as #5422."
msgstr ""
"'#<_ Z>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் சட் ஒருங்கிணைப்பைத் தரவும். "
"#5422 போலவே."

#. type: Plain text
#: src/gcode/overview.adoc:580
msgid ""
"'#<_a>' - Return current relative A coordinate including all offsets. Same "
"as #5423."
msgstr ""
"'#<a>' - தற்போதைய உறவினர் அனைத்து ஆஃப்செட் உட்பட ஒரு ஒருங்கிணைப்பைத் தரவும். #5423 அதே."

#. type: Plain text
#: src/gcode/overview.adoc:581
msgid ""
"'#<_b>' - Return current relative B coordinate including all offsets. Same "
"as #5424."
msgstr ""
"'#<_ b>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் B ஒருங்கிணைப்பைத் தரவும். #5424 "
"போன்றது."

#. type: Plain text
#: src/gcode/overview.adoc:582
msgid ""
"'#<_c>' - Return current relative C coordinate including all offsets. Same "
"as #5425."
msgstr ""
"'#<c>' - அனைத்து ஆஃப்செட் உட்பட தற்போதைய உறவினர் ஒருங்கிணைப்பைத் தரவும். #5425 போன்றது."

#. type: Plain text
#: src/gcode/overview.adoc:583
msgid ""
"'#<_u>' - Return current relative U coordinate including all offsets. Same "
"as #5426."
msgstr ""
"'#<_ u>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் உ ஒருங்கிணைப்பைத் தரவும். #5426 "
"போன்றது."

#. type: Plain text
#: src/gcode/overview.adoc:584
msgid ""
"'#<_v>' - Return current relative V coordinate including all offsets. Same "
"as #5427."
msgstr ""
"'#<_ v>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் v ஒருங்கிணைப்பைத் தரவும். #5427 "
"அதே."

#. type: Plain text
#: src/gcode/overview.adoc:585
msgid ""
"'#<_w>' - Return current relative W coordinate including all offsets. Same "
"as #5428."
msgstr ""
"'#<_ w>' - அனைத்து ஆஃப்செட்டுகள் உட்பட தற்போதைய உறவினர் w ஒருங்கிணைப்பைத் தரவும். #5428 "
"போன்றது."

#. type: Plain text
#: src/gcode/overview.adoc:586
msgid ""
"'#<_abs_x>' - Return current absolute X coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_X>' - ஆஃப்செட்டுகள் உட்பட தற்போதைய முழுமையான ஃச் ஒருங்கிணைப்பு (G53) ஐத் "
"தரவும்."

#. type: Plain text
#: src/gcode/overview.adoc:587
msgid ""
"'#<_abs_y>' - Return current absolute Y coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_Y>' - ஆஃப்செட்டுகள் உட்பட தற்போதைய முழுமையான ஒய் ஒருங்கிணைப்பு (G53) ஐத் "
"தரவும்."

#. type: Plain text
#: src/gcode/overview.adoc:588
msgid ""
"'#<_abs_z>' - Return current absolute Z coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_Z>' - ஆஃப்செட்டுகள் எதுவும் உட்பட தற்போதைய முழுமையான சட் ஒருங்கிணைப்பு (G53) "
"ஐத் தரவும்."

#. type: Plain text
#: src/gcode/overview.adoc:589
msgid ""
"'#<_abs_a>' - Return current absolute A coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_A>' - ஆஃப்செட்டுகள் எதுவும் உட்பட தற்போதைய முழுமையான ஒரு ஒருங்கிணைப்பு "
"(G53) திரும்பவும்."

#. type: Plain text
#: src/gcode/overview.adoc:590
msgid ""
"'#<_abs_b>' - Return current absolute B coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_B>' - ஆஃப்செட்டுகள் எதுவும் உட்பட தற்போதைய முழுமையான பி ஒருங்கிணைப்பு (சி "
"53) ஐத் திரும்புக."

#. type: Plain text
#: src/gcode/overview.adoc:591
msgid ""
"'#<_abs_c>' - Return current absolute C coordinate (G53) including no "
"offsets."
msgstr ""
"'#<_ ABS_C>' - ஆஃப்செட்டுகள் எதுவும் உட்பட தற்போதைய முழுமையான சி ஒருங்கிணைப்பு (G53) "
"ஐத் திரும்புக."

#. type: Plain text
#: src/gcode/overview.adoc:592
msgid ""
"'#<_current_tool>' - Return number of the current tool in spindle. Same as "
"#5400."
msgstr ""
"'#<_ CURRENT_TOOL>' - சுழற்சியில் தற்போதைய கருவியின் வருவாய் எண்ணிக்கை. #5400 "
"போன்றது."

#. type: Plain text
#: src/gcode/overview.adoc:593
msgid "'#<_current_pocket>' - Return the tooldata index for the current tool."
msgstr "'#<_ current_pocket>' - தற்போதைய கருவிக்கான டோல்டேட்டா குறியீட்டைத் தரவும்."

#. type: Plain text
#: src/gcode/overview.adoc:594
msgid ""
"'#<_selected_tool>' - Return number of the selected tool post a T code. "
"Default -1."
msgstr ""
"'#<_ தேர்ந்தெடுக்கப்பட்ட_டூல்>' - தேர்ந்தெடுக்கப்பட்ட கருவியின் எண்ணிக்கையை ஒரு டி "
"குறியீட்டை இடுகையிடவும். இயல்புநிலை -1."

#. type: Plain text
#: src/gcode/overview.adoc:596
msgid ""
"'#<_selected_pocket>' - Return the tooldata index of the selected pocket "
"post a T code.  Default -1 (no pocket selected)."
msgstr ""
"'#<_ தேர்ந்தெடுக்கப்பட்ட_பொகெட்>' - தேர்ந்தெடுக்கப்பட்ட பாக்கெட் இடுகை ஒரு டி குறியீட்டின் "
"டோல்டேட்டா குறியீட்டைத் தரவும். இயல்புநிலை -1 (பாக்கெட் தேர்ந்தெடுக்கப்படவில்லை)."

#. type: Plain text
#: src/gcode/overview.adoc:599
msgid ""
"'#<_value>' - Return value from the last O-code 'return' or 'endsub'. "
"Default value 0 if no expression after 'return' or 'endsub'. Initialized to "
"0 on program start."
msgstr ""
"'#<_ மதிப்பு>' - கடைசி ஓ -குறியீடு 'ரிட்டர்ன்' அல்லது 'எண்ட் சப்' இலிருந்து வருவாய் "
"மதிப்பு. இயல்புநிலை மதிப்பு 0 'திரும்ப' அல்லது 'EndSub' க்குப் பிறகு வெளிப்பாடு இல்லை "
"என்றால். நிரல் தொடக்கத்தில் 0 க்கு துவக்கப்பட்டது."

#. type: Plain text
#: src/gcode/overview.adoc:601
msgid ""
"'#<_value_returned>' - 1.0 if the last O-code 'return' or 'endsub' returned "
"a value, 0 otherwise. Cleared by the next O-code call."
msgstr ""
"'#<_ value_returned>' - 1.0 கடைசி ஓ -குறியீடு 'ரிட்டர்ன்' அல்லது 'எண்ட்சப்' ஒரு "
"மதிப்பைத் திருப்பினால், 0 இல்லையெனில். அடுத்த ஓ-குறியீடு அழைப்பால் அழிக்கப்பட்டது."

#. type: Plain text
#: src/gcode/overview.adoc:606
msgid ""
"'#<_task>' - 1.0 if the executing interpreter instance is part of milltask, "
"0.0 otherwise. Sometimes it is necessary to treat this case specially to "
"retain proper preview, for instance when testing the success of a probe "
"(G38.n) by inspecting #5070, which will always fail in the preview "
"interpreter (e.g. Axis)."
msgstr ""
"'#<_ பணி>' - 1.0 செயல்படுத்தும் மொழிபெயர்ப்பாளர் நிகழ்வு மில்டாச்கின் ஒரு பகுதியாக "
"இருந்தால், 0.0 இல்லையெனில். சில நேரங்களில் இந்த வழக்கை சரியான முன்னோட்டத்தைத் தக்க வைத்துக் "
"கொள்ள வேண்டியது தேவை, உதாரணமாக #5070 ஐ ஆய்வு செய்வதன் மூலம் ஒரு ஆய்வின் (G38.N) "
"வெற்றியை சோதிக்கும் போது, இது முன்னோட்ட மொழிபெயர்ப்பாளரில் (எ.கா. அச்சு) எப்போதும் "
"தோல்வியடையும்."

#. type: Plain text
#: src/gcode/overview.adoc:607
msgid ""
"'#<_call_level>' - current nesting level of O-code procedures. For debugging."
msgstr ""
"'#<_ Call_level>' - O -குறியீட்டு நடைமுறைகளின் தற்போதைய கூடுகள் நிலை. "
"பிழைத்திருத்தத்திற்காக."

#. type: Plain text
#: src/gcode/overview.adoc:609
msgid ""
"'#<_remap_level>' - current level of the remap stack. Each remap in a block "
"adds one to the remap level. For debugging."
msgstr ""
"'#<_ remap_level>' - ரீமேப் அடுக்கின் தற்போதைய நிலை. ஒரு தொகுதியில் உள்ள ஒவ்வொரு "
"ரீமேப் ரீமேப் மட்டத்தில் ஒன்றை சேர்க்கிறது. பிழைத்திருத்தத்திற்காக."

#. type: Index entry
#: src/gcode/overview.adoc:611 src/gcode/overview.adoc:616
#, fuzzy, no-wrap
#| msgid "Setting pin and widget values"
msgid "HAL pins and INI values"
msgstr "முள் மற்றும் விட்செட் மதிப்புகளை அமைத்தல்"

#. type: Plain text
#: src/gcode/overview.adoc:616
msgid ""
"If enabled in the <<sub:ini:sec:rs274ngc, INI file>> G-code has access to "
"the values of INI file entries and HAL pins."
msgstr ""
"<<sub:ini:sec:rs274ngc, இனி கோப்பு >> g-code இனி கோப்பு உள்ளீடுகள் மற்றும் HAL "
"ஊசிகளின் மதிப்புகளுக்கு அணுகலைக் கொண்டுள்ளது."

#. type: Plain text
#: src/gcode/overview.adoc:619
msgid ""
"'#<_ini[section]name>' Returns the value of the corresponding item in the "
"INI file."
msgstr ""
"'#<_ இனி [பிரிவு] பெயர்>' ஐ.என்.ஐ கோப்பில் தொடர்புடைய உருப்படியின் மதிப்பை "
"வழங்குகிறது."

#. type: Plain text
#: src/gcode/overview.adoc:621
msgid "For example, if the INI file looks like so:"
msgstr "எடுத்துக்காட்டாக, ஐ.என்.ஐ கோப்பு அப்படி இருந்தால்:"

#. type: delimited block -
#: src/gcode/overview.adoc:627
#, no-wrap
msgid ""
"[SETUP]\n"
"XPOS = 3.145\n"
"YPOS = 2.718\n"
msgstr ""
"[அமைவு]\n"
" XPOS = 3.145\n"
" Ypos = 2.718\n"

#. type: Plain text
#: src/gcode/overview.adoc:631
msgid ""
"you may refer to the named parameters `#<_ini[setup]xpos>` and "
"`#<_ini[setup]ypos>` within G-code."
msgstr ""
"சி-குறியீட்டிற்குள் பெயரிடப்பட்ட அளவுருக்கள் `#<_ இனி [அமைவு] XPOS>` மற்றும் `#<_ இனி "
"[setup] ypos>` ஆகியவற்றைக் குறிப்பிடலாம்."

#. type: Plain text
#: src/gcode/overview.adoc:634
msgid "`EXISTS` can be used to test for presence of a given INI file variable:"
msgstr "கொடுக்கப்பட்ட ஐ.என்.ஐ கோப்பு மாறியின் இருப்பை சோதிக்க `உள்ளது` பயன்படுத்தப்படலாம்:"

#. type: delimited block -
#: src/gcode/overview.adoc:642
#, no-wrap
msgid ""
"o100 if [EXISTS[#<_ini[setup]xpos>]]\n"
"  (debug, [setup]xpos exists: #<_ini[setup]xpos>)\n"
"o100 else\n"
"  (debug, [setup]xpos does not exist)\n"
"o100 endif\n"
msgstr ""
"O100 என்றால் [#<_ இனி [setup] xpos>]]\n"
" .\n"
" O100 வேறு\n"
" (பிழைத்திருத்தம், [அமைவு] XPOS இல்லை)\n"
" O100 endif\n"

#. type: Plain text
#: src/gcode/overview.adoc:649
#, fuzzy
#| msgid ""
#| "The value is read from the INI file once, and cached in the interpreter. "
#| "These parameters are read-only - assigning a value will cause a runtime "
#| "error. The names are not case sensitive - they are converted to uppercase "
#| "before consulting the INI file."
msgid ""
"The value is read from the INI file once, and cached in the interpreter. "
"These parameters are read-only - assigning a value will cause a runtime "
"error. In the G-code the names are not case sensitive - they are converted "
"to uppercase before consulting the INI file. Hence INI entries that contain "
"lowercase characters can not be accessed from G-code."
msgstr ""
"மதிப்பு ஒரு முறை ஐ.என்.ஐ கோப்பிலிருந்து வாசிக்கப்படுகிறது, மேலும் மொழிபெயர்ப்பாளரில் "
"தற்காலிகமாக சேமிக்கப்படுகிறது. இந்த அளவுருக்கள் படிக்க மட்டுமே - மதிப்பை ஒதுக்குவது "
"இயக்க நேர பிழையை ஏற்படுத்தும். பெயர்கள் வழக்கு உணர்திறன் இல்லை - ஐ.என்.ஐ கோப்பை "
"கலந்தாலோசிப்பதற்கு முன்பு அவை பெரிய அளவிற்கு மாற்றப்படுகின்றன."

#. type: Plain text
#: src/gcode/overview.adoc:658
msgid ""
"'#<_hal[HAL item]>' Allows G-code programs to read the values of HAL pins "
"Variable access is read-only, the only way to _set_ HAL pins from G-code "
"remains M62-M65, M67, M68 and custom M100-M199 codes.  Note that the value "
"read will not update in real-time, typically the value that was on the pin "
"when the G-code program was started will be returned. It is possible to work "
"round this by forcing a state synch.  One way to do this is with a dummy M66 "
"command: M66E0L0"
msgstr ""
"'#<_ ஆல் [ஆல் உருப்படி]>' சி-கோட் நிரல்களை ஆல் ஊசிகளின் மதிப்புகளைப் படிக்க "
"அனுமதிக்கிறது மாறி அணுகல் மட்டுமே படிக்க மட்டுமே, சி-குறியீட்டிலிருந்து _ செட்_ ஆல் "
"ஊசிகளுக்கான ஒரே வழி m62-m65, m67, m68 மற்றும் தனிப்பயன் M100-M199 குறியீடுகள். "
"வாசிப்பு மதிப்பு நிகழ்நேரத்தில் புதுப்பிக்கப்படாது என்பதை நினைவில் கொள்க, பொதுவாக சி-"
"கோட் நிரல் தொடங்கப்பட்டபோது முள் மீது இருந்த மதிப்பு திருப்பித் தரப்படும். ஒரு மாநில "
"ஒத்திசைவை கட்டாயப்படுத்துவதன் மூலம் இதைச் சுற்றி வேலை செய்ய முடியும். இதைச் செய்வதற்கான "
"ஒரு வழி போலி M66 கட்டளையுடன் உள்ளது: M66E0L0"

#. type: delimited block -
#: src/gcode/overview.adoc:664
#, no-wrap
msgid "(debug, #<_hal[motion-controller.time]>)\n"
msgstr "(பிழைத்திருத்தம், #<_ ஆல் [மோசன்-கன்ட்ரோலர். நேரம்]>)\n"

#. type: Plain text
#: src/gcode/overview.adoc:668
msgid ""
"Access of HAL items is read-only. Currently, only all-lowercase HAL names "
"can be accessed this way."
msgstr ""
"HAL உருப்படிகளின் அணுகல் படிக்க மட்டுமே. தற்போது, அனைத்து-லவர் கேச் எச்ஏஎல் பெயர்களை "
"மட்டுமே இந்த வழியில் அணுக முடியும்."

#. type: Plain text
#: src/gcode/overview.adoc:670
msgid "`EXISTS` can be used to test for the presence of a given HAL item:"
msgstr "கொடுக்கப்பட்ட HAL உருப்படி இருப்பதை சோதிக்க `உள்ளது` பயன்படுத்தப்படலாம்:"

#. type: delimited block -
#: src/gcode/overview.adoc:678
#, no-wrap
msgid ""
"o100 if [EXISTS[#<_hal[motion-controller.time]>]]\n"
"  (debug, [motion-controller.time] exists: #<_hal[motion-controller.time]>)\n"
"o100 else\n"
"  (debug, [motion-controller.time] does not exist)\n"
"o100 endif\n"
msgstr ""
"O100 என்றால் [#<_ HAL [மோசன்-CONTROLLER.TIME]>]]\n"
" .\n"
" O100 வேறு\n"
" (பிழைத்திருத்தம், [மோசன்-கன்ட்ரோலர். நேரம்] இல்லை)\n"
" O100 endif\n"

#. type: Plain text
#: src/gcode/overview.adoc:686
msgid ""
"This feature was motivated by the desire for stronger coupling between user "
"interface components like `GladeVCP` and `PyVCP` to act as parameter source "
"for driving NGC file behavior. The alternative - going through the M6x pins "
"and wiring them - has a limited, non-mnemonic namespace and is unnecessarily "
"cumbersome just as a UI/Interpreter communications mechanism."
msgstr ""
"என்சிசி கோப்பு நடத்தையை இயக்குவதற்கான அளவுரு மூலமாக செயல்பட `gladevcp` மற்றும்` "
"PYVCP` போன்ற பயனர் இடைமுக கூறுகளுக்கு இடையில் வலுவான இணைப்புக்கான விருப்பத்தால் இந்த "
"நற்பொருத்தம் தூண்டப்பட்டது. மாற்று - M6x ஊசிகளின் வழியாகச் சென்று அவற்றை வயரிங் செய்வது - "
"ஒரு வரையறுக்கப்பட்ட, நினைவூட்டல் அல்லாத பெயர்வெளியைக் கொண்டுள்ளது மற்றும் UI/"
"மொழிபெயர்ப்பாளர் தகவல்தொடர்பு பொறிமுறையாக தேவையில்லாமல் சிக்கலானது."

#. type: Index entry
#: src/gcode/overview.adoc:688 src/gcode/overview.adoc:698
#, fuzzy, no-wrap
#| msgid "Example Session"
msgid "Expressions"
msgstr "எடுத்துக்காட்டு அமர்வு"

#. type: Plain text
#: src/gcode/overview.adoc:698
msgid ""
"An expression is a set of characters starting with a left bracket '[' and "
"ending with a balancing right bracket ']' . In between the brackets are "
"numbers, parameter values, mathematical operations, and other expressions. "
"An expression is evaluated to produce a number. The expressions on a line "
"are evaluated when the line is read, before anything on the line is "
"executed. An example of an expression is '[1 + acos[0] - [#3 ** [4.0/2]]]'."
msgstr ""
"ஒரு வெளிப்பாடு என்பது இடது அடைப்புக்குறிக்குள் தொடங்கி '[' மற்றும் சமநிலைப்படுத்தும் "
"வலது அடைப்புக்குறியுடன் முடிவடையும் எழுத்துக்களின் தொகுப்பாகும். அடைப்புக்குறிக்கு "
"இடையில் எண்கள், அளவுரு மதிப்புகள், கணித செயல்பாடுகள் மற்றும் பிற வெளிப்பாடுகள் உள்ளன. "
"ஒரு எண்ணை உருவாக்க ஒரு வெளிப்பாடு மதிப்பீடு செய்யப்படுகிறது. வரியில் உள்ள எதையும் "
"செயல்படுத்தப்படுவதற்கு முன்பு, ஒரு வரியில் உள்ள வெளிப்பாடுகள் மதிப்பீடு செய்யப்படுகின்றன. "
"ஒரு வெளிப்பாட்டின் எடுத்துக்காட்டு '[1 + ACOS [0] - [#3 ** [4.0/2]]'."

#. type: Index entry
#: src/gcode/overview.adoc:700 src/gcode/overview.adoc:713
#, fuzzy, no-wrap
#| msgid "Operators"
msgid "Binary Operators"
msgstr "ஆபரேட்டர்கள்"

#. type: Plain text
#: src/gcode/overview.adoc:713
msgid ""
"Binary operators only appear inside expressions. There are four basic "
"mathematical operations: addition ('+'), subtraction ('-'), multiplication "
"('\\*'), and division ('/'). There are three logical operations: non-"
"exclusive or ('OR'), exclusive or ('XOR'), and logical and ('AND'). The "
"eighth operation is the modulus operation ('MOD'). The ninth operation is "
"the 'power' operation ('**') of raising the number on the left of the "
"operation to the power on the right. The relational operators are equality "
"('EQ'), inequality ('NE'), strictly greater than ('GT'), greater than or "
"equal to ('GE'), strictly less than ('LT'), and less than or equal to ('LE')."
msgstr ""
"பைனரி ஆபரேட்டர்கள் வெளிப்பாடுகளுக்குள் மட்டுமே தோன்றும். நான்கு அடிப்படை கணித "
"செயல்பாடுகள் உள்ளன: கூட்டல் ('+'), கழித்தல் ('-'), பெருக்கல் ('\\*') மற்றும் பிரிவு "
"('/'). மூன்று தர்க்கரீதியான செயல்பாடுகள் உள்ளன: பிரத்தியேகமற்ற OR ('அல்லது'), "
"பிரத்தியேக OR ('Xor'), மற்றும் தர்க்கரீதியான மற்றும் ('மற்றும்'). எட்டாவது செயல்பாடு "
"மாடுலச் செயல்பாடு ('மோட்'). ஒன்பதாவது செயல்பாடு என்பது செயல்பாட்டின் இடதுபுறத்தில் உள்ள "
"எண்ணை வலதுபுறத்தில் உள்ள சக்திக்கு உயர்த்துவதற்கான 'ஆற்றல்' செயல்பாடு ('**') ஆகும். "
"தொடர்புடைய ஆபரேட்டர்கள் ஒரு நிகர் ('Eq'), சமத்துவமின்மை ('ne'), கண்டிப்பாக ('gt') ஐ "
"விடவும், ('Ge') ஐ விடவும் அல்லது சமமாகவோ, கண்டிப்பாக ('lt') விட குறைவாகவும், "
"குறைவாகவும் குறைவாகும் அல்லது ('லே') க்கு சமம்."

#. type: Plain text
#: src/gcode/overview.adoc:723
msgid ""
"The binary operations are divided into several groups according to their "
"precedence. If operations in different precedence groups are strung together "
"(for example in the expression '[2.0 / 3 * 1.5 - 5.5 / 11.0]'), operations "
"in a higher group are to be performed before operations in a lower group. If "
"an expression contains more than one operation from the same group (such as "
"the first '/' and '*' in the example), the operation on the left is "
"performed first. Thus, the example is equivalent to: '[ [ [2.0 / 3] * 1.5] - "
"[5.5 / 11.0] ]' , which is equivalent to to '[1.0 - 0.5]' , which is '0.5'."
msgstr ""
"பைனரி செயல்பாடுகள் அவற்றின் முன்னுரிமைக்கு ஏற்ப பல குழுக்களாக பிரிக்கப்பட்டுள்ளன. "
"வெவ்வேறு முன்னுரிமை குழுக்களில் செயல்பாடுகள் ஒன்றாக இணைக்கப்பட்டிருந்தால் (எடுத்துக்காட்டாக "
"'[2.0 / 3 * 1.5 - 5.5 / 11.0]' என்ற வெளிப்பாட்டில்), குறைந்த குழுவில் செயல்படும் முன் "
"உயர் குழுவில் செயல்பாடுகள் செய்யப்பட வேண்டும். ஒரு வெளிப்பாடு ஒரே குழுவிலிருந்து "
"ஒன்றுக்கு மேற்பட்ட செயல்பாடுகளைக் கொண்டிருந்தால் (எடுத்துக்காட்டில் முதல் '/' மற்றும் '*' "
"போன்றவை), இடதுபுறத்தில் செயல்பாடு முதலில் செய்யப்படுகிறது. எனவே, எடுத்துக்காட்டு இதற்கு "
"சமம்: '[[[2.0 / 3] * 1.5] - [5.5 / 11.0]]', இது '[1.0 - 0.5]' க்கு சமம், இது "
"'0.5'."

#. type: Plain text
#: src/gcode/overview.adoc:727
msgid ""
"The logical operations and modulus are to be performed on any real numbers, "
"not just on integers. The number zero is equivalent to logical false, and "
"any non-zero number is equivalent to logical true."
msgstr ""
"தர்க்கரீதியான செயல்பாடுகள் மற்றும் மாடுலச் ஆகியவை முழு எண்களிலும் செய்யப்பட வேண்டும், முழு "
"எண்களில் மட்டுமல்ல. எண் பூச்சியம் தர்க்கரீதியான பொய்யுக்கு சமம், மற்றும் பூச்சியமற்ற எண்ணிக்கை "
"தர்க்கரீதியான உண்மைக்கு சமம்."

