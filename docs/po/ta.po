msgid ""
"component logic \"LinuxCNC HAL component providing experimental logic functions\";\n"
"pin in bit in-##[16 : personality & 0xff];\n"
"pin out bit and if personality & 0x100;\n"
"pin out bit or if personality & 0x200;\n"
"pin out bit xor if personality & 0x400;\n"
"option period no;\n"
"function _ nofp;\n"
"description \"\"\"\n"
"Experimental general 'logic function' component.  Can perform 'and', 'or'\n"
"and 'xor' of up to 16 inputs.  Determine the proper value for 'personality'\n"
"by adding:\n"
".IP \\\\(bu 4\n"
"The number of input pins, usually from 2 to 16\n"
".IP \\\\(bu\n"
"256 (0x100)  if the 'and' output is desired\n"
".IP \\\\(bu\n"
"512 (0x200)  if the 'or' output is desired\n"
".IP \\\\(bu\n"
"1024 (0x400)  if the 'xor' (exclusive or) output is desired\"\"\";\n"
"license \"GPL\"; // indicates GPL v2 or later\n"
";;\n"
"FUNCTION(_) {\n"
"    int i, a=1, o=0, x=0;\n"
"    for(i=0; i < (personality & 0xff); i++) {\n"
"        if(in(i)) { o = 1; x = !x; }\n"
"        else { a = 0; }\n"
"    }\n"
"    if(personality & 0x100) and = a;\n"
"    if(personality & 0x200) or = o;\n"
"    if(personality & 0x400) xor = x;\n"
"}\n"
msgstr ""
"கூறு வழக்கு \"லினக்ச் சிஎன்சி எச்ஏஎல் கூறு சோதனை வழக்கு செயல்பாடுகளை வழங்கும்”;\n"
" பிட் இன்-## [16: ஆளுமை & 0xff];\n"
" பிட் அவுட் மற்றும் ஆளுமை என்றால் & 0x100;\n"
" பிட் அவுட் அல்லது ஆளுமை என்றால் & 0x200;\n"
" ஆளுமை என்றால் பிட் xor ஐ முள் & 0x400;\n"
" செயல்பாடு _ NOFP;\n"
" விளக்கம் \"\" \"\n"
" சோதனை பொது 'வழக்கு செயல்பாடு' கூறு. 'மற்றும்', 'அல்லது' செய்ய முடியும்\n"
" மற்றும் 16 உள்ளீடுகள் வரை 'xor'. 'ஆளுமை' என்பதற்கான சரியான மதிப்பை தீர்மானிக்கவும்\n"
" சேர்ப்பதன் மூலம்:\n"
" .Ip \\\\ (bu 4\n"
" உள்ளீட்டு ஊசிகளின் எண்ணிக்கை, பொதுவாக 2 முதல் 16 வரை\n"
" .Ip \\\\ (bu\n"
" 256 (0x100) 'மற்றும்' வெளியீடு விரும்பினால்\n"
" .Ip \\\\ (bu\n"
" 512 (0x200) 'அல்லது' வெளியீடு விரும்பினால்\n"
" .Ip \\\\ (bu\n"
" 1024 (0x400) 'xor' (பிரத்தியேக அல்லது) வெளியீடு விரும்பினால் \"\" \";\n"
" உரிமம் \"சி.பி.எல்\"; // சிபிஎல் வி 2 அல்லது அதற்குப் பிறகு குறிக்கிறது\n"
" ;;\n"
" செயல்பாடு (_) {\n"
" int i, a = 1, o = 0, ஃச் = 0;\n"
" (i = 0; i <(ஆளுமை & 0xff); i ++) {\n"
" if (in (i)) {o = 1; ஃச் =! x; }\n"
" else {a = 0; }\n"
" }\n"
" if (ஆளுமை & 0x100) மற்றும் = a;\n"
" if (ஆளுமை & 0x200) அல்லது = o;\n"
" if (ஆளுமை & 0x400) xor = x;\n"
" }\n"

