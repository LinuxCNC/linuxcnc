#. type: delimited block -
#: src/gui/gmoccapy.adoc:1002
#, no-wrap
msgid ""
"[RS274NGC]\n"
"# is the sub, with is called when a error during tool change happens, not needed on every machine configuration\n"
"ON_ABORT_COMMAND=O <on_abort> call\n"
msgstr ""
"[Rs274ngc]\n"
" # என்பது துணை, கருவி மாற்றத்தின் போது பிழை நிகழும்போது அழைக்கப்படுகிறது, ஒவ்வொரு இயந்திர உள்ளமைவிலும் தேவையில்லை\n"
" On_abort_command = o <on_abort> அழைப்பு\n"

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1005
#, no-wrap
msgid ""
"# The remap code\n"
"REMAP=M6  modalgroup=6 prolog=change_prolog ngc=change epilog=change_epilog\n"
msgstr ""
"# ரீமேப் குறியீடு\n"
" Remap = m6 modalgroup = 6 prolog = change_prolog ngc = மாற்றத்தை மாற்றவும் = மாற்றம்_பிலாக்\n"

#. type: NOTE
#: src/gui/gmoccapy.adoc:1008
msgid ""
"Make sure INI_VARS and HAL_PIN_VARS are not set to 0. They are set to 1 by "
"default."
msgstr ""
"Ini_vars மற்றும் hal_pin_vars ஆகியவை 0 ஆக அமைக்கப்படவில்லை என்பதை உறுதிப்படுத்திக் "
"கொள்ளுங்கள். அவை இயல்பாக 1 ஆக அமைக்கப்படுகின்றன."

#. type: Title ====
#: src/gui/gmoccapy.adoc:1009 src/gui/qtdragon.adoc:1257
#, no-wrap
msgid "The Tool Sensor Section"
msgstr "கருவி சென்சார் பிரிவு"

#. type: NOTE
#: src/gui/gmoccapy.adoc:1012
msgid ""
"The position of the tool sensor and the start position of the probing "
"movement, all values are absolute coordinates, except MAXPROBE, which must "
"be given in relative movement."
msgstr ""
"கருவி சென்சாரின் நிலை மற்றும் ஆய்வு இயக்கத்தின் தொடக்க நிலை, அனைத்து மதிப்புகளும் "
"MAXPROBE ஐத் தவிர முழுமையான ஆயத்தொகுப்புகளாகும், அவை உறவினர் இயக்கத்தில் கொடுக்கப்பட "
"வேண்டும்."

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1020
#, no-wrap
msgid ""
"[TOOLSENSOR]\n"
"X = 10\n"
"Y = 10\n"
"Z = -20\n"
"MAXPROBE = -20\n"
msgstr ""
"[Coursencensor]\n"
" ஃச் = 10\n"
" ஒய் = 10\n"
" சட் = -20\n"
" MaxProbe = -20\n"

#. type: Title ====
#: src/gui/gmoccapy.adoc:1022 src/gui/qtdragon.adoc:1293
#, no-wrap
msgid "The Change Position Section"
msgstr "மாற்றம் நிலை பிரிவு"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1025
msgid ""
"This is not named TOOL_CHANGE_POSITION on purpose - *canon uses that name "
"and will interfere otherwise.* The position to move the machine before "
"giving the change tool command. All values are in absolute coordinates."
msgstr ""
"This is not named TOOL_CHANGE_POSITION on purpose - *canon uses that பெயர் "
"and will interfere otherwise.* The position பெறுநர் move the machine before "
"giving the change கருவி command. அனைத்து மதிப்புகளும் முழுமையான ஒருங்கிணைப்புகளில் "
"உள்ளன."

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1032 src/gui/qtdragon.adoc:1306
#, no-wrap
msgid ""
"[CHANGE_POSITION]\n"
"X = 10\n"
"Y = 10\n"
"Z = -2\n"
msgstr ""
"[மாற்றம்_போசிசன்]\n"
" ஃச் = 10\n"
" ஒய் = 10\n"
" சட் = -2\n"

#. type: Title ====
#: src/gui/gmoccapy.adoc:1034 src/gui/qtdragon.adoc:1308
#, no-wrap
msgid "The Python Section"
msgstr "பைதான் பிரிவு"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1036
msgid "The Python plug ins serves interpreter and task."
msgstr "பைதான் பிளக் இன்ச் மொழிபெயர்ப்பாளர் மற்றும் பணியை வழங்குகிறது."

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1044
#, no-wrap
msgid ""
"[PYTHON]\n"
"# The path to start a search for user modules\n"
"PATH_PREPEND = python\n"
"# The start point for all.\n"
"TOPLEVEL = python/toplevel.py\n"
msgstr ""
"[பைதான்]\n"
" # பயனர் தொகுதிகளுக்கான தேடலைத் தொடங்குவதற்கான பாதை\n"
" Path_prepend = பைதான்\n"
" # அனைவருக்கும் தொடக்க புள்ளி.\n"
" Toplevel = python/toplevel.py\n"

#. type: Title ===
#: src/gui/gmoccapy.adoc:1046
#, no-wrap
msgid "Needed Files"
msgstr "கோப்புகள் தேவை"

