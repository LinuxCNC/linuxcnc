#. type: Plain text
#: src/gui/halui.adoc:251
msgid "'halui.mode.auto' (bit, in) - pin for requesting auto mode"
msgstr "'halui.mode.auto' (பிட், IN) - ஆட்டோ பயன்முறையைக் கோருவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:252
msgid "'halui.mode.is-auto' (bit, out) - indicates auto mode is on"
msgstr ""
"'halui.mode.is -auto' (பிட், அவுட்) - ஆட்டோ பயன்முறை இயக்கத்தில் இருப்பதைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:253
msgid ""
"'halui.mode.is-joint' (bit, out) - indicates joint by joint jog mode is on"
msgstr ""
"'halui.mode.is -foint' (பிட், அவுட்) - கூட்டு சாக் பயன்முறையால் கூட்டு என்பதைக் "
"குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:254
msgid "'halui.mode.is-manual' (bit, out) - indicates manual mode is on"
msgstr ""
"'halui.mode.is -venual' (பிட், அவுட்) - கையேடு பயன்முறை இயக்கத்தில் இருப்பதைக் "
"குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:255
msgid "'halui.mode.is-mdi' (bit, out) - indicates MDI mode is on"
msgstr ""
"'halui.mode.is -mdi' (பிட், அவுட்) - MDI பயன்முறை இயக்கத்தில் இருப்பதைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:256
msgid ""
"'halui.mode.is-teleop' (bit, out) - indicates coordinated jog mode is on"
msgstr ""
"'halui.mode.is -teleop' (பிட், அவுட்) - ஒருங்கிணைந்த சாக் பயன்முறையில் இருப்பதைக் "
"குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:257
msgid ""
"'halui.mode.joint' (bit, in) - pin for requesting joint by joint jog mode"
msgstr ""
"'halui.mode.joint' (பிட், IN) - கூட்டு சாக் பயன்முறையால் கூட்டு கோருவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:258
msgid "'halui.mode.manual' (bit, in) - pin for requesting manual mode"
msgstr "'halui.mode.anual' (பிட், IN) - கையேடு பயன்முறையைக் கோருவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:259
msgid "'halui.mode.mdi' (bit, in) - pin for requesting MDI mode"
msgstr "'halui.mode.mdi' (பிட், ஐ.என்) - எம்.டி.ஐ பயன்முறையைக் கோருவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:260
msgid "'halui.mode.teleop' (bit, in) - pin for requesting coordinated jog mode"
msgstr "'halui.mode.teleop' (பிட், IN) - ஒருங்கிணைந்த சாக் பயன்முறையை கோருவதற்கு முள்"

#. type: Title ====
#: src/gui/halui.adoc:261 src/man/man1/halui.1.adoc:111
#: src/man/man1/xhc-whb04b-6.1.adoc:222
#, no-wrap
msgid "Program"
msgstr "திட்டம்"

#. type: Plain text
#: src/gui/halui.adoc:264
msgid ""
"'halui.program.block-delete.is-on' (bit, out) - status pin telling that "
"block delete is on"
msgstr "'halui.program."

#. type: Plain text
#: src/gui/halui.adoc:265
msgid ""
"'halui.program.block-delete.off' (bit, in) - pin for requesting that block "
"delete is off"
msgstr "'halui.program."

#. type: Plain text
#: src/gui/halui.adoc:266
msgid ""
"'halui.program.block-delete.on' (bit, in) - pin for requesting that block "
"delete is on"
msgstr ""
"'halui.program.block -delete.on' (பிட், IN) - தொகுதி நீக்குதல் இயக்கப்பட வேண்டும் "
"என்று கோருவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:267
msgid ""
"'halui.program.is-idle' (bit, out) - status pin telling that no program is "
"running"
msgstr ""
"'halui.program.is -idle' (பிட், அவுட்) - நிலை முள் எந்த நிரலும் இயங்கவில்லை என்று "
"கூறுகிறது"

#. type: Plain text
#: src/gui/halui.adoc:268
msgid ""
"'halui.program.is-paused' (bit, out) - status pin telling that a program is "
"paused"
msgstr ""
"'halui.program.is- முன்' (பிட், அவுட்) - ஒரு நிரல் இடைநிறுத்தப்பட்டுள்ளது என்று நிலை "
"முள் கூறுகிறது"

#. type: Plain text
#: src/gui/halui.adoc:269
msgid ""
"'halui.program.is-running' (bit, out) - status pin telling that a program is "
"running"
msgstr ""
"'halui.program.is- ரன்னிங்' (பிட், அவுட்) - ஒரு நிரல் இயங்குகிறது என்று நிலை முள்"

#. type: Plain text
#: src/gui/halui.adoc:270
msgid ""
"'halui.program.optional-stop.is-on' (bit, out) - status pin telling that the "
"optional stop is on"
msgstr ""
"'halui.program.optional-stop.is-on' (பிட், அவுட்)-விருப்பமான நிறுத்தம் இயக்கத்தில் "
"இருப்பதாக நிலை முள் கூறுகிறது"

#. type: Plain text
#: src/gui/halui.adoc:271
msgid ""
"'halui.program.optional-stop.off' (bit, in) - pin requesting that the "
"optional stop is off"
msgstr ""
"'halui.program.optional-top.off' (பிட், ஐ.என்) - விருப்பமான நிறுத்தம் "
"முடக்கப்பட்டதாகக் கோருகிறது"

#. type: Plain text
#: src/gui/halui.adoc:272
msgid ""
"'halui.program.optional-stop.on' (bit, in) - pin requesting that the "
"optional stop is on"
msgstr ""
"'halui.program.optional-top.on' (பிட், ஐ.என்) - விருப்பமான நிறுத்தம் இயக்கத்தில் "
"இருக்க வேண்டும் என்று கோருகிறது"

#. type: Plain text
#: src/gui/halui.adoc:273
msgid "'halui.program.pause' (bit, in) - pin for pausing a program"
msgstr "'halui.program.pause' (பிட், IN) - ஒரு நிரலை இடைநிறுத்துவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:274
msgid "'halui.program.resume' (bit, in) - pin for resuming a paused program"
msgstr ""
"'halui.program.resume' (பிட், ஐ.என்) - இடைநிறுத்தப்பட்ட நிரலை மீண்டும் தொடங்குவதற்கான "
"முள்"

#. type: Plain text
#: src/gui/halui.adoc:275
msgid "'halui.program.run' (bit, in) - pin for running a program"
msgstr "'halui.program.run' (பிட், IN) - ஒரு நிரலை இயக்குவதற்கு முள்"

#. type: Plain text
#: src/gui/halui.adoc:276
msgid "'halui.program.step' (bit, in) - pin for stepping in a program"
msgstr "'halui.program.step' (பிட், ஐ.என்) - ஒரு நிரலில் அடியெடுத்து வைப்பதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:277
msgid "'halui.program.stop' (bit, in) - pin for stopping a program"
msgstr "'halui.program.stop' (பிட், IN) - ஒரு நிரலை நிறுத்துவதற்கான முள்"

#. type: Title ===
#: src/gui/halui.adoc:278 src/man/man1/halui.1.adoc:397
#, no-wrap
msgid "Rapid Override"
msgstr "விரைவான மேலெழுதும்"

#. type: Plain text
#: src/gui/halui.adoc:281
msgid ""
"'halui.rapid-override.count-enable' (bit in (default: TRUE)) - When TRUE, "
"modify Rapid Override when counts changes."
msgstr ""
"'halui.rapid-override.count-enable' (பிட் இன் (இயல்புநிலை: உண்மை))-உண்மையாக "
"இருக்கும்போது, எண்ணும் போது விரைவான மேலெழுதலை மாற்றவும்."

#. type: Plain text
#: src/gui/halui.adoc:282
msgid ""
"'halui.rapid-override.counts' (s32 in) - counts X scale = Rapid Override "
"percentage. Can be used with an encoder or 'direct-value'."
msgstr ""
"'halui.rapid -override.counts' (S32 in) - எண்ணிக்கை ஃச் அளவுகோல் = விரைவான "
"மேலெழுத விழுக்காடு. ஒரு குறியாக்கி அல்லது 'நேரடி-மதிப்பு' உடன் பயன்படுத்தலாம்."

#. type: Plain text
#: src/gui/halui.adoc:283
msgid ""
"'halui.rapid-override.decrease' (bit in) - pin for decreasing the Rapid "
"Override (-=scale)"
msgstr ""
"'halui.rapid-override.decraese' (பிட் இன்)-விரைவான மேலெழுதலைக் குறைப்பதற்கான முள் "
"(-= அளவுகோல்)"

#. type: Plain text
#: src/gui/halui.adoc:284
msgid ""
"'halui.rapid-override.direct-value' (bit in) - pin to enable direct value "
"Rapid Override input"
msgstr ""
"'halui.rapid-override.direct- மதிப்பு' (பிட் இன்)-நேரடி மதிப்பு விரைவான மேலெழுத "
"உள்ளீட்டை இயக்க முள்"

#. type: Plain text
#: src/gui/halui.adoc:285
msgid ""
"'halui.rapid-override.increase' (bit in) - pin for increasing the Rapid "
"Override (+=scale)"
msgstr ""
"'halui.rapid -override.increase' (பிட் இன்) - விரைவான மேலெழுதலை அதிகரிப்பதற்கான "
"முள் (+= அளவுகோல்)"

#. type: Plain text
#: src/gui/halui.adoc:286
msgid ""
"'halui.rapid-override.scale' (float in) - pin for setting the scale on "
"changing the Rapid Override"
msgstr ""
"'halui.rapid -override.scale' (மிதவை) - விரைவான மேலெழுதலை மாற்றுவதற்கான அளவை "
"அமைப்பதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:287
msgid "'halui.rapid-override.value' (float out) - current Rapid Override value"
msgstr ""
"'halui.rapid -override.value' (மிதவை அவுட்) - தற்போதைய விரைவான மேலெழுத மதிப்பு"

#. type: Plain text
#: src/gui/halui.adoc:288
msgid ""
"'halui.rapid-override.reset' (bit, in) - pin for resetting the Rapid "
"Override value (scale=1.0)"
msgstr ""
"'halui.rapid -override.Reset' (பிட், IN) - விரைவான மேலெழுத மதிப்பை மீட்டமைக்க முள் "
"(அளவு = 1.0)"

#. type: Title ===
#: src/gui/halui.adoc:289 src/man/man1/halui.1.adoc:91
#, no-wrap
msgid "Spindle Override"
msgstr "சுழல் மேலெழுதும்"

#. type: Plain text
#: src/gui/halui.adoc:292
msgid ""
"'halui.spindle._N_.override.count-enable' (bit, in) - must be true for "
"'counts' or 'direct-value' to work."
msgstr ""
"'halui.spindle._n_.override.count-enable' (பிட், இல்)-வேலை செய்ய 'எண்ணிக்கைகள்' "
"அல்லது 'நேரடி-மதிப்பு' க்கு உண்மையாக இருக்க வேண்டும்."

#. type: Plain text
#: src/gui/halui.adoc:293
msgid ""
"'halui.spindle._N_.override.counts' (s32, in) - counts * scale = SO "
"percentage.  Can be used with an encoder or 'direct-value'."
msgstr ""
"'halui.spindle._n_.override.counts' (S32, IN) - எண்ணிக்கைகள் * அளவு = எனவே "
"விழுக்காடு. ஒரு குறியாக்கி அல்லது 'நேரடி-மதிப்பு' உடன் பயன்படுத்தலாம்."

#. type: Plain text
#: src/gui/halui.adoc:294
msgid ""
"'halui.spindle._N_.override.decrease' (bit, in) - pin for decreasing the SO "
"(-=scale)"
msgstr ""
"'halui.spindle._n_.override.decrease' (பிட், இன்) - SO ( - = அளவுகோல்) "
"குறைப்பதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:295
msgid ""
"'halui.spindle._N_.override.direct-value' (bit, in) - false when using "
"encoder to change counts, true when setting counts directly."
msgstr ""
"'halui.spindle._n_.override.direct- மதிப்பு' (பிட், IN) - எண்ணிக்கையை மாற்ற "
"குறியாக்கியைப் பயன்படுத்தும் போது தவறானது, எண்ணிக்கையை நேரடியாக அமைக்கும் போது உண்மை."

#. type: Plain text
#: src/gui/halui.adoc:296
msgid ""
"'halui.spindle._N_.override.increase' (bit, in) - pin for increasing the SO "
"(+=scale)"
msgstr ""
"'halui.spindle._n_.override.increase' (பிட், IN) - SO ஐ அதிகரிப்பதற்கான முள் (+= "
"அளவுகோல்)"

#. type: Plain text
#: src/gui/halui.adoc:297
msgid ""
"'halui.spindle._N_.override.scale' (float, in) - pin for setting the scale "
"on changing the SO"
msgstr ""
"'halui.spindle._n_.override.scale' (மிதவை, IN) - SO ஐ மாற்றுவதில் அளவை "
"அமைப்பதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:298
msgid "'halui.spindle._N_.override.value' (float, out) - current SO value"
msgstr "'halui.spindle._n_.override.value' (மிதவை, அவுட்) - தற்போதைய மதிப்பு"

#. type: Plain text
#: src/gui/halui.adoc:299
msgid ""
"'halui.spindle._N_.override.reset' (bit, in) - pin for resetting the SO "
"value (scale=1.0)"
msgstr ""
"'halui.spindle._n_.override.Reset' (பிட், IN) - SO மதிப்பை மீட்டமைப்பதற்கான முள் "
"(அளவு = 1.0)"

#. type: Plain text
#: src/gui/halui.adoc:303
msgid "'halui.spindle._N_.brake-is-on' (bit, out) - indicates brake is on"
msgstr ""
"'halui.spindle._n_.brake-is-on' (பிட், அவுட்)-பிரேக் இயக்கப்பட்டிருப்பதைக் குறிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:304
msgid ""
"'halui.spindle._N_.brake-off' (bit, in) - pin for deactivating spindle/brake"
msgstr ""
"'halui.spindle._n_.brake -off' (பிட், IN) - சுழல்/பிரேக்கை செயலிழக்கச் செய்வதற்கான "
"முள்"

#. type: Plain text
#: src/gui/halui.adoc:305
msgid ""
"'halui.spindle._N_.brake-on' (bit, in) - pin for activating spindle-brake"
msgstr ""
"'halui.spindle._n_.brake-on' (பிட், IN)-சுழல்-பிரேக்கை செயல்படுத்துவதற்கான முள்"

#. type: Plain text
#: src/gui/halui.adoc:306
msgid "'halui.spindle._N_.decrease' (bit, in) - decreases spindle speed"
msgstr "'halui.spindle._n_.decrease' (பிட், ஐ.என்) - சுழல் வேகத்தை குறைக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:307
msgid ""
"'halui.spindle._N_.forward' (bit, in) - starts the spindle with CW motion"
msgstr ""
"'halui.spindle._n_.forward' (பிட், ஐ.என்) - சி.டபிள்யூ இயக்கத்துடன் சுழல் "
"தொடங்குகிறது"

#. type: Plain text
#: src/gui/halui.adoc:308
msgid "'halui.spindle._N_.increase' (bit, in)- increases spindle speed"
msgstr "'halui.spindle._n_.increase' (பிட், ஐ.என்)- சுழல் வேகத்தை அதிகரிக்கிறது"

#. type: Plain text
#: src/gui/halui.adoc:309
msgid ""
"'halui.spindle._N_.is-on' (bit, out) - indicates spindle is on (either "
"direction)"
msgstr ""
"'halui.spindle._n_.is -on' (பிட், அவுட்) - சுழல் இருப்பதைக் குறிக்கிறது (இரு "
"திசையும்)"

#. type: Plain text
#: src/gui/halui.adoc:310
msgid ""
"'halui.spindle._N_.reverse' (bit, in)- starts the spindle with a CCW motion"
msgstr ""
"'halui.spindle._n_.reverse' (பிட், ஐ.என்)- சி.சி.டபிள்யூ இயக்கத்துடன் சுழல் "
"தொடங்குகிறது"

#. type: Plain text
#: src/gui/halui.adoc:311
msgid ""
"'halui.spindle._N_.runs-backward' (bit, out) - indicates spindle is on, and "
"in reverse"
msgstr ""
"'halui.spindle._n_.runs -Backward' (பிட், அவுட்) - சுழல் இயக்கத்தில் இருப்பதைக் "
"குறிக்கிறது, தலைகீழ்"

#. type: Plain text
#: src/gui/halui.adoc:312
msgid ""
"'halui.spindle._N_.runs-forward' (bit, out) - indicates spindle is on, and "
"in forward"
msgstr ""
"'halui.spindle._n_.runs- முன்னோக்கி' (பிட், அவுட்) - சுழல் இயக்கத்தில் இருப்பதைக் "
"குறிக்கிறது, மற்றும் முன்னோக்கி"

#. type: Plain text
#: src/gui/halui.adoc:313
msgid "'halui.spindle._N_.start' (bit, in) - starts the spindle"
msgstr "'halui.spindle._n_.start' (பிட், ஐ.என்) - சுழல் தொடங்குகிறது"

#. type: Plain text
#: src/gui/halui.adoc:314
msgid "'halui.spindle._N_.stop' (bit, in) - stops the spindle"
msgstr "'halui.spindle._n_.stop' (பிட், IN) - சுழற்சியை நிறுத்துகிறது"

#. type: Title ===
#: src/gui/halui.adoc:315 src/man/man1/halui.1.adoc:39
#, no-wrap
msgid "Tool"
msgstr "கருவி"

#. type: Plain text
#: src/gui/halui.adoc:318
msgid ""
"'halui.tool.length-offset.a' (float out) - current applied tool length "
"offset for the A axis"
msgstr ""
"'halui.tool.lengthoffset.a' (மிதவை அவுட்) - ஒரு அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:319
msgid ""
"'halui.tool.length-offset.b' (float out) - current applied tool length "
"offset for the B axis"
msgstr ""
"'halui.tool.length-fechset.b' (மிதவை அவுட்) - பி அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:320
msgid ""
"'halui.tool.length-offset.c' (float out) - current applied tool length "
"offset for the C axis"
msgstr ""
"'halui.tool.length -ffest.c' (மிதவை அவுட்) - சி அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:321
msgid ""
"'halui.tool.length-offset.u' (float out) - current applied tool length "
"offset for the U axis"
msgstr ""
"'halui.tool.lengthoff-set.u' (மிதவை அவுட்) - உ அச்சுக்கு தற்போதைய பயன்பாட்டு கருவி "
"நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:322
msgid ""
"'halui.tool.length-offset.v' (float out) - current applied tool length "
"offset for the V axis"
msgstr ""
"'halui.tool.length-fofsset.v' (மிதவை அவுட்) - வி அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:323
msgid ""
"'halui.tool.length-offset.w' (float out) - current applied tool length "
"offset for the W axis"
msgstr ""
"'halui.tool.length-fofsset.w' (மிதவை அவுட்) - W அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:324
msgid ""
"'halui.tool.length-offset.x' (float out) - current applied tool length "
"offset for the X axis"
msgstr ""
"'halui.tool.length-fechset.x' (மிதவை அவுட்) - ஃச் அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:325
msgid ""
"'halui.tool.length-offset.y' (float out) - current applied tool length "
"offset for the Y axis"
msgstr ""
"'halui.tool.length-fechset.y' (மிதவை அவுட்) - ஒய் அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:326
msgid ""
"'halui.tool.length-offset.z' (float out) - current applied tool length "
"offset for the Z axis"
msgstr ""
"'halui.tool.length-fechset.z' (மிதவை அவுட்) - சட் அச்சுக்கு தற்போதைய பயன்பாட்டு "
"கருவி நீளம் ஆஃப்செட்"

#. type: Plain text
#: src/gui/halui.adoc:327
msgid ""
"'halui.tool.diameter' (float out) - Current tool diameter, or 0 if no tool "
"is loaded."
msgstr ""
"'halui.tool.diameter' (மிதவை வெளியே) - தற்போதைய கருவி விட்டம், அல்லது 0 எந்த "
"கருவியும் ஏற்றப்படாவிட்டால் 0."

#. type: Plain text
#: src/gui/halui.adoc:328
msgid "'halui.tool.number' (u32, out) - indicates current selected tool"
msgstr ""
"'halui.tool.number' (U32, Out) - தற்போதைய தேர்ந்தெடுக்கப்பட்ட கருவியைக் குறிக்கிறது"

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/image-to-gcode.adoc:5 src/gui/image-to-gcode.adoc:13
#, no-wrap
msgid "Image to G-Code"
msgstr "சி-குறியீட்டிற்கு படம்"

#. type: Target for macro image
#: src/gui/image-to-gcode.adoc:13
#, no-wrap
msgid "images/image-to-gcode.png"
msgstr "படங்கள்/படம்-க்கு-gcode.png"

#. type: Title ==
#: src/gui/image-to-gcode.adoc:15
#, no-wrap
msgid "What is a depth map?"
msgstr "ஆழமான வரைபடம் என்றால் என்ன?"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:19
msgid ""
"A depth map is a greyscale image where the brightness of each pixel "
"corresponds to the depth (or height) of the object at each point."
msgstr ""
"ஆழமான வரைபடம் என்பது ஒரு கிரேச்கேல் படமாகும், அங்கு ஒவ்வொரு பிக்சலின் பிரகாசமும் "
"ஒவ்வொரு புள்ளியிலும் பொருளின் ஆழத்திற்கு (அல்லது உயரம்) ஒத்திருக்கிறது."

#. type: Title ==
#: src/gui/image-to-gcode.adoc:20
#, no-wrap
msgid "Integrating image-to-gcode with the AXIS user interface"
msgstr "அச்சு-க்கு-GCODE ஐ அச்சு பயனர் இடைமுகத்துடன் ஒருங்கிணைத்தல்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:25
msgid ""
"Add the following lines to the '[FILTER]' section of your INI file to make "
"AXIS automatically invoke image-to-gcode when you open a PNG, GIF, or JPEG "
"image:"
msgstr ""
"உங்கள் இனி கோப்பின் '[வடிகட்டி]' பிரிவில் பின்வரும் வரிகளைச் சேர்க்கவும், நீங்கள் ஒரு PNG, "
"GIF அல்லது JPEG படத்தைத் திறக்கும்போது அச்சுக்கு தானாகவே படத்திலிருந்து GCODE ஐ "
"அழைக்கவும்:"

#. type: delimited block -
#: src/gui/image-to-gcode.adoc:32
#, no-wrap
msgid ""
"PROGRAM_EXTENSION = .png,.gif,.jpg Grayscale Depth Image\n"
"png = image-to-gcode\n"
"gif = image-to-gcode\n"
"jpg = image-to-gcode\n"
msgstr ""
"Program_extension = .png, .gif, .jpg கிரேச்கேல் ஆழம் படம்\n"
" Png = படம்-க்கு-GCODE\n"
" GIF = படம்-க்கு-GCODE\n"
" JPG = படம்-க்கு-GCODE\n"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:36
msgid ""
"The standard 'sim/axis.ini' configuration file is already prepared this way."
msgstr ""
"நிலையான 'சிம்/ஆக்சிச்.இனி' உள்ளமைவு கோப்பு ஏற்கனவே இந்த வழியில் தயாரிக்கப்பட்டுள்ளது."

#. type: Title ==
#: src/gui/image-to-gcode.adoc:37
#, no-wrap
msgid "Using `image-to-gcode`"
msgstr "`படத்திலிருந்து-GCODE` ஐப் பயன்படுத்துதல்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:41
msgid ""
"Start image-to-gcode either by opening an image file in AXIS, or by invoking "
"image-to-gcode from the terminal, as follows:"
msgstr ""
"ஒரு படக் கோப்பை அச்சில் திறப்பதன் மூலமாகவோ அல்லது முனையத்திலிருந்து படத்திலிருந்து "
"GCODE ஐ செயல்படுத்துவதன் மூலமாகவோ படத்திலிருந்து-GCODE ஐத் தொடங்கவும்:"

#. type: delimited block -
#: src/gui/image-to-gcode.adoc:44
#, no-wrap
msgid "image-to-gcode torus.png > torus.ngc\n"
msgstr "image-to-gcode torus.png> torus.ngc\n"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:52
msgid ""
"Verify all the settings in the right-hand column, then press OK to create "
"the G-code. Depending on the image size and options chosen, this may take "
"from a few seconds to a few minutes. If you are loading the image in AXIS, "
"the G-code will automatically be loaded and previewed once image-to-gcode "
"completes. In AXIS, hitting reload will show the image-to-gcode option "
"screen again, allowing you to tweak them."
msgstr ""
"வலது கை நெடுவரிசையில் உள்ள அனைத்து அமைப்புகளையும் சரிபார்க்கவும், பின்னர் சி-குறியீட்டை "
"உருவாக்க சரி என்பதை அழுத்தவும். படத்தின் அளவு மற்றும் தேர்ந்தெடுக்கப்பட்ட விருப்பங்களைப் "
"பொறுத்து, இது சில வினாடிகள் முதல் சில நிமிடங்கள் வரை ஆகலாம். நீங்கள் படத்தை அச்சில் "
"ஏற்றினால், படத்திலிருந்து GCODE முடிந்ததும் சி-குறியீடு தானாக ஏற்றப்பட்டு "
"முன்னோட்டமிடப்படும். அச்சில், மறுஏற்றம் அடிப்பது படத்திலிருந்து GCODE விருப்பத் திரையை "
"மீண்டும் காண்பிக்கும், அவற்றை மாற்றியமைக்க உங்களை அனுமதிக்கும்."

#. type: Title ==
#: src/gui/image-to-gcode.adoc:53
#, no-wrap
msgid "Option Reference"
msgstr "விருப்ப குறிப்பு"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:59
msgid ""
"Specifies whether to use G20 (inches) or G21 (mm) in the generated G-code "
"and as the units for each option labeled '(units)'."
msgstr ""
"உருவாக்கப்பட்ட சி-குறியீட்டில் ஐயா 20 (அங்குலங்கள்) அல்லது ஐயா 21 (மிமீ) ஐப் "
"பயன்படுத்தலாமா என்பதையும், '(அலகுகள்)' என்று பெயரிடப்பட்ட ஒவ்வொரு விருப்பத்திற்கும் "
"அலகுகளாகவும் குறிப்பிடுகிறது."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:60
#, no-wrap
msgid "Invert Image"
msgstr "படம் தலைகீழ்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:65
msgid ""
"If \"no\", the black pixel is the lowest point and the white pixel is the "
"highest point. If \"yes\", the black pixel is the highest point and the "
"white pixel is the lowest point."
msgstr ""
"\"இல்லை\" என்றால், கருப்பு படப்புள்ளி மிகக் குறைந்த புள்ளி மற்றும் வெள்ளை படப்புள்ளி மிக "
"உயர்ந்த புள்ளியாகும். \"ஆம்\" என்றால், கருப்பு படப்புள்ளி மிக உயர்ந்த புள்ளி மற்றும் வெள்ளை "
"படப்புள்ளி மிகக் குறைந்த புள்ளியாகும்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:66
#, no-wrap
msgid "Normalize Image"
msgstr "படத்தை இயல்பாக்குங்கள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:70
msgid ""
"If 'yes', the darkest pixel is remapped to black, the lightest pixel is "
"remapped to white."
msgstr ""
"'ஆம்' என்றால், இருண்ட படப்புள்ளி கருப்பு நிறமாக மாற்றப்பட்டால், லேசான படப்புள்ளி வெள்ளை "
"நிறமாக மாற்றப்படுகிறது."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:71
#, no-wrap
msgid "Expand Image Border"
msgstr "பட எல்லையை விரிவாக்குங்கள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:77
msgid ""
"If 'None', the input image is used as-is, and details which are at the very "
"edges of the image may be cut off. If 'White' or 'Black', then a border of "
"pixels equal to the tool diameter is added on all sides, and details which "
"are at the very edges of the images will not be cut off."
msgstr ""
"'எதுவுமில்லை' என்றால், உள்ளீட்டு படம் பயன்படுத்தப்படுகிறது, மேலும் படத்தின் விளிம்புகளில் "
"உள்ள விவரங்கள் துண்டிக்கப்படலாம். 'வெள்ளை' அல்லது 'கருப்பு' என்றால், கருவி விட்டம் சமமான "
"பிக்சல்களின் எல்லை எல்லா பக்கங்களிலும் சேர்க்கப்படுகிறது, மேலும் படங்களின் விளிம்புகளில் உள்ள "
"விவரங்கள் துண்டிக்கப்படாது."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:78
#, no-wrap
msgid "Tolerance (units)"
msgstr "சகிப்புத்தன்மை (அலகுகள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:84
msgid ""
"When a series of points are within 'tolerance' of being a straight line, "
"they are output as a straight line.  Increasing tolerance can lead to better "
"contouring performance in LinuxCNC, but can also remove or blur small "
"details in the image."
msgstr ""
"ஒரு தொடர்ச்சியான புள்ளிகள் ஒரு நேர் கோட்டாக இருப்பதற்கான 'சகிப்புத்தன்மைக்கு' இருக்கும் "
"போது, அவை ஒரு நேர் கோட்டாக வெளியீடாகும். சகிப்புத்தன்மையை அதிகரிப்பது Linuxcnc இல் "
"சிறந்த வரையறைக்கு வழிவகுக்கும், ஆனால் படத்தில் சிறிய விவரங்களையும் அகற்றலாம் அல்லது மங்கச் "
"செய்யலாம்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:85
#, no-wrap
msgid "Pixel Size (units)"
msgstr "படப்புள்ளி அளவு (அலகுகள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:91
msgid ""
"One pixel in the input image will be this many units--usually this number is "
"much smaller than 1.0. For instance, to mill a 2.5x2.5-inch object from a "
"400x400 image file, use a pixel size of .00625, because 2.5 / 400 = .00625."
msgstr ""
"உள்ளீட்டு படத்தில் ஒரு படப்புள்ளி இந்த பல அலகுகளாக இருக்கும்-பொதுவாக இந்த எண்ணிக்கை 1.0 ஐ "
"விட மிகச் சிறியது. உதாரணமாக, 400x400 படக் கோப்பிலிருந்து 2.5x2.5-இன்ச் பொருளை "
"ஆலைக்கு, .00625 இன் படப்புள்ளி அளவைப் பயன்படுத்தவும், ஏனெனில் 2.5 / 400 = .00625."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:92
#, no-wrap
msgid "Plunge Feed Rate (units per minute)"
msgstr "தீவன விகிதம் (நிமிடத்திற்கு அலகுகள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:95
msgid "The feed rate for the initial plunge movement."
msgstr "ஆரம்ப வீழ்ச்சி இயக்கத்திற்கான தீவன விகிதம்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:96
#, no-wrap
msgid "Feed Rate (units per minute)"
msgstr "தீவன வீதம் (நிமிடத்திற்கு அலகுகள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:99
msgid "The feed rate for other parts of the path."
msgstr "பாதையின் பிற பகுதிகளுக்கான தீவன விகிதம்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:100
#, no-wrap
msgid "Spindle Speed (RPM)"
msgstr "சுழல் விரைவு (ஆர்.பி.எம்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:103
msgid "The spindle speed S-code that should be put into the G-code file."
msgstr "சி-கோட் கோப்பில் வைக்கப்பட வேண்டிய சுழல் விரைவு எச்-குறியீடு."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:104
#, no-wrap
msgid "Scan Pattern"
msgstr "ச்கேன் முறை"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:107
msgid "Possible scan patterns are:"
msgstr "சாத்தியமான ச்கேன் வடிவங்கள்:"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:109
msgid "Rows"
msgstr "வரிசைகள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:110
msgid "Columns"
msgstr "நெடுவரிசைகள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:111
msgid "Rows, then Columns"
msgstr "வரிசைகள், பின்னர் நெடுவரிசைகள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:112
msgid "Columns, then Rows"
msgstr "நெடுவரிசைகள், பின்னர் வரிசைகள்"

#. type: Title ===
#: src/gui/image-to-gcode.adoc:113
#, no-wrap
msgid "Scan Direction"
msgstr "திசையை ச்கேன் செய்யுங்கள்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:116
msgid "Possible scan directions are:"
msgstr "சாத்தியமான ச்கேன் திசைகள்:"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:119
msgid ""
"Positive: Start milling at a low X or Y axis value, and move towards a high "
"X or Y axis value."
msgstr ""
"நேர்மறை: குறைந்த ஃச் அல்லது ஒய் அச்சு மதிப்பில் அரைப்பதைத் தொடங்கி, உயர் ஃச் அல்லது ஒய் "
"அச்சு மதிப்பை நோக்கி நகர்த்தவும்."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:121
msgid ""
"Negative: Start milling at a high X or Y axis value, and move towards a low "
"X or Y axis value."
msgstr ""
"எதிர்மறை: உயர் ஃச் அல்லது ஒய் அச்சு மதிப்பில் அரைப்பதைத் தொடங்கி, குறைந்த ஃச் அல்லது ஒய் "
"அச்சு மதிப்பை நோக்கி நகர்த்தவும்."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:123
msgid ""
"Alternating: Start on the same end of the X or Y axis travel that the last "
"move ended on. This reduces the amount of traverse movements."
msgstr ""
"மாற்று: கடைசி நகர்வு முடிவடைந்த ஃச் அல்லது ஒய் அச்சு பயணத்தின் அதே முடிவில் தொடங்கவும். "
"இது பயண இயக்கங்களின் அளவைக் குறைக்கிறது."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:124
msgid "Up Milling: Start milling at low points, moving towards high points."
msgstr ""
"அப் அரைத்தல்: குறைந்த புள்ளிகளில் அரைப்பதைத் தொடங்குங்கள், அதிக புள்ளிகளை நோக்கி நகரும்."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:125
msgid "Down Milling: Start milling at high points, moving towards low points."
msgstr ""
"பேரூர் அரைக்கும்: அதிக புள்ளிகளில் அரைக்கத் தொடங்கி, குறைந்த புள்ளிகளை நோக்கி நகரும்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:126
#, no-wrap
msgid "Depth (units)"
msgstr "ஆழம் (அலகுகள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:130
msgid ""
"The top of material is always at 'Z = 0'.  The deepest cut into the material "
"is at _Z = -depth_."
msgstr ""
"பொருளின் மேற்பகுதி எப்போதும் 'சட் = 0' இல் இருக்கும். பொருளில் ஆழமான வெட்டு _Z = "
"-Depth_ இல் உள்ளது."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:131
#, no-wrap
msgid "Step Over (pixels)"
msgstr "படி (பிக்சல்கள்)"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:138
msgid ""
"The distance between adjacent rows or columns. To find the number of pixels "
"for a given units distance, compute 'distance/pixel size' and round to the "
"nearest whole number. For example, if 'pixel size=.006' and the desired step "
"over 'distance=.015', then use a Step Over of 2 or 3 pixels, because "
"'.015/.006=2.5'."
msgstr ""
"அருகிலுள்ள வரிசைகள் அல்லது நெடுவரிசைகளுக்கு இடையிலான தூரம். கொடுக்கப்பட்ட அலகுகள் "
"தூரத்திற்கான பிக்சல்களின் எண்ணிக்கையைக் கண்டறிய, 'தூரம்/பிக்சல் அளவு' மற்றும் அருகிலுள்ள "
"முழு எண்ணுக்கு வட்டமிடுங்கள். எடுத்துக்காட்டாக, 'படப்புள்ளி அளவு = .006' மற்றும் 'தூரம் = "
".015' க்கு மேல் விரும்பிய படி என்றால், 2 அல்லது 3 பிக்சல்களுக்கு மேல் ஒரு படி "
"பயன்படுத்தவும், ஏனெனில் '.015/.006 = 2.5'."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:139
#, no-wrap
msgid "Tool Diameter"
msgstr "கருவி விட்டம்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:142
msgid "The diameter of the cutting part of the tool."
msgstr "கருவியின் வெட்டும் பகுதியின் விட்டம்."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:143
#, no-wrap
msgid "Safety Height"
msgstr "பாதுகாப்பு உயரம்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:147
msgid ""
"The height to move to for traverse movements. image-to-gcode always assumes "
"the top of material is at 'Z=0'."
msgstr ""
"டிராவர்ச் அசைவுகளுக்கு செல்ல வேண்டிய உயரம். படம்-க்கு-GCODE எப்போதும் பொருளின் மேற்புறம் "
"'சட் = 0' என்று கருதுகிறது."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:148
#, no-wrap
msgid "Tool Type"
msgstr "கருவி வகை"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:151
msgid "The shape of the cutting part of the tool. Possible tool shapes are:"
msgstr "கருவியின் வெட்டும் பகுதியின் வடிவம். சாத்தியமான கருவி வடிவங்கள்:"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:153
msgid "Ball End"
msgstr "பந்து முனை"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:154
msgid "Flat End"
msgstr "தட்டையான முடிவு"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:155
msgid "45 degree \"vee\""
msgstr "45 டிகிரி \"வீ\""

#. type: Plain text
#: src/gui/image-to-gcode.adoc:156
msgid "60 degree \"vee\""
msgstr "60 டிகிரி \"வீ\""

#. type: Title ===
#: src/gui/image-to-gcode.adoc:157
#, no-wrap
msgid "Lace bounding"
msgstr "சரிகை எல்லை"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:162
msgid ""
"This controls whether areas that are relatively flat along a row or column "
"are skipped. This option only makes sense when both rows and columns are "
"being milled. Possible bounding options are:"
msgstr ""
"ஒரு வரிசை அல்லது நெடுவரிசையில் ஒப்பீட்டளவில் தட்டையான பகுதிகள் தவிர்க்கப்பட்டதா என்பதை "
"இது கட்டுப்படுத்துகிறது. வரிசைகள் மற்றும் நெடுவரிசைகள் இரண்டும் அரைக்கப்படும் போது "
"மட்டுமே இந்த விருப்பம் அர்த்தமுள்ளதாக இருக்கும். சாத்தியமான எல்லை விருப்பங்கள்:"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:164
msgid "None: Rows and columns are both fully milled."
msgstr "எதுவுமில்லை: வரிசைகள் மற்றும் நெடுவரிசைகள் இரண்டும் முழுமையாக அரைக்கப்படுகின்றன."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:166
msgid ""
"Secondary: When milling in the second direction, areas that do not strongly "
"slope in that direction are skipped."
msgstr ""
"இரண்டாம் நிலை: இரண்டாவது திசையில் அரைக்கும் போது, அந்த திசையில் வலுவாக சாய்வு செய்யாத "
"பகுதிகள் தவிர்க்கப்படுகின்றன."

#. type: Plain text
#: src/gui/image-to-gcode.adoc:170
msgid ""
"Full: When milling in the first direction, areas that strongly slope in the "
"second direction are skipped. When milling in the second direction, areas "
"that do not strongly slope in that direction are skipped."
msgstr ""
"முழு: முதல் திசையில் அரைக்கும் போது, இரண்டாவது திசையில் வலுவாக சாய்வு செய்யும் "
"பகுதிகள் தவிர்க்கப்படுகின்றன. இரண்டாவது திசையில் அரைக்கும் போது, அந்த திசையில் வலுவாக "
"சாய்வு செய்யாத பகுதிகள் தவிர்க்கப்படுகின்றன."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:171
#, no-wrap
msgid "Contact angle"
msgstr "தொடர்பு கோணம்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:176
msgid ""
"When 'Lace bounding' is not 'None', slopes greater than 'Contact angle' are "
"considered to be 'strong' slopes, and slopes less than that angle are "
"considered to be weak slopes."
msgstr ""
"'சரிகை எல்லை' 'எதுவுமில்லை' இல்லாதபோது, 'தொடர்பு கோணத்தை' விட அதிகமான சரிவுகள் "
"'வலுவான' சரிவுகளாகக் கருதப்படுகின்றன, மேலும் அந்த கோணத்தை விட குறைவான சரிவுகள் "
"பலவீனமான சரிவுகளாகக் கருதப்படுகின்றன."

#. type: Title ===
#: src/gui/image-to-gcode.adoc:177
#, no-wrap
msgid "Roughing offset and depth per pass"
msgstr "ஒரு பாசுக்கு தோராயமான ஆஃப்செட் மற்றும் ஆழம்"

#. type: Plain text
#: src/gui/image-to-gcode.adoc:188
msgid ""
"Image-to-gcode can optionally perform roughing passes. The depth of "
"successive roughing passes is given by 'Roughing depth per pass'. For "
"instance, entering 0.2 will perform the first roughing pass with a depth of "
"0.2, the second roughing pass with a depth of 0.4, and so on until the full "
"Depth of the image is reached. No part of any roughing pass will cut closer "
"than Roughing Offset to the final part. The following figure shows a tall "
"vertical feature being milled.  In this image, Roughing depth per pass is "
"0.2 inches and roughing offset is 0.1 inches."
msgstr ""
"படம்-க்கு-GCODE விருப்பமாக தோராயமான பாச்களைச் செய்யலாம். அடுத்தடுத்த முரட்டுத்தனமான "
"பாச்களின் ஆழம் 'ஒரு பாசுக்கு கடினமான ஆழம்' மூலம் வழங்கப்படுகிறது. உதாரணமாக, 0.2 க்குள் "
"நுழைவது முதல் தோராயமான மொழி 0.2 ஆழம், இரண்டாவது கரடுமுரடான பாச் 0.4 ஆழத்துடன் "
"செய்யும், மற்றும் படத்தின் முழு ஆழத்தை அடையும் வரை. எந்தவொரு கடினமான பாசின் பகுதியும் "
"இறுதி பகுதிக்கு ஆஃப்செட்டை விட நெருக்கமாக குறைக்காது. பின்வரும் எண்ணிக்கை ஒரு உயரமான "
"செங்குத்து நற்பொருத்தம் அரைக்கப்படுவதைக் காட்டுகிறது. இந்த படத்தில், ஒரு பாசுக்கு "
"கரடுமுரடான ஆழம் 0.2 அங்குலங்கள் மற்றும் தோராயமான ஆஃப்செட் 0.1 அங்குலங்கள்."

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/image-to-gcode.adoc:189 src/gui/image-to-gcode.adoc:190
#, no-wrap
msgid "Roughing passes and final pass"
msgstr "தோராயமான பாச்கள் மற்றும் இறுதி பாச்"

#. type: Target for macro image
#: src/gui/image-to-gcode.adoc:190
#, no-wrap
msgid "images/i2g-roughing.png"
msgstr "படங்கள்/i2g-roughing.png"

#. type: Title =
#: src/gui/mdro.adoc:5
#, no-wrap
msgid "MDRO GUI"
msgstr ""

#. type: Index entry
#: src/gui/mdro.adoc:22
#, fuzzy
#| msgid "Post GUI"
msgid "mdro GUI"
msgstr "போச்ட் குய்"

#. type: Plain text
#: src/gui/mdro.adoc:22
msgid ""
"MDRO is a simple graphical front-end for LinuxCNC providing a display of "
"data from Digital Read Out (DRO) scales. It provides functionality similar "
"to a normal machinist's DRO display, allowing the user to use the DRO scales "
"on the machine when operating in a manual-only (hand-cranked) mode. It is "
"most useful for manual machines such as DRO equipped Bridgeport style mills "
"that have been converted to CNC but still have the manual controls."
msgstr ""
"எம்.டி.ஆர்.ஓ என்பது லினக்ச்.சி.என்.சிக்கு டிசிட்டல் ரீட் அவுட் (டி.ஆர்.ஓ) அளவீடுகளிலிருந்து "
"தரவின் காட்சியை வழங்கும் எளிய வரைகலை முன்-இறுதி. இது ஒரு சாதாரண இயந்திரவியலாளரின் "
"டி.ஆர்.ஓ டிச்ப்ளேவைப் போன்ற செயல்பாட்டை வழங்குகிறது, இது கையேடு-மட்டும் (கை-கிராங்க்) "
"பயன்முறையில் இயங்கும்போது கணினியில் டி.ஆர்.ஓ அளவீடுகளைப் பயன்படுத்த பயனரை "
"அனுமதிக்கிறது. டி.ஆர்.ஓ பொருத்தப்பட்ட பிரிட்ச்போர்ட் பாணி மில்ச் போன்ற கையேடு "
"இயந்திரங்களுக்கு இது மிகவும் பயனுள்ளதாக இருக்கும், அவை சி.என்.சி ஆக மாற்றப்பட்டுள்ளன, "
"ஆனால் இன்னும் கையேடு கட்டுப்பாடுகள் உள்ளன."

#. type: Plain text
#: src/gui/mdro.adoc:24
msgid "MDRO is mouse and touch screen friendly."
msgstr "Mdro என்பது சுட்டி மற்றும் தொடுதிரை நட்பு."

#. type: Title ==
#: src/gui/mdro.adoc:26 src/gui/mdro.adoc:27 src/gui/mdro.adoc:92
#, no-wrap
msgid "MDRO Window"
msgstr "Mdro சாளரம்"

#. type: Target for macro image
#: src/gui/mdro.adoc:27
#, no-wrap
msgid "images/mdro.png"
msgstr "படங்கள்/mdro.png"

#. type: Plain text
#: src/gui/mdro.adoc:38
msgid ""
"If your configuration is not currently set up to use MDRO, you can change it "
"by editing the INI file. In the `[DISPLAY]` section, change the `DISPLAY =` "
"line to read `DISPLAY = mdro`. MDRO defaults to XYZ for the axes but that "
"can be changed.  Set `[DISPLAY]` section `GEOMETRY = XYZ` for a 3 axis mill. "
"A lathe with with DRO scales on the X and Z axes might use `GEOMETRY = XZ`."
msgstr ""
"MDRO ஐப் பயன்படுத்த உங்கள் உள்ளமைவு தற்போது அமைக்கப்படவில்லை என்றால், இனி கோப்பைத் "
"திருத்துவதன் மூலம் அதை மாற்றலாம். `[காட்சி]` பிரிவில், `காட்சி = mdro` ஐப் படிக்க` "
"காட்சி = `வரியை மாற்றவும். MDRO அச்சுகளுக்கு XYZ க்கு இயல்புநிலையாகிறது, ஆனால் அதை "
"மாற்றலாம். 3 அச்சு ஆலைக்கு `[காட்சி]` பிரிவு `வடிவியல் = xyz` ஐ அமைக்கவும். ஃச் மற்றும் "
"சட் அச்சுகளில் டி.ஆர்.ஓ செதில்களைக் கொண்ட ஒரு லேத் `வடிவியல் = xz` ஐப் பயன்படுத்தலாம்."

#. type: Plain text
#: src/gui/mdro.adoc:41
msgid ""
"When MDRO starts, a window like the one in the figure <<fig:mdro-window>> "
"above opens."
msgstr ""
"MDRO தொடங்கும் போது, படம் <<fig:mdro-window>> மேலே உள்ளதைப் போன்ற ஒரு சாளரம் "
"திறக்கிறது."

#. type: Title ===
#: src/gui/mdro.adoc:42
#, no-wrap
msgid "INI File Options"
msgstr "இது கோப்பு விருப்பங்கள்"

#. type: Plain text
#: src/gui/mdro.adoc:45
msgid "Other options that can be included on the `[DISPLAY]` section include:"
msgstr "`[காட்சி]` பிரிவில் சேர்க்கக்கூடிய பிற விருப்பங்கள் பின்வருமாறு:"

#. type: Plain text
#: src/gui/mdro.adoc:47
msgid ""
"`MDRO_VAR_FILE = <file.var>` - preload G54 - G57 coordinate system data."
msgstr ""
"`Mdro_var_file = <file.var>` - g54 ஐ முன் ஏற்றவும் - G57 கணினி தரவை ஒருங்கிணைத்தல்."

#. type: Plain text
#: src/gui/mdro.adoc:49
msgid ""
"Preload a .var file. This is typically the .var file used by the operational "
"code."
msgstr ""
"ஒரு .var கோப்பை முன்னரே ஏற்றவும். இது பொதுவாக செயல்பாட்டுக் குறியீட்டால் "
"பயன்படுத்தப்படும் .var கோப்பு."

#. type: Plain text
#: src/gui/mdro.adoc:50
msgid "`POINT_SIZE = <n>` - Set text point size."
msgstr "`Point_size = <n>` - உரை புள்ளி அளவை அமைக்கவும்."

#. type: Plain text
#: src/gui/mdro.adoc:53
msgid ""
"This option sets the size of the font used which sets the overall size of "
"the window. The default point size is 20, Typical sizes are 20 to 30."
msgstr ""
"இந்த விருப்பம் பயன்படுத்தப்படும் எழுத்துருவின் அளவை அமைக்கிறது, இது சாளரத்தின் ஒட்டுமொத்த "
"அளவை அமைக்கிறது. இயல்புநிலை புள்ளி அளவு 20, வழக்கமான அளவுகள் 20 முதல் 30 வரை."

#. type: Plain text
#: src/gui/mdro.adoc:54
msgid "`MM = 1` Set this if the DRO scales provide data scaled in millimeters."
msgstr ""
"`மிமீ = 1` மில்லிமீட்டரில் அளவிடப்பட்ட தரவை டி.ஆர்.ஓ அளவுகள் வழங்கினால் இதை அமைக்கவும்."

#. type: Plain text
#: src/gui/mdro.adoc:59
msgid ""
"MDRO can be started by a `loadusr` command in a HAL file. Options equivalent "
"to those in the INI file can be set on the command line:"
msgstr ""
"MDRO ஐ HAL கோப்பில் `loadusr` கட்டளை மூலம் தொடங்கலாம். ஐ.என்.ஐ கோப்பில் உள்ளவர்களுக்கு "
"சமமான விருப்பங்கள் கட்டளை வரியில் அமைக்கப்படலாம்:"

#. type: Plain text
#: src/gui/mdro.adoc:61
msgid "`-l <file.var>` - preload G54 - G57 coordinate system data."
msgstr "`-l <file.var>` - g54 ஐ முன் ஏற்றவும் - G57 கணினி தரவை ஒருங்கிணைத்தல்."

#. type: Plain text
#: src/gui/mdro.adoc:62
msgid "`-p <n>` - Set text point size."
msgstr "`-p <n>` - உரை புள்ளி அளவை அமைக்கவும்."

#. type: Plain text
#: src/gui/mdro.adoc:63
msgid "`-m` - Set this if the DRO scales provide data scaled in millimeters."
msgstr ""
"`-m` - டி.ஆர்.ஓ அளவீடுகள் மில்லிமீட்டரில் அளவிடப்பட்ட தரவை வழங்கினால் இதை அமைக்கவும்."

#. type: Plain text
#: src/gui/mdro.adoc:64
msgid "`<axes>` - axes to display. See `GEOMETRY` above."
msgstr "`<அச்சுகள்>` - காண்பிக்க அச்சுகள். மேலே `வடிவியல்` ஐப் பார்க்கவும்."

#. type: Plain text
#: src/gui/mdro.adoc:69
msgid ""
"Using an example of \"XYZA\" for an AXES argument, these pins will be "
"created when MDRO starts:"
msgstr ""
"அச்சுகள் வாதத்திற்கு \"xyza\" இன் எடுத்துக்காட்டு பயன்படுத்தி, MDRO தொடங்கும் போது இந்த "
"ஊசிகளை உருவாக்கும்:"

#. type: delimited block -
#: src/gui/mdro.adoc:80
#, no-wrap
msgid ""
"mdro.axis.0\n"
"mdro.axis.1\n"
"mdro.axis.2\n"
"mdro.axis.3\n"
"mdro.index-enable.0\n"
"mdro.index-enable.1\n"
"mdro.index-enable.2\n"
"mdro.index-enable.3\n"
msgstr ""
"Mdro.axis.0\n"
" Mdro.axis.1\n"
" Mdro.axis.2\n"
" Mdro.axis.3\n"
" mdro.index-enable.0\n"
" mdro.index-enable.1\n"
" mdro.index-enable.2\n"
" mdro.index-enable.3\n"

#. type: Plain text
#: src/gui/mdro.adoc:86
msgid ""
"In this example, the first row of the display will be labeled `X` and will "
"show the data from the DRO scale connected to pin `mdro.axis.0`. The "
"`mdro.index-enable.n` pins should be connected to the index pins of the DRO "
"if the DRO supports them."
msgstr ""
"இந்த எடுத்துக்காட்டில், காட்சியின் முதல் வரிசை `x` என்று பெயரிடப்பட்டு, முள்` "
"mdro.axis.0` உடன் இணைக்கப்பட்ட டி.ஆர்.ஓ அளவிலிருந்து தரவைக் காண்பிக்கும். டி.ஆர்.ஓவை "
"ஆதரித்தால், `mdro.index-enable.n` ஊசிகளை DRO இன் குறியீட்டு ஊசிகளுடன் இணைக்க வேண்டும்."

#. type: Plain text
#: src/gui/mdro.adoc:91
msgid ""
"The pins must be connected in the file specified in the `POSTGUI_HALFILE` "
"entry of the INI file when the program is started from an INI file. They can "
"be set directly after the loadusr command if the program is started in a HAL "
"file."
msgstr ""
"ஐ.என்.ஐ கோப்பிலிருந்து நிரல் தொடங்கப்படும் போது ஐ.என்.ஐ கோப்பின் `Postgui_halfile` "
"நுழைவில் குறிப்பிடப்பட்டுள்ள கோப்பில் ஊசிகளை இணைக்க வேண்டும். HAL கோப்பில் நிரல் "
"தொடங்கப்பட்டால் அவற்றை LOADUSR கட்டளைக்குப் பிறகு நேரடியாக அமைக்கலாம்."

#. type: Plain text
#: src/gui/mdro.adoc:95
msgid "The MDRO window contains the following elements:"
msgstr "MDRO சாளரத்தில் பின்வரும் கூறுகள் உள்ளன:"

#. type: Plain text
#: src/gui/mdro.adoc:97
msgid "A row for each axis. Each row includes:"
msgstr "ஒவ்வொரு அச்சுக்கும் ஒரு வரிசை. ஒவ்வொரு வரிசையிலும் அடங்கும்:"

#. type: Plain text
#: src/gui/mdro.adoc:98
msgid "the name of the axis,"
msgstr "அச்சின் பெயர்,"

#. type: Plain text
#: src/gui/mdro.adoc:99
msgid "the current value,"
msgstr "தற்போதைய மதிப்பு,"

#. type: Plain text
#: src/gui/mdro.adoc:100
msgid "a \"z\" button that zeros the value,"
msgstr "மதிப்பை பூச்சியமாக்கும் \"சட்\" பொத்தான்,"

#. type: Plain text
#: src/gui/mdro.adoc:101
msgid "a \"1/2\" button that halves the value,"
msgstr "மதிப்பைக் குறைக்கும் \"1/2\" பொத்தானை,"

#. type: Plain text
#: src/gui/mdro.adoc:103
msgid ""
"a entry field that can be used to set a user-defined value. This field can "
"be set from the keyboard or from the on-screen keypad."
msgstr ""
"பயனர் வரையறுக்கப்பட்ட மதிப்பை அமைக்க பயன்படுத்தக்கூடிய நுழைவு புலம். இந்த புலம் "
"விசைப்பலகையிலிருந்து அல்லது திரையில் விசைப்பலகையிலிருந்து அமைக்கப்படலாம்."

#. type: Plain text
#: src/gui/mdro.adoc:104
msgid "A \"I\" button that starts an index operation (see below),"
msgstr "ஒரு குறியீட்டு செயல்பாட்டைத் தொடங்கும் \"நான்\" பொத்தானை (கீழே காண்க),"

#. type: Plain text
#: src/gui/mdro.adoc:106
msgid ""
"a keypad used to set values in the entry field via a mouse or touchscreen,"
msgstr ""
"நுழைவு புலத்தில் மதிப்புகளை ஒரு சுட்டி அல்லது தொடுதிரை வழியாக அமைக்க பயன்படுத்தப்படும் "
"ஒரு விசைப்பலகையை,"

#. type: Plain text
#: src/gui/mdro.adoc:107
msgid "coordinate system selection buttons:"
msgstr "கணினி தேர்வு பொத்தான்களை ஒருங்கிணைத்தல்:"

#. type: Plain text
#: src/gui/mdro.adoc:110
msgid ""
"The \"mcs\" button selects the machine coordinate system. These are the raw "
"values from the encoders connected to the `mdro.axis.n` pins."
msgstr ""
"\"எம்.சி.எச்\" பொத்தான் இயந்திர ஒருங்கிணைப்பு அமைப்பைத் தேர்ந்தெடுக்கிறது. `Mdro.axis.n` "
"ஊசிகளுடன் இணைக்கப்பட்ட குறியாக்கிகளிலிருந்து வரும் மூல மதிப்புகள் இவை."

#. type: Plain text
#: src/gui/mdro.adoc:116
msgid ""
"The \"cs1\" - \"cs4\" buttons allow the user to select among one of four "
"user-defined coordinate systems. If the program is started with the "
"`MDRO_VAR_FILE =` option, the labels will be changed to \"g54\" - \"g57\" "
"and the values from the specified .var file will be preloaded. Note that any "
"changes to the values are not persistent: the .var file is never changed."
msgstr ""
"\"சிஎச் 1\" - \"சிஎச் 4\" பொத்தான்கள் பயனரை நான்கு பயனர் வரையறுக்கப்பட்ட ஒருங்கிணைப்பு "
"அமைப்புகளில் ஒன்றைத் தேர்ந்தெடுக்க அனுமதிக்கின்றன. நிரல் `mdro_var_file =` விருப்பத்துடன் "
"தொடங்கப்பட்டால், லேபிள்கள் \"G54\" - \"G57\" ஆக மாற்றப்படும், மேலும் குறிப்பிட்ட .var "
"கோப்பிலிருந்து மதிப்புகள் முன்பே ஏற்றப்படும். மதிப்புகளில் ஏதேனும் மாற்றங்கள் தொடர்ந்து இல்லை "
"என்பதை நினைவில் கொள்க: .var கோப்பு ஒருபோதும் மாற்றப்படாது."

#. type: Plain text
#: src/gui/mdro.adoc:117
msgid "Inch/Millimeter selection buttons."
msgstr "அங்குல/மில்லிமீட்டர் தேர்வு பொத்தான்கள்."

#. type: Title ==
#: src/gui/mdro.adoc:118
#, no-wrap
msgid "Index operations"
msgstr "குறியீட்டு செயல்பாடுகள்"

#. type: Plain text
#: src/gui/mdro.adoc:124
msgid ""
"`MDRO` supports DRO scales with index marks. Hit the \"I\" button on the "
"axis row then crank the axis to the index position. The machine coordinate "
"will be zeroed. This is easiest to see at startup or when the \"mcs\" "
"coordinate system has been selected."
msgstr ""
"`Mdro` குறியீட்டு மதிப்பெண்களுடன் DRO அளவீடுகளை ஆதரிக்கிறது. அச்சு வரிசையில் உள்ள "
"\"நான்\" பொத்தானை அழுத்தவும், பின்னர் அச்சை குறியீட்டு நிலைக்கு இழுக்கவும். இயந்திர "
"ஒருங்கிணைப்பு பூச்சியமாக இருக்கும். தொடக்கத்தில் அல்லது \"எம்.சி.எச்\" ஒருங்கிணைப்பு "
"அமைப்பு தேர்ந்தெடுக்கப்பட்டபோது இது எளிதானது."

#. type: Title ==
#: src/gui/mdro.adoc:125
#, no-wrap
msgid "Simulation"
msgstr "பாவனை"

#. type: Plain text
#: src/gui/mdro.adoc:130
msgid ""
"The easiest way to see how `MDRO` works is to try it in a simulation "
"environment.  Add this section to the end of your simulation HAL file, "
"usually \"hallib/core_sim.hal\":"
msgstr ""
"உருவகப்படுத்துதல் சூழலில் அதை முயற்சிப்பதே `mdro` எவ்வாறு செயல்படுகிறது என்பதைப் "
"பார்ப்பதற்கான எளிதான வழி. உங்கள் உருவகப்படுத்துதல் HAL கோப்பின் முடிவில் இந்த பகுதியைச் "
"சேர்க்கவும், வழக்கமாக \"Hallib/core_sim.hal\":"

#. type: delimited block -
#: src/gui/mdro.adoc:137
#, no-wrap
msgid ""
"loadusr -W mdro -l sim.var XYZ\n"
"net x-pos-fb  => mdro.axis.0\n"
"net y-pos-fb  => mdro.axis.1\n"
"net z-pos-fb  => mdro.axis.2\n"
msgstr ""
"loadusr -w mdro -l sim.var xyz\n"
" நிகர x-pos-fb => mdro.axis.0\n"
" நிகர y-pos-fb => mdro.axis.1\n"
" நிகர z-pos-fb => mdro.axis.2\n"

#. type: Labeled list
#: src/gui/ngcgui.adoc:5 src/gui/ngcgui.adoc:19 src/user/user-intro.adoc:127
#, no-wrap
msgid "NGCGUI"
msgstr "என்சிசி குய்"

#. type: Block title
#: src/gui/ngcgui.adoc:13
#, no-wrap
msgid "NGCGUI embedded into AXIS"
msgstr "Ngcgui அச்சில் பதிக்கப்பட்டுள்ளது"

#. type: Target for macro image
#: src/gui/ngcgui.adoc:14
#, no-wrap
msgid "images/ngcgui.png"
msgstr "படங்கள்/ngcgui.png"

#. type: Plain text
#: src/gui/ngcgui.adoc:23
msgid ""
"'NGCGUI' is a Tcl application to work with subroutines. It allows you to "
"have a conversational interface with LinuxCNC. You can organize the "
"subroutines in the order you need them to run and concatenate the "
"subroutines into one file for a complete part program."
msgstr ""
"'Ngcgui' என்பது சப்ரூட்டின்களுடன் பணிபுரிய ஒரு டி.சி.எல் பயன்பாடு. இது "
"லினக்ச்.சி.என்.சியுடன் உரையாடல் இடைமுகத்தை வைத்திருக்க உங்களை அனுமதிக்கிறது. ஒரு "
"முழுமையான பகுதி நிரலுக்காக சப்ரூட்டின்களை ஒரு கோப்பாக இயக்கவும் இணைக்கவும் உங்களுக்குத் "
"தேவையான வரிசையில் நீங்கள் சப்ரூட்டின்களை ஒழுங்கமைக்கலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:25
msgid ""
"'NGCGUI' can run as a standalone application or can be embedded in multiple "
"tab pages in the AXIS GUI."
msgstr ""
"'Ngcgui' ஒரு முழுமையான பயன்பாடாக இயங்கலாம் அல்லது அச்சு GUI இல் பல தாவல் பக்கங்களில் "
"உட்பொதிக்கப்படலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:26
msgid "'PyNGCGUI' is an alternate, Python implementation of NGCGUI."
msgstr "'Pyngcgui' என்பது NGCGUI இன் மாற்று, பைதான் செயல்படுத்தல்."

#. type: Plain text
#: src/gui/ngcgui.adoc:30
msgid ""
"'PyNGCGUI' can run as a standalone application or can be embedded as a tab "
"page (with its own set of multiple subroutine tabs) in any GUI that supports "
"embedding of GladeVCP applications AXIS, Touchy, Gscreen and GMOCCAPY."
msgstr ""
"'Pyngcgui' ஒரு முழுமையான பயன்பாடாக இயங்கலாம் அல்லது GLADEVCP பயன்பாடுகள் அச்சு, "
"டச்சி, சிச்கிரீன் மற்றும் சி.எம்.ஓ.சி.ஓ.சி.பியின் உட்பொதியை ஆதரிக்கும் எந்தவொரு GUI இல் "
"தாவல் பக்கமாக (பல சப்ரூட்டீன் தாவல்களின் தொகுப்புடன்) உட்பொதிக்கப்படலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:32
msgid "Using NGCGUI or PyNGCGUI:"
msgstr "Ngcgui அல்லது pyngcgui ஐப் பயன்படுத்துதல்:"

#. type: Plain text
#: src/gui/ngcgui.adoc:34
msgid "Tab pages are provided for each subroutine specified in the INI file."
msgstr ""
"ஐ.என்.ஐ கோப்பில் குறிப்பிடப்பட்டுள்ள ஒவ்வொரு சப்ரூட்டினுக்கும் தாவல் பக்கங்கள் வழங்கப்படுகின்றன."

#. type: Plain text
#: src/gui/ngcgui.adoc:36
msgid ""
"New subroutines tab pages can be added on the fly using the <<ngcgui-"
"ini,custom tab>>."
msgstr ""
"<<ngcgui-ini, தனிப்பயன் தாவல் >> ஐப் பயன்படுத்தி புதிய சப்ரூட்டின்கள் தாவல் பக்கங்களை "
"பறக்கும்போது சேர்க்கலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:37
msgid ""
"Each subroutine tab page provides entry boxes for all subroutine parameters."
msgstr ""
"ஒவ்வொரு சப்ரூட்டீன் தாவல் பக்கமும் அனைத்து சப்ரூட்டீன் அளவுருக்களுக்கும் நுழைவு பெட்டிகளை "
"வழங்குகிறது."

#. type: Plain text
#: src/gui/ngcgui.adoc:39
msgid ""
"The entry boxes can have a default value and an label that are identified by "
"special comments in the subroutine file."
msgstr ""
"நுழைவு பெட்டிகளில் இயல்புநிலை மதிப்பு மற்றும் சப்ரூட்டீன் கோப்பில் உள்ள சிறப்பு கருத்துகளால் "
"அடையாளம் காணப்படும் லேபிளைக் கொண்டிருக்கலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:41
msgid ""
"Subroutine invocations can be concatenated together to form a multiple step "
"program."
msgstr "பல படி திட்டத்தை உருவாக்க சப்ரூட்டீன் அழைப்புகளை ஒன்றிணைக்க முடியும்."

#. type: Plain text
#: src/gui/ngcgui.adoc:42
msgid ""
"Any single-file G-code subroutine that conforms to NGCGUI conventions can be "
"used."
msgstr ""
"NGCGUI மாநாடுகளுக்கு இணங்கும் எந்த ஒற்றை கோப்பு சி-குறியீட்டு சப்ரூட்டினும் "
"பயன்படுத்தப்படலாம்."

#. type: Plain text
#: src/gui/ngcgui.adoc:45
msgid ""
"Any gcmc (G-code-meta-compiler) program that conforms to NGCGUI conventions "
"for tagging variables can be used. (The gcmc executable must be installed "
"separately, see: https://www.vagrearg.org/content/gcmc)"
msgstr ""
"குறிச்சொல் மாறிகளைக் குறிக்கும் NGCGUI மாநாடுகளுக்கு இணங்கும் எந்த சி.சி.எம்.சி (சி-"
"கோட்-மெட்டா-காம்பைலர்) நிரலையும் பயன்படுத்தலாம். (சி.சி.எம்.சி இயங்கக்கூடியது "
"தனித்தனியாக நிறுவப்பட வேண்டும், காண்க: https://www.vagrearg.org/content/gcmc)"

#. type: delimited block =
#: src/gui/ngcgui.adoc:51
msgid ""
"NGCGUI and PyNGCGUI implement the same functions and both process .ngc "
"and .gcmc files that conform to a few NGCGUI-specific conventions.  In this "
"document, the term 'NGCGUI' generally refers to either application."
msgstr ""
"NGCGUI மற்றும் PYNGCGUI ஒரு சில NGCGUI- குறிப்பிட்ட மாநாடுகளுக்கு ஒத்துப்போகும் .ngc "
"மற்றும் .gcmc கோப்புகளை ஒரே செயல்பாடுகளையும் செயலாக்கத்தையும் செயல்படுத்துகின்றன. இந்த "
"ஆவணத்தில், 'ngcgui' என்ற சொல் பொதுவாக பயன்பாட்டைக் குறிக்கிறது."

#. type: Title ==
#: src/gui/ngcgui.adoc:53
#, no-wrap
msgid "Demonstration Configurations"
msgstr "ஆர்ப்பாட்டம் உள்ளமைவுகள்"

#. type: Plain text
#: src/gui/ngcgui.adoc:58
msgid ""
"A number of demonstration configurations are located in the sim directory of "
"the Sample Configurations offered by the LinuxCNC configuration picker. The "
"configuration picker is on the system's main menu: Applications > CNC > "
"LinuxCNC"
msgstr ""
"லினக்ச் சிஎன்சி உள்ளமைவு பிக்கர் வழங்கும் மாதிரி உள்ளமைவுகளின் சிம் கோப்பகத்தில் பல "
"ஆர்ப்பாட்டம் உள்ளமைவுகள் அமைந்துள்ளன. உள்ளமைவு எடுப்பர் கணினியின் முதன்மையான பட்டியலில் "
"உள்ளது: பயன்பாடுகள்> சி.என்.சி> லினக்ச் சி.என்.சி"

#. type: Plain text
#: src/gui/ngcgui.adoc:66
msgid ""
"Examples are included for the AXIS, Touchy, gscreen, and GMOCCAPY.  These "
"examples demonstrate both 3-axis (XYZ) cartesian configurations (like mills) "
"and lathe (XZ) setups.  Some examples show the use of a pop up keyboard for "
"touch screen systems and other examples demonstrate the use of files created "
"for the gcmc (G-code Meta Compiler) application.  The touchy examples also "
"demonstrate incorporation of a GladeVCP back plot viewer (gremlin_view)."
msgstr ""
"அச்சு, தொடு, சிச்கிரீன் மற்றும் சி.எம்.ஓ.சி.ஓபி ஆகியவற்றிற்கு எடுத்துக்காட்டுகள் "
"சேர்க்கப்பட்டுள்ளன. இந்த எடுத்துக்காட்டுகள் 3-அச்சு (XYZ) கார்ட்டீசியன் உள்ளமைவுகள் (ஆலைகள் "
"போன்றவை) மற்றும் லேத் (XZ) அமைப்புகள் இரண்டையும் நிரூபிக்கின்றன. சில எடுத்துக்காட்டுகள் "
"தொடுதிரை அமைப்புகளுக்கான பாப் அப் விசைப்பலகையைப் பயன்படுத்துவதைக் காட்டுகின்றன மற்றும் "
"பிற எடுத்துக்காட்டுகள் சி.சி.எம்.சி (சி-குறியீட்டு மேவு கம்பைலர்) பயன்பாட்டிற்காக "
"உருவாக்கப்பட்ட கோப்புகளின் பயன்பாட்டை நிரூபிக்கின்றன. தொடு எடுத்துக்காட்டுகள் ஒரு "
"gladevcp பின் சூழ்ச்சி பார்வையாளரை (கிரெம்ளின்_வியூ) இணைப்பதையும் நிரூபிக்கின்றன."

