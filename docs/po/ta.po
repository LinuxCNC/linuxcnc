#, no-wrap
#~ msgid "EMCIO = iov2 -support-start-change "
#~ msgstr "Emcio = iov2 -போர்ட்-ச்டார்ட்-சேஞ்ச்"

#, no-wrap
#~ msgid "You need to explicitly enable the start-change protocol by adding the -support-start-change option; otherwise the start-change pin remains low and   start-change-ack is ignored. The reason for this is better backwards compatibility.\n"
#~ msgstr "-போர்ட்-ச்டார்ட்-சேஞ்ச் விருப்பத்தை சேர்ப்பதன் மூலம் நீங்கள் தொடக்க-மாற்ற நெறிமுறையை வெளிப்படையாக இயக்க வேண்டும்; இல்லையெனில் தொடக்க-மாற்ற முள் குறைவாக இருக்கும் மற்றும் தொடக்க-மாற்ற-ஆக் புறக்கணிக்கப்படுகிறது. இதற்கான காரணம் பின்னோக்கி பொருந்தக்கூடியது.\n"

#, no-wrap
#~ msgid "IO_ERROR "
#~ msgstr "I_error"

#~ msgid ""
#~ "Printf-style template for operator error display (negative toolchanger "
#~ "fault codes).  No quoting needed. Example: `IO_ERROR = Toolchanger fault "
