#, no-wrap
msgid "images/style-comparison.png"
msgstr "படங்கள்/பாணி-ஒப்பீட்டு"

#. type: Title ==
#: src/gui/qtdragon.adoc:1499 src/plasma/qtplasmac.adoc:4218
#, no-wrap
msgid "Internationalisation"
msgstr "பன்னாட்டுமயமாக்கல்"

#. type: NOTE
#: src/gui/qtdragon.adoc:1502
msgid ""
"It is possible to create translation files for QtDragon to display in the "
"language of the current locale."
msgstr ""
"தற்போதைய இடத்தின் மொழியில் காண்பிக்க Qtdragon க்கான மொழிபெயர்ப்பு கோப்புகளை உருவாக்க "
"முடியும்."

#. type: Plain text
#: src/gui/qtdragon.adoc:1504 src/plasma/qtplasmac.adoc:4223
msgid ""
"To create and or edit a translation file requires that LinuxCNC has been "
"installed as run in place."
msgstr ""
"மொழிபெயர்ப்பு கோப்பை உருவாக்க அல்லது திருத்துவதற்கு லினக்ச்என்சி ரன் இடத்தில் "
"நிறுவப்பட்டுள்ளது."

#. type: Plain text
#: src/gui/qtdragon.adoc:1506 src/plasma/qtplasmac.adoc:4225
#, fuzzy
#| msgid ""
#| "The following assumes that the linuxcnc git directory is ~/linuxcnc-dev."
msgid ""
"The following assumes that the LinuxCNC git directory is ~/linuxcnc-dev."
msgstr ""
"லினக்ச் சிஎன்சி சிஐடி அடைவு ~/லினக்ச் சிஎன்சி-டிஇவி என்று பின்வருபவை கருதுகின்றன."

#. type: NOTE
#: src/gui/qtdragon.adoc:1509
msgid "If using QtDragon_hd substitute 'qtdragon_hd' for 'qtdragon'"
msgstr "'Qtdragn' க்கு qtdragon_hd மாற்றாக 'qtdragon_hd' ஐப் பயன்படுத்தினால்"

#. type: NOTE
#: src/gui/qtdragon.adoc:1511
msgid ""
"All language files are kept in ~/linuxcnc-dev/share/screens/qtdragon/"
"languages."
msgstr ""
"அனைத்து மொழி கோப்புகளும் ~/linuxcnc-dev/share/திரைகள்/qtdragon/மொழிகளில் "
"வைக்கப்படுகின்றன."

#. type: NOTE
#: src/gui/qtdragon.adoc:1513
msgid ""
"The qtdragon.py file is a Python version of the GUI file used for "
"translation purposes."
msgstr ""
"Qtdragon.py கோப்பு என்பது மொழிபெயர்ப்பு நோக்கங்களுக்காகப் பயன்படுத்தப்படும் GUI கோப்பின் "
"பைதான் பதிப்பாகும்."

#. type: Plain text
#: src/gui/qtdragon.adoc:1516 src/plasma/qtplasmac.adoc:4232
msgid ""
"The .ts files are the translation source files for the translations.  These "
"are the files that require creating/editing for each language."
msgstr ""
".Ts கோப்புகள் மொழிபெயர்ப்புகளுக்கான மொழிபெயர்ப்பு மூல கோப்புகள். ஒவ்வொரு மொழிக்கும் "
"உருவாக்க/திருத்த வேண்டிய கோப்புகள் இவை."

#. type: NOTE
#: src/gui/qtdragon.adoc:1518
msgid "The .qm files are the compiled translation files used by pyqt."
msgstr ".Qm கோப்புகள் PYQT ஆல் பயன்படுத்தப்பட்ட தொகுக்கப்பட்ட மொழிபெயர்ப்பு கோப்புகள்."

#. type: NOTE
#: src/gui/qtdragon.adoc:1522
msgid ""
"The language is determined by an underscore plus the first two letters of "
"the locale, for example if an Italian translation was being done then it "
"would be `_it`.  It will be referred to as `_xx` in this document, so "
"`qtdragon_xx.ts` in this document would actually be `qtdragon_it.ts` for an "
"Italian translation."
msgstr ""
"மொழி ஒரு அண்டர்ச்கோர் மற்றும் லோகேலின் முதல் இரண்டு எழுத்துக்களால் தீர்மானிக்கப்படுகிறது, "
"எடுத்துக்காட்டாக ஒரு இத்தாலிய மொழிபெயர்ப்பு செய்யப்பட்டால் அது `_it` ஆக இருக்கும். இந்த "
"ஆவணத்தில் இது `_xx` என குறிப்பிடப்படும், எனவே இந்த ஆவணத்தில்` qtdragon_xx.ts` "
"உண்மையில் ஒரு இத்தாலிய மொழிபெயர்ப்புக்கு `qtdragon_it.ts` ஆக இருக்கும்."

#. type: NOTE
#: src/gui/qtdragon.adoc:1524
msgid ""
"The default locale for QtDragon is `_en` which means that any translation "
"files created as `qtdragon_en.*` will not be used for translations."
msgstr ""
"Qtdragon க்கான இயல்புநிலை இருப்பிடம் `_en` ஆகும், அதாவது` qtdragon_en என "
"உருவாக்கப்பட்ட எந்த மொழிபெயர்ப்பு கோப்புகளும்.*`மொழிபெயர்ப்புகளுக்கு பயன்படுத்தப்படாது."

#. type: Plain text
#: src/gui/qtdragon.adoc:1526 src/plasma/qtplasmac.adoc:4244
msgid ""
"If any of the required utilities (pyuic5, pylupdate5, linguist) are not "
"installed then the user will need to install the required development tools:"
msgstr ""
"தேவையான பயன்பாடுகள் ஏதேனும் (PYUIC5, pylupdate5, மொழியியலாளர்) நிறுவப்படவில்லை "
"என்றால், பயனர் தேவையான மேம்பாட்டுக் கருவிகளை நிறுவ வேண்டும்:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1528 src/plasma/qtplasmac.adoc:4246
#, no-wrap
msgid "sudo apt install qttools5-dev-tools pyqt5-dev-tools\n"
msgstr "sudo apt install qttools5-dev-tools pyqt5-dev-tools\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1531 src/plasma/qtplasmac.adoc:4249
msgid "Change to the languages directory:"
msgstr "மொழிகளின் கோப்பகத்திற்கு மாற்றவும்:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1533
#, no-wrap
msgid "cd ~/linuxcnc-dev/share/qtvcp/screens/qtdragon/languages\n"
msgstr "cd ~/linuxcnc-dev/share/qtvcp/திரைகள்/qtdragon/மொழிகள்\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1536 src/plasma/qtplasmac.adoc:4254
msgid ""
"If any text changes have been made to the GUI then run the following to "
"update the GUI Python file:"
msgstr ""
"GUI இல் ஏதேனும் உரை மாற்றங்கள் செய்யப்பட்டிருந்தால், GUI பைதான் கோப்பைப் புதுப்பிக்க "
"பின்வருவனவற்றை இயக்கவும்:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1538
#, no-wrap
msgid "pyuic5 ../qtdragon.ui > qtdragon.py\n"
msgstr "pyuic5 ../qtdragon.ui> qtdragon.py\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1543
msgid ""
"The user can either create a new translation source file for a non-existing "
"language translation or modify an existing translation source file due to "
"changes being made to some text in a QtDragon source file.  If modifying an "
"existing translation that has had no source file changes then this step is "
"not required."
msgstr ""
"Qtdragon மூல கோப்பில் சில உரையில் மாற்றங்கள் செய்யப்படுவதால் பயனர் இல்லாத மொழி "
"மொழிபெயர்ப்பிற்கான புதிய மொழிபெயர்ப்பு மூல கோப்பை உருவாக்கலாம் அல்லது ஏற்கனவே உள்ள "
"மொழிபெயர்ப்பு மூல கோப்பை மாற்றலாம். மூல கோப்பு மாற்றங்கள் இல்லாத ஏற்கனவே உள்ள "
"மொழிபெயர்ப்பை மாற்றியமைத்தால், இந்த படி தேவையில்லை."

#. type: Plain text
#: src/gui/qtdragon.adoc:1545 src/plasma/qtplasmac.adoc:4263
msgid "Create or edit a .ts file:"
msgstr "ஒரு .ts கோப்பை உருவாக்கவும் அல்லது திருத்தவும்:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1547 src/plasma/qtplasmac.adoc:4265
#, no-wrap
msgid "./langfile xx\n"
msgstr "./langfile xx\n"

#. type: NOTE
#: src/gui/qtdragon.adoc:1551
msgid ""
"this command is a script which runs the following: $ pylupdate5 *.py ../"
"*.py ../../../../../lib/python/qtvcp/lib/qtdragon/*.py -ts qtdragon_xx.ts"
msgstr ""
"இந்த கட்டளை பின்வருவனவற்றை இயக்கும் ச்கிரிப்ட் ஆகும்: $ pylupdate5*.py ../"
"*.py ../../../.. ts qtdragon_xx.ts"

#. type: NOTE
#: src/gui/qtdragon.adoc:1553 src/plasma/qtplasmac.adoc:4271
msgid "The editing of the translation is done with the linguist application:"
msgstr "மொழிபெயர்ப்பின் திருத்துதல் மொழியியலாளர் பயன்பாட்டுடன் செய்யப்படுகிறது:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1555 src/plasma/qtplasmac.adoc:4273
#, no-wrap
msgid "linguist\n"
msgstr "மொழியியலாளர்\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1558 src/plasma/qtplasmac.adoc:4276
msgid "Open the TS file and translate the strings"
msgstr "TS கோப்பைத் திறந்து சரங்களை மொழிபெயர்க்கவும்"

#. type: Plain text
#: src/gui/qtdragon.adoc:1561
msgid ""
"It is not necessary to provide a translation for every text string, if no "
"translation is specified for a string then the original string will be used "
"in the application.  The user needs to be careful with the length of strings "
"that appear on widgets as space is limited. If possible try to make the "
"translation no longer than the original."
msgstr ""
"ஒவ்வொரு உரை சரத்திற்கும் மொழிபெயர்ப்பை வழங்க வேண்டிய அவசியமில்லை, ஒரு சரத்திற்கு எந்த "
"மொழிபெயர்ப்பும் குறிப்பிடப்படவில்லை என்றால், அசல் சரம் பயன்பாட்டில் பயன்படுத்தப்படும். "
"விண்வெளி குறைவாக இருப்பதால் விட்செட்டுகளில் தோன்றும் சரங்களின் நீளத்துடன் பயனர் கவனமாக "
"இருக்க வேண்டும். முடிந்தால் மொழிபெயர்ப்பை அசலை விட இனி செய்ய முயற்சிக்கவும்."

#. type: Plain text
#: src/gui/qtdragon.adoc:1564 src/plasma/qtplasmac.adoc:4282
#, no-wrap
msgid ""
"When editing is complete save the file:\n"
"`File -> Save`"
msgstr ""
"திருத்துதல் முடிந்ததும் கோப்பை சேமிக்கவும்:\n"
" `கோப்பு -> சேமி`"

#. type: Plain text
#: src/gui/qtdragon.adoc:1567 src/plasma/qtplasmac.adoc:4285
#, no-wrap
msgid ""
"Then create the .qm file:\n"
"`File -> Release`"
msgstr ""
"பின்னர் .qm கோப்பை உருவாக்கவும்:\n"
" `File -> Release`"

#. type: Plain text
#: src/gui/qtdragon.adoc:1569
msgid ""
"QtDragon will be translated to the language of the current locale on the "
"next start so long as a .qm file exists in that language."
msgstr ""
"அந்த மொழியில் ஒரு .qm கோப்பு இருக்கும் வரை அடுத்த தொடக்கத்தில் தற்போதைய இடத்தின் மொழிக்கு "
"Qtdragon மொழிபெயர்க்கப்படும்."

#. type: Plain text
#: src/gui/qtdragon.adoc:1573
msgid ""
"Users are welcome to submit translation files for inclusion into QtDragon.  "
"The preferred method is to submit a pull request from the users GitHub "
"account as described in the https://www.linuxcnc.org/docs/html/code/"
"contributing-to-linuxcnc.html[contributing to LinuxCNC] documentation.  The "
"only files required to be committed are qtdragon_xx.ts and qtdragon_xx.qm."
msgstr ""
"Qtdragon இல் சேர்ப்பதற்கான மொழிபெயர்ப்பு கோப்புகளை சமர்ப்பிக்க பயனர்கள் "
"வரவேற்கப்படுகிறார்கள். Https://www.linuxcnc.org/docs/html/code/contributing-to-"
"to-linuxcnc.html linuxcnc] ஆவணத்தில் விவரிக்கப்பட்டுள்ளபடி பயனர்கள் அறிவிலிமையம் "
"கணக்கிலிருந்து ஒரு இழுப்பு கோரிக்கையை சமர்ப்பிப்பதே விருப்பமான முறை. க்யூட் "
"டிராகன்_எக்ச்எக்ச்.டிஎச் மற்றும் Qtdragon_xx.qm ஆகியவை செய்யப்பட வேண்டிய ஒரே கோப்புகள்."

#. type: Title ==
#: src/gui/qtdragon.adoc:1574
#, no-wrap
msgid "Customization"
msgstr "தனிப்பயனாக்கம்"

#. type: Plain text
#: src/gui/qtdragon.adoc:1577
msgid ""
"A general overview of <<cha:qtvcp:modifying-screens,Customizing Stock "
"Screens>>."
msgstr ""
"<<cha:qtvcp:modifying-screens, பங்குத் திரைகளைத் தனிப்பயனாக்குதல் >> பற்றிய பொதுவான "
"கண்ணோட்டம்."

#. type: Title ===
#: src/gui/qtdragon.adoc:1578
#, no-wrap
msgid "Stylesheets"
msgstr "ச்டைல்சீட்ச்"

#. type: Plain text
#: src/gui/qtdragon.adoc:1585
#, no-wrap
msgid ""
"Stylesheets can be leveraged to do a fair amount of customization, but you usually need to know a bit about the widget names. Pressing F12 will display a stylesheet editor dialog to load/test/save modification.\n"
"The 'View Sheet' tab will allow you to select and apply what stylesheet QtDragon will use when it's first loaded.\n"
"Press the button 'Copy to Edit Tab' to copy the current stylesheet to the edit tab.\n"
"The 'Edit Sheet' tab allows editing, applying and saving of changes od the displayed stylesheet."
msgstr ""
"தனிப்பயனாக்கத்தின் நியாயமான அளவு செய்ய ச்டைல்சீட்கள் அந்நியப்படுத்தப்படலாம், ஆனால் நீங்கள் வழக்கமாக விட்செட் பெயர்களைப் பற்றி கொஞ்சம் தெரிந்து கொள்ள வேண்டும். F12 ஐ அழுத்தினால் மாற்றத்தை ஏற்ற/சோதிக்க/சேமிக்க ஒரு ச்டைல்சீட் எடிட்டர் உரையாடலைக் காண்பிக்கும்.\n"
" 'வியூ தாள்' தாவல் முதலில் ஏற்றப்பட்டபோது Qtdragon பயன்படுத்தும் ச்டைலேசீட் எதைப் பயன்படுத்துகிறது என்பதைத் தேர்ந்தெடுத்து பயன்படுத்த அனுமதிக்கும்.\n"
" திருத்து தாவலுக்கு தற்போதைய ச்டைல்சீட்டை நகலெடுக்க 'தாவலைத் திருத்த நகலெடு' என்ற பொத்தானை அழுத்தவும்.\n"
" 'திருத்து தாள்' தாவல் காண்பிக்கப்படும் நடைதாள் மாற்றங்களை திருத்துதல், விண்ணப்பித்தல் மற்றும் சேமிக்க அனுமதிக்கிறது."

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/qtdragon.adoc:1586
#, no-wrap
msgid "QtDragon stylesheet editor"
msgstr "Qtdragon slaynesheet ஆசிரியர்"

#. type: Target for macro image
#: src/gui/qtdragon.adoc:1586
#, no-wrap
msgid "images/qtdragon_stylesheet_editor.png"
msgstr "படங்கள்/qtdragon_stylesheet_editor.png"

#. type: Plain text
#: src/gui/qtdragon.adoc:1589
msgid ""
"Sometimes these lines will be present and you can change them, otherwise you "
"will need to add them. +"
msgstr ""
"சில நேரங்களில் இந்த கோடுகள் இருக்கும், அவற்றை நீங்கள் மாற்றலாம், இல்லையெனில் நீங்கள் அவற்றைச் "
"சேர்க்க வேண்டும். +"

#. type: Plain text
#: src/gui/qtdragon.adoc:1591
msgid ""
"For instance, to change the DRO font (look for this entry and change the "
"font name):"
msgstr ""
"உதாரணமாக, டி.ஆர்.ஓ எழுத்துருவை மாற்ற (இந்த உள்ளீட்டைத் தேடி எழுத்துரு பெயரை மாற்றவும்):"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1600
#, no-wrap
msgid ""
"DROLabel,\n"
"StatusLabel#status_rpm {\n"
"    border: 1px solid black;\n"
"    border-radius: 4px;\n"
"    font: 20pt \"Noto Mono\";\n"
"}\n"
msgstr ""
"ட்ரோலபெல்,\n"
" Statuslabel#status_rpm {\n"
" எல்லை: 1px திட கருப்பு;\n"
" எல்லை-ரேடியச்: 4px;\n"
" எழுத்துரு: 20pt \"நோட்டோ மோனோ\";\n"
" }\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1603
msgid "To change the DRO display font and display format:"
msgstr "டி.ஆர்.ஓ காட்சி எழுத்துரு மற்றும் காட்சி வடிவமைப்பை மாற்ற:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1611
#, no-wrap
msgid ""
"DROLabel {\n"
"    font: 25pt \"Lato Heavy\";\n"
"    qproperty-imperial_template: '%9.5f';\n"
"    qproperty-metric_template: '%10.4f';\n"
"    qproperty-angular_template: '%11.2f';\n"
msgstr ""
"ட்ரோலபல் {\n"
" எழுத்துரு: 25pt \"லாட்டோ எவி\";\n"
" QProperty-amperial_template: '%9.5f';\n"
" qproperty-metric_template: '%10.4f';\n"
" QProperty-angular_template: '%11.2f';\n"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1620
#, no-wrap
msgid ""
"    /*Adjust the menu options */\n"
"    qproperty-showLast: true;\n"
"    qproperty-showDivide : false;\n"
"    qproperty-showGotoOrigin: false;\n"
"    qproperty-showZeroOrigin: false;\n"
"    qproperty-showSetOrigin: true;\n"
"    qproperty-dialogName: CALCULATOR;\n"
"}\n"
msgstr ""
"/ *மெனு விருப்பங்களை சரிசெய்யவும் */\n"
" qproperty- சோவ்லாச்ட்: உண்மை;\n"
" qproperty-showdivide: பொய்;\n"
" QProperty-Showgotoorigin: பொய்;\n"
" qproperty-showzerourigin: பொய்;\n"
" QProperty-Showsetorigin: உண்மை;\n"
" QProperty-dialogname: கால்குலேட்டர்;\n"
" }\n"

#. type: Plain text
#: src/gui/qtdragon.adoc:1623
msgid "Change the axis select button's click menu items:"
msgstr "அச்சு தேர்ந்தெடுக்கப்பட்ட பொத்தானின் சொடுக்கு பட்டியல் உருப்படிகளை மாற்றவும்:"

#. type: delimited block -
#: src/gui/qtdragon.adoc:1635
#, no-wrap
msgid ""
