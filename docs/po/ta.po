msgstr ""
"# இந்த கட்டத்தில்:\n"
" # விட்செட்டுகள் உடனடிப்படுத்தப்படுகின்றன.\n"
" # ஆல் ஊசிகள் கட்டப்பட்டுள்ளன, ஆனால் ஆல் தயாராக இல்லை\n"
" DEF துவக்கப்பட்டது __ (சுய):\n"
" self.pin_button_in = qhal.newpin ('சைக்கிள்-ச்டார்ட்-இன்', qhal.hal_bit, qhal.hal_in)\n"
" self.pin_button_in.pinvaluechanged.connect (self.buttonchanged)\n"
" self.pin_button_in.isdrivenchanged.connect (லாம்ப்டா பி, கள்: தன்வய.\n"

#. type: delimited block -
