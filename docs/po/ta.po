#, no-wrap
msgid "Meaning"
msgstr "பொருள்"

#. type: Table
#: src/drivers/motenc.adoc:96
#, no-wrap
msgid "Timeout is 16ms if set, 8ms if unset"
msgstr "நேரம் முடிந்தது 16ms அமைக்கப்பட்டால், 8ms அமைக்கப்படாவிட்டால்"

#. type: Table
