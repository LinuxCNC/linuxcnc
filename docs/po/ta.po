#. type: Title ===
#: src/gui/axis.adoc:1234
#, no-wrap
msgid "Switch Tabs with HAL Pins"
msgstr "ஆல் ஊசிகளுடன் தாவல்களை மாற்றவும்"

#. type: delimited block -
#: src/gui/axis.adoc:1240
#, no-wrap
msgid ""
"# HAL pins from a GladeVCP panel will not be ready when user_live_update is run\n"
"# to read them you need to put them in a try/except block\n"
msgstr ""
"# ஒரு gladevcp பேனலில் இருந்து ஆல் ஊசிகள் USER_LIVE_UPDATE இயங்கும் போது தயாராக இருக்காது\n"
" # அவற்றைப் படிக்க நீங்கள் அவற்றை முயற்சித்துப் பார்க்க வேண்டும்/தடுப்பதைத் தவிர\n"

#. type: delimited block -
#: src/gui/axis.adoc:1245
#, no-wrap
msgid ""
"# the following example assumes 5 HAL buttons in a GladeVCP panel used to switch\n"
"# the tabs in the AXIS screen.\n"
"# button names are 'manual-tab', 'mdi-tab', 'preview-tab', 'dro-tab', 'user0-tab'\n"
"# the user_0 tab if it exists would be the first GladeVCP embedded tab\n"
msgstr ""
"# பின்வரும் எடுத்துக்காட்டு 5 HAL பொத்தான்களை மாற்றுவதற்கு பயன்படுத்தப்படும் ஒரு gladevcp பேனலில் கருதுகிறது\n"
" # அச்சு திரையில் உள்ள தாவல்கள்.\n"
" # பொத்தான் பெயர்கள் 'கையேடு-டேப்', 'எம்.டி.ஐ-டேப்', 'முன்னோட்டம்-டேப்', 'ட்ரோ-டேப்', 'பயனர் 0-டேப்'\n"
" # பயனர்_0 தாவல் இருந்தால் அது முதல் gladevcp உட்பொதிக்கப்பட்ட தாவலாக இருக்கும்\n"

#. type: delimited block -
#: src/gui/axis.adoc:1247
#, no-wrap
msgid "# for LinuxCNC 2.8+ branch\n"
msgstr "# Linuxcnc 2.8+ கிளைக்கு\n"

#. type: delimited block -
#: src/gui/axis.adoc:1262
#, no-wrap
msgid ""
"def user_live_update():\n"
"    try:\n"
"        if hal.get_value('gladevcp.manual-tab'):\n"
"            root_window.tk.call('.pane.top.tabs','raise','manual')\n"
"        elif hal.get_value('gladevcp.mdi-tab'):\n"
"            root_window.tk.call('.pane.top.tabs','raise','mdi')\n"
"        elif hal.get_value('gladevcp.preview-tab'):\n"
"            root_window.tk.call('.pane.top.right','raise','preview')\n"
"        elif hal.get_value('gladevcp.numbers-tab'):\n"
"            root_window.tk.call('.pane.top.right','raise','numbers')\n"
"        elif hal.get_value('gladevcp.user0-tab'):\n"
"            root_window.tk.call('.pane.top.right','raise','user_0')\n"
"    except:\n"
"        pass\n"
msgstr ""
"def user_live_update ():\n"
" முயற்சிக்கவும்:\n"
" hal.get_value ('gladevcp.anual-tab'):\n"
" root_window.tk.call ('. pane.top.tabs', 'உயர்த்த', 'கையேடு')\n"
" elif hal.get_value ('gladevcp.mdi-tab'):\n"
" root_window.tk.call ('. pane.top.tabs', 'உயர்த்த', 'MDI')\n"
" elif hal.get_value ('gladevcp.preview-tab'):\n"
" root_window.tk.call ('. pane.top.right', 'உயர்த்த', 'முன்னோட்டம்')\n"
" elif hal.get_value ('gladevcp.numbers-tab'):\n"
" root_window.tk.call ('. pane.top.right', 'உயர்த்த', 'எண்கள்')\n"
" elif hal.get_value ('gladevcp.user0-tab'):\n"
" root_window.tk.call ('. pane.top.right', 'உயர்த்த', 'பயனர்_0')\n"
" தவிர:\n"
" பாச்\n"

#. type: Title ===
#: src/gui/axis.adoc:1264
#, no-wrap
msgid "Add a GOTO Home button"
msgstr "கோட்டோ முகப்பு பொத்தானைச் சேர்க்கவும்"

#. type: delimited block -
#: src/gui/axis.adoc:1275
#, no-wrap
msgid ""
"def goto_home(axis):\n"
"    if s.interp_state == linuxcnc.INTERP_IDLE:\n"
"        home = inifile.find('JOINT_' + str(inifile.find('TRAJ', 'COORDINATES').upper().index(axis)), 'HOME')\n"
"        mode = s.task_mode\n"
"        if s.task_mode != linuxcnc.MODE_MDI:\n"
"            c.mode(linuxcnc.MODE_MDI)\n"
"        c.mdi('G53 G0 ' + axis + home)\n"
msgstr ""
"def goto_home (அச்சு):\n"
" s.interp_state == linuxcnc.interp_idle என்றால்:\n"
" வீடு = inifile.find ('commond_' + str (inifile.find ('traj', 'ஒருங்கிணைப்புகள்').\n"
" பயன்முறை = s.task_mode\n"
" s.task_mode! = linuxcnc.mode_mdi:\n"
" c.mode (linuxcnc.mode_mdi)\n"
" C.MDI ('G53 G0' + அச்சு + முகப்பு)\n"

#. type: delimited block -
#: src/gui/axis.adoc:1278
#, no-wrap
msgid ""
"# make a button to home y axis\n"
"root_window.tk.call('button','.pane.top.tabs.fmanual.homey','-text','Home Y','-command','goto_home Y','-height','2')\n"
msgstr ""
"# வீட்டு ஒய் அச்சுக்கு ஒரு பொத்தானை உருவாக்கவும்\n"
" ரூட் சாளரம். 2 ')\n"

#. type: delimited block -
#: src/gui/axis.adoc:1281
#, no-wrap
msgid ""
"# place the button\n"
"root_window.tk.call('grid','.pane.top.tabs.fmanual.homey','-column','1','-row','7','-columnspan','2','-padx','4','-sticky','w')\n"
msgstr ""
"# பொத்தானை வைக்கவும்\n"
" ரூட் சாளரம். , '-padx', '4', '-ஒட்டும்', 'W')\n"

#. type: delimited block -
#: src/gui/axis.adoc:1285
#, no-wrap
msgid ""
"# any function called from Tcl needs to be added to TclCommands\n"
"TclCommands.goto_home = goto_home\n"
"commands = TclCommands(root_window)\n"
msgstr ""
"# TCL இலிருந்து அழைக்கப்படும் எந்தவொரு செயல்பாடும் TCLCommands இல் சேர்க்கப்பட வேண்டும்\n"
" Tclcommands.goto_home = goto_home\n"
" கட்டளைகள் = tclcommands (root_window)\n"

#. type: Title ===
#: src/gui/axis.adoc:1287
#, no-wrap
msgid "Add Button to manual frame"
msgstr "கையேடு சட்டத்திற்கு பொத்தானைச் சேர்க்கவும்"

#. type: delimited block -
#: src/gui/axis.adoc:1292
#, no-wrap
msgid "# make a new button and put it in the manual frame\n"
msgstr "# ஒரு புதிய பொத்தானை உருவாக்கி கையேடு சட்டகத்தில் வைக்கவும்\n"

#. type: delimited block -
#: src/gui/axis.adoc:1295
#, no-wrap
msgid ""
"root_window.tk.call('button','.pane.top.tabs.fmanual.mybutton','-text','My Button','-command','mybutton_clicked','-height','2')\n"
"root_window.tk.call('grid','.pane.top.tabs.fmanual.mybutton','-column','1','-row','6','-columnspan','2','-padx','4','-sticky','w')\n"
msgstr ""
"root_window.tk.call ('பொத்தான்', '. Pane.top.tabs.fmanual.mybutton', '-உரை', 'என் பொத்தான்', '-கட்டளை', 'myButton_clicked', '-உயரம்', '2' )\n"
" root_window.tk.call ('கட்டம்', '. pane.top.tabs.fmanual.mybutton', '-நெடுவரிசை', '1', '-வரிசை', '6 ','-நெடுவரிசை ',' 2 ', '-பாட்எக்ச்', '4', '-ஒட்டும்', 'டபிள்யூ')\n"

#. type: delimited block -
#: src/gui/axis.adoc:1300
#, no-wrap
msgid ""
"# the above send the \"mybutton_clicked\" command when clicked\n"
"# other options are to bind a press or release (or both) commands to the button\n"
"# these can be in addition to or instead of the clicked command\n"
"# if instead of then delete '-command','mybutton_clicked', from the first line\n"
msgstr ""
"# மேலே உள்ளவை சொடுக்கு செய்யும் போது \"mybutton_clicked\" கட்டளையை அனுப்பவும்\n"
" # பிற விருப்பங்கள் பொத்தானை அழுத்தவும் அல்லது வெளியிடவும் (அல்லது இரண்டும்) கட்டளைகளை பிணைப்பது\n"
" # இவை சொடுக்கு செய்யப்பட்ட கட்டளைக்கு கூடுதலாக அல்லது அதற்கு பதிலாக இருக்கலாம்\n"
" # முதல் வரியிலிருந்து, 'mybutton_clicked' என்ற '-command' ஐ நீக்கு\n"

#. type: delimited block -
#: src/gui/axis.adoc:1302
#, no-wrap
msgid "# Button-1 = left mouse button, 2 = right or 3 = middle\n"
msgstr "# பொத்தான் -1 = இடது சுட்டி பொத்தான், 2 = வலது அல்லது 3 = நடுத்தர\n"

#. type: delimited block -
#: src/gui/axis.adoc:1305
#, no-wrap
msgid ""
"root_window.tk.call('bind','.pane.top.tabs.fmanual.mybutton','<Button-1>','mybutton_pressed')\n"
"root_window.tk.call('bind','.pane.top.tabs.fmanual.mybutton','<ButtonRelease-1>','mybutton_released')\n"
msgstr ""
"root_window.tk.call ('bind', '. Pane.top.tabs.fmanual.mybutton', '<பொத்தான் -1>', 'myButton_pressed')\n"
" root_window.tk.call ('bind', '. pane.top.tabs.fmanual.mybutton', '<bottonRelease-1>', 'mybutton_reled'\n"

#. type: delimited block -
#: src/gui/axis.adoc:1307
#, no-wrap
msgid "# functions called from the buttons\n"
msgstr "# பொத்தான்களிலிருந்து அழைக்கப்படும் செயல்பாடுகள்\n"

#. type: delimited block -
#: src/gui/axis.adoc:1314
#, no-wrap
msgid ""
"def mybutton_clicked():\n"
"    print('mybutton was clicked')\n"
"def mybutton_pressed():\n"
"    print('mybutton was pressed')\n"
"def mybutton_released():\n"
"    print('mybutton was released')\n"
msgstr ""
"def mybutton_clicked ():\n"
" அச்சு ('MyButton சொடுக்கு செய்யப்பட்டது')\n"
" def mybutton_pressed ():\n"
" அச்சு ('MyButton அழுத்தப்பட்டது')\n"
" def mybutton_reled ():\n"
" அச்சு ('MyButton வெளியிடப்பட்டது')\n"

#. type: delimited block -
#: src/gui/axis.adoc:1316
#, no-wrap
msgid "# any function called from Tcl needs to be added to TclCommands\n"
msgstr "# TCL இலிருந்து அழைக்கப்படும் எந்தவொரு செயல்பாடும் TCLCommands இல் சேர்க்கப்பட வேண்டும்\n"

#. type: delimited block -
#: src/gui/axis.adoc:1321
#, no-wrap
msgid ""
"TclCommands.mybutton_clicked = mybutton_clicked\n"
"TclCommands.mybutton_pressed = mybutton_pressed\n"
"TclCommands.mybutton_released = mybutton_released\n"
"commands = TclCommands(root_window)\n"
msgstr ""
"Tclcommands.mybutton_clicked = mybutton_clicked\n"
" Tclcommands.mybutton_pressed = myButton_pressed\n"
" Tclcommands.mybutton_releaded = mybutton_reled\n"
" கட்டளைகள் = tclcommands (root_window)\n"

