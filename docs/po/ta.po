msgstr "ஒரு வரிசை, ஒத்திசைவு இல்லை"

#. type: delimited block -
#: src/config/ini-homing.adoc:309
#, no-wrap
msgid ""
"[JOINT_0]HOME_SEQUENCE =  0\n"
"[JOINT_1]HOME_SEQUENCE =  0\n"
"[JOINT_2]HOME_SEQUENCE =  0\n"
msgstr ""
"[கூட்டு_0] முகப்பு_ வரிசை = 0\n"
" [கூட்டு_1] முகப்பு_ வரிசை = 0\n"
" [கூட்டு_2] முகப்பு_ வரிசை = 0\n"

#. type: Plain text
#: src/config/ini-homing.adoc:312
msgid "One sequence, all joints synchronized"
msgstr "ஒரு வரிசை, அனைத்து மூட்டுகளும் ஒத்திசைக்கப்படுகின்றன"

