"# ரன் ச்கிரிப்ட் முதலில் எந்த அரைநிலையையும் இயக்க ஆல்க்எம்டியைப் பயன்படுத்துகிறது\n"
" # கோப்புகள், பின்னர் எந்தவொரு தனிப்பட்ட HALCMD கட்டளைகளையும் இயக்க.\n"
" #\n"

#. type: delimited block -
#: src/source-highlight/ini-demo.adoc:124
#, no-wrap
msgid ""
"# list of HAL config files to run through halcmd\n"
"# files are executed in the order in which they appear\n"
"HALFILE =                    core_sim.hal\n"
"HALFILE =\t\t     axis_manualtoolchange.hal\n"
"HALFILE = simulated_home.hal\n"
"#HALFILE = gamepad.hal\n"
msgstr ""
"# HAL கட்டமைப்பு கோப்புகளின் பட்டியல் HALCMD மூலம் இயங்க\n"
" # கோப்புகள் அவை தோன்றும் வரிசையில் செயல்படுத்தப்படுகின்றன\n"
" அரை = core_sim.hal\n"
" அரை = அச்சு_மெனுவல்டூல்சேஞ்ச்.ஆல்\n"
" அரை = உருவகப்படுத்தப்பட்ட_ஓம்.ஆல்\n"
" #Halfile = gamepad.hal\n"

#. type: delimited block -
#: src/source-highlight/ini-demo.adoc:128
#, no-wrap
msgid ""
"# list of halcmd commands to execute\n"
"# commands are executed in the order in which they appear\n"
"#HALCMD =                    save neta\n"
msgstr ""
"# செயல்படுத்த HALCMD கட்டளைகளின் பட்டியல்\n"
" # கட்டளைகள் அவை தோன்றும் வரிசையில் செயல்படுத்தப்படுகின்றன\n"
" #ஆல்க்எம்டி = நெட்டாவை சேமிக்கவும்\n"

#. type: delimited block -
#: src/source-highlight/ini-demo.adoc:132
