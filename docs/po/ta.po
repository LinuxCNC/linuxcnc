msgstr "சாகிங் மதிப்புகள் _ini கோப்பு_ கீழ் இருந்து வருகின்றன:"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:1307
msgid "`[DISPLAY]INCREMENTS`, or"
msgstr "`[காட்சி] அதிகரிப்புகள்`, அல்லது"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:1308
msgid "`[DISPLAY]ANGULAR_INCREMENTS`"
msgstr "`[காட்சி] Angunal_increments`"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:1310
