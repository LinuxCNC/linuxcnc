#. type: Block title
#: src/gui/pyvcp.adoc:1070
#, no-wrap
msgid "Tabs"
msgstr "தாவல்கள்"

#. type: Plain text
#: src/gui/pyvcp.adoc:1073
msgid "A tabbed interface can save quite a bit of space."
msgstr "ஒரு தாவலாக்கப்பட்ட இடைமுகம் சிறிது இடத்தை சேமிக்க முடியும்."

#. type: delimited block -
#: src/gui/pyvcp.adoc:1101
#, no-wrap
msgid ""
"<tabs>\n"
"    <names> [\"spindle\",\"green eggs\"]</names>\n"
"</tabs>\n"
"<tabs>\n"
"    <names>[\"Spindle\", \"Green Eggs\", \"Ham\"]</names>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"Spindle speed:\"</text>\n"
"        </label>\n"
"        <bar>\n"
"            <halpin>\"spindle-speed\"</halpin>\n"
"            <max_>5000</max_>\n"
"        </bar>\n"
"    </vbox>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"(this is the green eggs tab)\"</text>\n"
"        </label>\n"
"    </vbox>\n"
"    <vbox>\n"
"        <label>\n"
"            <text>\"(this tab has nothing on it)\"</text>\n"
"        </label>\n"
"    </vbox>\n"
"</tabs>\n"
msgstr ""
"<தாவல்கள்>\n"
" <பெயர்கள்> [\"சுழல்\", \"பச்சை முட்டைகள்\"] </பெயர்கள்>\n"
" </தாவல்கள்>\n"
" <தாவல்கள்>\n"
" <பெயர்கள்> [\"சுழல்\", \"பச்சை முட்டைகள்\", \"ஆம்\"] </பெயர்கள்>\n"
" <VBOX>\n"
