#. type: Target for macro image
#: src/motion/kinematics.adoc:252
#, no-wrap
msgid "images/kinematics-math-06.png"
msgstr "படங்கள்/இயக்கவியல்-math-06.png"

#. type: Target for macro image
#: src/motion/kinematics.adoc:254
#, no-wrap
msgid "images/kinematics-math-07.png"
msgstr "படங்கள்/இயக்கவியல்-math-07.png"

#
#. latexmath::[\[AD=\sqrt{x^{2}+y^{2}}\]]
#. latexmath::[\[BD=\sqrt{(Bx-x)^{2}+y^{2}}\]]
#. type: Plain text
#: src/motion/kinematics.adoc:263
msgid "or translated to actual code:"
msgstr "அல்லது உண்மையான குறியீட்டிற்கு மொழிபெயர்க்கப்பட்டுள்ளது:"

#. type: delimited block -
#: src/motion/kinematics.adoc:270
#, no-wrap
msgid ""
"double x2 = pos->tran.x * pos->tran.x;\n"
"double y2 = pos->tran.y * pos->tran.y;\n"
"joints[0] = sqrt(x2 + y2);\n"
"joints[1] = sqrt((Bx - pos->tran.x)*(Bx - pos->tran.x) + y2);\n"
"return 0;\n"
msgstr ""
"இரட்டை x2 = pos-> tran.x * pos-> tran.x;\n"
" இரட்டை y2 = pos-> tran.y * pos-> tran.y;\n"
" மூட்டுகள் [0] = sqrt (x2 + y2);\n"
" மூட்டுகள் [1] = sqrt ((bx - pos-> tran.x)*(bx - pos-> tran.x) + y2);\n"
" திரும்ப 0;\n"

