#, fuzzy, no-wrap
#| msgid "rtapi_snprintf(3rtapi)"
msgid "rtapi_snprintf(3)"
msgstr "Ratapi_syprintf (3 ரத்தாபி)"

#. type: Plain text
#: src/man/man3/rtapi_snprintf.3.adoc:8
msgid ""
"rtapi_snprintf, rtapi_vsnprintf - Perform snprintf-like string formatting"
msgstr ""
"rtapi_snprintf, rtapi_vsnprintf - snprintf போன்ற சரம் வடிவமைப்பைச் செய்யுங்கள்"

#. type: delimited block -
#: src/man/man3/rtapi_snprintf.3.adoc:15
#, no-wrap
msgid ""
"int rtapi_snprintf(char* _buf_, unsigned long int _size_, const char* _fmt_, _..._);\n"
"int rtapi_vsnprintf(char* _buf_, unsigned long int _size_, const char* _fmt_, va_list _apf);\n"
msgstr ""
"int rtapi_snprintf (char* _buf_, கையொப்பமிடாத நீண்ட int _size_, const char* _fmt_, _..._);\n"
" int rtapi_vsnprintf (char* _buf_, கையொப்பமிடாத நீண்ட int _size_, const char* _fmt_, va_list _apf);\n"

#. type: Plain text
#: src/man/man3/rtapi_snprintf.3.adoc:20
msgid "As for _snprintf(3)_ or _vsnprintf(3)_."
msgstr "_Snprintf (3) _ அல்லது _vsnprintf (3) _ ஐப் பொறுத்தவரை."

#. type: Plain text
#: src/man/man3/rtapi_snprintf.3.adoc:25
msgid ""
"These functions work like the standard C printf functions, except that a "
"reduced set of formatting operations are supported."
msgstr ""
"இந்த செயல்பாடுகள் நிலையான சி பிரிண்ட்ஃப் செயல்பாடுகளைப் போலவே செயல்படுகின்றன, தவிர "
"குறைக்கப்பட்ட வடிவமைப்பு செயல்பாடுகள் ஆதரிக்கப்படுகின்றன."

#. type: Plain text
#: src/man/man3/rtapi_snprintf.3.adoc:29
msgid ""
"In particular: formatting of long long values is not supported.  Formatting "
"of floating-point values is done as though with %A even when other formats "
"like %f are specified."
msgstr ""
"குறிப்பாக: நீண்ட நீண்ட மதிப்புகளை வடிவமைத்தல் ஆதரிக்கப்படவில்லை. %F போன்ற பிற வடிவங்கள் "
"குறிப்பிடப்படும்போது கூட மிதக்கும்-புள்ளி மதிப்புகளின் வடிவமைப்பு %A உடன் "
"செய்யப்படுகிறது."

#. type: Plain text
#: src/man/man3/rtapi_snprintf.3.adoc:37
msgid "The number of characters written to _buf_."
msgstr "_Buf_ க்கு எழுதப்பட்ட எழுத்துகளின் எண்ணிக்கை."

