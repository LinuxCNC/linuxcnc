#| " net no-inverter classicladder.0.out-23 inverterfail.trigger\n"
msgid ""
"setp oillow\\&.edge 0 #this pin should be active low\n"
"net no-oil classicladder\\&.0\\&.out-21 oillow\\&.trigger\n"
"net no-pressure classicladder\\&.0\\&.out-22 oilpressure\\&.trigger\n"
"net no-inverter classicladder\\&.0\\&.out-23 inverterfail\\&.trigger\n"
msgstr ""
"setp oillow.edge 0 #இந்த முள் செயலில் குறைவாக இருக்க வேண்டும்\n"
" நிகர இல்லை-எண்ணெய் கிளாசிக் லாடர் .0.out-21 oillow.trigger\n"
" நிகர நோ-பிரசர் கிளாசிக் லாடர் .0.out-22 Oilpressure.Trigger\n"
" நெட் நோ-இன்-இன்வெர்ட்டர் கிளாசிக் லாடர் .0.out-23 இன்வெர்டர்பெயில்.ரிகர்\n"

