msgstr "* கூட்டு_போச்* [{0 | 1 | ...}]"

#. type: Plain text
#: src/man/man1/linuxcncrsh.1.adoc:344
#, fuzzy
#| msgid ""
#| "*joint_homed [{0|1|...}]*\n"
#| "  With get, returns the homed status of the specified joint as \"homed\" "
#| "or \"not\".\n"
#| "  If no joint number is specified, returns the homed status of all "
#| "joints.\n"
msgid ""
"With get, returns the homed status of the specified joint as \"homed\" or "
"\"not\".  If no joint number is specified, returns the homed status of all "
"joints."
msgstr ""
"*கூட்டு_ஓம் [{0 | 1 | ...}]*\n"
" GET உடன், குறிப்பிட்ட கூட்டு நிலையை \"வீட்டு\" அல்லது \"இல்லை\" என்று தருகிறது.\n"
