msgstr "5-அச்சு-புள்ளிவிவரங்கள்/சமன்பாடு__15.png"

#. type: Plain text
#: src/motion/5-axis-kinematics.adoc:153
msgid ""
"where R^T is the transpose of R (rows and columns swappped). We therefore "
"obtain:"
msgstr ""
