msgstr "படம்: படங்கள்/கருவி_பிளாக் டெலெட்."

#. type: Plain text
#: src/gui/axis.adoc:296
msgid ""
"image:images/tool_optpause.png[\"Toggle Optional Pause\"] Toggle Optional "
"Pause [Alt-M-1]"
msgstr ""
"படம்: படங்கள்/கருவி_ஆப் டைபாச்.பின்கே [\"விருப்ப இடைநிறுத்தத்தை மாற்றவும்\"] விருப்ப "
"இடைநிறுத்தத்தை மாற்றவும் [Alt-M-1]"

#. type: Plain text
#: src/gui/axis.adoc:297
msgid "image:images/tool_zoomin.png[\"Zoom In\"] Zoom In"
msgstr "படம்: படங்கள்/கருவி_சூமின்"

#. type: Plain text
#: src/gui/axis.adoc:298
msgid "image:images/tool_zoomout.png[\"Zoom Out\"] Zoom Out"
msgstr "படம்: படங்கள்/கருவி_சூம்அவுட்.பிஎங் [\"பெரிதாக்கு\"] பெரிதாக்கவும்"

#. type: Plain text
#: src/gui/axis.adoc:299
msgid "image:images/tool_axis_z.png[\"Top view\"] Top view"
msgstr "படம்: படங்கள்/கருவி_ஆக்சிச்_செச்பிஎங் [\"சிறந்த பார்வை\"] சிறந்த பார்வை"

#. type: Plain text
#: src/gui/axis.adoc:300
msgid "image:images/tool_axis_z2.png[\"Rotated Top view\"] Rotated Top view"
