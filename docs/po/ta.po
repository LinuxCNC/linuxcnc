#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:40
#, no-wrap
msgid ""
"; G-code highlighting stresstest - useless otherwise\n"
";\n"
"#<tool_change_at_g30> = 0\n"
"G0 (Rapid to start) X1 Y1\n"
"G0 X1 Y1 (Rapid to start; but don't forget the coolant)\n"
"M2 ; End of program.\n"
"M66 P1 L3 Q[#<timeout>]\n"
"M66 P1 L3 Q[#<timeout> + [#4711]]\n"
"M66 P1 L3 Q#<timeout>\n"
"M66 P1 L3 Q#3\n"
"M66 P1 L3 Q#5999\n"
"G5  X23.5 a 19.2\n"
"(debug, foo!)\n"
"(Debug, some text and a substitution: #23 and some more thereafter)\n"
"(DEBUG, #<_a_param>)\n"
"(DEBUG, #<xxx>)\n"
msgstr ""
"; ஐயா -கோட் மன அழுத்தத்தை முன்னிலைப்படுத்துகிறது - இல்லையெனில் பயனற்றது\n"
" ;\n"
" #<good_change_at_g30> = 0\n"
" G0 (தொடங்க விரைவானது) x1 y1\n"
" G0 X1 Y1 (தொடங்குவதற்கு விரைவானது; ஆனால் குளிரூட்டியை மறந்துவிடாதீர்கள்)\n"
" எம் 2; நிரலின் முடிவு.\n"
" M66 P1 L3 Q [#<timeout>]\n"
" M66 P1 L3 Q [#<timeout> + [#4711]]\n"
" M66 P1 L3 Q#<TIMEOUT>\n"
" M66 P1 L3 Q#3\n"
" M66 P1 L3 Q#5999\n"
" G5 x23.5 A 19.2\n"
" (பிழைத்திருத்தம், ஃபூ!)\n"
" (பிழைத்திருத்தம், சில உரை மற்றும் மாற்றீடு: #23 மற்றும் அதன்பிறகு இன்னும் சில)\n"
" (பிழைத்திருத்தம், #<_ a_param>)\n"
" (பிழைத்திருத்தம், #<xxx>)\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:68
#, no-wrap
msgid ""
"G0 G53 Z0 X[#19]\n"
"G 3 0\n"
"G00\n"
"G01\n"
"G 0 1\n"
"G3 0\n"
"G30\n"
"G53\n"
"G5 3\n"
"G 5 3\n"
"G0\n"
"G1\n"
";\n"
"; To activate, incantate as follows in the INI file:\n"
";\n"
"; [RS274NGC]\n"
"; # Remap M6 to a named O-word subroutine.\n"
"; # The tool number currently loaded (in spindle) is passed as parameter #1\n"
"; M6_COMMAND=o<m6demo>call\n"
";\n"
";\n"
"N4711 O<m6demo> sub\n"
";\n"
";\n"
"N 0815 #<tool_change_with_spindle_on> = 0\n"
"#<tool_change_quill_up> = 0\n"
"#<tool_change_at_g30> = 0\n"
msgstr ""
"G0 G53 Z0 ஃச் [#19]\n"
" ஐயா 3 0\n"
" G00\n"
" G01\n"
" G 0 1\n"
" ஐயா 3 0\n"
" ஐயா 30\n"
" ஐயா 53\n"
" ஐயா 5 3\n"
" G 5 3\n"
" G0\n"
" ஐயா 1\n"
" ;\n"
" ; செயல்படுத்த, இனி கோப்பில் பின்வருமாறு மந்திரி:\n"
" ;\n"
" ; [Rs274ngc]\n"
" ; # பெயரிடப்பட்ட ஓ-சொல் சப்ரூட்டினுக்கு M6 ஐ மறுபரிசீலனை செய்யுங்கள்.\n"
" ; # தற்போது ஏற்றப்பட்ட கருவி எண் (சுழலில்) # 1 அளவுருவாக அனுப்பப்படுகிறது\n"
" ; M6_command = o <m6demo> அழைப்பு\n"
" ;\n"
" ;\n"
" N4711 O <M6Demo> துணை\n"
" ;\n"
" ;\n"
" N 0815 #<good_change_with_spindle_on> = 0\n"
" #<good_change_quill_up> = 0\n"
" #<good_change_at_g30> = 0\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:70
#, no-wrap
msgid "#4711 = 8.15\n"
msgstr "#4711 = 8.15\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:79
#, no-wrap
msgid ""
"; number of seconds to wait for 'tool-changed' equivalent\n"
"#<timeout> = 9999\n"
";\n"
"(DEBUG, executing M6 O-word sub, tool=#1)\n"
";\n"
"O<m6demo_spindle_off> if [#<tool_change_with_spindle_on>] EQ 0\n"
"    M5\n"
"O<m6demo_spindle_off> endif\n"
msgstr ""
"; 'கருவி மாற்றப்பட்ட' சமமான காத்திருக்க வினாடிகளின் எண்ணிக்கை\n"
" #<நேரம் முடிந்தது> = 9999\n"
" ;\n"
" (பிழைத்திருத்தம், M6 O- சொல் துணை, கருவி =#1 ஐ இயக்குதல்)\n"
" ;\n"
" O <M6DEMO_SPINDLE_OFF> என்றால் [#<coold_change_with_spindle_on>] Eq 0\n"
" எம் 5\n"
" O <m6demo_spindle_off> endif\n"

#. type: delimited block -
#: src/source-highlight/ngc-demo.adoc:83
#, no-wrap
msgid ""
"O<m6demo_quill_up> if [#<tool_change_quill_up>] NE 0\n"
