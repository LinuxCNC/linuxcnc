"G90 G17\n"
"G0 X-2 Y4\n"
"G5.1 X2 I2 J-8\n"
msgstr ""
"G90 G17\n"
" G0 x-2 ஒய் 4\n"
" 5.1 ஃச் 2 I 2 J-8\n"

#. type: Plain text
#: src/gcode/g-code.adoc:615
