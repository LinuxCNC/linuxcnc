msgstr ""
"உள்ளீட்டைத் தேர்ந்தெடுக்கவும். 0.0 மற்றும் 1.0 க்கு இடையிலான மதிப்புகளுக்கு, வெளியீடு IN2 "
"முதல் IN1 வரை நேர்கோட்டுடன் மாறுகிறது"

#. type: Plain text
#: man/man9/blend.9:58
#, fuzzy
#| msgid "B<blend.>I<N>B<.out> float out "
msgid "B<blend>\\&.I<N>\\&.B<out> float out"
msgstr "பி <கலப்பு.> நான் <n> பி <.out> மிதக்கவும்"

#. type: Plain text
#: man/man9/blend.9:60
#, fuzzy
#| msgid "Output value."
msgid "Output value\\&."
msgstr "வெளியீட்டு மதிப்பு."

#. type: Plain text
#: man/man9/blend.9:64
#, fuzzy
#| msgid "B<blend.>I<N>B<.open> bit rw "
msgid "B<blend>\\&.I<N>\\&.B<open> bit rw"
msgstr "பி <கலப்பு"

#. type: Plain text
#: man/man9/blend.9:66
#, fuzzy
#| msgid ""
#| "If true, select values outside the range 0.0 to 1.0 give values outside "
#| "the range in2 to in1.  If false, outputs are clamped to the the range in2 "
#| "to in1"
msgid ""
"If true, select values outside the range 0\\&.0 to 1\\&.0 give values "
"outside the range in2 to in1\\&. If false, outputs are clamped to the the "
"range in2 to in1"
msgstr ""
"உண்மை என்றால், 0.0 முதல் 1.0 வரம்பிற்கு வெளியே மதிப்புகளைத் தேர்ந்தெடுக்கவும் IN2 முதல் "
"IN1 வரம்பிற்கு வெளியே மதிப்புகளைக் கொடுங்கள். தவறு செய்தால், வெளியீடுகள் IN2 முதல் IN1 "
"வரையிலான வரம்பில் பிணைக்கப்படுகின்றன"

#. type: TH
#: man/man9/carousel.9:10
#, no-wrap
msgid "CAROUSEL"
msgstr "கொணர்வி"

#. type: Plain text
#: man/man9/carousel.9:32
msgid "carousel - Orient a toolchanger carousel using various encoding schemes"
msgstr ""
"கொணர்வி - பல்வேறு குறியாக்கத் திட்டங்களைப் பயன்படுத்தி ஒரு கருவித்திறன் கொணர்வி ஓரியண்ட்"

#. type: Plain text
#: man/man9/carousel.9:35
#, fuzzy
#| msgid ""
#| "B<loadrt carousel pockets=>I<N>[,I<N>] B<encoding=>I<ssss>[,I<sss>] "
#| "B<num_sense=>I<N>[,I<N>] B<dir=>I<N>[,I<N]>"
msgid ""
"B<loadrt> B<carousel> B<pockets>=I<N>[,I<N>] B<encoding>=I<ssss>[,I<sss>] "
"B<num_sense>=I<N>[,I<N>] B<dir>=I<N>[,I<N>]"
msgstr ""
"B <loadrt கொணர்வி பாக்கெட்டுகள் => i <n> [, i <n>] b <encoding => i <ssss> [, i "
"<sss>] b <num_sense => i <n> [, i <n>] B <dir => i <n> [, i <n]>"

#. type: Plain text
#: man/man9/carousel.9:37
#, fuzzy
#| msgid "B<pockets> The number of pockets in each toolchanger."
msgid "B<pockets> The number of pockets in each toolchanger"
msgstr "பி <பாக்கெட்டுகள்> ஒவ்வொரு கருவித்தொகுப்பிலும் பாக்கெட்டுகளின் எண்ணிக்கை."

#. type: Plain text
#: man/man9/carousel.9:39
#, fuzzy
#| msgid ""
#| "Use up to 8 numbers separated by commas to create multiple carousel "
#| "components."
msgid ""
"Use up to 8 numbers separated by commas to create multiple carousel "
"components\\&."
msgstr ""
"பல கொணர்வி கூறுகளை உருவாக்க காற்புள்ளிகளால் பிரிக்கப்பட்ட 8 எண்களைப் பயன்படுத்தவும்."

#. type: Plain text
#: man/man9/carousel.9:42
msgid "B<encoding>"
msgstr ""

#. type: Plain text
#: man/man9/carousel.9:53
#, fuzzy
#| msgid "gray, binary, bcd, index, edge, counts or single. Default = 'gray'"
msgid ""
"The position encoding\\&. One of gray, binary, bcd, index, edge, counts or "
"single\\&. Default = gray\\&."
msgstr ""
"சாம்பல், பைனரி, பி.சி.டி, குறியீட்டு, விளிம்பு, எண்ணிக்கைகள் அல்லது ஒற்றை. இயல்புநிலை = "
"'சாம்பல்'"

#. type: Plain text
#: man/man9/carousel.9:56
msgid "B<num_sense>"
msgstr ""

#. type: Plain text
#: man/man9/carousel.9:58
#, fuzzy
#| msgid "B<num_sense> The number of position sense pins."
msgid "The number of position sense pins\\&. Default = 4\\&."
msgstr "பி <num_sense> நிலை உணர்வு ஊசிகளின் எண்ணிக்கை."

#. type: Plain text
#: man/man9/carousel.9:61
msgid "B<dir>"
msgstr ""

#. type: Plain text
#: man/man9/carousel.9:63
#, fuzzy
#| msgid ""
#| "B<dir> Set to 1 for unidirectional or  2 for bidirectional operation."
msgid ""
"Set to 1 for unidirectional or 2 for bidirectional operation\\&. Default = "
"bidirectional"
msgstr ""
"B <dir> ஒருதலைப்பட்சத்திற்கு 1 அல்லது இருதரப்பு செயல்பாட்டிற்கு 2 என அமைக்கப்பட்டுள்ளது."

#. type: Plain text
#: man/man9/carousel.9:66
msgid "B<parity>"
msgstr ""

#. type: Plain text
#: man/man9/carousel.9:68
#, fuzzy
#| msgid "B<parity> Set to 1 for odd parity, 0 for even parity checking."
msgid ""
"Set to 1 for odd parity, 0 for even parity checking\\&. Default = 0 (even)"
msgstr ""
"பி <பரிதி> ஒற்றைப்படை சமநிலைக்கு 1 ஆக அமைக்கப்பட்டுள்ளது, 0 சமநிலை சோதனைக்கு கூட."

#. type: Plain text
#: man/man9/carousel.9:72
#, fuzzy
#| msgid ""
#| "This component is intended to help operate various types of carousel-type "
#| "toolchangers."
msgid ""
"This component is intended to help operate various types of carousel-type "
"toolchangers\\&."
msgstr "இந்த கூறு பல்வேறு வகையான கொணர்வி வகை கருவித்தொகுப்பாளர்களை இயக்க உதவும்."

#. type: Plain text
#: man/man9/carousel.9:74
#, fuzzy
#| msgid ""
#| "The component can be configured to operate with binary, binary-coded "
#| "decimal (BCD)  or gray-coded position feedback ('binary;, 'bcd' and "
#| "'gray' modes)  It can alternatively work with an individual sensor for "
#| "each tool position ('single' mode) or with a sensor at each tool position "
#| "and a separate index ('index' mode). Systems using a stepper motor or "
#| "quadrature encoder are also supported ('counts' mode).  B<edge> is a "
#| "special case of index mode for tool changers with pockets on both the "
#| "rising and falling edges of the position sensor.  (Seen on at least one "
#| "Denford Orac.)"
msgid ""
"The component can be configured to operate with binary, binary-coded decimal "
"(BCD) or gray-coded position feedback (I<binary;, \\*(Aqbcd> and I<gray> "
"modes) It can alternatively work with an individual sensor for each tool "
"position (I<single> mode) or with a sensor at each tool position and a "
"separate index (I<index> mode)\\&. Systems using a stepper motor or "
"quadrature encoder are also supported (I<counts> mode)\\&. B<edge> is a "
"special case of index mode for tool changers with pockets on both the rising "
"and falling edges of the position sensor\\&. (Seen on at least one Denford "
"Orac\\&.)"
msgstr ""
"பைனரி, பைனரி-குறியிடப்பட்ட தசம (பி.சி.டி) அல்லது சாம்பல்-குறியிடப்பட்ட நிலை "
"பின்னூட்டத்துடன் ('பைனரி;,' பி.சி.டி 'மற்றும்' சாம்பல் 'முறைகள்) செயல்பட கூறு "
"கட்டமைக்கப்படலாம், இது மாற்றாக ஒவ்வொரு கருவி நிலைக்கும் ஒரு தனிப்பட்ட சென்சாருடன் வேலை "
"செய்யலாம் ( 'ஒற்றை' பயன்முறை) அல்லது ஒவ்வொரு கருவி நிலையில் ஒரு சென்சார் மற்றும் ஒரு "
"தனி குறியீட்டு ('குறியீட்டு' பயன்முறை). ச்டெப்பர் மின்னோடி அல்லது குவாட்ரேச்சர் "
"குறியாக்கியைப் பயன்படுத்தும் அமைப்புகளும் ஆதரிக்கப்படுகின்றன ('எண்ணிக்கைகள்' பயன்முறை). பி "
"<எட்ச்> என்பது நிலை சென்சாரின் உயரும் மற்றும் வீழ்ச்சியடைந்த விளிம்புகள் இரண்டிலும் "
"பாக்கெட்டுகளுடன் கருவி மாற்றிகளுக்கான குறியீட்டு பயன்முறையின் ஒரு சிறப்பு வழக்கு. "
"(குறைந்தது ஒரு டென்ஃபோர்ட் ஆராக்கில் காணப்படுகிறது.)"

#. type: Plain text
#: man/man9/carousel.9:76
#, fuzzy
#| msgid ""
#| "Both unidirectional and bidirectional systems are supported and those "
#| "that reverse against a stop when in position."
msgid ""
"Both unidirectional and bidirectional systems are supported and those that "
"reverse against a stop when in position\\&."
msgstr ""
"ஒருதலைப்பட்ச மற்றும் இருதரப்பு அமைப்புகள் இரண்டும் ஆதரிக்கப்படுகின்றன, மேலும் நிலையில் "
"இருக்கும்போது நிறுத்தத்திற்கு எதிராக தலைகீழாகின்றன."

#. type: Plain text
#: man/man9/carousel.9:78
#, fuzzy
#| msgid ""
#| "The number of carousel component instances created depends on the number "
#| "of entries in the 'pockets' modparam. For example"
msgid ""
"The number of carousel component instances created depends on the number of "
"entries in the I<pockets> modparam\\&. For example"
msgstr ""
"உருவாக்கப்பட்ட கொணர்வி கூறு நிகழ்வுகளின் எண்ணிக்கை 'பாக்கெட்டுகள்' மோட்பரத்தில் உள்ளீடுகளின் "
"எண்ணிக்கையைப் பொறுத்தது. உதாரணமாக"

#. type: Plain text
#: man/man9/carousel.9:80
#, fuzzy
#| msgid ""
#| "Would create 3 carousel instances with 10, 10 and 8 pockets. The other "
#| "parameters are optional. If absent then defaults will be used. Any "
#| "missing entry will assume the previous value."
msgid ""
"B<B loadrt carousel pockets=10,10,8>. Would create 3 carousel instances with "
"10, 10 and 8 pockets\\&. The other parameters are optional\\&. If absent "
"then defaults will be used\\&. Any missing entry will assume the previous "
"value\\&."
msgstr ""
"10, 10 மற்றும் 8 பைகளில் 3 கொணர்வி நிகழ்வுகளை உருவாக்கும். மற்ற அளவுருக்கள் "
"விருப்பமானவை. இல்லையென்றால் இயல்புநிலை பயன்படுத்தப்படும். காணாமல் போன எந்தவொரு நுழைவும் "
"முந்தைய மதிப்பைக் கருதும்."

#. type: Plain text
#: man/man9/carousel.9:82
#, fuzzy
#| msgid ""
#| "When the enable pin is set to true the component will immediately set the "
#| "\"active\" pin to true and then (for a bidirectional instance) calculate "
#| "the shortest path to the requested pocket number. The appropriate motor "
#| "direction output pins will then be set. Bit outputs for forward and "
#| "reverse are provided as well as a three-state velocity output for driving "
#| "a DC motor PWM or a velocity-mode stepgen."
msgid ""
"When the enable pin is set to true the component will immediately set the "
"\"active\" pin to true and then (for a bidirectional instance) calculate the "
"shortest path to the requested pocket number\\&. The appropriate motor "
"direction output pins will then be set\\&. Bit outputs for forward and "
"reverse are provided as well as a three-state velocity output for driving a "
"DC motor PWM or a velocity-mode stepgen\\&."
msgstr ""
"செயல்படுத்தும் முள் உண்மைக்கு அமைக்கப்படும்போது, கூறு உடனடியாக \"செயலில்\" முள் உண்மையாக "
"அமைக்கும், பின்னர் (இருதரப்பு நிகழ்வுக்கு) கோரப்பட்ட பாக்கெட் எண்ணுக்கு குறுகிய பாதையை "
"கணக்கிடுகிறது. பொருத்தமான மின்னோடி திசை வெளியீட்டு ஊசிகளும் அமைக்கப்படும். முன்னோக்கி "
"மற்றும் தலைகீழான பிட் வெளியீடுகள் மற்றும் டி.சி மின்னோடி பி.டபிள்யூ.எம் அல்லது வேகம்-"
"பயன்முறை ச்டெப்சென் ஓட்டுவதற்கு மூன்று-நிலை திசைவேக வெளியீடு வழங்கப்படுகிறது."

#. type: Plain text
#: man/man9/carousel.9:84
#, fuzzy
#| msgid ""
#| "The component will monitor the carousel position and, when the correct "
#| "position is reached, set the motor-control pins to 0, set \"active\" to 0 "
#| "and set \"ready\" to 1."
msgid ""
"The component will monitor the carousel position and, when the correct "
"position is reached, set the motor-control pins to 0, set \"active\" to 0 "
"and set \"ready\" to 1\\&."
msgstr ""
"கூறு கொணர்வி நிலையை கண்காணிக்கும், சரியான நிலையை அடையும் போது, மோட்டார்-கட்டுப்பாட்டு "
"ஊசிகளை 0 ஆக அமைத்து, \"செயலில்\" 0 ஆக அமைத்து, \"தயாராக\" 1 ஆக அமைக்கவும்."

#. type: Plain text
#: man/man9/carousel.9:86
#, fuzzy
#| msgid ""
#| "In 'index', 'edge' or 'counts'mode there is a need to find the initial "
#| "home position of the carousel.  The first time that the \"enable\" pin is "
#| "set; the carousel will rotate forwards searching for a home signal. In "
#| "'index' and 'edge' mode this is when both the index and pulse inputs are "
#| "true. In 'counts' mode only the index input needs to be set to set home. "
#| "Additionally in 'counts' mode the usual index-enable logic of the encoder "
#| "counters is supported."
msgid ""
"In I<index>, I<edge> or I<counts\\(cqmode there is a need to find the "
"initial home position of the carousel\\&. The first time that the \"enable\" "
"pin is set; the carousel will rotate forwards searching for a home "
"signal\\&. In \\*(Aqindex> and I<edge> mode this is when both the index and "
"pulse inputs are true\\&. In I<counts> mode only the index input needs to be "
"set to set home\\&. Additionally in I<counts> mode the usual index-enable "
"logic of the encoder counters is supported\\&."
msgstr ""
"'குறியீட்டு', 'எட்ச்' அல்லது 'எண்ணிக்கையில்' கொணர்வியின் ஆரம்ப வீட்டு நிலையை கண்டுபிடிக்க "
"வேண்டிய தேவை உள்ளது. \"இயக்கு\" முள் அமைக்கப்பட்ட முதல் முறையாக; கொணர்வி ஒரு வீட்டு "
"சமிக்ஞையைத் தேடி முன்னோக்கி சுழலும். 'குறியீட்டு' மற்றும் 'எட்ச்' பயன்முறையில் குறியீட்டு "
"மற்றும் துடிப்பு உள்ளீடுகள் இரண்டும் உண்மையாக இருக்கும்போது இது. 'எண்ணிக்கைகள்' "
"பயன்முறையில், வீட்டிற்கு அமைக்க குறியீட்டு உள்ளீடு மட்டுமே அமைக்கப்பட வேண்டும். கூடுதலாக, "
"'எண்ணிக்கைகள்' பயன்முறையில் குறியாக்கி கவுண்டர்களின் வழக்கமான குறியீட்டு-இயக்கக்கூடிய "
"வழக்கு ஆதரிக்கப்படுகிறது."

#. type: Plain text
#: man/man9/carousel.9:88
#, fuzzy
#| msgid ""
#| "With some carousel designs the carousel will not stop immediately. To "
#| "allow for this set the B<lign-dc> pin to a low velocity to be used for a "
#| "final latching move, and set theB<decel-time> to a suitable value.  Once "
#| "the decel-time has expired the carousel will, if it was moving forwards, "
#| "reverse back on to the position marker, off of the arker and then bak on "
#| "to the FWD edge. If moving in reverse it will continue off the marker and "
#| "then reverse slowly on to the FWD edge.  This algnment is only possible "
#| "with a motor-vel controlled bidirectional carousel, Other combinations "
#| "will be accepted but probably won't have the desired behaviour.  Some "
#| "tuning will be needed of align-dc and decel-time to achieve reliable "
#| "operation."
msgid ""
"With some carousel designs the carousel will not stop immediately\\&. To "
"allow for this set the B<align-dc> pin to a low velocity to be used for a "
"final latching move, and set the B<decel-time> to a suitable value\\&. Once "
"the decel-time has expired the carousel will, if it was moving forwards, "
"reverse back on to the position marker, off of the marker and then back on "
"to the FWD edge\\&. If moving in reverse it will continue off the marker and "
"then reverse slowly on to the FWD edge\\&. This alignment is only possible "
"with a motor-vel controlled bidirectional carousel, Other combinations will "
"be accepted but probably will not have the desired behaviour\\&. Some tuning "
"will be needed of align-dc and decel-time to achieve reliable operation\\&."
msgstr ""
"சில கொணர்வி வடிவமைப்புகளுடன் கொணர்வி உடனடியாக நிறுத்தப்படாது. இதை அனுமதிக்க, பி "
"<லிக்ன்-டிசி> முள் ஒரு இறுதி லாட்சிங் நகர்வுக்கு பயன்படுத்த குறைந்த வேகத்திற்கு "
"அமைக்கவும், மேலும் பொருத்தமான மதிப்புக்கு Theb <cisel-time> ஐ அமைக்கவும். கொணர்வி "
"நேரம் காலாவதியானவுடன், கொணர்வி விருப்பத்தை காலாவதியானவுடன், அது முன்னோக்கி நகர்ந்தால், "
"மீண்டும் நிலை மார்க்கருக்கு தலைகீழாக, ஆர்கரின் வெளியேறி, பின்னர் எஃப்.டபிள்யூ.டி "
"விளிம்பிற்குச் செல்லுங்கள். தலைகீழாக நகர்ந்தால், அது மார்க்கரைத் தொடரும், பின்னர் மெதுவாக "
"FWD விளிம்பில் தலைகீழாக மாற்றும். மோட்டார்-அளவிலான கட்டுப்படுத்தப்பட்ட இருதரப்பு கொணர்வி "
"மூலம் மட்டுமே இந்த அலக்சன் சாத்தியமாகும், பிற சேர்க்கைகள் ஏற்றுக்கொள்ளப்படும், ஆனால் அநேகமாக "
"விரும்பிய நடத்தை இருக்காது. நம்பகமான செயல்பாட்டை அடைய சில ட்யூனிங் சீரமை-டி.சி மற்றும் "
"வீழ்ச்சி நேரத்திற்கு தேவைப்படும்."

#. type: Plain text
#: man/man9/carousel.9:90
#, fuzzy
#| msgid ""
#| "In the unusual case that the index and pulse signals do not align it is "
#| "possible to use HAL logic to achieve the desired pin switching during "
#| "homing."
msgid ""
"In the unusual case that the index and pulse signals do not align it is "
"possible to use HAL logic to achieve the desired pin switching during "
"homing\\&."
msgstr ""
"குறியீட்டு மற்றும் துடிப்பு சமிக்ஞைகள் சீரமைக்கப்படாத அசாதாரண சந்தர்ப்பத்தில், ஓமிங்கின் போது "
"விரும்பிய முள் மாறுதலை அடைய HAL தர்க்கத்தைப் பயன்படுத்த முடியும்."

#. type: Plain text
#: man/man9/carousel.9:92
#, fuzzy
#| msgid ""
#| "Setting \"enable\" low does not halt the homing move, so if homing on "
#| "first tool change is not needed then the enable pin can be toggled by an "
#| "axis homing pin or a script and the homing process will continue even if "
#| "that driving signal resets during the carousel homing move."
msgid ""
"Setting \"enable\" low does not halt the homing move, so if homing on first "
"tool change is not needed then the enable pin can be toggled by an axis "
"homing pin or a script and the homing process will continue even if that "
"driving signal resets during the carousel homing move\\&."
msgstr ""
"\"இயக்கு\" லோ அமைப்பது ஓமிங் நகர்வைத் தடுக்காது, எனவே முதல் கருவி மாற்றத்தில் ஓலிங் "
"தேவையில்லை என்றால், இயக்க முள் ஒரு அச்சு ஓமிங் முள் அல்லது ச்கிரிப்ட் மூலம் மாற்றப்படலாம் "
"மற்றும் அந்த ஓட்டுநர் சமிக்ஞை மீட்டமைக்கப்பட்டாலும் கூட ஓமிங் செயல்முறை தொடரும் கொணர்வி ஓமிங் "
"நடவடிக்கை."

#. type: Plain text
#: man/man9/carousel.9:94
#, fuzzy
#| msgid ""
#| "To operate the component with an encoder or stepgen use mode \"C\". The "
#| "B<scale> pin should be the number of steps or encoder counts between "
#| "pocket centres. The B<width> pin can be used to stop the motor some "
#| "distance before the centre of the pocket to allow the motor time to "
#| "decelerate.  In mode \"C\" it is possible to use either the speed/"
#| "direction control used in other modes or to use direct position mode "
#| "using the counts-target pin. The internal scaling of the encoder or "
#| "stepgen should be set to 1.0. A PID hal component will be needed for "
#| "encoder applications whereas stepgen configurations can use a stepgen in "
#| "position control mode or in velocity control mode with a PID."
msgid ""
"To operate the component with an encoder or stepgen use mode \"C\"\\&. The "
"B<scale> pin should be the number of steps or encoder counts between pocket "
"centres\\&. The B<width> pin can be used to stop the motor some distance "
"before the centre of the pocket to allow the motor time to decelerate\\&. In "
"mode \"C\" it is possible to use either the speed/direction control used in "
"other modes or to use direct position mode using the counts-target pin\\&. "
"The internal scaling of the encoder or stepgen should be set to 1\\&.0\\&. A "
"PID hal component will be needed for encoder applications whereas stepgen "
"configurations can use a stepgen in position control mode or in velocity "
"control mode with a PID\\&."
msgstr ""
"ஒரு குறியாக்கி அல்லது ச்டெப்சென் பயன்பாட்டு பயன்முறை \"சி\" உடன் கூறுகளை இயக்க. பி "
"<அளவுகோல்> முள் பாக்கெட் மையங்களுக்கு இடையில் படிகள் அல்லது குறியாக்கி எண்ணிக்கையின் "
"எண்ணிக்கையாக இருக்க வேண்டும். மின்னோடி நேரத்தை குறைக்க அனுமதிக்க பாக்கெட்டின் மையத்திற்கு "
"முன் மோட்டாரை சிறிது தூரம் நிறுத்த பி <அகலம்> முள் பயன்படுத்தப்படலாம். \"சி\" "
"பயன்முறையில் மற்ற முறைகளில் பயன்படுத்தப்படும் வேகம்/திசைக் கட்டுப்பாட்டைப் பயன்படுத்தலாம் "
"அல்லது எண்ணிக்கைகள்-இலக்கு முள் பயன்படுத்தி நேரடி நிலை பயன்முறையைப் பயன்படுத்தலாம். "
"குறியாக்கி அல்லது ச்டெப்செனின் உள் அளவிடுதல் 1.0 ஆக அமைக்கப்பட வேண்டும். குறியாக்கி "
"பயன்பாடுகளுக்கு ஒரு PID HAL கூறு தேவைப்படும், அதேசமயம் ச்டெப்சென் உள்ளமைவுகள் நிலை "
"கட்டுப்பாட்டு பயன்முறையில் அல்லது PID உடன் விரைவு கட்டுப்பாட்டு பயன்முறையில் ஒரு "
"படிநிலையைப் பயன்படுத்தலாம்."

