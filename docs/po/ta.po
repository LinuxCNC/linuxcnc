#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/pyvcp-examples.adoc:273
#, no-wrap
msgid "Port Tester Panel"
msgstr "துறைமுகம் சோதனையாளர் குழு"

#. type: Target for macro image
#: src/gui/pyvcp-examples.adoc:273
#, no-wrap
msgid "images/ptest.png"
msgstr "படங்கள்/ptest.png"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:277
msgid ""
"To run the HAL commands that we need to get everything up and running we put "
"the following in our ptest.hal file."
msgstr ""
"எல்லாவற்றையும் எழுப்பி இயங்க வேண்டிய HAL கட்டளைகளை இயக்க நாங்கள் பின்வருவனவற்றை எங்கள் "
"ptest.hal கோப்பில் வைக்கிறோம்."

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:290
#, no-wrap
msgid ""
"loadrt hal_parport cfg=\"0x378 out\"\n"
"loadusr -Wn ptest pyvcp -c ptest ptest.xml\n"
"loadrt threads name1=porttest period1=1000000\n"
"addf parport.0.read porttest\n"
"addf parport.0.write porttest\n"
"net pin01 ptest.btn01 parport.0.pin-01-out ptest.led-01\n"
"net pin02 ptest.btn02 parport.0.pin-02-out ptest.led-02\n"
"net pin10 parport.0.pin-10-in ptest.led-10\n"
"net pin11 parport.0.pin-11-in ptest.led-11\n"
"start\n"
msgstr ""
"loadrt hal_parport cfg = \"0x378 out\"\n"
" loadusr -wn ptest pyvcp -c ptest ptest.xml\n"
" loadrt நூல்கள் name1 = porttest peare1 = 1000000\n"
" Addf parport.0.Read PortTest\n"
" addf parport.0.write porttest\n"
" வலைமம் PIN01 PTEST.BTN01 PARPORT.0.PIN-01-OUT PTEST.LED-01\n"
" வலைமம் PIN02 PTEST.BTN02 PARPORT.0.PIN-02-OUT PTEST.LED-02\n"
" நிகர முள் 10 பார்போர்ட்\n"
" நிகர முள் 11 பார்போர்ட்\n"
" தொடக்க\n"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:293
msgid ""
"To run the HAL file we use the following command from a terminal window."
msgstr "HAL கோப்பை இயக்க முனைய சாளரத்திலிருந்து பின்வரும் கட்டளையைப் பயன்படுத்துகிறோம்."

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:296
#, no-wrap
msgid "~$ halrun -I -f ptest.hal\n"
msgstr "~ $ halrun -i -f ptest.hal\n"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:299
msgid "The following figure shows what a complete panel might look like."
msgstr "ஒரு முழுமையான குழு எப்படி இருக்கும் என்பதை பின்வரும் எண்ணிக்கை காட்டுகிறது."

