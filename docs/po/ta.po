#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:159
msgid ""
"Widget that interact with LinuxCNC's controller are only a little more "
"complicated and they require some _extra libraries_."
msgstr ""
"லினக்ச் சி.என்.சியின் கட்டுப்படுத்தியுடன் தொடர்பு கொள்ளும் விட்செட் இன்னும் கொஞ்சம் "
"சிக்கலானது, மேலும் அவர்களுக்கு சில _ எக்ச்ட்ரா நூலகங்கள்_ தேவை."

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:161
msgid ""
"In this cut down example we will add properties that can be changed in Qt "
"Designer."
msgstr ""
"இந்த வெட்டு எடுத்துக்காட்டில், கியுடி வடிவமைப்பாளரில் மாற்றக்கூடிய பண்புகளை சேர்ப்போம்."

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:163
msgid ""
"This LED indicator widget will respond to selectable LinuxCNC controller "
"states."
msgstr ""
"இந்த எல்இடி காட்டி விட்செட் தேர்ந்தெடுக்கப்பட்ட லினக்ச் சிஎன்சி கட்டுப்படுத்தி நிலைகளுக்கு "
"பதிலளிக்கும்."

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:177
#, no-wrap
msgid ""
"###############################\n"
"# Imports\n"
"###############################\n"
"from PyQt5.QtCore import pyqtProperty\n"
"from qtvcp.widgets.led_widget import LED\n"
"from qtvcp.core import Status\n"
msgstr ""
"######################################\n"
" # இறக்குமதி\n"
" ######################################\n"
" Pyqt5.qtcore இலிருந்து இறக்குமதி pyqtproperty\n"
" qtvcp.widgets.led_widget இறக்குமதி எல்.ஈ.டி.\n"
" QTVCP.CORE இறக்குமதி நிலையிலிருந்து\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:182 src/gui/qtvcp-custom-widgets.adoc:276
#, no-wrap
msgid ""
"###########################################\n"
"# **** instantiate libraries section **** #\n"
"###########################################\n"
"STATUS = Status()\n"
msgstr ""
"#####################################################\n"
" # **** உடனடி நூலகங்கள் பிரிவு **** #\n"
" #####################################################\n"
" நிலை = நிலை ()\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:194
#, no-wrap
msgid ""
"##########################################\n"
"# custom widget class definition\n"
"##########################################\n"
"class StateLED(LED):\n"
"    def __init__(self, parent=None):\n"
"        super(StateLED, self).__init__(parent)\n"
"        self.has_hal_pins = False\n"
"        self.setState(False)\n"
"        self.is_estopped = False\n"
"        self.is_on = False\n"
"        self.invert_state = False\n"
msgstr ""
"######################################################\n"
" # தனிப்பயன் விட்செட் வகுப்பு வரையறை\n"
" ######################################################\n"
" வகுப்பு நிலை (எல்.ஈ.டி):\n"
" def __init __ (சுய, பெற்றோர் = எதுவுமில்லை):\n"
" சூப்பர் (ச்டேட்டில்ட், சுய) .__ init __ (பெற்றோர்)\n"
" self.has_hal_pins = பொய்\n"
" self.setstate (பொய்)\n"
" self.is_estopped = பொய்\n"
" self.is_on = பொய்\n"
" self.invert_state = பொய்\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:202 src/gui/qtvcp-custom-widgets.adoc:322
#, no-wrap
msgid ""
"    def _hal_init(self):\n"
"        if self.is_estopped:\n"
"            STATUS.connect('state-estop', lambda w:self._flip_state(True))\n"
"            STATUS.connect('state-estop-reset', lambda w:self._flip_state(False))\n"
"        elif self.is_on:\n"
"            STATUS.connect('state-on', lambda w:self._flip_state(True))\n"
"            STATUS.connect('state-off', lambda w:self._flip_state(False))\n"
msgstr ""
"def _hal_init (சுய):\n"
" self.is_estopped என்றால்:\n"
" Status.connect ('state-estop', lambda w: self._flip_state (உண்மை))\n"
" Status.connect ('state-estop-reset', lambda w: self._flip_state (பொய்))\n"
" elif self.is_on:\n"
" Status.connect ('state-on', லாம்ப்டா w: self._flip_state (உண்மை))\n"
" Status.connect ('state-off', lambda w: self._flip_state (பொய்))\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:207 src/gui/qtvcp-custom-widgets.adoc:370
#, no-wrap
msgid ""
"    def _flip_state(self, data):\n"
"            if self.invert_state:\n"
"                data = not data\n"
"            self.change_state(data)\n"
msgstr ""
"def _flip_state (சுய, தரவு):\n"
" self.invert_state என்றால்:\n"
" தரவு = தரவு அல்ல\n"
" self.change_state (தரவு)\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:211 src/gui/qtvcp-custom-widgets.adoc:396
#, no-wrap
msgid ""
"    #########################################################################\n"
"    # Qt Designer properties setter/getters/resetters\n"
"    ########################################################################\n"
msgstr ""
"##################################################################### ##############################\n"
" # கியுடி வடிவமைப்பாளர் பண்புகள் செட்டர்/பெறுநர்கள்/மீட்டமைப்பாளர்கள்\n"
" ##################################################################### ###########################\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:219 src/gui/qtvcp-custom-widgets.adoc:404
#, no-wrap
msgid ""
"    # invert status\n"
"    def set_invert_state(self, data):\n"
"        self.invert_state = data\n"
"    def get_invert_state(self):\n"
"        return self.invert_state\n"
"    def reset_invert_state(self):\n"
"        self.invert_state = False\n"
msgstr ""
"# தலைகீழ் நிலை\n"
" def set_invert_state (சுய, தரவு):\n"
" self.invert_state = தரவு\n"
" def get_invert_state (சுய):\n"
" தன்வய\n"
" DEF Reset_invert_state (சுய):\n"
" self.invert_state = பொய்\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:227 src/gui/qtvcp-custom-widgets.adoc:412
#, no-wrap
msgid ""
"    # machine is estopped status\n"
"    def set_is_estopped(self, data):\n"
"        self.is_estopped = data\n"
"    def get_is_estopped(self):\n"
"        return self.is_estopped\n"
"    def reset_is_estopped(self):\n"
"        self.is_estopped = False\n"
msgstr ""
"# இயந்திரம் எறியப்பட்ட நிலை\n"
" def set_is_estopped (சுய, தரவு):\n"
" self.is_estopped = தரவு\n"
" def get_is_estopped (சுய):\n"
" தன்வய\n"
" DEF Reset_is_estopped (சுய):\n"
" self.is_estopped = பொய்\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:235 src/gui/qtvcp-custom-widgets.adoc:420
#, no-wrap
msgid ""
"    # machine is on status\n"
"    def set_is_on(self, data):\n"
"        self.is_on = data\n"
"    def get_is_on(self):\n"
"        return self.is_on\n"
"    def reset_is_on(self):\n"
"        self.is_on = False\n"
msgstr ""
"# இயந்திரம் அந்தச்தில் உள்ளது\n"
" def set_is_on (சுய, தரவு):\n"
" self.is_on = தரவு\n"
" def get_is_on (சுய):\n"
" தன்வய\n"
" DEF Reset_is_on (self):\n"
" self.is_on = பொய்\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:242 src/gui/qtvcp-custom-widgets.adoc:435
#, no-wrap
msgid ""
"    #######################################\n"
"    # Qt Designer properties\n"
"    #######################################\n"
"    invert_state_status = pyqtProperty(bool, get_invert_state, set_invert_state, reset_invert_state)\n"
"    is_estopped_status = pyqtProperty(bool, get_is_estopped, set_is_estopped, reset_is_estopped)\n"
"    is_on_status = pyqtProperty(bool, get_is_on, set_is_on, reset_is_on)\n"
msgstr ""
"####################################################\n"
" # கியுடி வடிவமைப்பாளர் பண்புகள்\n"
" ####################################################\n"
" invert_state_status = pyqtproperty (bool, get_invert_state, set_invert_state, reset_invert_state)\n"
" is_estopped_status = pyqtproperty (bool, get_is_estopped, set_is_estopped, reset_is_estopped)\n"
" is_on_status = pyqtproperty (bool, get_is_on, set_is_on, reset_is_on)\n"

