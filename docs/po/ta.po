msgstr "மேம்பட்ட அமைப்புகள்"

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/gmoccapy.adoc:1348
#, no-wrap
msgid "Advanced settings"
msgstr "மேம்பட்ட அமைப்புகள்"

