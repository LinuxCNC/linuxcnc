msgstr "help1.insert (10, (\"கட்டுப்பாடு+`, 1..9,0 \", _ (\" விரைவான மேலெழுதலை 0% முதல் 100% வரை அமைக்கவும் \"),),),)\n"

#. type: delimited block -
#: src/gui/axis.adoc:1169
#, no-wrap
