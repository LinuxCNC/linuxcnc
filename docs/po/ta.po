msgstr "டார்ச் பிரேக்அவே சென்சார் செயல்படுத்தப்படுவதைக் குறிக்கிறது."

#. type: Block title
#: src/plasma/qtplasmac.adoc:823
#, no-wrap
msgid "*THC*"
msgstr ""

#. type: Table
#: src/plasma/qtplasmac.adoc:829
#, no-wrap
msgid "This box determines whether the THC will be enabled or disabled during a cut."
msgstr "வெட்டின் போது THC இயக்கப்பட்டிருக்குமா அல்லது முடக்கப்படுமா என்பதை இந்த பெட்டி தீர்மானிக்கிறது."

#. type: Table
#: src/plasma/qtplasmac.adoc:829
#, no-wrap
msgid "ENABLED"
msgstr "இயக்கப்பட்டது"

#. type: Table
#: src/plasma/qtplasmac.adoc:830
#, no-wrap
msgid "This LED indicates whether the THC is enabled or disabled."
msgstr "இந்த எல்.ஈ.டி THC இயக்கப்பட்டதா அல்லது முடக்கப்பட்டதா என்பதைக் குறிக்கிறது."

#. type: Table
#: src/plasma/qtplasmac.adoc:830
#, no-wrap
msgid "ACTIVE"
msgstr "செயலில்"

#. type: Table
#: src/plasma/qtplasmac.adoc:831
#, no-wrap
msgid "This LED indicates that the THC is actively controlling the Z axis."
msgstr "THC சட் அச்சை தீவிரமாக கட்டுப்படுத்துகிறது என்பதை இந்த எல்.ஈ.டி குறிக்கிறது."

#. type: Table
