#. type: Plain text
#: src/gcode/overview.adoc:528
msgid "'#<_metric>' - Return 1 if G21 is on, else 0."
msgstr "'#<_ மெட்ரிக்>' - g21 இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:529
msgid "'#<_imperial>' - Return 1 if G20 is on, else 0."
msgstr "'#<_ இம்பீரியல்>' - ஐயா 20 இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:530
msgid "'#<_absolute>' - Return 1 if G90 is on, else 0."
msgstr "'#<_ முழுமையான>' - g90 இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:531
msgid "'#<_incremental>' - Return 1 if G91 is on, else 0."
msgstr "'#<_ அதிகரிப்பு>' - g91 இயக்கப்பட்டிருந்தால் 1 திரும்பவும், வேறு 0."

#. type: Plain text
#: src/gcode/overview.adoc:532
msgid "'#<_inverse_time>' - Return 1 if inverse feed mode (G93) is on, else 0."
msgstr ""
"'#<_ தலைகீழ்_ நேரம்>' - தலைகீழ் ஊட்ட முறை (G93) இயக்கத்தில் இருந்தால் 1 திரும்பவும்."

#. type: Plain text
#: src/gcode/overview.adoc:533
msgid ""
"'#<_units_per_minute>' - Return 1 if Units/minute feed mode (G94) is on, "
"else 0."
msgstr ""
"'#<_ அலகுகள்_பெர்_மினூட்>' - அலகுகள்/நிமிட தீவன முறை (சி 94) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும், இல்லையெனில் 0."

#. type: Plain text
#: src/gcode/overview.adoc:534
msgid ""
"'#<_units_per_rev>' - Return 1 if Units/revolution mode (G95) is on, else 0."
msgstr ""
"'#<_ _ UNITS_PER_REV>' - அலகுகள்/புரட்சி பயன்முறை (G95) இயக்கப்பட்டிருந்தால் 1 "
"திரும்பவும்."

#. type: Plain text
#: src/gcode/overview.adoc:537
msgid ""
"'#<_coord_system>' - Return a float of the current coordinate system name "
"(G54..G59.3).  For example if your in G55 coordinate system the return value "
"is 550.000000 and if your in G59.1 the return value is 591.000000."
msgstr ""
"'#<_ COURD_SYSTEM>' - தற்போதைய ஒருங்கிணைப்பு கணினி பெயரின் மிதவை (G54..G59.3) "
"திருப்பித் தரவும். எடுத்துக்காட்டாக, உங்கள் G55 ஒருங்கிணைப்பு கணினியில் வருவாய் மதிப்பு "
"550.000000 ஆகவும், உங்கள் G59.1 இல் இருந்தால் வருவாய் மதிப்பு 591.000000 ஆகவும் "
"இருந்தால்."

