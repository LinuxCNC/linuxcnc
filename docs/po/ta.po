msgid "Diameter of the LED."
msgstr "எல்.ஈ.டி விட்டம்."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2316
msgid "Color of the LED when on."
msgstr "LED இன் நிறம்."

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2318
