"        <relief>RAISED</relief>\n"
"        <text>\"RAISED\"</text>\n"
"        <bd>3</bd>\n"
"    </button>\n"
"    <button>\n"
"        <relief>GROOVE</relief>\n"
"        <text>\"GROOVE\"</text>\n"
"        <bd>3</bd>\n"
"    </button>\n"
