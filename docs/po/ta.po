msgstr "கின்ச்டைப் = [** பி ** | ** பி **] இயக்கவியல்_போத்"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:86
#, no-wrap
msgid "kinstype=[**f**|**F**] for KINEMATICS_FORWARD_ONLY"
msgstr "Kinstype = [** f ** | ** f **] இயக்கவியல்_ஃபோர்வார்ட்_ஆன்"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:88
#, no-wrap
