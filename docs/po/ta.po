msgstr "* rtapi_mutex_get* mutex கிடைக்கும் வரை தொகுதிகள்.\n"

#. type: Plain text
#: src/man/man3/rtapi_mutex.3.adoc:32
#, fuzzy
#| msgid ""
#| "*rtapi_mutex_give* releases a mutex acquired by *rtapi_mutex_try* or "
#| "*rtapi_mutex_get*.\n"
msgid ""
"*rtapi_mutex_give* releases a mutex acquired by *rtapi_mutex_try* or "
"*rtapi_mutex_get*."
msgstr ""
"*rtapi_mutex_give* releases a mutex acquired by *rtapi_mutex_try* or "
"*rtapi_mutex_get*.\n"

#. type: Plain text
#: src/man/man3/rtapi_mutex.3.adoc:36
#, fuzzy
#| msgid ""
#| "*rtapi_mutex_give* and *rtapi_mutex_try* may be used from non-realtime, "
