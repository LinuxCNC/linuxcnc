"[காட்சி]\n"
" MDI_HISTORY_FILE = MDI_HISTORY.DAT\n"
" Machine_log_path = Macine_log.dat\n"
" Log_file = qtdragon.log\n"

#. type: Title ====
#: src/gui/gui-dev-reference.adoc:82
#, fuzzy, no-wrap
#| msgid "Jogging increments"
msgid "Jog Increments"
msgstr "சாகிங் அதிகரிப்புகள்"

#. type: Plain text
#: src/gui/gui-dev-reference.adoc:87
#, no-wrap
msgid ""
"Radio buttons or a combobox are generally used for increments selection.\n"
"The linear increments can be a mix of inches or millimeters.\n"
"Angular increments are specified in degrees.\n"
"The word 'continuous' is used to specify continuous jogging and probably should be added even if left out of the INI line."
msgstr ""

#. type: delimited block -
#: src/gui/gui-dev-reference.adoc:92
#, fuzzy, no-wrap
#| msgid ""
#| "[DISPLAY]\n"
#| "INCREMENTS = Continuous, .001 mm, .01 mm, .1 mm, 1 mm, 1.0 inch, 0.1 inch, 0.01 inch\n"
#| "ANGULAR_INCREMENTS = 1, 5, 10, 30, 45, 90, 180, 360\n"
