msgstr "* முகப்பு* {0 | 1 | 2 | ...} | -1"

#. type: Plain text
#: src/man/man1/linuxcncrsh.1.adoc:287
msgid "With set, homes the indicated joint or, if -1, homes all joints."
msgstr ""
"செட், வீடுகள் சுட்டிக்காட்டப்பட்ட கூட்டு அல்லது, -1 என்றால், வீடுகள் அனைத்து மூட்டுகளும்."

#. type: Plain text
#: src/man/man1/linuxcncrsh.1.adoc:291
#, no-wrap
msgid ""
