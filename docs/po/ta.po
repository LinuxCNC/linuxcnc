#. type: Block title
#: src/gui/qtvcp.adoc:321
#, no-wrap
msgid "An advanced instance patching example"
msgstr "ஒரு மேம்பட்ட நிகழ்வு ஒட்டுதல் சான்று"

#. type: Plain text
#: src/gui/qtvcp.adoc:324
#, no-wrap
msgid ""
"This could work with the QtDragon screen's handler file.\n"
"Here we show how to add new functions and override existing ones."
msgstr ""
"இது Qtdragon திரையின் ஏண்ட்லர் கோப்பில் வேலை செய்யலாம்.\n"
" புதிய செயல்பாடுகளை எவ்வாறு சேர்ப்பது மற்றும் ஏற்கனவே உள்ளவற்றை மேலெழுதுவது இங்கே காண்பிக்கிறோம்."

#. type: delimited block -
#: src/gui/qtvcp.adoc:330
#, no-wrap
msgid ""
"# Needed to instance patch.\n"
"# reference: https://ruivieira.dev/python-monkey-patching-for-readability.html\n"
"import types\n"
msgstr ""
"# உதாரணமாக ஒட்டு தேவை.\n"
" # குறிப்பு: https://ruivieira.dev/python-monkey-tatching-for-readability.html\n"
" இறக்குமதி வகைகள்\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:334
#, no-wrap
msgid ""
"# import the handlerfile to get reference to its libraries.\n"
"# use <screenname>_handler\n"
"import qtdragon_handler as hdlr\n"
msgstr ""
"# அதன் நூலகங்களைக் குறிப்பிட ஏண்ட்லர்ஃபைலை இறக்குமதி செய்க.\n"
" # <wareenname> _handler ஐப் பயன்படுத்தவும்\n"
" Qtdragon_handler ஐ HDLR ஆக இறக்குமதி செய்யுங்கள்\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:341
#, no-wrap
msgid ""
"# This is actually an unbounded function with 'obj' as a parameter.\n"
"# You call this function without the usual preceding 'self.'.\n"
"# This is because will will not be patching it into the original handler class instance\n"
"# It will only be called from code in this file.\n"
"def test_function(obj):\n"
"    print(dir(obj))\n"
msgstr ""
"# இது உண்மையில் ஒரு அளவுருவாக 'OBJ' உடன் வரம்பற்ற செயல்பாடு.\n"
" # வழக்கமான 'தன்வய' இல்லாமல் இந்த செயல்பாட்டை நீங்கள் அழைக்கிறீர்கள்.\n"
" # ஏனென்றால், அசல் ஏண்ட்லர் வகுப்பு நிகழ்வில் வில் அதை இணைக்காது\n"
" # இது இந்த கோப்பில் உள்ள குறியீட்டிலிருந்து மட்டுமே அழைக்கப்படும்.\n"
" def test_function (obj):\n"
" அச்சு (dir (obj))\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:349
#, no-wrap
msgid ""
"# This is a new function we will added to the existing handler class instance.\n"
"# Notice it calls the unbounded function with 'self' as an parameter 'self' is the only global reference available.\n"
"# It references the window instance.\n"
"def on_keycall_F10(self,event,state,shift,cntrl):\n"
"    if state:\n"
"        print ('F10')\n"
"        test_function(self)\n"
msgstr ""
"# இது ஒரு புதிய செயல்பாடு, தற்போதுள்ள ஏண்ட்லர் வகுப்பு நிகழ்வில் நாங்கள் சேர்த்துள்ளோம்.\n"
" # கவனிப்பதைக் கவனியுங்கள், எல்லையற்ற செயல்பாட்டை 'தன்வய' உடன் 'தன்வய' அளவுருவாக அழைப்பது உலகளாவிய குறிப்பு மட்டுமே.\n"
" # இது சாளர நிகழ்வைக் குறிக்கிறது.\n"
" def on_keycall_f10 (சுய, நிகழ்வு, நிலை, மாற்றம், சி.என்.டி.ஆர்.எல்):\n"
" நிலை என்றால்:\n"
" அச்சு ('F10')\n"
" சோதனை_ செயல்பாடு (சுய)\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:357
#, no-wrap
msgid ""
"# This will be used to override an existing function in the existing handler class instance.\n"
"# Note, we also call a copy of the original function too.\n"
"# This shows how to extend an existing function to do extra functions.\n"
"def on_keycall_F11(self,event,state,shift,cntrl):\n"
"    if state:\n"
"        self.on_keycall_F11_super(event,state,shift,cntrl)\n"
"        print ('Hello')\n"
msgstr ""
"# தற்போதுள்ள ஏண்ட்லர் வகுப்பு நிகழ்வில் ஏற்கனவே உள்ள செயல்பாட்டை மேலெழுத இது பயன்படுத்தப்படும்.\n"
" # குறிப்பு, அசல் செயல்பாட்டின் நகலையும் அழைக்கிறோம்.\n"
" # கூடுதல் செயல்பாடுகளைச் செய்ய ஏற்கனவே இருக்கும் செயல்பாட்டை எவ்வாறு நீட்டிப்பது என்பதை இது காட்டுகிறது.\n"
" def on_keycall_f11 (சுய, நிகழ்வு, நிலை, மாற்றம், சி.என்.டி.ஆர்.எல்):\n"
" நிலை என்றால்:\n"
" self.on_keycall_f11_super (நிகழ்வு, மாநிலம், சிப்ட், சி.என்.டி.ஆர்.எல்)\n"
" அச்சு ('அலோ')\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:362
#, no-wrap
msgid ""
"# We are referencing the KEYBIND library that was instantiated in the original handler class instance\n"
"# by adding 'hdlr.' to it (from the imp).\n"
"# This function tells KEYBIND to call 'on_keycall_F10' when F10 is pressed.\n"
"hdlr.KEYBIND.add_call('Key_F10','on_keycall_F10')\n"
msgstr ""
"# அசல் ஏண்ட்லர் வகுப்பு நிகழ்வில் உடனடிப்படுத்தப்பட்ட கீபைண்ட் நூலகத்தை நாங்கள் குறிப்பிடுகிறோம்\n"
" # 'HDLR' சேர்ப்பதன் மூலம். அதற்கு (IMP இலிருந்து).\n"
" # இந்த செயல்பாடு F10 அழுத்தும் போது 'on_keycall_f10' என்று அழைக்க கீபிண்டைக் கூறுகிறது.\n"
" hdlr.keybind.add_call ('key_f10', 'on_keycall_f10')\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:366
#, no-wrap
msgid ""
"# Here we are instance patching the original handler file to add a new function\n"
"# that calls our new function (of the same name) defined in this file.\n"
"self.on_keycall_F10 = types.MethodType(on_keycall_F10, self)\n"
msgstr ""
"# இங்கே ஒரு புதிய செயல்பாட்டைச் சேர்க்க அசல் ஏண்ட்லர் கோப்பை ஒட்டுதல்\n"
" # இந்த கோப்பில் வரையறுக்கப்பட்ட எங்கள் புதிய செயல்பாட்டை (அதே பெயரில்) அழைக்கிறது.\n"
" self.on_keycall_f10 = வகைகள்.\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:371
#, no-wrap
msgid ""
"# Here we are defining a copy of the original 'on_keycall_F11' function,\n"
"# so we can call it later. We can use any valid, unused function name.\n"
"# We need to do this before overriding the original function.\n"
"self.on_keycall_F11_super = self.on_keycall_F11\n"
msgstr ""
"# இங்கே நாம் அசல் 'on_keycall_f11' செயல்பாட்டின் நகலை வரையறுக்கிறோம்,\n"
" # எனவே அதை பின்னர் அழைக்கலாம். செல்லுபடியாகும், பயன்படுத்தப்படாத செயல்பாட்டு பெயரைப் பயன்படுத்தலாம்.\n"
" # அசல் செயல்பாட்டை மீறுவதற்கு முன் இதை நாம் செய்ய வேண்டும்.\n"
" self.on_keycall_f11_super = self.on_keycall_f11\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:375
#, no-wrap
msgid ""
"# Here we are instance patching the original handler file to override an existing function\n"
"# to point to our new function (of the same name) defined in this file.\n"
"self.on_keycall_F11 = types.MethodType(on_keycall_F11, self)\n"
msgstr ""
"# இங்கே நாம் ஏற்கனவே இருக்கும் செயல்பாட்டை மேலெழுத அசல் ஏண்ட்லர் கோப்பை ஒட்டிக்கொள்கிறோம்\n"
" # இந்த கோப்பில் வரையறுக்கப்பட்ட எங்கள் புதிய செயல்பாட்டை (அதே பெயரில்) சுட்டிக்காட்ட.\n"
" self.on_keycall_f11 = வகைகள்.\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:378
#, no-wrap
msgid "# add a new pin to the screen:\n"
msgstr "# திரையில் புதிய முள் சேர்க்கவும்:\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:382
#, no-wrap
msgid ""
"# pin callback to print the state\n"
"def new_pin_changed(data):\n"
"    print(data)\n"
msgstr ""
"# மாநிலத்தை அச்சிட பின் கால்பேக்\n"
" def new_pin_changed (தரவு):\n"
" அச்சிடு (தரவு)\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:391
#, no-wrap
msgid ""
"# Special function that gets called before the HAL component is set ready.\n"
"# Here we used the function to add a bit input pin with a callback.\n"
"def after_override__(self):\n"
"    try:\n"
"        pin = hdlr.QHAL.newpin(\"new_pin\", hdlr.QHAL.HAL_BIT, hdlr.QHAL.HAL_IN)\n"
"        pin.value_changed.connect(new_pin_changed)\n"
"    except Exception as e:\n"
"        print(e)\n"
msgstr ""
"# HAL கூறு தயாராக இருக்கும் முன் அழைக்கப்படும் சிறப்பு செயல்பாடு.\n"
" # இங்கே நாங்கள் செயல்பாட்டைப் பயன்படுத்தினோம்.\n"
" def after_override __ (சுய):\n"
" முயற்சிக்கவும்:\n"
" முள் = hdlr.qhal.newpin (\"new_pin\", hdlr.qhal.hal_bit, hdlr.qhal.hal_in)\n"
" pin.value_changed.connect (புதிய_பின்_சாங்)\n"
" இ என விதிவிலக்கு தவிர:\n"
" அச்சிடு (இ)\n"

#. type: delimited block -
#: src/gui/qtvcp.adoc:395
#, no-wrap
msgid ""
"# Here we are instance patching the original handler file to add a new function\n"
"# that calls our new function (of the same name) defined in this file.\n"
"self.after_override__ = types.MethodType(after_override__, self)\n"
msgstr ""
"# இங்கே ஒரு புதிய செயல்பாட்டைச் சேர்க்க அசல் ஏண்ட்லர் கோப்பை ஒட்டுதல்\n"
" # இந்த கோப்பில் வரையறுக்கப்பட்ட எங்கள் புதிய செயல்பாட்டை (அதே பெயரில்) அழைக்கிறது.\n"
" self.fter_override__ = வகைகள்.\n"

