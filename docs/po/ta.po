"இருந்தால் N/C வெளியீட்டைப் பயன்படுத்தவும்)"

#. type: Plain text
#: src/ladder/ladder-examples.adoc:98
msgid "Next we add the following lines to the custom_postgui.hal file"
msgstr "அடுத்து Custom_postgui.hal கோப்பில் பின்வரும் வரிகளைச் சேர்க்கிறோம்"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:102
#, no-wrap
msgid "# E-Stop example using PyVCP buttons to simulate external components\n"
msgstr "வெளிப்புற கூறுகளை உருவகப்படுத்த PYVCP பொத்தான்களைப் பயன்படுத்துதல் # மின்-நிறுத்த எடுத்துக்காட்டு\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:105
#, no-wrap
msgid ""
"# The PyVCP checkbutton simulates a normally closed external E-Stop\n"
"net ext-estop classicladder.0.in-00 <= pyvcp.py-estop\n"
msgstr ""
"# PYVCP சரிபார்ப்பு பொதுவாக மூடப்பட்ட வெளிப்புற மின்-நிறுத்தத்தை உருவகப்படுத்துகிறது\n"
" நிகர நீட்டிப்பு-எச்டாப் கிளாசிக் லாடர் .0.in -00 <= pyvcp.py-estop\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:108
#, no-wrap
msgid ""
"# Request E-Stop Enable from LinuxCNC\n"
"net estop-all-ok iocontrol.0.emc-enable-in <= classicladder.0.out-00\n"
msgstr ""
"# கோரிக்கை மின்-ச்டாப் லினக்ச் சிஎன்சியிலிருந்து இயக்கவும்\n"
" நிகர எச்டோப்-ஆல்-ஓக் ஐகோன்ட்ரோல்\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:111
#, no-wrap
msgid ""
"# Request E-Stop Enable from PyVCP or external source\n"
"net ext-estop-reset classicladder.0.in-03 <= pyvcp.py-reset\n"
msgstr ""
"# கோரிக்கை மின்-ச்டாப் PYVCP அல்லது வெளிப்புற மூலத்திலிருந்து இயக்கவும்\n"
" நிகர நீட்டிப்பு-எச்டாப்-ரெசெட் கிளாசிக் லாடர் .0.in-03 <= pyvcp.py-reset\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:114
#, no-wrap
msgid ""
"# This line resets the E-Stop from LinuxCNC\n"
"net emc-reset-estop iocontrol.0.user-request-enable => classicladder.0.in-02\n"
msgstr ""
"# இந்த வரி Linuxcnc இலிருந்து மின்-நிறுத்தத்தை மீட்டமைக்கிறது\n"
" வலைமம் EMC-RESET-ESTOP IOControl.0.USER-REQUEST-ENABLE => Classladder.0.in-02\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:117
#, no-wrap
msgid ""
"# This line enables LinuxCNC to unlatch the E-Stop in ClassicLadder\n"
"net emc-estop iocontrol.0.user-enable-out => classicladder.0.in-01\n"
msgstr ""
"# இந்த வரி கிளாசிக் லேடரில் மின்-நிறுத்தத்தை அவிழ்க்க லினக்ச் சிஎன்சிக்கு உதவுகிறது\n"
" வலைமம் EMC-ESTOP IOControl.0.USER-ENABLE-OUT => கிளாசிக் லாடர் .0.IN-01\n"

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:120
#, no-wrap
msgid ""
"# This line turns on the green indicator when out of E-Stop\n"
"net estop-all-ok => pyvcp.py-es-status\n"
msgstr ""
"# மின்-நிறுத்தத்திற்கு வெளியே இருக்கும்போது இந்த வரி பச்சை காட்டி மீது மாறுகிறது\n"
" நிகர எச்டோப்-ஆல்-ஓக் => pyvcp.py-es-status\n"

#. type: Plain text
#: src/ladder/ladder-examples.adoc:124
msgid ""
"Next we add the following lines to the panel.xml file. Note you have to open "
"it with the text editor not the default html viewer."
msgstr ""
"அடுத்து பின்வரும் வரிகளை pane.xml கோப்பில் சேர்க்கிறோம். குறிப்பு நீங்கள் அதை இயல்புநிலை "
"உஉகுமொ பார்வையாளர் அல்ல உரை எடிட்டருடன் திறக்க வேண்டும்."

#. type: delimited block -
#: src/ladder/ladder-examples.adoc:146
#, no-wrap
msgid ""
"<pyvcp>\n"
"<vbox>\n"
"<label><text>\"E-Stop Demo\"</text></label>\n"
"<led>\n"
"<halpin>\"py-es-status\"</halpin>\n"
"<size>50</size>\n"
"<on_color>\"green\"</on_color>\n"
"<off_color>\"red\"</off_color>\n"
"</led>\n"
"<checkbutton>\n"
"<halpin>\"py-estop\"</halpin>\n"
"<text>\"E-Stop\"</text>\n"
"</checkbutton>\n"
"</vbox>\n"
"<button>\n"
"<halpin>\"py-reset\"</halpin>\n"
"<text>\"Reset\"</text>\n"
"</button>\n"
"</pyvcp>\n"
msgstr ""
"<byvcp>\n"
" <VBOX>\n"
" <லேபிள்> <உரை> \"இ-ச்டாப் டெமோ\" </உரை> </லேபிள்>\n"
" <ed>\n"
" <Halpin> \"Py-es-status\" </halpin>\n"
" <அளவு> 50 </size>\n"
" <on_color> \"பச்சை\" </on_color>\n"
" <off_color> \"சிவப்பு\" </off_color>\n"
" </led>\n"
" <CheckButton>\n"
" <Halpin> \"PY-ESTOP\" </halpin>\n"
" <உரை> \"இ-ச்டாப்\" </text>\n"
" </CheckButton>\n"
" </vbox>\n"
" <பொத்தான்>\n"
" <ஆல்பின்> \"பை-ரெசெட்\" </halpin>\n"
" <உரை> \"மீட்டமை\" </உரை>\n"
" </பொத்தான்>\n"
" </pyvcp>\n"

#. type: Plain text
