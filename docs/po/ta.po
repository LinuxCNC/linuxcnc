#: src/gui/halui.adoc:300 src/gui/qtdragon.adoc:690
#: src/man/man1/halui.1.adoc:64 src/man/man1/xhc-whb04b-6.1.adoc:161
#, no-wrap
msgid "Spindle"
msgstr "சுழல்"

#. type: Index entry
#: src/common/glossary.adoc:330 src/gcode/machining-center.adoc:79
#: src/gui/tklinuxcnc.adoc:196
#, fuzzy
#| msgid "*spindle*"
msgid "spindle"
msgstr "*சுழல்*"

#. type: Plain text
#: src/common/glossary.adoc:330
#, fuzzy
#| msgid ""
#| "(((spindle))) The part of a machine tool that spins to do the cutting. On "
#| "a mill or drill, the spindle holds the cutting tool. On a lathe, the "
#| "spindle holds the workpiece."
msgid ""
"The part of a machine tool that spins to do the cutting. On a mill or drill, "
"the spindle holds the cutting tool. On a lathe, the spindle holds the "
"workpiece."
msgstr ""
"(((சுழல்))) வெட்டுவதற்கு சுழலும் இயந்திர கருவியின் பகுதி. ஒரு ஆலை அல்லது "
"துரப்பணியில், சுழல் வெட்டும் கருவியை வைத்திருக்கிறது. ஒரு லேத் மீது, சுழல் பணியிடத்தை "
"வைத்திருக்கிறது."

#. type: Title ===
#: src/common/glossary.adoc:331 src/gui/axis.adoc:582
#, no-wrap
msgid "Spindle Speed Override"
msgstr "சுழல் விரைவு மேலெழுகிறது"

#. type: Plain text
#: src/common/glossary.adoc:336
msgid ""
"A manual, operator controlled change in the rate at which the tool rotates "
"while cutting. Often used to allow the operator to adjust for chatter caused "
"by the cutter's teeth. Spindle Speed Override assumes that the LinuxCNC "
"software has been configured to control spindle speed."
msgstr ""
"ஒரு கையேடு, ஆபரேட்டர் கட்டுப்படுத்தப்பட்ட மாற்றத்தை கட்டுப்படுத்தும் போது கருவி சுழலும் "
"விகிதத்தில். கட்டரின் பற்களால் ஏற்படும் உரையாடலை சரிசெய்ய ஆபரேட்டரை அனுமதிக்க "
"பெரும்பாலும் பயன்படுத்தப்படுகிறது. சுழல் வேகத்தைக் கட்டுப்படுத்த லினக்ச் சிஎன்சி மென்பொருள் "
"கட்டமைக்கப்பட்டுள்ளது என்று சுழல் விரைவு மேலெழுதல் கருதுகிறது."

#. type: Labeled list
#: src/common/glossary.adoc:337
#, no-wrap
msgid "StepConf"
msgstr "ச்டெப்கான்ஃப்"

#. type: Plain text
#: src/common/glossary.adoc:342
msgid ""
"An LinuxCNC configuration wizard. It is able to handle many step-and-"
"direction motion command based machines. It writes a full configuration "
"after the user answers a few questions about the computer and machine that "
"LinuxCNC is to run on."
msgstr ""
"ஒரு லினக்ச் சிஎன்சி உள்ளமைவு வழிகாட்டி. இது பல படி மற்றும் திசை இயக்க கட்டளை "
"அடிப்படையிலான இயந்திரங்களை கையாள முடியும். லினக்ச் சி.என்.சி இயங்க வேண்டிய கணினி "
"மற்றும் இயந்திரம் பற்றிய சில கேள்விகளுக்கு பயனர் பதிலளித்த பிறகு இது ஒரு முழு உள்ளமைவை "
"எழுதுகிறது."

#. type: Labeled list
#: src/common/glossary.adoc:343
#, no-wrap
msgid "Stepper Motor"
msgstr "ச்டெப்ச் மின்னோடி"

#. type: Index entry
#: src/common/glossary.adoc:348
#, fuzzy
#| msgid "Stepper Motor"
msgid "stepper motor"
msgstr "ச்டெப்ச் மின்னோடி"

#. type: Plain text
#: src/common/glossary.adoc:348
#, fuzzy
#| msgid ""
#| "(((stepper motor))) A type of motor that turns in fixed steps. By "
#| "counting steps, it is possible to determine how far the motor has turned. "
#| "If the load exceeds the torque capability of the motor, it will skip one "
#| "or more steps, causing position errors."
msgid ""
"A type of motor that turns in fixed steps. By counting steps, it is possible "
"to determine how far the motor has turned. If the load exceeds the torque "
"capability of the motor, it will skip one or more steps, causing position "
"errors."
msgstr ""
"(((ச்டெப்பர் மோட்டார்))) நிலையான படிகளில் மாறும் ஒரு வகை மின்னோடி. படிகளை எண்ணுவதன் "
"மூலம், மின்னோடி எவ்வளவு தூரம் திரும்பியுள்ளது என்பதை தீர்மானிக்க முடியும். சுமை மோட்டரின் "
"முறுக்கு திறனை மீறினால், அது ஒன்று அல்லது அதற்கு மேற்பட்ட படிகளைத் தவிர்க்கும், இதனால் "
"நிலை பிழைகள் ஏற்படுகின்றன."

#. type: Plain text
#: src/common/glossary.adoc:352
#, fuzzy
#| msgid ""
#| "(((TASK))) The module within LinuxCNC that coordinates the overall "
#| "execution and interprets the part program."
msgid ""
"The module within LinuxCNC that coordinates the overall execution and "
"interprets the part program."
msgstr ""
"(((பணி))) ஒட்டுமொத்த செயல்பாட்டை ஒருங்கிணைத்து பகுதி நிரலை விளக்கும் "
"லினக்ச்.சி.என்.சிக்குள் உள்ள தொகுதி."

#. type: Labeled list
