#. type: delimited block -
#: src/gui/qtvcp-vismach.adoc:544
#, no-wrap
msgid ""
"# build axis origin markers\n"
"X = CylinderX(-500,1,500,1)\n"
"X = Color([1, 0, 0, 1], [X])\n"
"Y = CylinderY(-500,1,500,1)\n"
"Y = Color([0, 1, 0, 1], [Y])\n"
"Z = CylinderZ(-500,1,500,1)\n"
"Z = Color([0, 0, 1, 1], [Z])\n"
"origin = Collection([X,Y,Z])\n"
msgstr ""
"# அச்சு தோற்றம் குறிப்பான்களை உருவாக்குங்கள்\n"
" ஃச் = சிலிண்டர்எக்ச் (-500,1,500,1)\n"
" ஃச் = நிறம் ([1, 0, 0, 1], [x])\n"
" ஒய் = சிலிண்டரி (-500,1,500,1)\n"
" ஒய் = நிறம் ([0, 1, 0, 1], [y])\n"
" சட் = சிலிண்டர்ச் (-500,1,500,1)\n"
" சட் = நிறம் ([0, 0, 1, 1], [z])\n"
" தோற்றம் = சேகரிப்பு ([x, ஒய், z])\n"

#. type: Plain text
