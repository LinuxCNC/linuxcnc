#, no-wrap
msgid ""
"F #<_hal[gmoccapy.probevel]>\n"
"G38.2 Z-4\n"
msgstr ""
"F #<_ hal [gmoccapy.probevel]>\n"
" G38.2 Z-4\n"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1072
msgid "You may want to modify this file to fit more your needs."
msgstr "உங்கள் தேவைகளுக்கு ஏற்றவாறு இந்த கோப்பை மாற்ற நீங்கள் விரும்பலாம்."

#. type: Title ===
#: src/gui/gmoccapy.adoc:1073
#, no-wrap
msgid "Needed HAL Connections"
msgstr "ஆல் இணைப்புகள் தேவை"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1076
msgid "Connect the tool probe in your HAL file like so:"
msgstr "உங்கள் HAL கோப்பில் கருவி ஆய்வை இணைக்கவும்:"

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1080 src/gui/qtdragon.adoc:1330
#, no-wrap
msgid "net probe  motion.probe-input <= <your_input_pin>\n"
msgstr "நிகர ஆய்வு இயக்கம்\n"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1083
msgid "The line might look like this:"
msgstr "வரி இப்படி தோன்றலாம்:"

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1088
#, no-wrap
msgid "net probe  motion.probe-input <= parport.0.pin-15-in\n"
msgstr "நிகர ஆய்வு இயக்கம்\n"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1091
msgid "In your postgui.hal file add the following lines:"
msgstr "உங்கள் postgui.hal கோப்பில் பின்வரும் வரிகளைச் சேர்க்கவும்:"

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1099
#, no-wrap
msgid ""
"# The next lines are only needed if the pins had been connected before\n"
"unlinkp iocontrol.0.tool-change\n"
"unlinkp iocontrol.0.tool-changed\n"
"unlinkp iocontrol.0.tool-prep-number\n"
"unlinkp iocontrol.0.tool-prepared\n"
msgstr ""
"# முன்னர் ஊசிகளை இணைத்திருந்தால் மட்டுமே அடுத்த வரிகள் தேவைப்படுகின்றன\n"
" Unlinkp iocontrol.0.tool- மாற்ற\n"
" Unlinkp iocontrol.0.tool- மாற்றப்பட்டது\n"
" Unclinkp iocontrol.0.tool-prep-number\n"
" Unclinkp iocontrol.0.tool-prepared\n"

#. type: delimited block -
#: src/gui/gmoccapy.adoc:1105
#, fuzzy, no-wrap
#| msgid ""
#| "# link to GMOCCAPY toolchange, so you get the advantage of tool description on change dialog\n"
#| "net tool-change gmoccapy.toolchange-change <= iocontrol.0.tool-change\n"
#| "net tool-changed gmoccapy.toolchange-changed <= iocontrol.0.tool-changed\n"
#| "net tool-prep-number gmoccapy.toolchange-number <= iocontrol.0.tool-prep-number\n"
#| "net tool-prep-loop iocontrol.0.tool-prepare <= iocontrol.0.tool-prepared\n"
msgid ""
"# link to GMOCCAPY toolchange, so you get the advantage of tool description on change dialog\n"
"net tool-change gmoccapy.toolchange-change <= iocontrol.0.tool-change\n"
"net tool-changed gmoccapy.toolchange-changed => iocontrol.0.tool-changed\n"
"net tool-prep-number gmoccapy.toolchange-number <= iocontrol.0.tool-prep-number\n"
"net tool-prep-loop iocontrol.0.tool-prepare <= iocontrol.0.tool-prepared\n"
msgstr ""
"# GMOCCAPY கருவித்தொகுப்புடன் இணைக்கவும், எனவே மாற்ற உரையாடலில் கருவி விளக்கத்தின் நன்மையைப் பெறுவீர்கள்\n"
" நிகர கருவி-மாற்றம் gmocchapy.toolChange- மாறுதல் <= iocontrol.0.tool- மாற்ற\n"
" நிகர கருவி மாற்றப்பட்ட gmoccapy.toolChange- மாற்றப்பட்ட <= iocontrol.0.tool- மாற்றப்பட்டது\n"
" நிகர கருவி-தயாரிப்பு-எண் gmoccapy.toolChange- எண் <= iocontrol.0.tool-prep-number\n"
" நிகர கருவி-தயாரிப்பு-லூப் Iocontrol.0.tool-prepare <= iocontrol.0.tool-prepared\n"

#. type: Title ==
#: src/gui/gmoccapy.adoc:1108
#, no-wrap
msgid "The Settings Page"
msgstr "அமைப்புகள் பக்கம்"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1112
msgid ""
"To enter the page you will have to click on image:images/"
"gmoccapy_settings_button.png[align=\"left\"] and give an unlock code, which "
"is *123* by default.  If you want to change it at this time you will have to "
"edit the hidden preference file, see <<gmoccapy:display-section,the display "
"section>> for details."
msgstr ""
"பக்கத்தை உள்ளிட நீங்கள் படத்தைக் சொடுக்கு செய்ய வேண்டும்: படங்கள்/"
"gmoccapy_settings_button.png [சீரமை = \"இடது\"] மற்றும் திறத்தல் குறியீட்டை "
"கொடுங்கள், இது இயல்பாக * 123 *. இந்த நேரத்தில் நீங்கள் அதை மாற்ற விரும்பினால், மறைக்கப்பட்ட "
"விருப்பக் கோப்பைத் திருத்த வேண்டும், விவரங்களுக்கு <<gmoccapy:display-section, காட்சி "
"பிரிவு >> ஐப் பார்க்கவும்."

#. type: Plain text
#: src/gui/gmoccapy.adoc:1114
msgid "The page is separated in three main tabs:"
msgstr "பக்கம் மூன்று முக்கிய தாவல்களில் பிரிக்கப்பட்டுள்ளது:"

#. type: Title ===
#: src/gui/gmoccapy.adoc:1115
#, no-wrap
msgid "Appearance"
msgstr "தோற்றம்"

#. type: Block title
#: src/gui/gmoccapy.adoc:1117
#, no-wrap
msgid "GMOCCAPY settings page Appearance"
msgstr "GMOCCAPY அமைப்புகள் பக்கம் தோற்றம்"

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/gui/gmoccapy.adoc:1118
#, no-wrap
msgid "Configuration page"
msgstr "உள்ளமைவு பக்கம்"

#. type: Target for macro image
#: src/gui/gmoccapy.adoc:1118
#, no-wrap
msgid "images/gmoccapy_settings_appearance.png"
msgstr "படங்கள்/gmoccapy அமைப்புகள் தோற்றம்"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1121
msgid "On this tab you will find the following options:"
msgstr "இந்த தாவலில் பின்வரும் விருப்பங்களைக் காண்பீர்கள்:"

#. type: Block title
#: src/gui/gmoccapy.adoc:1122
#, no-wrap
msgid "Main Window"
msgstr "முதன்மை சாளரம்"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1127
msgid ""
"Here you can select how you wish the GUI to start.  The main reason for this "
"was the wish to get an easy way for the user to set the starting options "
"without the need to touch code.  You have three options:"
msgstr ""
"GUI ஐ எவ்வாறு தொடங்க விரும்புகிறீர்கள் என்பதை இங்கே நீங்கள் தேர்ந்தெடுக்கலாம். இதற்கு முக்கிய "
"காரணம், குறியீட்டைத் தொட வேண்டிய அவசியமின்றி பயனருக்கு தொடக்க விருப்பங்களை அமைக்க "
"எளிதான வழியைப் பெற வேண்டும். உங்களுக்கு மூன்று விருப்பங்கள் உள்ளன:"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1129
msgid "_Start as full screen_"
msgstr "_ முழு திரை_"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1130
msgid "_Start maximized_"
msgstr "_START அதிகபட்சம்_"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1133
msgid ""
"_Start as window_ - If you select start as window the spinboxes to set the "
"position and size will get active.  One time set, the GUI will start every "
"time on the place and with the size selected.  Nevertheless the user can "
"change the size and position using the mouse, but that will not have any "
"influence on the settings."
msgstr ""
"_ சாளரமாக ச்டார்ட்_ - நீங்கள் சாளரமாகத் தொடங்கினால், நிலை மற்றும் அளவை அமைக்க ச்பின் "
"பாக்ச்கள் செயலில் இருக்கும். ஒரு முறை அமைக்கப்பட்டால், GUI ஒவ்வொரு முறையும் அந்த "
"இடத்திலும், தேர்ந்தெடுக்கப்பட்ட அளவிலும் தொடங்கும். ஆயினும்கூட பயனர் சுட்டியைப் பயன்படுத்தி "
"அளவையும் நிலையையும் மாற்ற முடியும், ஆனால் அது அமைப்புகளில் எந்த செல்வாக்கையும் "
"கொண்டிருக்காது."

#. type: Plain text
#: src/gui/gmoccapy.adoc:1134
#, fuzzy
#| msgid ""
#| "_Window decorated_ - Allows the title bar to be hidden. (default: title "
#| "bar visible)"
msgid ""
"_hide title bar_ - Allows the title bar to be hidden. (default: title bar "
"visible)."
msgstr ""
"சாளரம் அலங்கரிக்கப்பட்ட _ - தலைப்பு பட்டியை மறைக்க அனுமதிக்கிறது. (இயல்புநிலை: தலைப்பு "
"பட்டி தெரியும்)"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1135
msgid ""
"_hide cursor_ - Does allow to hide the cursor, what is very useful if you "
"use a touch screen."
msgstr ""
"_ஐட் கர்சர்_ - கர்சரை மறைக்க அனுமதிக்கிறது, நீங்கள் தொடுதிரையைப் பயன்படுத்தினால் மிகவும் "
"பயனுள்ளதாக இருக்கும்."

#. type: Plain text
#: src/gui/gmoccapy.adoc:1136
msgid "_hide tooltips_ - Hides the tool tips."
msgstr "உதவிக்குறிப்பை மறைக்க - உதவிக்குறிப்பை மறைக்கவும்."

#. type: Title ==
#: src/gui/gmoccapy.adoc:1137 src/gui/qtdragon.adoc:509
#: src/gui/qtvcp-libraries.adoc:1255
#, no-wrap
msgid "Virtual Keyboard"
msgstr "மெய்நிகர் விசைப்பலகை"

#. type: Plain text
#: src/gui/gmoccapy.adoc:1142
#, fuzzy
#| msgid ""
#| "The checkboxes allow the user to select if he wants the on board keyboard "
#| "to be shown immediately, when entering the MDI Mode, when entering the "
#| "offset page, the tooledit widget or when open a program in the EDIT "
#| "mode.  The keyboard button on the bottom button list will not be affected "
#| "by these settings, so you are able to show or hide the keyboard by "
#| "pressing the button.  The default behavior will be set by the checkboxes."
msgid ""
"The checkboxes allow the user to select if he wants the on board keyboard to "
"be shown immediately when entering the MDI Mode, the offset page, the "
"tooledit widget or when open a program in the EDIT mode.  The keyboard "
"button on the bottom button list will not be affected by these settings, so "
"you are able to show or hide the keyboard by pressing the button."
msgstr ""
"எம்.டி.ஐ பயன்முறையை உள்ளிடும்போது, ஆஃப்செட் பக்கத்தை உள்ளிடும்போது, கோக்லெடிட் விட்செட் "
"அல்லது திருத்து பயன்முறையில் ஒரு நிரலைத் திறக்கும்போது, ஆன் போர்டு விசைப்பலகை "
"உடனடியாகக் காட்டப்பட வேண்டுமா என்பதைத் தேர்ந்தெடுக்க தேர்வுப்பெட்டிகள் பயனரை "
"அனுமதிக்கின்றன. கீழே உள்ள பொத்தானை பட்டியலில் உள்ள விசைப்பலகை பொத்தான் இந்த அமைப்புகளால் "
"பாதிக்கப்படாது, எனவே பொத்தானை அழுத்துவதன் மூலம் விசைப்பலகை காட்ட அல்லது மறைக்க "
"முடியும். இயல்புநிலை நடத்தை தேர்வுப்பெட்டிகளால் அமைக்கப்படும்."

