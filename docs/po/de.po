#. type: delimited block -
#: src/gui/qtvcp.adoc:913
#, no-wrap
msgid ""
"    def on_keycall_APOS(self,event,state,shift,cntrl):\n"
"        pass\n"
"        #self.kb_jog(state, 3, 1, shift, False)\n"
msgstr ""
"    def on_keycall_APOS(self,event,state,shift,cntrl):\n"
"        pass\n"
"        #self.kb_jog(state, 3, 1, shift, False)\n"

#. type: delimited block -
