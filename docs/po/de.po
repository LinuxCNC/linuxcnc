"      if formWindow:\n"
"          formWindow.cursor().setProperty(\"estop_action\",\n"
"              QtCore.QVariant(self.c_estop.isChecked()))\n"
"      self.accept()\n"

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:877
#, no-wrap
msgid "class ActionButtonMenuEntry(QPyDesignerTaskMenuExtension):\n"
msgstr "class ActionButtonMenuEntry(QPyDesignerTaskMenuExtension):\n"

