#: src/gui/qtvcp-widgets.adoc:807
msgid "Toggles display option. Will follow the current M7/8 mode."
msgstr "Wechselt Anzeige-Option. Wird dem aktuellen M7/8 Modus folgen."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:807
#, no-wrap
msgid "*`follow_reference_changes`*"
msgstr "*`follow_reference_changes`*"

