#. type: Plain text
#: src/man/man3/hm2_pktuart_setup.3.adoc:6
msgid "hm2_pktuart_setup - setup a Hostmot2 PktUART instance"
msgstr "hm2_pktuart_setup - Einrichtung einer Hostmot2 PktUART-Instanz"

#. type: delimited block -
#: src/man/man3/hm2_pktuart_setup.3.adoc:14
#, no-wrap
