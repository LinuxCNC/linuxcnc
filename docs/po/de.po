msgstr "Diese _Objektinstanz des Widgets_"

#. type: Plain text
#: src/gui/qtvcp-custom-widgets.adoc:74
msgid "The _QtVCP's path library instance_"
msgstr "Die Instanz der _QtVCP-Pfadbibliothek_"

