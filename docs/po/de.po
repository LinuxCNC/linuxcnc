msgstr "Oder siehe http://linuxcnc.org/docs/devel/html/man/man1/halui.1.html"

#. type: Title ===
#: src/gui/halui.adoc:104 src/gui/tklinuxcnc.adoc:86
#: src/man/man1/halui.1.adoc:34
#, no-wrap
msgid "Abort"
msgstr "Abbrechen"

#. type: Plain text
#: src/gui/halui.adoc:107
msgid ""
"'halui.abort' (bit, in) - pin to send an abort message (clears out most "
"errors)"
msgstr ""
"halui.abort' (bit, in) - Pin zum Senden einer Abbruchmeldung (löscht die "
"meisten Fehler)"

#. type: Title ===
#: src/gui/halui.adoc:108
#, no-wrap
msgid "E-Stop"
msgstr "Notaus (engl. E-Stop)"

#. type: Plain text
#: src/gui/halui.adoc:111
msgid "'halui.estop.activate' (bit, in) - pin for requesting E-Stop"
msgstr ""
"halui.estop.activate' (bit, in) - Pin für die Anforderung des Notausschalters"

#. type: Plain text
#: src/gui/halui.adoc:112
msgid "'halui.estop.is-activated' (bit, out) - indicates E-stop reset"
msgstr ""
"halui.estop.is-activated' (Bit, out) - zeigt an, dass der Not-Aus-Schalter "
"zurückgesetzt wurde"

#. type: Plain text
#: src/gui/halui.adoc:113
msgid "'halui.estop.reset' (bit, in) - pin for requesting E-Stop reset"
msgstr ""
"halui.estop.reset' (bit, in) - Pin für die Anforderung eines Not-Aus-Resets"

#. type: Plain text
#: src/gui/halui.adoc:117
msgid ""
"'halui.feed-override.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr ""
"'halui.feed-override.count-enable' (bit, in) - muss wahr sein, damit "
"'counts' oder 'direct-value' funktioniert."

#. type: Plain text
#: src/gui/halui.adoc:118
msgid ""
"'halui.feed-override.counts' (s32, in) - counts * scale = FO percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'halui.feed-override.counts' (s32, in) - counts * scale = FO percentage. "
"Kann mit einem Encoder oder 'direct-value' verwendet werden."

#. type: Plain text
#: src/gui/halui.adoc:119
msgid ""
"'halui.feed-override.decrease' (bit, in) - pin for decreasing the FO (-"
"=scale)"
msgstr ""
"'halui.feed-override.decrease' (bit, in) - Pin zum Verringern des FO (-"
"=Skala)"

#. type: Plain text
#: src/gui/halui.adoc:120
msgid ""
"'halui.feed-override.increase' (bit, in) - pin for increasing the FO "
"(+=scale)"
msgstr ""
"'halui.feed-override.increase' (bit, in) - Pin zur Erhöhung des FO (+=Skala)"

#. type: Plain text
#: src/gui/halui.adoc:121
msgid ""
"'halui.feed-override.reset' (bit, in) - pin for resetting the FO (scale=1.0)"
msgstr ""
"'halui.feed-override.reset' (bit, in) - Pin zum Zurücksetzen des FO "
"(scale=1.0)"

#. type: Plain text
#: src/gui/halui.adoc:122
msgid ""
"'halui.feed-override.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.feed-override.direct-value' (bit, in) - falsch, wenn der Encoder "
"verwendet wird, um die Anzahl zu ändern, wahr, wenn die Anzahl direkt "
"eingestellt wird."

#. type: Plain text
#: src/gui/halui.adoc:123
msgid ""
"'halui.feed-override.scale' (float, in) - pin for setting the scale for "
"increase and decrease of 'feed-override'."
msgstr ""
"'halui.feed-override.scale' (float, in) - Pin zum Einstellen der Skala für "
"die Erhöhung und Verringerung des 'feed-override'."

#. type: Plain text
#: src/gui/halui.adoc:124
msgid "'halui.feed-override.value' (float, out) - current FO value"
msgstr "'halui.feed-override.value' (float, out) - aktueller FO-Wert"

#. type: Title ===
#: src/gui/halui.adoc:125
#, no-wrap
msgid "Mist"
msgstr "Nebel (engl. mist)"

#. type: Plain text
#: src/gui/halui.adoc:128
msgid "'halui.mist.is-on' (bit, out) - indicates mist is on"
msgstr "'halui.mist.is-on' (bit, out) - zeigt an, dass Nebel eingeschaltet ist"

#. type: Plain text
#: src/gui/halui.adoc:129
msgid "'halui.mist.off' (bit, in) - pin for requesting mist off"
msgstr "'halui.mist.off' (bit, in) - Pin zum Anfordern von Nebel"

#. type: Plain text
#: src/gui/halui.adoc:130
msgid "'halui.mist.on' (bit, in) - pin for requesting mist on"
msgstr "halui.mist.on' (bit, in) - Pin zur Abfrage von Nebel ein"

#. type: Title ===
#: src/gui/halui.adoc:131
#, no-wrap
msgid "Flood"
msgstr "Flut-Kühlmittel (engl. flood)"

#. type: Plain text
#: src/gui/halui.adoc:134
msgid "'halui.flood.is-on' (bit, out) - indicates flood is on"
msgstr "'halui.flood.is-on' (bit, out) - zeigt an, dass die Flut an ist"

#. type: Plain text
#: src/gui/halui.adoc:135
msgid "'halui.flood.off' (bit, in) - pin for requesting flood off"
msgstr ""
"'halui.flood.off' (bit, in) - Pin zum Anforderung des Ausschaltens der Flut"

#. type: Plain text
#: src/gui/halui.adoc:136
msgid "'halui.flood.on' (bit, in) - pin for requesting flood on"
msgstr ""
"'halui.flood.on' (bit, in) - Pin für die Anforderung für das Einschalten der "
"Flut"

#. type: Plain text
#: src/gui/halui.adoc:141
msgid ""
"'halui.home-all' (bit, in) - pin for requesting all axis to home. This pin "
"will only be there if HOME_SEQUENCE is set in the INI file."
msgstr ""
"'halui.home-all' (bit, in) - Pin zum Anfordern einer Referenzfahrt aller "
"Achsen. Dieser Pin ist nur vorhanden, wenn HOME_SEQUENCE in der INI-Datei "
"festgelegt ist."

#. type: Title ====
#: src/gui/halui.adoc:142 src/man/man1/halui.1.adoc:214
#: src/man/man1/xhc-whb04b-6.1.adoc:150
#, no-wrap
msgid "Machine"
msgstr "Maschine"

#. type: Plain text
#: src/gui/halui.adoc:146
msgid ""
"'halui.machine.units-per-mm' (float out) - pin for machine units-per-mm "
"(inch:1/25.4, mm:1) according to inifile setting: [TRAJ]LINEAR_UNITS"
msgstr ""
"halui.machine.units-per-mm' (float out) - Pin für Maschineneinheiten-pro-mm "
"(inch:1/25.4, mm:1) entsprechend der inifile-Einstellung: [TRAJ]LINEAR_UNITS"

#. type: Plain text
#: src/gui/halui.adoc:147
msgid "'halui.machine.is-on' (bit, out) - indicates machine on"
msgstr ""
"halui.machine.is-on' (bit, out) - zeigt an, dass die Maschine eingeschaltet "
"ist"

#. type: Plain text
#: src/gui/halui.adoc:148
msgid "'halui.machine.off' (bit, in) - pin for requesting machine off"
msgstr ""
"'halui.machine.off' (bit, in) - Pin zum Anfordern der Maschinen-Abschaltung"

#. type: Plain text
#: src/gui/halui.adoc:149
msgid "'halui.machine.on' (bit, in) - pin for requesting machine on"
msgstr ""
"'halui.machine.on' (bit, in) - Pin zum Anfordern der Maschinen-Einschaltung"

#. type: Plain text
#: src/gui/halui.adoc:154
msgid ""
"The maximum linear velocity can be adjusted from 0 to the MAX_VELOCITY that "
"is set in the [TRAJ] section of the INI file."
msgstr ""
"Die maximale lineare Geschwindigkeit kann zwischen 0 und der MAX_VELOCITY "
"eingestellt werden, die im Abschnitt [TRAJ] der INI-Datei festgelegt ist."

#. type: Plain text
#: src/gui/halui.adoc:156
msgid ""
"'halui.max-velocity.count-enable' (bit, in) - must be true for 'counts' or "
"'direct-value' to work."
msgstr ""
"'halui.max-velocity.count-enable' (bit, in) - muss true sein, damit 'counts' "
"oder 'direct-value' funktionieren."

#. type: Plain text
#: src/gui/halui.adoc:157
msgid ""
"'halui.max-velocity.counts' (s32, in) - counts * scale = MV percentage. Can "
"be used with an encoder or 'direct-value'."
msgstr ""
"'halui.max-velocity.counts' (s32, in) - counts * scale = MV percentage. Kann "
"mit einem Encoder oder 'direct-value' verwendet werden."

#. type: Plain text
#: src/gui/halui.adoc:158
msgid ""
"'halui.max-velocity.direct-value' (bit, in) - false when using encoder to "
"change counts, true when setting counts directly."
msgstr ""
"'halui.max-velocity.direct-value' (bit, in) - false bei Verwendung des "
"Encoders zum Ändern der Anzahl, true beim direkten Festlegen von Zählungen."

#. type: Plain text
#: src/gui/halui.adoc:159
msgid ""
"'halui.max-velocity.decrease' (bit, in) - pin for decreasing max velocity"
msgstr ""
"'halui.max-velocity.decrease' (bit, in) - Pin zur Verringerung der maximalen "
"Geschwindigkeit"

#. type: Plain text
#: src/gui/halui.adoc:160
msgid ""
"'halui.max-velocity.increase' (bit, in) - pin for increasing max velocity"
msgstr ""
"'halui.max-velocity.increase' (bit, in) - Pin zur Erhöhung der maximalen "
"Geschwindigkeit"

#. type: Plain text
#: src/gui/halui.adoc:161
msgid ""
"'halui.max-velocity.scale' (float, in) - the amount applied to the current "
"maximum velocity with each transition from off to on of the increase or "
"decrease pin in machine units per second."
msgstr ""
"'halui.max-velocity.scale' (float, in) - der Betrag, der auf die aktuelle "
"maximale Geschwindigkeit bei jedem Übergang von Aus zu Ein des An- oder "
"Abnahmestiftes in Maschineneinheiten pro Sekunde angewendet wird."

#. type: Plain text
#: src/gui/halui.adoc:162
msgid ""
"'halui.max-velocity.value' (float, out) - is the maximum linear velocity in "
"machine units per second."
msgstr ""
"'halui.max-velocity.value' (float, out) - ist die maximale lineare "
"Geschwindigkeit in Maschineneinheiten pro Sekunde."

#. type: Plain text
#: src/gui/halui.adoc:170
#, no-wrap
msgid ""
"'halui.mdi-command-_<nn>_' (bit, in) - halui will try to send the MDI command defined in the INI. _<nn>_ is a two  digit number  starting  at 00.\n"
"If the command succeeds then it will place LinuxCNC in the MDI mode and then back to Manual mode.\n"
"If no [HALUI]MDI_COMMAND variables are set in the  ini  file, no halui.mdi-command-<nn> pins will be exported by halui."
msgstr ""
"halui.mdi-command-<nn>' (bit, in) - halui versucht, den in der INI-Datei definierten MDI-Befehl zu senden. <nn> ist eine zweistellige Zahl, die bei 00 beginnt.\n"
"Wenn das Kommando erfolgreich ist, dann wird es LinuxCNC in den MDI-Modus setzen und dann zurück in den manuellen Modus.\n"
"Wenn keine [HALUI]MDI_COMMAND Variablen in der INI-Datei gesetzt sind, werden keine halui.mdi-command-<nn> Pins von halui exportiert."

#. type: Plain text
#: src/gui/halui.adoc:173
msgid ""
"'halui.halui-mdi-is-running' (bit, out) - execution status of MDI commands "
"sent by halui. The status is active even during mode switching.  If no "
"[HALUI]MDI_COMMAND variables are set in the ini file, this pins will not be "
"exported by halui."
msgstr ""
"'halui.halui-mdi-is-running' (bit, out) - Ausführungsstatus der von halui "
"gesendeten MDI-Befehle. Der Status ist auch beim Modenwechsel aktiv. Wenn in "
"der INI-Datei keine [HALUI]MDI_COMMAND-Variablen gesetzt werden, werden "
"diese Pins nicht von halui exportiert."

#. type: Title ===
#: src/gui/halui.adoc:174 src/man/man1/halui.1.adoc:225
#, no-wrap
msgid "Joint"
msgstr "Gelenk"

#. type: Plain text
#: src/gui/halui.adoc:178
#, no-wrap
msgid ""
"_N_ = joint number (0 ... num_joints-1)\n"
"Example:"
msgstr ""
"_N_ = Gelenknummer (0 ... num_joints-1)\n"
"Beispiel:"

#. type: Plain text
#: src/gui/halui.adoc:180
msgid "'halui.joint._N_.select' (bit in) - pin for selecting joint _N_"
msgstr "'halui.joint.N.select' (Bit in) - Pin zur Auswahl von Gelenk N"

#. type: Plain text
#: src/gui/halui.adoc:181
msgid ""
"'halui.joint._N_.is-selected' (bit out) - status pin that joint _N_ is "
"selected"
msgstr ""
"'halui.joint.N.is-s selected' (bit out) – Status-Pin, dass Gelenk N "
"ausgewählt ist"

#. type: Plain text
#: src/gui/halui.adoc:182
msgid ""
"'halui.joint._N_.has-fault' (bit out) - status pin telling that joint _N_ "
"has a fault"
msgstr ""
"'halui.joint.N.has-fault' (bit out) - Status-Pin, der angibt, dass Gelenk N "
"einen Fehler hat"

#. type: Plain text
#: src/gui/halui.adoc:183
msgid "'halui.joint._N_.home' (bit in) - pin for homing joint _N_"
msgstr "'halui.joint.N.home' (Bit in) - Pin für Referenzfahrt von Gelenk N"

#. type: Plain text
#: src/gui/halui.adoc:184
msgid ""
"'halui.joint._N_.is-homed' (bit out) - status pin telling that joint _N_ is "
"homed"
msgstr ""
"'halui.joint.N.is-homed' (bit out) - Status-Pin, der angibt, dass Gelenk N "
"referenziert ist"

#. type: Plain text
#: src/gui/halui.adoc:185
msgid ""
"'halui.joint._N_.on-hard-max-limit' (bit out) - status pin telling that "
"joint _N_ is on the positive hardware limit"
msgstr ""
"'halui.joint._N_.on-hard-max-limit' (bit out) - Status-Pin, der anzeigt, "
"dass Gelenk _N_ am positiven Hardware-Limit liegt"

#. type: Plain text
#: src/gui/halui.adoc:186
msgid ""
"'halui.joint._N_.on-hard-min-limit' (bit out) - status pin telling that "
"joint _N_ is on the negative hardware limit"
msgstr ""
"'halui.joint._N_.on-hard-min-limit' (bit out) - Status-Pin, der anzeigt, "
"dass sich Gelenk _N_ am negativen Hardware-Limit befindet"

#. type: Plain text
#: src/gui/halui.adoc:187
msgid ""
"'halui.joint._N_.on-soft-max-limit' (bit out) - status pin telling that "
"joint _N_ is on the positive software limit"
msgstr ""
"'halui.joint._N_.on-hard-max-limit' (bit out) - Status-Pin, der anzeigt, "
"dass Gelenk _N_ am positiven Hardware-Limit liegt"

#. type: Plain text
#: src/gui/halui.adoc:188
msgid ""
"'halui.joint._N_.on-soft-min-limit' (bit out) - status pin telling that "
"joint _N_ is on the negative software limit"
msgstr ""
"'halui.joint._N_.on-soft-min-limit' (bit out) - Status-Pin, der anzeigt, "
"dass sich Gelenk _N_ an der negativen Softwaregrenze befindet"

#. type: Plain text
#: src/gui/halui.adoc:189
msgid ""
"'halui.joint._N_.override-limits' (bit out) - status pin telling that joint "
"_N_'s limits are temporarily overridden"
msgstr ""
"'halui.joint._N_.override-limits' (bit out) - Status-Pin, der angibt, dass "
"die Grenzen von Gelenk _N_ vorübergehend außer Kraft gesetzt werden"

#. type: Plain text
#: src/gui/halui.adoc:190
msgid "'halui.joint._N_.unhome' (bit in) - pin for unhoming joint _N_"
msgstr ""
"'halui.joint._N_.unhome' (bit in) - Pin für das Aufheben der Referenzierung "
"von Gelenk _N_"

#. type: Plain text
#: src/gui/halui.adoc:191
msgid ""
"'halui.joint.selected' (u32 out) - selected joint number (0 ... num_joints-1)"
msgstr ""
"'halui.joint.selected' (u32 out) - ausgewählte Gelenknummer (0 ... "
"num_joints-1"

#. type: Plain text
#: src/gui/halui.adoc:192
msgid ""
"'halui.joint.selected.has-fault' (bit out) - status pin selected joint is "
"faulted"
msgstr ""
"'halui.joint.selected.has-fault' (bit out) - Status-Pin ausgewähltes Gelenk "
"ist fehlerhaft"

#. type: Plain text
#: src/gui/halui.adoc:193
msgid ""
"'halui.joint.selected.home' (bit in) - pin for homing the selected joint"
msgstr ""
"'halui.joint.selected.home' (Bit in) - Pin für das Homing des ausgewählten "
"Gelenks"

#. type: Plain text
#: src/gui/halui.adoc:194
msgid ""
"'halui.joint.selected.is-homed' (bit out) - status pin telling that the "
"selected joint is homed"
msgstr ""
"'halui.joint.s selected.is-homed' (bit out) - Status-Pin, der angibt, dass "
"das ausgewählte Gelenk referenziert ist"

#. type: Plain text
#: src/gui/halui.adoc:195
msgid ""
"'halui.joint.selected.on-hard-max-limit' (bit out) - status pin telling that "
"the selected joint is on the positive hardware limit"
msgstr ""
"'halui.joint.selected.on-hard-max-limit' (bit out) - Status-Pin, der "
"anzeigt, dass sich das ausgewählte Gelenk auf dem positiven Hardware-Limit "
"befindet"

#. type: Plain text
#: src/gui/halui.adoc:196
msgid ""
"'halui.joint.selected.on-hard-min-limit' (bit out) - status pin telling that "
"the selected joint is on the negative hardware limit"
msgstr ""
"'halui.joint.selected.on-hard-min-limit' (bit out) - Status-Pin, der "
"anzeigt, dass sich das ausgewählte Gelenk am negativen Hardware-Limit "
"befindet"

#. type: Plain text
#: src/gui/halui.adoc:197
msgid ""
"'halui.joint.selected.on-soft-max-limit' (bit out) - status pin telling that "
"the selected joint is on the positive software limit"
msgstr ""
"'halui.joint.s selected.on-soft-max-limit' (bit out) - Status-Pin, der "
"angibt, dass sich das ausgewählte Gelenk auf der positiven Softwaregrenze "
"befindet"

#. type: Plain text
#: src/gui/halui.adoc:198
msgid ""
"'halui.joint.selected.on-soft-min-limit' (bit out) - status pin telling that "
"the selected joint is on the negative software limit"
msgstr ""
"'halui.joint.selected.on-soft-min-limit' (bit out) - Status-Pin, der "
"anzeigt, dass sich das ausgewählte Gelenk auf dem negativen Software-Limit "
"befindet"

#. type: Plain text
#: src/gui/halui.adoc:199
msgid ""
"'halui.joint.selected.override-limits' (bit out) - status pin telling that "
"the selected joint's limits are temporarily overridden"
msgstr ""
"'halui.joint.s selected.override-limits' (bit out) - Status-Pin, der angibt, "
"dass die Grenzen des ausgewählten Gelenks vorübergehend außer Kraft gesetzt "
"werden"

#. type: Plain text
#: src/gui/halui.adoc:200
msgid ""
"'halui.joint.selected.unhome' (bit in) - pin for unhoming the selected joint"
msgstr ""
"'halui.joint.s selected.unhome' (bit in) - Pin zum Unhoming des ausgewählten "
"Gelenks"

#. type: Title ===
#: src/gui/halui.adoc:201
#, no-wrap
msgid "Joint Jogging"
msgstr "Gelenk-Joggen"

#. type: Plain text
#: src/gui/halui.adoc:204 src/man/man1/halui.1.adoc:228
msgid "_N_ = joint number (0 ... num_joints-1)"
msgstr "_N_ = Anzahl der Gelenke (0 ... num_joints-1)"

#. type: Plain text
#: src/gui/halui.adoc:206
msgid ""
"'halui.joint.jog-deadband' (float in) - pin for setting jog analog deadband "
"(jog analog inputs smaller/slower than this - in absolute value - are "
"ignored)"
msgstr ""
"'halui.joint.jog-deadband' (float in) - Pin zum Einstellen der Jog-Analog-"
