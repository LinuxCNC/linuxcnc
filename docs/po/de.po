#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2388
msgid "Interpreter idle"
msgstr "Interpreter idle"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2389
msgid "E-stop off"
msgstr "Notaus aus"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2390
msgid "All-homed"
msgstr "Alle referenziert (engl. all-homed)"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2392
