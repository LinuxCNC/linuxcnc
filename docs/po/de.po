msgstr "B<oneshot>\\&.I<N>\\&.B<reset> bit in"

#. type: Plain text
#: man/man9/oneshot.9:57
msgid "B<oneshot>\\&.I<N>\\&.B<out> bit out"
msgstr "B<oneshot>\\&.I<N>\\&.B<out> bit out"

#. type: Plain text
#: man/man9/oneshot.9:59
msgid "Active high pulse"
msgstr "Aktiver hoher Impuls"

#. type: Plain text
#: man/man9/oneshot.9:62
msgid "B<oneshot>\\&.I<N>\\&.B<out-not> bit out"
msgstr "B<oneshot>\\&.I<N>\\&.B<out-not> bit out"

#. type: Plain text
#: man/man9/oneshot.9:64
msgid "Active low pulse"
msgstr "Aktiver niedriger Impuls"

#. type: Plain text
#: man/man9/oneshot.9:67
msgid "B<oneshot>\\&.I<N>\\&.B<width> float in (default: I<0>)"
msgstr "B<oneshot>\\&.I<N>\\&.B<width> float in (Voreinstellung: I<0>)"

#. type: Plain text
#: man/man9/oneshot.9:69
msgid "Pulse width in seconds"
msgstr "Impulsbreite in Sekunden"

#. type: Plain text
#: man/man9/oneshot.9:72
msgid "B<oneshot>\\&.I<N>\\&.B<time-left> float out"
msgstr "B<oneshot>\\&.I<N>\\&.B<time-left> float out"

#. type: Plain text
#: man/man9/oneshot.9:74
msgid "Time left in current output pulse"
msgstr "Verbleibende Zeit im aktuellen Ausgangsimpuls"

#. type: Plain text
#: man/man9/oneshot.9:78
msgid "B<oneshot>\\&.I<N>\\&.B<retriggerable> bit rw (default: I<TRUE>)"
msgstr ""
"B<oneshot>\\&.I<N>\\&.B<retriggerable> bit rw (Voreinstellung: I<TRUE>)"

#. type: Plain text
#: man/man9/oneshot.9:80
msgid "Allow additional edges to extend pulse"
msgstr "Zusätzliche Flanken zur Impulsverlängerung zulassen"

#. type: Plain text
#: man/man9/oneshot.9:83
msgid "B<oneshot>\\&.I<N>\\&.B<rising> bit rw (default: I<TRUE>)"
msgstr "B<oneshot>\\&.I<N>\\&.B<rising> bit rw (Voreinstellung: I<TRUE>)"

#. type: Plain text
#: man/man9/oneshot.9:85
msgid "Trigger on rising edge"
msgstr "Auslösung bei steigender Flanke"

#. type: Plain text
#: man/man9/oneshot.9:88
msgid "B<oneshot>\\&.I<N>\\&.B<falling> bit rw (default: I<FALSE>)"
msgstr "B<oneshot>\\&.I<N>\\&.B<falling> bit rw (Voreinstellung: I<FALSE>)"

#. type: Plain text
