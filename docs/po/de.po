#, no-wrap
msgid "SIM_HOME_SWITCH"
msgstr "SIM_HOME_SWITCH"

#. type: Plain text
#: man/man9/sim_home_switch.9:32
msgid "sim_home_switch - Home switch simulator"
msgstr "sim_home_switch - Referenzschalter-Simulator"

#. type: Plain text
#: man/man9/sim_home_switch.9:35
msgid ""
