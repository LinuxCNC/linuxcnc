#. type: Plain text
#: src/drivers/mb2hal.adoc:126
msgid "Modbus protocol exceptions:"
msgstr "Ausnahmen vom Modbus-Protokoll:"

#. type: Plain text
#: src/drivers/mb2hal.adoc:128
msgid ""
"0x01 - ILLEGAL_FUNCTION - the FUNCTION code received in the query is not "
"allowed or invalid."
msgstr ""
"0x01 - ILLEGAL_FUNCTION - der in der Abfrage empfangene FUNCTION-Code ist "
"nicht erlaubt oder ungültig."

#. type: Plain text
#: src/drivers/mb2hal.adoc:129
msgid ""
"0x02 - ILLEGAL_DATA_ADDRESS - the DATA ADDRESS received in the query is not "
"an allowable address for the slave or is invalid."
msgstr ""
"0x02 - ILLEGAL_DATA_ADDRESS - die in der Abfrage empfangene DATA ADDRESS ist "
"keine zulässige Adresse für den Slave oder ist ungültig."

#. type: Plain text
#: src/drivers/mb2hal.adoc:130
msgid ""
"0x03 - ILLEGAL_DATA_VALUE - a VALUE contained in the data query field is not "
"an allowable value or is invalid."
msgstr ""
"0x03 - ILLEGAL_DATA_VALUE - ein im Datenabfragefeld enthaltener WERT ist "
"kein zulässiger Wert oder ist ungültig."

#. type: Plain text
#: src/drivers/mb2hal.adoc:131
msgid ""
"0x04 - SLAVE_DEVICE_FAILURE - SLAVE (or MASTER) device unrecoverable FAILURE "
"while attempting to perform the requested action."
msgstr ""
"0x04 - SLAVE_DEVICE_FAILURE - Nicht wiederherstellbarer Fehler des SLAVE- "
"(oder MASTER-) Geräts beim Versuch, die angeforderte Aktion durchzuführen."

#. type: Plain text
#: src/drivers/mb2hal.adoc:132
msgid "0x04 - SERVER_FAILURE - (see above)."
msgstr "0x04 - SERVER_FAILURE - (siehe oben)."

#. type: Plain text
#: src/drivers/mb2hal.adoc:133
msgid ""
"0x05 - ACKNOWLEDGE - This response is returned to PREVENT A TIMEOUT in the "
"master. A long duration of time is required to process the request in the "
"slave."
msgstr ""
"0x05 - ACKNOWLEDGE - Diese Antwort wird zurückgegeben, um einen TIMEOUT im "
"Master zu VERMEIDEN. Für die Bearbeitung der Anfrage im Slave ist eine lange "
"Zeitspanne erforderlich."

#. type: Plain text
#: src/drivers/mb2hal.adoc:134
msgid ""
"0x06 - SLAVE_DEVICE_BUSY - The slave (or server) is BUSY.  Retransmit the "
"request later."
msgstr ""
"0x06 - SLAVE_DEVICE_BUSY - Der Slave (oder Server) ist BUSY.  Übertragen Sie "
"die Anfrage später erneut."

#. type: Plain text
#: src/drivers/mb2hal.adoc:135
msgid "0x06 - SERVER_BUSY - (see above)."
msgstr "0x06 - SERVER_BUSY - (siehe oben)."

#. type: Plain text
#: src/drivers/mb2hal.adoc:136
msgid ""
"0x07 - NEGATIVE_ACKNOWLEDGE - Unsuccessful programming request using "
"function code 13 or 14."
msgstr ""
"0x07 - NEGATIVE_ACKNOWLEDGE - Erfolglose Programmieranfrage mit "
"Funktionscode 13 oder 14."

#. type: Plain text
#: src/drivers/mb2hal.adoc:137
msgid "0x08 - MEMORY_PARITY_ERROR - SLAVE parity error in MEMORY."
msgstr "0x08 - MEMORY_PARITY_ERROR - SLAVE-Paritätsfehler im SPEICHER."

#. type: Plain text
#: src/drivers/mb2hal.adoc:138
msgid "0x0A (-10) - GATEWAY_PROBLEM_PATH - Gateway path(s) not available."
msgstr "0x0A (-10) - GATEWAY_PROBLEM_PATH - Gateway-Pfad(e) nicht verfügbar."

#. type: Plain text
#: src/drivers/mb2hal.adoc:139
msgid ""
"0x0B (-11) - GATEWAY_PROBLEM_TARGET - The target device failed to respond "
"(generated by master, not slave)."
msgstr ""
"0x0B (-11) - GATEWAY_PROBLEM_TARGET - Das Zielgerät hat nicht geantwortet "
"(vom Master, nicht vom Slave erzeugt)."

#. type: Plain text
#: src/drivers/mb2hal.adoc:141
msgid "Program or connection:"
msgstr "Programm oder Verbindung:"

#. type: Plain text
#: src/drivers/mb2hal.adoc:143
msgid "0x0C (-12) - COMM_TIME_OUT"
msgstr "0x0C (-12) - COMM_TIME_OUT"

#. type: Plain text
#: src/drivers/mb2hal.adoc:144
msgid "0x0D (-13) - PORT_SOCKET_FAILURE"
msgstr "0x0D (-13) - PORT_SOCKET_FAILURE"

#. type: Plain text
#: src/drivers/mb2hal.adoc:145
msgid "0x0E (-14) - SELECT_FAILURE"
msgstr "0x0E (-14) - SELECT_FAILURE"

#. type: Plain text
#: src/drivers/mb2hal.adoc:146
msgid "0x0F (-15) - TOO_MANY_DATAS"
msgstr "0x0F (-15) - TOO_MANY_DATAS"

#. type: Plain text
#: src/drivers/mb2hal.adoc:147
msgid "0x10 (-16) - INVALID_CRC"
msgstr "0x10 (-16) - INVALID_CRC"

#. type: Plain text
#: src/drivers/mb2hal.adoc:148
msgid "0x11 (-17) - INVALID_EXCEPTION_CODE"
msgstr "0x11 (-17) - INVALID_EXCEPTION_CODE"

