msgstr ".dirdelay"

#. type: Table
#: src/drivers/gm.adoc:303
#, no-wrap
msgid "Minimum time between step pulse and direction change in nanoseconds."
msgstr "Mindestzeit zwischen Schrittimpuls und Richtungswechsel in Nanosekunden."

#. type: Plain text
#: src/drivers/gm.adoc:306
