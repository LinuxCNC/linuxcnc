#, no-wrap
msgid ""
"      layout.addWidget(buttonBox, 5, 0, 1, 2)\n"
"      self.setLayout(layout)\n"
msgstr ""
"      layout.addWidget(buttonBox, 5, 0, 1, 2)\n"
"      self.setLayout(layout)\n"

#. type: delimited block -
