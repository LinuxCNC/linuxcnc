#. type: Plain text
#: src/gcode/overview.adoc:528
msgid "'#<_metric>' - Return 1 if G21 is on, else 0."
msgstr "'#<_metric>' - Gibt 1 zurück, wenn G21 eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:529
msgid "'#<_imperial>' - Return 1 if G20 is on, else 0."
msgstr "'#<_imperial>' - Gibt 1 zurück, wenn G20 eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:530
msgid "'#<_absolute>' - Return 1 if G90 is on, else 0."
msgstr "'#<_absolute>' - Gibt 1 zurück, wenn G90 eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:531
msgid "'#<_incremental>' - Return 1 if G91 is on, else 0."
msgstr ""
"'#<_incremental>' - Gibt 1 zurück, wenn G91 eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:532
msgid "'#<_inverse_time>' - Return 1 if inverse feed mode (G93) is on, else 0."
msgstr ""
"'#<_inverse_time>' - Gibt 1 zurück, wenn der inverse Vorschubmodus (G93) "
"eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:533
msgid ""
"'#<_units_per_minute>' - Return 1 if Units/minute feed mode (G94) is on, "
"else 0."
msgstr ""
"'#<_Units_per_minute>' - Rückgabe 1, wenn der Modus Einheiten/Minute (G94) "
"eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:534
msgid ""
"'#<_units_per_rev>' - Return 1 if Units/revolution mode (G95) is on, else 0."
msgstr ""
"'#<_units_per_rev>' - Rückgabe 1, wenn der Modus Einheiten/Umdrehung (G95) "
"eingeschaltet ist, sonst 0."

#. type: Plain text
#: src/gcode/overview.adoc:537
msgid ""
"'#<_coord_system>' - Return a float of the current coordinate system name "
"(G54..G59.3).  For example if your in G55 coordinate system the return value "
"is 550.000000 and if your in G59.1 the return value is 591.000000."
msgstr ""
"#<_coord_system>' - Gibt eine Fließkommazahl mit dem Namen des aktuellen "
"Koordinatensystems zurück (G54..G59.3).  Wenn Sie sich beispielsweise im G55-"
"Koordinatensystem befinden, ist der Rückgabewert 550.000000 und wenn Sie "
"sich im G59.1-Koordinatensystem befinden, ist der Rückgabewert 591.000000."

