"      layout.addWidget(self.c_estop)\n"
msgstr ""
"      layout = QtWidgets.QGridLayout()\n"
"      self.c_estop = QtWidgets.QCheckBox(\"Estop Action\")\n"
"      self.c_estop.setChecked(widget.estop )\n"
"      layout.addWidget(self.c_estop)\n"

#. type: delimited block -
