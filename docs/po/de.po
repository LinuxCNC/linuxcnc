msgstr "Der eigentliche Schleppfehler."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:344
#, no-wrap
msgid "**joint.**_N_**.f-error-lim** OUT FLOAT *(DEBUG)*"
msgstr "**joint.**_N_**.f-error-lim** OUT FLOAT *(DEBUG)*"

