msgstr "aktuell angewandter Werkzeuglängenversatz für die B-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:45
#, no-wrap
msgid "*halui.tool.length-offset.c*  float out"
msgstr "*halui.tool.length-offset.c*  float out"

#. type: Plain text
#: src/man/man1/halui.1.adoc:47
msgid "current applied tool length offset for the C axis"
msgstr "aktuell angewandter Werkzeuglängenversatz für die C-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:47
#, no-wrap
msgid "*halui.tool.length-offset.u*  float out"
msgstr "*halui.tool.length-offset.u*  float out"

#. type: Plain text
#: src/man/man1/halui.1.adoc:49
msgid "current applied tool length offset for the U axis"
msgstr "aktuell angewandter Werkzeuglängenversatz für die U-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:49
#, no-wrap
msgid "*halui.tool.length-offset.v*  float out"
msgstr "*halui.tool.length-offset.v*  float out"

#. type: Plain text
#: src/man/man1/halui.1.adoc:51
msgid "current applied tool length offset for the V axis"
msgstr "aktuell angewandter Werkzeuglängenversatz für die V-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:51
#, no-wrap
msgid "*halui.tool.length-offset.w*  float out"
msgstr "*halui.tool.length-offset.w*  float out"

#. type: Plain text
#: src/man/man1/halui.1.adoc:53
msgid "current applied tool length offset for the W axis"
msgstr "aktuell angewandter Werkzeuglängenversatz für die W-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:53
#, no-wrap
msgid "*halui.tool.length-offset.x*  float out"
msgstr "*halui.tool.length-offset.x*  float out"

#. type: Plain text
#: src/man/man1/halui.1.adoc:55
msgid "current applied tool length offset for the X axis"
msgstr "aktuell angewandter Werkzeuglängenversatz für die X-Achse"

#. type: Labeled list
#: src/man/man1/halui.1.adoc:55
#, no-wrap
msgid "*halui.tool.length-offset.y*  float out"
