msgid ""
"5-input AND and OR gates: `logic.1.and`, `logic.1.or`, `logic.1.in-00`, "
"`logic.1.in-01`, `logic.1.in-02`, `logic.1.in-03`, `logic.1.in-04`,"
msgstr ""
"5-input AND and OR gates: `logic.1.and`, `logic.1.or`, `logic.1.in-00`, "
"`logic.1.in-01`, `logic.1.in-02`, `logic.1.in-03`, `logic.1.in-04`,"

#. type: Plain text
