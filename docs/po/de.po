#, no-wrap
msgid "*`showDivide`*"
msgstr "*`showDivide`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:732 src/gui/qtvcp-widgets.adoc:817
msgid "Show the 'Divide by 2' action."
msgstr "Zeige die 'Teile durch 2' Aktion."

#. type: Labeled list
