"<vbox>\n"
"    <relief>RIDGE</relief>\n"
"    <bd>6</bd>\n"
"    <label><text>\"a vbox:\"</text></label>\n"
"    <led></led>\n"
"    <number></number>\n"
"    <bar></bar>\n"
"</vbox>\n"
msgstr ""
"<vbox>\n"
"    <relief>RIDGE</relief>\n"
"    <bd>6</bd>\n"
"    <label><text>\"eine vbox:\"</text></label>\n"
"    <led></led>\n"
"    <number></number>\n"
"    <bar></bar>\n"
"</vbox>\n"

