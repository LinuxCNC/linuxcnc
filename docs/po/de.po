msgstr "images/offsetpage.png"

#. type: Title ===
#: src/gui/gladevcp.adoc:1939
#, no-wrap
msgid "HAL_sourceview widget"
msgstr "HAL_sourceview-Widget"

#. type: Plain text
#: src/gui/gladevcp.adoc:1944
msgid ""
"This is for displaying and simple editing of G-code.  It looks for `.ngc` "
"highlighting specs in `~/share/gtksourceview-4/language-specs/`.  The "
"current running line will be highlighted."
msgstr ""
"Dies ist für die Anzeige und einfache Bearbeitung von G-Code.  Es sucht nach "
"`.ngc`-Hervorhebungsspezifikationen in `~/share/gtksourceview-4/language-"
"specs/`.  Die aktuell laufende Zeile wird hervorgehoben."

#. type: Plain text
#: src/gui/gladevcp.adoc:1946
msgid "With external Python glue code it can:"
msgstr "Mit externem Python-Glue-Code kann dies:"

#. type: Plain text
#: src/gui/gladevcp.adoc:1948
msgid "Search for text, undo and redo changes."
msgstr "Nach Text suchen, Änderungen rückgängig machen und Wiederherstellen,"

#. type: Plain text
#: src/gui/gladevcp.adoc:1949
msgid "Be used for program line selection."
msgstr "für die Auswahl von Programmzeilen genutzt werden."

#. type: Plain text
#: src/gui/gladevcp.adoc:1956
#, no-wrap
msgid ""
"`[widget name].redo()`\n"
"Redo one level of changes."
msgstr ""
"`[widget name].redo()` +\n"
"Wiederholung einer Ebene von Änderungen."

#. type: Plain text
#: src/gui/gladevcp.adoc:1958
#, no-wrap
msgid ""
"`[widget name].undo()`\n"
"Undo one level of changes"
msgstr ""
"[widget name].undo()` +\n"
"Rückgängig machen einer Ebene von Änderungen"

#. type: Plain text
#: src/gui/gladevcp.adoc:1961
#, no-wrap
msgid ""
"`[widget name].text_search(direction=True,mixed_case=True,text='G92')`\n"
"Searches forward (direction = True) or backward,\n"
"Searches with mixed case (mixed_case = True) or exact match"
msgstr ""
"`[Widgetname].text_search(direction=True,mixed_case=True,text='G92')` +\n"
"Sucht vorwärts (direction = True) oder rückwärts, +\n"
"Sucht mit gemischter Groß- und Kleinschreibung (mixed_case = True) oder exakter Übereinstimmung"

#. type: Plain text
#: src/gui/gladevcp.adoc:1964
#, no-wrap
msgid ""
"`[widget name].set_line_number(linenumber)`\n"
"Sets the line to highlight.\n"
"Uses the sourceview line numbers."
msgstr ""
"`[Widgetname].set_line_number(Zeilennummer)` +\n"
"Setzt die hervorzuhebende Zeile. +\n"
"Verwendet die Zeilennummern der Quellansicht."

#. type: Plain text
#: src/gui/gladevcp.adoc:1966
#, no-wrap
msgid ""
"`[widget name].get_line_number()`\n"
"Returns the currently highlighted line."
msgstr ""
"`[Widgetname].get_line_number()` +\n"
"Gibt die aktuell hervorgehobene Zeile zurück."

#. type: Plain text
#: src/gui/gladevcp.adoc:1968
#, no-wrap
msgid ""
"`[widget name].line_up()`\n"
"Moves the highlighted line up one line."
msgstr ""
"[Widget-Name].line_up()` +\n"
"Verschiebt die markierte Zeile um eine Zeile nach oben."

#. type: Plain text
#: src/gui/gladevcp.adoc:1970
#, no-wrap
msgid ""
"`[widget name].line_down()`\n"
"Moves the highlighted line down one line."
msgstr ""
"`[Name des Widgets].line_down()`\n"
"Verschiebt die markierte Zeile um eine Zeile nach unten."

#. type: Plain text
#: src/gui/gladevcp.adoc:1973
#, no-wrap
msgid ""
"`[widget name].load_file('filename')`\n"
"Loads a file.\n"
"Using None (not a filename string) will reload the same program."
msgstr ""
"`[Widgetname].load_file('Dateiname')`\n"
"Lädt eine Datei.\n"
"Die Verwendung von None (keine Zeichenkette für den Dateinamen) lädt das gleiche Programm erneut."

#. type: Plain text
#: src/gui/gladevcp.adoc:1975
#, no-wrap
msgid ""
"`[widget name].get_filename()`\n"
"FIXME description"
msgstr ""
"'[Widget-Name].get_filename()'\n"
"FIXME Beschreibung"

