msgid "The current set of *existing* codes open to redefinition is:"
msgstr ""
"Der derzeitige Satz von *bestehenden* Codes, die neu definiert werden "
"können, ist:"

#. type: Plain text
#: src/remap/remap.adoc:1793
msgid "T__x__ (Prepare)"
msgstr "T__x__ (Prepare)"

#. type: Plain text
#: src/remap/remap.adoc:1794
msgid "M6 (Change tool)"
msgstr "M6 (Werkzeug wechseln)"

#. type: Plain text
#: src/remap/remap.adoc:1795
msgid "M61 (Set tool number)"
msgstr "M61 (Werkzeugnummer einstellen)"

#. type: Plain text
#: src/remap/remap.adoc:1796
msgid "M0 (pause a running program temporarily)"
msgstr "M0 (ein laufendes Programm vorübergehend unterbrechen)"

#. type: Plain text
#: src/remap/remap.adoc:1797
msgid ""
"M1 (pause a running program temporarily if the optional stop switch is on)"
msgstr ""
"M1 (vorübergehendes Anhalten eines laufenden Programms, wenn der optionale "
"Stoppschalter eingeschaltet ist)"

#. type: Plain text
#: src/remap/remap.adoc:1798
msgid "M7 (activate coolant mist)"
msgstr "M7 (aktiviere Kühlnebel)"

#. type: Plain text
#: src/remap/remap.adoc:1799
msgid "M8 (activate coolant flood)"
msgstr "M8 (Kühlmittel-Flut aktivieren)"

#. type: Plain text
#: src/remap/remap.adoc:1800
msgid "M9 (deactivate coolant mist and flood)"
msgstr "M9 (Kühlmittelnebel und -flut deaktivieren)"

#. type: Plain text
#: src/remap/remap.adoc:1801
msgid ""
"M60 (exchange pallet shuttles and then pause a running program temporarily)"
msgstr ""
"M60 (Paletten-Shuttles austauschen und dann ein laufendes Programm "
"vorübergehend unterbrechen)"

#. type: Plain text
#: src/remap/remap.adoc:1802
msgid "M62 .. M65 (digital output control)"
msgstr "M62 .. M65 (digitale Ausgangssteuerung)"

#. type: Plain text
#: src/remap/remap.adoc:1803
msgid "M66 (wait on input)"
msgstr "M66 (Warten auf Eingabe)"

#. type: Plain text
#: src/remap/remap.adoc:1804
msgid "M67, M68 (analog output control)"
msgstr "M67, M68 (Steuerung des Analogausgangs)"

#. type: Plain text
#: src/remap/remap.adoc:1805
msgid "S (set spindle speed)"
msgstr "S (Spindeldrehzahl einstellen)"

#. type: Plain text
#: src/remap/remap.adoc:1806
msgid "F (set feed)"
msgstr "F (Vorschub einstellen)"

#. type: Title ===
#: src/remap/remap.adoc:1808
#, no-wrap
msgid "Currently unallocated G-codes:"
msgstr "Derzeit nicht zugewiesene M-Codes:"

#. type: Plain text
#: src/remap/remap.adoc:1813
msgid ""
"Currently unallocated G-codes (for remapping) must be selected from the "
"blank areas of the following tables.  All the listed G-codes are already "
"defined in the current implementation of LinuxCNC and may *not* be used to "
"remap new G-codes.  (Developers who add new G-codes to LinuxCNC are "
"encouraged to also add their new G-codes to these tables.)"
msgstr ""
"Derzeit nicht zugewiesene G-Codes (für remapping) müssen aus den leeren "
"Bereichen der folgenden Tabellen ausgewählt werden.  Alle aufgelisteten G-"
"Codes sind bereits in der aktuellen Implementierung von LinuxCNC definiert "
"und kann *nicht* verwendet werden, um neue G-Codes zu remappen.  "
"(Entwickler, die neue G-Codes zu LinuxCNC hinzufügen werden ermutigt, auch "
"ihre neuen G-Codes zu diesen Tabellen hinzufügen.)"

