#. type: Plain text
#: src/gui/halui.adoc:299
msgid ""
"'halui.spindle._N_.override.reset' (bit, in) - pin for resetting the SO "
"value (scale=1.0)"
msgstr ""
"'halui.spindle._N_.override.reset' (bit, in) - Pin zum Zurücksetzen des SO-"
"Werts (scale=1.0)"

#. type: Plain text
#: src/gui/halui.adoc:303
