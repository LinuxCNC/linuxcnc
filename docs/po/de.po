msgid "B<and>(9), B<logic>(9), B<not>(9), B<or2>(9), B<xor2>(9)\\&."
msgstr "B<and>(9), B<logic>(9), B<not>(9), B<or2>(9), B<xor2>(9)\\&."

#. type: TH
#: man/man9/maj3.9:10
#, no-wrap
msgid "MAJ3"
msgstr "MAJ3"

#. type: Plain text
