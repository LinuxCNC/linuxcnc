msgstr "Bitte beachten Sie das kombinierte Dokument hm2_pktuart.3"

#. type: Title =
#: src/man/man3/hm2_pktuart_send.3.adoc:1
#, no-wrap
msgid "hm2_pktuart_send(3)"
msgstr "hm2_pktuart_send(3)"

#. type: Plain text
#: src/man/man3/hm2_pktuart_send.3.adoc:6
msgid "hm2_pktuart_send - write data to a Hostmot2 PktUART"
msgstr "hm2_pktuart_send - schreibt Daten an einen Hostmot2 PktUART"

#. type: delimited block -
#: src/man/man3/hm2_pktuart_send.3.adoc:14
#, no-wrap
msgid ""
"#include <hostmot2-serial.h>\n"
"int hm2_uart_send(char* name, unsigned char data[], rtapi_u8* num_frames,\n"
"                  rtapi_u16 frame_sizes[]);\n"
msgstr ""
"#include <hostmot2-serial.h>\n"
"int hm2_uart_send(char* name, unsigned char data[], rtapi_u8* num_frames,\n"
"                  rtapi_u16 frame_sizes[]);\n"

#. type: Plain text
#: src/man/man3/hm2_pktuart_send.3.adoc:20
msgid ""
"*hm2_pktuart_send* writes \"num_frames\" of data to the PktUART \"name\" "
"from the buffer \"data\" with frame sizes preset in \"frame_sizes[]\" array."
msgstr ""
"*hm2_pktuart_send* schreibt \"num_frames\" Daten an den PktUART \"name\" aus "
"dem Puffer \"data\" mit den im Array \"frame_sizes[]\" eingestellten "
"Framegrößen."

#. type: Plain text
#: src/man/man3/hm2_pktuart_send.3.adoc:21
#: src/man/man3/hm2_pktuart_setup.3.adoc:20
msgid ""
