msgstr "**pentakins.effector.**_N_**.z**"

#. type: Plain text
#: src/man/man9/kins.9.adoc:257
msgid ""
"Parameters describing the __N__^th^ effector joint's radius and axial "
"position."
msgstr ""
"Parameter, die den Radius und die axiale Position des __N__-ten "
"Effektorgelenks beschreiben."

#. type: Labeled list
#: src/man/man9/kins.9.adoc:258
#, no-wrap
msgid "*pentakins.convergence-criterion*"
msgstr "*pentakins.convergence-criterion*"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:261
#, no-wrap
msgid "*pentakins.limit-iterations*"
msgstr "*pentakins.limit-iterations*"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:264
#, no-wrap
msgid "*pentakins.max-error*"
msgstr "*pentakins.max-error*"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:267
#, no-wrap
msgid "*pentakins.last-iterations*"
msgstr "*pentakins.last-iterations*"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:270
#, no-wrap
msgid "*pentakins.max-iterations*"
msgstr "*pentakins.max-iterations*"

#. type: Labeled list
#: src/man/man9/kins.9.adoc:273
#, no-wrap
msgid "*pentakins.tool-offset*"
msgstr "*pentakins.tool-offset*"

#. type: Plain text
#: src/man/man9/kins.9.adoc:276
msgid ""
"TCP offset from effector origin along Z to implement RTCP function.  To "
"avoid joints jump change tool offset only when the platform is not tilted."
msgstr ""
"TCP-Offset vom Effektor-Ursprung entlang Z zur Implementierung der RTCP-"
"Funktion. Um einen Sprung der Gelenke zu vermeiden, ändern Sie den "
"Werkzeugversatz nur, wenn die Plattform nicht gekippt ist."

#. type: Title ===
#: src/man/man9/kins.9.adoc:277
#, no-wrap
msgid "pumakins - kinematics for puma typed robots"
msgstr "pumakins - Kinematik für pumaähnliche Roboter"

#. type: Plain text
#: src/man/man9/kins.9.adoc:280
msgid "Kinematics for a puma-style robot with 6 joints:"
msgstr "Kinematik für einen puma-ähnlichen Roboter mit 6 Gelenken:"

#. type: Labeled list
