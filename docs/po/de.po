#. type: Plain text
#: src/man/man3/hm2_pktuart_read.3.adoc:6
msgid "hm2_pktuart_read - read data from a Hostmot2 UART buffer"
msgstr "hm2_pktuart_read - liest Daten aus einem Hostmot2 UART-Puffer"

#. type: delimited block -
#: src/man/man3/hm2_pktuart_read.3.adoc:14
