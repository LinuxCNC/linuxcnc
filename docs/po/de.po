#. type: TIP
#: src/gui/gmoccapy.adoc:1608 src/gui/gmoccapy.adoc:1615
msgid "_Arrow_Right_ or _NumPad_Right_ - Jog Z plus"
msgstr "_Pfeil rechts_ oder _NumPad_rechts_ - Jog Z plus"

#. type: TIP
#: src/gui/gmoccapy.adoc:1609
msgid "_Arrow_up_ or _NumPad_Up_ - Jog X minus"
msgstr "_Pfeil nach oben_ oder _NumPad_Hoch_ - Jog X minus"

#. type: TIP
#: src/gui/gmoccapy.adoc:1610
msgid "_Arrow_Down_ or _NumPad_Down_ - Jog X plus"
msgstr "_Pfeil nach unten_ oder _NumPad_runter_ - _Jog X plus_"

