msgstr "*hm2_pktuart_read* liest Daten vom PktUART \"name\"."

#. type: Plain text
#: src/man/man3/hm2_pktuart_read.3.adoc:21
msgid "DEPRECATED except in setup code."
msgstr "VERALTET, außer im Setup-Code."

#. type: Plain text
