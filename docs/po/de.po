#: src/gui/gui-dev-reference.adoc:191
#, no-wrap
msgid ""
"[HAL]\n"
"POSTGUI_HALFILE = keypad_postgui.hal\n"
"POSTGUI_HALFILE = vfd_postgui.hal\n"
msgstr ""
"[HAL]\n"
"POSTGUI_HALFILE = keypad_postgui.hal\n"
"POSTGUI_HALFILE = vfd_postgui.hal\n"

#. type: Title ====
#: src/gui/gui-dev-reference.adoc:193
#, no-wrap
msgid "Postgui Halcmd"
msgstr "Postgui Halcmd"

#. type: Plain text
#: src/gui/gui-dev-reference.adoc:195
msgid ""
"These files should be run one after another in order, after all the POSTGUI "
"files have been run."
msgstr ""
