msgid "AXISTEST"
msgstr "AXISTEST"

#. type: Plain text
#: man/man9/axistest.9:32
msgid "axistest - Used to allow testing of an axis\\&. Used IN PnCconf\\&."
msgstr ""
"axistest - Wird verwendet zum Testen einer Achse. Verwendet in PnCConf."

#. type: Plain text
#: man/man9/axistest.9:35
msgid "B<loadrt axistest> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"
msgstr "B<loadrt axistest> [B<count>=I<N>|B<names>=I<name1>[,I<name2>\\&...]]"

#. type: Plain text
#: man/man9/axistest.9:38
msgid "B<axistest>\\&.I<N>\\&.B<update> (requires a floating-point thread)"
msgstr "B<axistest>\\&.I<N>\\&.B<update> (erfordert einen Gleitkomma-Thread)"

#. type: Plain text
#: man/man9/axistest.9:43
msgid "B<axistest>\\&.I<N>\\&.B<jog-minus> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<jog-minus> bit in"

#. type: Plain text
#: man/man9/axistest.9:45
msgid "Drive TRUE to jog the axis in its negative (I<minus>) direction\\&."
msgstr ""
"Drücke TRUE, um die Achse in ihrer negativen (I<minus>) Richtung zu bewegen."

#. type: Plain text
#: man/man9/axistest.9:48
msgid "B<axistest>\\&.I<N>\\&.B<jog-plus> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<jog-plus> bit in"

#. type: Plain text
#: man/man9/axistest.9:50
msgid "Drive TRUE to jog the axis in its positive direction\\&."
msgstr "Setzen Sie TRUE, um die Achse in ihre positive Richtung zu joggen."

#. type: Plain text
#: man/man9/axistest.9:53
msgid "B<axistest>\\&.I<N>\\&.B<run> bit in"
msgstr "B<axistest>\\&.I<N>\\&.B<run> bit in"

#. type: Plain text
#: man/man9/axistest.9:55
msgid ""
"Drive TRUE to run the axis near its current position_fb with a trapezoidal "
"velocity profile\\&."
msgstr ""
"Mit TRUE belegen, um die Achse in der Nähe ihrer aktuellen position_fb mit "
"einem trapezförmigen Geschwindigkeitsprofil zu betreiben."

#. type: Plain text
#: man/man9/axistest.9:58
msgid "B<axistest>\\&.I<N>\\&.B<maxvel> float in"
msgstr "B<axistest>\\&.I<N>\\&.B<maxvel> float in"

#. type: Plain text
#: man/man9/axistest.9:60 man/man9/simple_tp.9:50 man/man9/steptest.9:60
msgid "Maximum velocity"
msgstr "Maximale Geschwindigkeit"

#. type: Plain text
#: man/man9/axistest.9:63
msgid "B<axistest>\\&.I<N>\\&.B<amplitude> float in"
msgstr "B<axistest>\\&.I<N>\\&.B<amplitude> float in"

#. type: Plain text
#: man/man9/axistest.9:66 man/man9/steptest.9:71
msgid "Approximate amplitude of positions to command during I<run>"
msgstr ""
"Ungefähre Amplitude der zu befehlenden Positionen während des I<Laufs> "
"(engl. run)"

#. type: Plain text
