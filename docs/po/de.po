#: man/man9/joyhandle.9:91
msgid "B<joyhandle>\\&.I<N>\\&.B<offset> float rw (default: I<0\\&.>)"
msgstr "B<joyhandle>\\&.I<N>\\&.B<offset> float rw (Voreinstellung: I<0\\&.>)"

