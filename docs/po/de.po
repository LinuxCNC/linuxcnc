msgstr ""
"'halui.spindle._N_.brake-is-on' (bit, out) - zeigt an, dass die Bremse "
"eingeschaltet ist"

#. type: Plain text
#: src/gui/halui.adoc:304
msgid ""
"'halui.spindle._N_.brake-off' (bit, in) - pin for deactivating spindle/brake"
msgstr ""
"'halui.spindle._N_.brake-off' (bit, in) - Pin zur Deaktivierung der Spindel/"
"Bremse"

#. type: Plain text
#: src/gui/halui.adoc:305
msgid ""
"'halui.spindle._N_.brake-on' (bit, in) - pin for activating spindle-brake"
msgstr ""
"'halui.spindle._N_.brake-off' (bit, in) - Pin zur Deaktivierung der Spindel/"
"Bremse"

#. type: Plain text
#: src/gui/halui.adoc:306
msgid "'halui.spindle._N_.decrease' (bit, in) - decreases spindle speed"
msgstr ""
"'halui.spindle._N_.decrease' (bit, in) - verringert die Spindeldrehzahl"

#. type: Plain text
#: src/gui/halui.adoc:307
msgid ""
"'halui.spindle._N_.forward' (bit, in) - starts the spindle with CW motion"
msgstr ""
"'halui.spindle._N_.forward' (bit, in) - startet die Spindel mit Bewegung im "
"Uhrzeigersinn"

#. type: Plain text
#: src/gui/halui.adoc:308
msgid "'halui.spindle._N_.increase' (bit, in)- increases spindle speed"
msgstr "'halui.spindle._N_.increase' (bit, in)- erhöht die Spindeldrehzahl"

#. type: Plain text
#: src/gui/halui.adoc:309
msgid ""
"'halui.spindle._N_.is-on' (bit, out) - indicates spindle is on (either "
"direction)"
msgstr ""
"'halui.spindle._N_.is-on' (bit, out) - zeigt an, dass die Spindel "
"eingeschaltet ist (in beide Richtungen)"

#. type: Plain text
#: src/gui/halui.adoc:310
msgid ""
"'halui.spindle._N_.reverse' (bit, in)- starts the spindle with a CCW motion"
msgstr ""
"'halui.spindle._N_.reverse' (bit, in)- startet die Spindel mit einer "
"Bewegung gegen den Uhrzeigersinn"

#. type: Plain text
#: src/gui/halui.adoc:311
msgid ""
"'halui.spindle._N_.runs-backward' (bit, out) - indicates spindle is on, and "
"in reverse"
msgstr ""
"'halui.spindle._N_.runs-backward' (bit, out) - zeigt an, dass die Spindel "
"eingeschaltet ist und umgekehrt"

#. type: Plain text
#: src/gui/halui.adoc:312
msgid ""
"'halui.spindle._N_.runs-forward' (bit, out) - indicates spindle is on, and "
"in forward"
msgstr ""
"'halui.spindle._N_.runs-forward' (bit, out) - zeigt an, dass die Spindel "
"eingeschaltet und vorwärts läuft"

#. type: Plain text
#: src/gui/halui.adoc:313
msgid "'halui.spindle._N_.start' (bit, in) - starts the spindle"
msgstr "'halui.spindle._N_.start' (bit, in) - startet die Spindel"

#. type: Plain text
#: src/gui/halui.adoc:314
msgid "'halui.spindle._N_.stop' (bit, in) - stops the spindle"
msgstr "'halui.spindle._N_.stop' (bit, in) - stoppt die Spindel"

