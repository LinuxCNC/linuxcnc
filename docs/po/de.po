#. type: Title ==
#: src/gui/pyvcp-examples.adoc:345
#, no-wrap
msgid "GS2 RPM Meter"
msgstr "GS2-Drehzahlmesser"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:350
msgid ""
"The following example uses the Automation Direct GS2 VDF driver and displays "
"the RPM and other info in a PyVCP panel. This example is based on the GS2 "
"example in the Hardware Examples section this manual."
msgstr ""
"Das folgende Beispiel verwendet den Automation Direct GS2 VDF-Treiber und "
"zeigt die U/min (engl. RPM) und andere Informationen in einem PyVCP-Panel "
"an. Dieses Beispiel basiert auf dem GS2-Beispiel im Abschnitt Hardware-"
"Beispiele dieses Handbuchs."

#. type: Title ===
#: src/gui/pyvcp-examples.adoc:351
#, no-wrap
msgid "The Panel"
msgstr "Das Panel"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:354
msgid "To create the panel we add the following to the XML file."
msgstr "Um das Panel zu erstellen, fügen wir der XML-Datei Folgendes hinzu."

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:357
#, no-wrap
msgid "<pyvcp>\n"
msgstr "<pyvcp>\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:374
#, no-wrap
msgid ""
"  <!-- the RPM meter -->\n"
"  <hbox>\n"
"    <relief>RAISED</relief>\n"
