msgstr "**joint.**_N_**.f-errored** OUT BIT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:348
msgid "TRUE when this joint has exceeded the following error limit."
msgstr "TRUE, wenn dieses Gelenk die Schleppfehlergrenze überschritten hat."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:348
#, no-wrap
msgid "**joint.**_N_**.faulted** OUT BIT *(DEBUG)*"
msgstr "**joint.**_N_**.faulted** OUT BIT *(DEBUG)*"

#. type: Labeled list
#: src/man/man9/motion.9.adoc:349
#, no-wrap
msgid "**joint.**_N_**.free-pos-cmd** OUT FLOAT *(DEBUG)*"
msgstr "**joint.**_N_**.free-pos-cmd** OUT FLOAT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:351
msgid "The \"free planner\" commanded position for this joint."
msgstr "Der \"freie Planer\" befahl die Position für dieses Gelenk."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:351
#, no-wrap
msgid "**joint.**_N_**.free-tp-enable** OUT BIT *(DEBUG)*"
msgstr "**joint.**_N_**.free-tp-enable** OUT BIT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:353
msgid "TRUE when the \"free planner\" is enabled for this joint."
msgstr "TRUE, wenn der \"freie Planer\" für diese Verbindung aktiviert ist."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:353
#, no-wrap
msgid "**joint.**_N_**.free-vel-lim** OUT FLOAT *(DEBUG)*"
msgstr "**joint.**_N_**.free-vel-lim** OUT FLOAT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:355
msgid "The velocity limit for the free planner."
msgstr "Die Geschwindigkeitsbegrenzung für den freien Planer."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:355
