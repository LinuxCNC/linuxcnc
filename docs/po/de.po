#. type: Table
#: src/plasma/qtplasmac.adoc:4433
#, no-wrap
msgid ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (enable adaptive feed) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (reduce feed rate to 60%) +\n"
"G3 I10 (the hole) +\n"
"M67 E3 Q100 (restore feed rate to 100%) +\n"
"M5 $0 (end cut) +\n"
"G0 X0 Y0 +\n"
"M2 (end job)"
msgstr ""
"G21 (metric) +\n"
"G64 P0.05 +\n"
"M52 P1 (adaptiven Vorschub aktivieren) +\n"
"F#<_hal[plasmac.cut-feed-rate]> +\n"
"G0 X10 Y10 +\n"
"M3 $0 S1 (start cut) +\n"
"G1 X0 +\n"
"M67 E3 Q60 (reduce feed rate to 60%) +\n"
"G3 I10 (the hole) +\n"
"M67 E3 Q100 (restore feed rate to 100%) +\n"
