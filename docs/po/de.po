msgstr "pyvcp_demo - Python Virtual Control Panel Demonstrationskomponente"

#. type: Plain text
#: src/man/man1/pyvcp_demo.1.adoc:10
msgid "*pyvcp_demo*"
msgstr "*pyvcp_demo*"

#. type: Plain text
#: src/man/man1/pyvcp_demo.1.adoc:14
msgid "*pyvcp_demo* is mainly used by sample configurations."
msgstr "*pyvcp_demo* wird hauptsächlich von Beispielkonfigurationen verwendet."

#. type: Plain text
#: src/man/man1/pyvcp_demo.1.adoc:18
msgid "pyvcp_demo filename1.xml filename2.hal [compname]"
msgstr "pyvcp_demo filename1.xml filename2.hal [compname]"

#. type: Plain text
#: src/man/man1/pyvcp_demo.1.adoc:20
msgid "If not provided, use compname == pyvcp"
msgstr "Wenn nicht angegeben, verwenden Sie compname == pyvcp"

