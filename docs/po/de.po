#, no-wrap
msgid "*`showGotoOrigin`*"
msgstr "*`showGotoOrigin`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:734 src/gui/qtvcp-widgets.adoc:819
msgid "Show the 'Go to G53/G5x origin' action."
msgstr "Zeige die 'Gehe zu G53/G5x Ursprung' Aktion."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:734 src/gui/qtvcp-widgets.adoc:819
#, no-wrap
msgid "*`showZeroOrigin`*"
msgstr "*`showZeroOrigin`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:736 src/gui/qtvcp-widgets.adoc:821
msgid "Show the 'Zero Origin' action."
msgstr "Zeige die 'Nulle Ursprung' Aktion."

#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:736 src/gui/qtvcp-widgets.adoc:821
#, no-wrap
msgid "*`showSetOrigin`*"
msgstr "*`showSetOrigin`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:738 src/gui/qtvcp-widgets.adoc:823
msgid "Show the 'Set Origin' action."
msgstr "Zeige die 'Setze Ursprung' Aktion."

