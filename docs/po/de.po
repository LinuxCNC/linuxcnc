msgstr "Schneiden <<plasma:hole-cutting,holes>> mit 60% Vorschub"

#. type: Table
#: src/plasma/qtplasmac.adoc:4373
#, no-wrap
msgid ""
"`#<holes> = 1` +\n"
"for holes less than 32 mm (1.26\") diameter"
msgstr ""
"`#<holes> = 1` +\n"
"für Löcher mit einem Durchmesser von weniger als 32 mm (1.26\")"

#. type: Table
#: src/plasma/qtplasmac.adoc:4373
#, no-wrap
msgid "Cut <<plasma:hole-cutting,holes>> at 60% feed rate, turn torch off at hole end, continue hole path for over cut."
msgstr "Schneiden Sie <<plasma:hole-cutting,holes>> mit 60% Vorschub, schalten Sie den Brenner am Ende der Bohrung aus, fahren Sie mit der Bohrung für den Überschnitt fort."

#. type: Table
#: src/plasma/qtplasmac.adoc:4376
#, no-wrap
msgid ""
"`#<holes> = 2` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"over cut length = 4 mm (0.157\")"
msgstr ""
"`#<holes> = 2` +\n"
"für Löcher mit weniger als 32 mm (1,26\") Durchmesser +\n"
"Überschnittlänge = 4 mm (0.157\")"

#. type: Table
#: src/plasma/qtplasmac.adoc:4376
#, no-wrap
msgid "Cut <<plasma:hole-cutting,holes>> and arcs at 60% feed rate."
msgstr "Schneiden von <<plasma:hole-cutting,holes>> und Bögen mit 60% Vorschub."

#. type: Table
#: src/plasma/qtplasmac.adoc:4379
#, no-wrap
msgid ""
"`#<holes> = 3` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"for arcs less than 16 mm (0.63\") radius"
msgstr ""
"`#<holes> = 3` +\n"
"für Löcher mit weniger als 32 mm (1,26\") Durchmesser +\n"
"für Bögen mit weniger als 16 mm (0,63\") Radius"

#. type: Table
#: src/plasma/qtplasmac.adoc:4379
#, no-wrap
msgid "Cut <<plasma:hole-cutting,holes>> and arcs at 60% feed rate, turn torch off at hole end, continue hole path for over cut."
msgstr "Schneiden Sie <<plasma:hole-cutting,Löcher>> (engl. holes) und Bögen mit 60% Vorschub, schalten Sie den Brenner am Ende der Bohrung aus, setzen Sie den Bohrungsweg für den Überschnitt fort."

#. type: Table
#: src/plasma/qtplasmac.adoc:4383
#, no-wrap
msgid ""
"`#<holes> = 4` +\n"
"for holes less than 32 mm (1.26\") diameter +\n"
"for arcs less than 16 mm (0.63\") radius +\n"
"over cut length = 4 mm (0.157\")"
msgstr ""
"`#<holes> = 4` +\n"
"für Löcher mit weniger als 32 mm (1,26\") Durchmesser +\n"
"für Bögen kleiner als 16 mm (0.63\") Radius +\n"
"Überschnittlänge = 4 mm (0.157\")"

#. type: Table
#: src/plasma/qtplasmac.adoc:4384
#, no-wrap
msgid ""
"Specify <<plasma:hole-cutting,hole>> diameter for +\n"
