msgstr "--help"

#. type: Plain text
#: src/man/man1/halshow.1.adoc:14
msgid "Displays the help"
msgstr "Zeigt die Hilfe an"

#. type: Labeled list
#: src/man/man1/halshow.1.adoc:15
#, no-wrap
msgid "--fformat _format_string_for_float_"
msgstr "--fformat _Format_Zeichenkette_für_float_"

#. type: Plain text
#: src/man/man1/halshow.1.adoc:16
msgid "Float format string"
msgstr "Gleitkomma (engl. float) formatierte Zeichenkette"

#. type: Labeled list
#: src/man/man1/halshow.1.adoc:17
#, no-wrap
msgid "--iformat _format_string_for_int_"
msgstr "--iformat _Format_Zeichenkette_für_int_"

