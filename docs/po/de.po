msgstr "*gmoccapy.jog.axis.jog-z-plus* _(bit IN)_"

#. type: NOTE
#: src/gui/gmoccapy.adoc:748
msgid "*gmoccapy.jog.axis.jog-z-minus* _(bit IN)_"
msgstr "*gmoccapy.jog.axis.jog-z-minus* _(bit IN)_"

#. type: NOTE
#: src/gui/gmoccapy.adoc:750
msgid "If you use a 4 axes configuration, there will be two additional pins:"
msgstr ""
"Wenn Sie eine 4-Achsen-Konfiguration verwenden, gibt es zwei zusätzliche "
"Pins:"

#. type: NOTE
#: src/gui/gmoccapy.adoc:752
msgid "*gmoccapy.jog.jog-<your fourth axis letter >-plus* _(bit IN)_"
msgstr "*gmoccapy.jog.jog-<Ihr Buchstabe der vierten Achse >-plus* _(bit IN)_"

#. type: NOTE
#: src/gui/gmoccapy.adoc:753
msgid "*gmoccapy.jog.jog-<your fourth axis letter >-minus* _(bit IN)_"
msgstr "*gmoccapy.jog.jog-<Ihr Buchstabe der vierten Achse >-minus* _(bit IN)_"

