msgstr "**joint.**_N_**.coarse-pos-cmd** OUT FLOAT *(DEBUG)*"

#. type: Labeled list
#: src/man/man9/motion.9.adoc:340
#, no-wrap
msgid "**joint.**_N_**.error** OUT BIT *(DEBUG)*"
msgstr "**joint.**_N_**.error** OUT BIT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:342
msgid ""
"TRUE when t*his joint has encountered an error, such as a limit switch "
"closing."
msgstr ""
"TRUE, wenn bei diesem Gelenk ein Fehler aufgetreten ist, z. B. der Kontakt "
"eines Endschalters."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:342
#, no-wrap
msgid "**joint.**_N_**.f-error** OUT FLOAT *(DEBUG)*"
msgstr "**joint.**_N_**.f-error** OUT FLOAT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:344
