#. type: Title =
#: src/man/man1/puma560gui.1.adoc:1
#, no-wrap
msgid "puma560gui(1)"
msgstr "puma560gui(1)"

#. type: Plain text
#: src/man/man1/puma560gui.1.adoc:6
msgid "puma560gui - Vismach Virtual Machine GUI"
