msgstr "**joint.**_N_**.backlash-filt** OUT FLOAT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:337
msgid ""
"Backlash or screw compensation filtered value (respecting motion limits)."
msgstr ""
"Spiel oder Spindelkompensation gefilterter Wert (unter Berücksichtigung der "
"Bewegungsgrenzen)."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:337
#, no-wrap
msgid "**joint.**_N_**.backlash-vel** OUT FLOAT *(DEBUG)*"
msgstr "**joint.**_N_**.backlash-vel** OUT FLOAT *(DEBUG)*"

#. type: Plain text
#: src/man/man9/motion.9.adoc:339
msgid "Backlash or screw compensation velocity."
msgstr "Spiel oder Schraubenausgleichsgeschwindigkeit."

#. type: Labeled list
#: src/man/man9/motion.9.adoc:339
#, no-wrap
