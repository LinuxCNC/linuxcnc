msgstr "Bit 4"

#. type: Table
#: src/hal/rtcomps.adoc:659 src/hal/rtcomps.adoc:700
#, no-wrap
msgid "Bit 3"
msgstr "Bit 3"

#. type: Labeled list
#: src/hal/rtcomps.adoc:659 src/hal/rtcomps.adoc:700
#: src/man/man3/hm2_uart_setup.3.adoc:38
#, no-wrap
msgid "Bit 2"
msgstr "Bit 2"

#. type: Table
#: src/hal/rtcomps.adoc:659 src/hal/rtcomps.adoc:700
#, no-wrap
msgid "Bit 1"
msgstr "Bit 1"

#. type: Labeled list
#: src/hal/rtcomps.adoc:659 src/hal/rtcomps.adoc:700
