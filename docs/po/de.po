"'iocontrol.0.coolant-mist' (bit, out) TRUE wenn Kühlmittelnebel angefordert "
"wird."

#. type: Plain text
#: src/config/core-components.adoc:314
msgid ""
"'iocontrol.0.emc-enable-in' (bit, in) Should be driven FALSE when an "
"external E-Stop condition exists."
msgstr ""
"'iocontrol.0.emc-enable-in' (bit, in) Sollte FALSE sein, wenn eine externe "
"Not-Aus-Bedingung vorliegt."

#. type: Plain text
#: src/config/core-components.adoc:315
msgid ""
"'iocontrol.0.tool-change' (bit, out) TRUE when a tool change is requested."
msgstr ""
"'iocontrol.0.tool-change' (bit, out) TRUE wenn ein Werkzeugwechsel "
"angefordert wird."

#. type: Plain text
#: src/config/core-components.adoc:316
msgid ""
"'iocontrol.0.tool-changed' (bit, in) Should be driven TRUE when a tool "
"change is completed."
msgstr ""
"'iocontrol.0.tool-changed' (bit, in) Sollte TRUE sein, wenn ein "
"Werkzeugwechsel abgeschlossen ist."

#. type: Plain text
#: src/config/core-components.adoc:317
msgid "'iocontrol.0.tool-number' (s32, out) The current tool number."
msgstr "'iocontrol.0.tool-number' (s32, out) Die aktuelle Werkzeugnummer."

#. type: Plain text
#: src/config/core-components.adoc:318
msgid ""
"'iocontrol.0.tool-prep-number' (s32, out) The number of the next tool, from "
"the RS274NGC T-word."
msgstr ""
"'iocontrol.0.tool-prep-number' (s32, out) Die Nummer des nächsten Werkzeugs, "
"aus dem RS274NGC T-Wort."

#. type: Plain text
#: src/config/core-components.adoc:319
msgid ""
"'iocontrol.0.tool-prepare' (bit, out) TRUE when a tool prepare is requested."
msgstr ""
"'iocontrol.0.tool-prepare' (bit, out) TRUE wenn eine Werkzeugvorbereitung "
"angefordert wird."

#. type: Plain text
#: src/config/core-components.adoc:320
msgid ""
"'iocontrol.0.tool-prepared' (bit, in) Should be driven TRUE when a tool "
"prepare is completed."
msgstr ""
"'iocontrol.0.tool-prepared' (bit, in) Sollte auf TRUE gesetzt werden, wenn "
"eine Werkzeugvorbereitung abgeschlossen ist."

#. type: Plain text
#: src/config/core-components.adoc:321
msgid ""
"'iocontrol.0.user-enable-out' (bit, out) FALSE when an internal E-Stop "
"condition exists."
msgstr ""
"'iocontrol.0.user-enable-out' (bit, out) FALSE, wenn eine interne Not-Aus-"
"Bedingung vorliegt."

#. type: Plain text
#: src/config/core-components.adoc:322
msgid ""
"'iocontrol.0.user-request-enable' (bit, out) TRUE when the user has "
"requested that E-Stop be cleared."
msgstr ""
"'iocontrol.0.user-request-enable' (bit, out) TRUE, wenn der Benutzer die "
"Freigabe des Notausschalters angefordert hat."

