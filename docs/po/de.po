msgstr "`qtversaprobe.probeheight` (HAL_FLOAT)"

#. type: CAUTION
#: src/gui/qtdragon.adoc:917 src/gui/qtdragon.adoc:1212
msgid "The toolsetter probe switch height. Reflects screen entry."
msgstr ""
"Die Höhe des Schalters für die Werkzeugsonde. Spiegelt die Eingabe am "
"Bildschirm wider."

#. type: Labeled list
#: src/gui/qtdragon.adoc:917 src/gui/qtdragon.adoc:1212
#, no-wrap
