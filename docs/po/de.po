msgstr "images/xyz_buttons.png"

#. type: Title ===
#: src/gui/pyvcp-examples.adoc:172
#, no-wrap
msgid "Make Connections"
msgstr "Verbindungen herstellen"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:176
msgid ""
"To make the connections needed open up your custom_postgui.hal file and add "
"the following."
msgstr ""
"Um die erforderlichen Verbindungen herzustellen, öffnen Sie die Datei "
"custom_postgui.hal, und fügen Sie Folgendes hinzu."

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:182
#, no-wrap
msgid ""
"# connect the X PyVCP buttons\n"
"net my-jogxminus halui.axis.x.minus <= pyvcp.x-minus\n"
"net my-jogxplus halui.axis.x.plus <= pyvcp.x-plus\n"
msgstr ""
"# Verbinden Sie die X-PyVCP-Tasten\n"
"net my-jogxminus halui.axis.x.minus <= pyvcp.x-minus\n"
"net my-jogxplus halui.axis.x.plus <= pyvcp.x-plus\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:186
#, no-wrap
msgid ""
"# connect the Y PyVCP buttons\n"
"net my-jogyminus halui.axis.y.minus <= pyvcp.y-minus\n"
"net my-jogyplus halui.axis.y.plus <= pyvcp.y-plus\n"
msgstr ""
"# Verbinden der Y-PyVCP-Tasten\n"
"net my-jogyminus halui.axis.y.minus <= pyvcp.y-minus\n"
"net my-jogyplus halui.axis.y.plus <= pyvcp.y-plus\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:190
#, no-wrap
msgid ""
"# connect the Z PyVCP buttons\n"
"net my-jogzminus halui.axis.z.minus <= pyvcp.z-minus\n"
"net my-jogzplus halui.axis.z.plus <= pyvcp.z-plus\n"
msgstr ""
"# Verbinden der Z-PyVCP-Tasten\n"
"net my-jogzminus halui.axis.z.minus <= pyvcp.z-minus\n"
"net my-jogzplus halui.axis.z.plus <= pyvcp.z-plus\n"

#. type: delimited block -
#: src/gui/pyvcp-examples.adoc:193
#, no-wrap
msgid ""
"# connect the PyVCP jog speed slider\n"
"net my-jogspeed halui.axis.jog-speed <= pyvcp.jog-speed-f\n"
msgstr ""
"# den PyVCP-Jog-Speed-Schieberegler anschließen\n"
"net my-jogspeed halui.axis.jog-speed <= pyvcp.jog-speed-f\n"

#. type: Plain text
#: src/gui/pyvcp-examples.adoc:199
msgid ""
"After resetting the E-Stop and putting it into jog mode and moving the jog "
"speed slider in the PyVCP panel to a value greater than zero the PyVCP jog "
"buttons should work. You can not jog when running a G-code file or while "
"paused or while the MDI tab is selected."
msgstr ""
"Nachdem Sie den Notaus (engl. E-Stop) zurückgesetzt und in den Jog-Modus "
"versetzt haben und den Schieberegler für die Jpggeschwindigkeit im PyVCP-"
"Bedienfeld auf einen Wert größer als Null gestellt haben, sollten die PyVCP-"
"Tipptasten funktionieren. Sie können nicht joggen, wenn eine G-Code-Datei "
"ausgeführt wird, wenn das Programm pausiert oder wenn die Registerkarte MDI "
"ausgewählt ist."

#. type: Title ==
