msgstr "images/Section_Display_Grid.png"

#. type: Plain text
#: src/ladder/classic-ladder.adoc:937
msgid "Now click on the N.O. input in the Editor Window."
msgstr "Klicken Sie nun auf den N.O.-Eingang im Editorfenster."

#. type: Target for macro image
#: src/ladder/classic-ladder.adoc:940
#, no-wrap
msgid "images/Editor_NO_Input.png"
msgstr "images/Editor_NO_Input.png"

#. type: Plain text
#: src/ladder/classic-ladder.adoc:943
msgid ""
"Now click in the upper left grid to place the N.O. Input into the ladder."
msgstr ""
"Klicken Sie nun in das obere linke Raster, um den N.O.-Eingang in der Leiter "
"zu platzieren."

#. type: Positional ($1) AttributeList argument for macro 'image'
#: src/ladder/classic-ladder.adoc:945 src/ladder/classic-ladder.adoc:946
#, no-wrap
