msgstr "B<joyhandle>\\&.I<N>\\&.B<power> float rw (Voreinstellung: I<2\\&.0>)"

#. type: Plain text
#: man/man9/joyhandle.9:83
msgid "B<joyhandle>\\&.I<N>\\&.B<deadband> float rw (default: I<0\\&.>)"
msgstr ""
