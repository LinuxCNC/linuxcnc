"        super(StateLed, self).__init__(parent)  # <3>\n"
"        self.has_hal_pins = False               # <4>\n"
"        self.setState(False)                    # <5>\n"
"        self.is_estopped = False\n"
"        self.is_on = False\n"
"        self.invert_state = False\n"
