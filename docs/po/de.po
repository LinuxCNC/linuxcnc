#. type: Plain text
#: man/man9/comp.9:38
msgid "B<comp>\\&.I<N> (requires a floating-point thread)"
msgstr "B<comp>\\&.I<N> (erfordert einen Gleitkomma-Thread)"

#. type: Plain text
#: man/man9/comp.9:40
msgid "Update the comparator"
msgstr "Aktualisieren des Komparators"

