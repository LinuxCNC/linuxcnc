msgstr ".7i77.0.0.output-__NN__ (bit out)"

#. type: Plain text
#: src/man/man9/sserial.9.adoc:247
msgid ""
"(_NN_ = 0 to 15). 16 digital outputs. The sense of the signal can be set via "
"a parameter."
msgstr ""
"(_NN_ = 0 bis 15). 16 digitale Ausgänge. Der Sinn (engl. sense) des Signals "
"kann über einen Parameter eingestellt werden."

