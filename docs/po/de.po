"3-input AND and XOR gates: `logic.2.and`, `logic.2.xor`, `logic.2.in-00`, "
"`logic.2.in-01`, `logic.2.in-02`"

#. type: Title ===
#: src/hal/comp.adoc:719
#, no-wrap
msgid "General Functions"
msgstr "Allgemeine Funktionen"

#. type: Plain text
#: src/hal/comp.adoc:723
msgid ""
"This example shows how to call functions from the main function.  It also "
"shows how to pass reference of HAL pins to those functions."
msgstr ""
"Dieses Beispiel zeigt, wie man Funktionen von der Hauptfunktion aus "
"aufruft.  Es zeigt auch, wie die Referenz von HAL-Pins an diese Funktionen "
"übergeben werden kann."

#. type: delimited block -
#: src/hal/comp.adoc:730
#, no-wrap
msgid ""
"component example;\n"
"pin in s32 in;\n"
"pin out bit out1;\n"
"pin out bit out2;\n"
msgstr ""
"component example;\n"
"pin in s32 in;\n"
"pin out bit out1;\n"
"pin out bit out2;\n"

#. type: delimited block -
#: src/hal/comp.adoc:735
#, no-wrap
msgid ""
"option period no;\n"
"function _;\n"
"license \"GPL\";\n"
";;\n"
msgstr ""
"option period no;\n"
"function _;\n"
"license \"GPL\";\n"
";;\n"

#. type: delimited block -
#: src/hal/comp.adoc:740
#, no-wrap
msgid ""
"// general pin set true function\n"
"void set(hal_bit_t *p){\n"
"    *p = 1;\n"
"}\n"
msgstr ""
"// allgemeine Pin Set True Funktion\n"
"void set(hal_bit_t *p){\n"
"    *p = 1;\n"
"}\n"

#. type: delimited block -
#: src/hal/comp.adoc:745
#, no-wrap
msgid ""
"// general pin set false function\n"
"void unset(hal_bit_t *p){\n"
"    *p = 0;\n"
"}\n"
msgstr ""
"// allgemeine Pin Set False Funktion\n"
"void unset(hal_bit_t *p){\n"
"    *p = 0;\n"
"}\n"

#. type: delimited block -
#: src/hal/comp.adoc:759
#, no-wrap
msgid ""
"//main function\n"
"FUNCTION(_) {\n"
"    if (in < 0){\n"
"        set(&out1);\n"
"        unset(&out2);\n"
"    }else if (in >0){\n"
"        unset(&out2);\n"
"        set(&out2);\n"
"    }else{\n"
"        unset(&out1);\n"
"        unset(&out2);\n"
"    }\n"
"}\n"
msgstr ""
"//Haupt-Funktion (engl. main)\n"
"FUNCTION(_) {\n"
"    if (in < 0){\n"
"        set(&out1);\n"
"        unset(&out2);\n"
"    }else if (in >0){\n"
"        unset(&out2);\n"
"        set(&out2);\n"
"    }else{\n"
"        unset(&out1);\n"
"        unset(&out2);\n"
"    }\n"
"}\n"

#. type: Plain text
#: src/hal/comp.adoc:762
msgid ""
"This component uses two general function to manipulate a HAL bit pin "
"referenced to it."
msgstr ""
"Diese Komponente verwendet zwei allgemeine Funktionen, um einen HAL-Bit-Pin "
"zu manipulieren, auf den sie referenziert ist."

