#. type: Title ===
#: src/plasma/plasma-cnc-primer.adoc:410
#, no-wrap
msgid "Ohmic Sensing (input)"
msgstr "Ohmsche Sensorik (engl. ohmic sensing) (Eingang)"

#. type: NOTE
#: src/plasma/plasma-cnc-primer.adoc:413
msgid ""
"Take care to follow the <<ohmic-sensing,ohmic sensing>> schematic shown "
"previously."
msgstr ""
"Beachten Sie das zuvor gezeigte Schema zu <<ohmic-sensing,ohmic sensing>>."

#. type: NOTE
#: src/plasma/plasma-cnc-primer.adoc:414
msgid ""
"An isolated power supply triggers a relay when the torch shield contacts the "
