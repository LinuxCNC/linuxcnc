#. type: Plain text
#: src/gui/gstat.adoc:139
#, no-wrap
msgid ""
"QtVCP extends GStat, so must be loaded differently but all the messages are available in QtVCP.\n"
"This handler file assumes there are three QLabels named:"
msgstr ""
"QtVCP erweitert GStat, muss also anders geladen werden, aber alle Meldungen sind in QtVCP verfügbar.\n"
"Diese Handler-Datei geht davon aus, dass es drei QLabels mit Namen gibt:"

#. type: delimited block -
#: src/gui/gstat.adoc:150
#, no-wrap
msgid ""
"from qtvcp.core import Status\n"
"GSTAT = Status()\n"
msgstr ""
"from qtvcp.core import Status\n"
"GSTAT = Status()\n"

