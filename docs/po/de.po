#, no-wrap
msgid "INI File"
msgstr "INI-Datei"

#. type: Title ==
#: src/config/ini-config.adoc:13 src/config/ini-config.adoc:24
#: src/config/ini-config.adoc:59 src/config/ini-config.adoc:84
#: src/config/ini-config.adoc:124 src/config/ini-config.adoc:176
