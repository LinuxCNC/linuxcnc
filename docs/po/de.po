msgid "B<axistest>\\&.I<N>\\&.B<dir> s32 in"
msgstr "B<axistest>\\&.I<N>\\&.B<dir> s32 in"

#. type: Plain text
#: man/man9/axistest.9:71 man/man9/steptest.9:76
msgid ""
"Direction from central point to test: 0 = both, 1 = positive, 2 = negative"
msgstr ""
"Richtung vom zentralen Punkt zum Test: 0 = beides, 1 = positiv, 2 = negativ"

