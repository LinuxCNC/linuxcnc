#, no-wrap
msgid "rtapi_strlcpy(3)"
msgstr "rtapi_strlcpy(3)"

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:6
msgid "rtapi_strlcpy - RTAPI string manipulation functions"
msgstr "rtapi_strlcpy - RTAPI-Funktionen zur Bearbeitung von Zeichenketten"

#. type: delimited block -
#: src/man/man3/rtapi_strlcpy.3.adoc:12
#, no-wrap
msgid "#include <rtapi_string.h>\n"
msgstr "#include <rtapi_string.h>\n"

#. type: delimited block -
#: src/man/man3/rtapi_strlcpy.3.adoc:17
#, no-wrap
msgid ""
"size_t rtapi_strlcpy(char *dst, const char *src, size_t sz);\n"
"#define rtapi_strxcpy(dst, src) ...\n"
"size_t rtapi_strlcat(char *dst, const char *src, size_t sz);\n"
"#define rtapi_strxcat(dst, src) ...\n"
msgstr ""
"size_t rtapi_strlcpy(char *dst, const char *src, size_t sz);\n"
"#define rtapi_strxcpy(dst, src) ...\n"
"size_t rtapi_strlcat(char *dst, const char *src, size_t sz);\n"
"#define rtapi_strxcat(dst, src) ...\n"

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:23
msgid ""
"rtapi_strlcpy will copy at most 'sz' chars from 'src' to 'dst'.  Always "
"leaves 'dst' NUL-terminated except if 'sz' is 0."
msgstr ""
"rtapi_strlcpy kopiert maximal 'sz' Zeichen von 'src' nach 'dst'.  Lässt "
"'dst' immer NUL-terminiert, außer wenn 'sz' 0 ist."

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:27
msgid ""
"rtapi_strxcpy(dst, src) checks that 'dst' is an array with known size, and "
"calls rtapi_strlcpy(dst, src, sizeof(dst)). If it is not an array with a "
"known size, it is a (possibly cryptic!) syntax error."
msgstr ""
"rtapi_strxcpy(dst, src) überprüft, ob 'dst' ein Array mit bekannter Größe "
"ist, und ruft rtapi_strlcpy(dst, src, sizeof(dst)) auf. Wenn es sich nicht "
"um ein Array mit bekannter Größe handelt, liegt ein (möglicherweise "
"kryptischer!) Syntaxfehler vor."

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:31
msgid ""
"rtapi_strlcat will append characters from 'src' to 'dst', stopping when the "
"end of 'src' is reached, or 'dst' uses 'sz'-many bytes of storage including "
"the tailing null."
msgstr ""
"rtapi_strlcat hängt Zeichen von 'src' an 'dst' an und stoppt, wenn das Ende "
"von 'src' erreicht ist, oder 'dst' verwendet 'sz'-viele Speicherbytes, "
"einschließlich der terminalen 0."

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:35
msgid ""
"rtapi_strxcat(dst, src) checks that 'dst' is an array with known size, and "
"calls rtapi_strlcat(dst, src, sizeof(dst)). If it is not an array with a "
"known size, it is a (possibly cryptic!) syntax error."
msgstr ""
"rtapi_strxcpy(dst, src) überprüft, ob 'dst' ein Array mit bekannter Größe "
"ist, und ruft rtapi_strlcpy(dst, src, sizeof(dst)) auf. Wenn es sich nicht "
"um ein Array mit bekannter Größe handelt, liegt ein (möglicherweise "
"kryptischer!) Syntaxfehler vor."

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:41
msgid ""
"The total length of the string strlcpy or strlcat tried to create.  For "
"strlcpy() that means the length of 'src'.  If the return value is greater "
"than or equal to 'sz', the result was truncated."
msgstr ""
"Die Gesamtlänge der Zeichenkette, die strlcpy oder strlcat zu erzeugen "
"versucht.  Bei strlcpy() ist das die Länge von 'src'. Wenn der Rückgabewert "
"größer oder gleich 'sz' ist, wurde das Ergebnis abgeschnitten."

#. type: Plain text
#: src/man/man3/rtapi_strlcpy.3.adoc:44
msgid "strlcpy(3bsd), strlcat(3bsd)"
msgstr "strlcpy(3bsd), strlcat(3bsd)"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:8
msgid "rtapi_task_new, rtapi_task_delete - create a realtime task"
msgstr "rtapi_task_new, rtapi_task_delete - Erstellen eines Echtzeit-Tasks"

#. type: delimited block -
#: src/man/man3/rtapi_task_new.3.adoc:16
#, no-wrap
msgid ""
"int rtapi_task_new(void (*_taskcode_)(void*), void *_arg_, int _prio_,\n"
"                   unsigned long _stacksize_, int _uses_fp_);\n"
"int rtapi_task_delete(int _task_id_);\n"
msgstr ""
"int rtapi_task_new(void (*_taskcode_)(void*), void *_arg_, int _prio_,\n"
"                   unsigned long _stacksize_, int _uses_fp_);\n"
"int rtapi_task_delete(int _task_id_);\n"

#. type: Labeled list
#: src/man/man3/rtapi_task_new.3.adoc:20
#, no-wrap
msgid "taskcode"
msgstr "taskcode"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:22
msgid "A pointer to the function to be called when the task is started"
msgstr ""
"Ein Zeiger auf die Funktion, die beim Starten der Aufgabe aufgerufen wird"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:24
msgid ""
"An argument to be passed to the _taskcode_ function when the task is started"
msgstr ""
"Ein Argument, das an die Funktion _taskcode_ übergeben wird, wenn die "
"Aufgabe gestartet wird"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:26
msgid "A task priority value returned by *rtapi_prio_xxxx*"
msgstr "Ein von *rtapi_prio_xxxx* zurückgegebener Wert für die Task-Priorität"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:28
msgid "A flag that tells the OS whether the task uses floating point or not."
msgstr ""
"Ein Flag, das dem Betriebssystem mitteilt, ob der Task Gleitkomma verwendet "
"oder nicht."

#. type: Labeled list
#: src/man/man3/rtapi_task_new.3.adoc:28
#: src/man/man3/rtapi_task_pause.3.adoc:19
#: src/man/man3/rtapi_task_start.3.adoc:16
#, no-wrap
msgid "task_id"
msgstr "task_id"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:30
#: src/man/man3/rtapi_task_start.3.adoc:18
msgid "A task ID returned by a previous call to *rtapi_task_new*"
msgstr ""
"Eine Task-ID, die durch einen früheren Aufruf von *rtapi_task_new* "
"zurückgegeben wurde"

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:37
msgid ""
"*rtapi_task_new* creates but does not start a realtime task.  The task is "
"created in the \"paused\" state.  To start it, call either "
"*rtapi_task_start* for periodic tasks, or *rtapi_task_resume* for free-"
"running tasks."
msgstr ""
"*rtapi_task_new* erstellt einen Echtzeit-Task, startet ihn aber nicht.  Der "
"Task wird im \"paused\" Zustand erstellt.  Um diesen zu starten, rufen Sie "
"entweder *rtapi_task_start* für periodische Tasks auf oder "
"*rtapi_task_resume* für freilaufende Tasks."

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:41
#: src/man/man3/rtapi_task_start.3.adoc:29
msgid "Call only from within init/cleanup code, not from realtime tasks."
msgstr "Aufruf nur aus dem Init/Cleanup-Code, nicht aus Echtzeit-Tasks."

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:47
msgid ""
"On success, returns a positive integer task ID.  This ID is used for all "
"subsequent calls that need to act on the task.  On failure, returns an RTAPI "
"status code."
msgstr ""
"Gibt bei Erfolg eine positive ganzzahlige Aufgaben-ID zurück.  Diese ID wird "
"für alle nachfolgenden Aufrufe verwendet, die auf die Aufgabe reagieren "
"müssen.  Im Fehlerfall wird ein RTAPI-Statuscode zurückgegeben."

#. type: Plain text
#: src/man/man3/rtapi_task_new.3.adoc:51
msgid ""
"rtapi_prio(3), rtapi_task_start(3), rtapi_task_wait(3), rtapi_task_resume(3)"
msgstr ""
"rtapi_prio(3), rtapi_task_start(3), rtapi_task_wait(3), rtapi_task_resume(3)"

#. type: Title =
#: src/man/man3/rtapi_task_pause.3.adoc:3
#, no-wrap
msgid "rtapi_task_pause(3)"
msgstr "rtapi_task_pause(3)"

#. type: Plain text
#: src/man/man3/rtapi_task_pause.3.adoc:8
msgid "rtapi_task_pause, rtapi_task_resume - pause and resume real-time tasks"
msgstr ""
"rtapi_task_pause, rtapi_task_resume - Anhalten und Fortsetzen von "
"Echtzeitaufgaben"

#. type: delimited block -
#: src/man/man3/rtapi_task_pause.3.adoc:15
#, no-wrap
msgid ""
"void rtapi_task_pause(int _task_id_);\n"
"void rtapi_task_resume(int _task_id_);\n"
msgstr ""
"void rtapi_task_pause(int _task_id_);\n"
"void rtapi_task_resume(int _task_id_);\n"

#. type: Plain text
#: src/man/man3/rtapi_task_pause.3.adoc:21
msgid ""
"An RTAPI task identifier returned by an earlier call to *rtapi_task_new*."
msgstr ""
"Eine RTAPI-Task-Kennung, die durch einen früheren Aufruf von "
"*rtapi_task_new* zurückgegeben wurde."

#. type: Plain text
#: src/man/man3/rtapi_task_pause.3.adoc:26
msgid ""
"*rtapi_task_resume* starts a task in free-running mode.  The task must be in "
"the \"paused\" state."
msgstr ""
"*rtapi_task_resume* startet eine Aufgabe im freilaufenden Modus.  Die "
"Aufgabe muss sich im Zustand \"pausiert\" befinden."

#. type: Plain text
#: src/man/man3/rtapi_task_pause.3.adoc:28
msgid "A free running task runs continuously until either:"
msgstr ""
"Ein frei ausgeführter Task wird kontinuierlich ausgeführt, bis entweder:"

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:32
msgid ""
"It is prempted by a higher priority task.  It will resume as soon as the "
"higher priority task releases the CPU."
msgstr ""
"dieser durch eine Aufgabe mit höherer Priorität ausgelagert wird. Er wird "
"fortgesetzt, sobald die Aufgabe mit höherer Priorität die CPU freigibt."

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:34
msgid ""
"It calls a blocking function, like *rtapi_sem_take*.  It will resume when "
"the function unblocks."
msgstr ""
"Er eine blockierende Funktion aufruft, wie *rtapi_sem_take*. Er wird "
"fortgesetzt, wenn die Funktion die Blockierung aufhebt."

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:36
msgid ""
"It is returned to the \"paused\" state by *rtapi_task_pause*.  May be called "
"from init/cleanup code, and from within realtime tasks."
msgstr ""
"Er durch *rtapi_task_pause* in den \"paused\"-Zustand zurückversetzt wird.  "
"Kann von init/cleanup-Code und von Echtzeit-Tasks aus aufgerufen werden."

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:44
msgid ""
"*rtapi_task_pause* causes a task to stop execution and change to the "
"\"paused\" state. The task can be free-running or periodic. Note that "
"*rtapi_task_pause* may called from any task, or from init or cleanup code, "
"not just from the task that is to be paused. The task will resume execution "
"when either *rtapi_task_resume* or *rtapi_task_start* (depending on whether "
"this is a free-running or periodic task) is called."
msgstr ""
"*rtapi_task_pause* veranlasst eine Task, ihre Ausführung zu beenden und in "
"den Zustand \"pausiert\" zu wechseln. Der Task kann freilaufend oder "
"periodisch sein. Beachten Sie, dass *rtapi_task_pause* von jeder beliebigen "
"Task oder von init- oder cleanup-Code aufgerufen werden kann, nicht nur von "
"der Task, die pausiert werden soll. Die Task wird wieder aufgenommen, wenn "
"entweder *rtapi_task_resume* oder *rtapi_task_start* (je nachdem, ob es sich "
"um eine freilaufende oder periodische Task handelt) aufgerufen wird."

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:52
msgid "An RTAPI status code."
msgstr "Ein RTAPI-Statuscode."

#. type: arabic
#: src/man/man3/rtapi_task_pause.3.adoc:55
msgid "rtapi_task_new(3), rtapi_task_start(3)"
msgstr "rtapi_task_new(3), rtapi_task_start(3)"

#. type: Title =
#: src/man/man3/rtapi_task_self.3.adoc:1
#, no-wrap
msgid "rtapi_task_self(3)"
msgstr "rtapi_task_self(3)"

#. type: Plain text
#: src/man/man3/rtapi_task_self.3.adoc:6
msgid "rtapi_task_self - Retrieve ID of current task"
msgstr "rtapi_task_self - Abrufen der ID der aktuellen Aufgabe"

#. type: delimited block -
#: src/man/man3/rtapi_task_self.3.adoc:12
#, no-wrap
msgid "void rtapi_task_self();\n"
msgstr "void rtapi_task_self();\n"

#. type: Plain text
#: src/man/man3/rtapi_task_self.3.adoc:18
msgid ""
"*rtapi_task_self* retrieves the current task, or -EINVAL if not in a "
"realtime task (e.g., in startup or shutdown code)."
msgstr ""
"*rtapi_task_self* ruft den aktuellen Task ab, oder -EINVAL, wenn er sich "
"nicht in einem Echtzeit-Task befindet (z.B. im Startup- oder Shutdown-Code)."

#. type: Plain text
#: src/man/man3/rtapi_task_self.3.adoc:26
msgid "The task number previously returned by *rtapi_task_new* or -EINVAL."
msgstr "Die zuvor von *rtapi_task_new* zurückgegebene Tasknummer oder -EINVAL."

#. type: Title =
#: src/man/man3/rtapi_task_start.3.adoc:1
#, no-wrap
msgid "rtapi_task_start(3)"
msgstr "rtapi_task_start(3)"

#. type: Plain text
#: src/man/man3/rtapi_task_start.3.adoc:6
msgid "rtapi_task_start - start a realtime task in periodic mode"
msgstr "rtapi_task_start - Start eines Echtzeit-Tasks im periodischen Modus"

#. type: delimited block -
#: src/man/man3/rtapi_task_start.3.adoc:12
#, no-wrap
msgid "int rtapi_task_start(int task_id, unsigned long period_nsec);\n"
msgstr "int rtapi_task_start(int task_id, unsigned long period_nsec);\n"

#. type: Labeled list
#: src/man/man3/rtapi_task_start.3.adoc:18
#, no-wrap
msgid "period_nsec"
msgstr "period_nsec"

#. type: Plain text
#: src/man/man3/rtapi_task_start.3.adoc:20
msgid "The clock period in nanoseconds between iterations of a periodic task"
msgstr ""
"Die Taktperiode in Nanosekunden zwischen den Iterationen einer periodischen "
"Aufgabe"

#. type: Plain text
#: src/man/man3/rtapi_task_start.3.adoc:25
msgid ""
"*rtapi_task_start* starts a task in periodic mode.  The task must be in the "
"_paused_ state."
msgstr ""
"*rtapi_task_start* startet eine Task im periodischen Modus.  Der Task muss "
"sich im Zustand _paused_ befinden."

#. type: Plain text
#: src/man/man3/rtapi_task_start.3.adoc:33
msgid "Returns an RTAPI status code."
msgstr "Gibt einen RTAPI-Statuscode zurück."

#. type: Plain text
#: src/man/man3/rtapi_task_start.3.adoc:36
msgid "rtapi_task_new(3), rtapi_task_pause(3), rtapi_task_resume(3)"
msgstr "rtapi_task_new(3), rtapi_task_pause(3), rtapi_task_resume(3)"

#. type: Title =
#: src/man/man3/rtapi_task_wait.3.adoc:1
#, no-wrap
msgid "rtapi_task_wait(3)"
msgstr "rtapi_task_wait(3)"

#. type: Plain text
#: src/man/man3/rtapi_task_wait.3.adoc:6
msgid "rtapi_task_wait - suspend execution of this periodic task"
msgstr "rtapi_task_wait - Aussetzen der Ausführung dieser periodischen Aufgabe"

#. type: delimited block -
#: src/man/man3/rtapi_task_wait.3.adoc:12
#, no-wrap
msgid "void rtapi_task_wait();\n"
msgstr "void rtapi_task_wait();\n"

#. type: Plain text
#: src/man/man3/rtapi_task_wait.3.adoc:18
msgid ""
"*rtapi_task_wait* suspends execution of the current task until the next "
"period.  The task must be periodic. If not, the result is undefined."
msgstr ""
"*rtapi_task_wait* unterbricht die Ausführung der aktuellen Aufgabe bis zur "
"nächsten Periode.  Der Task muss periodisch sein.  Wenn nicht, ist das "
"Ergebnis undefiniert."

#. type: Plain text
#: src/man/man3/rtapi_task_wait.3.adoc:22
msgid "Call only from within a periodic realtime task."
msgstr "Aufruf nur aus einer periodischen Echtzeit-Task heraus."

#. type: Plain text
#: src/man/man3/rtapi_task_wait.3.adoc:29
msgid "rtapi_task_start(3), rtapi_task_pause(3)"
msgstr "rtapi_task_start(3), rtapi_task_pause(3)"

