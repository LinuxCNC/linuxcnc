#, no-wrap
msgid "TRISTATE_FLOAT"
msgstr "TRISTATE_FLOAT"

#. type: Plain text
#: man/man9/tristate_float.9:32
msgid ""
"tristate_float - Place a signal on an I/O pin only when enabled, similar to "
"a tristate buffer in electronics"
msgstr ""
"tristate_float - Legt ein Signal nur dann auf einen E/A-Pin, wenn er "
"aktiviert ist, ähnlich wie ein Tristate-Puffer in der Elektronik"

