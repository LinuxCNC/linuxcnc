#. type: Labeled list
#: src/gui/qtvcp-widgets.adoc:2046
#, no-wrap
msgid "*`originOffset_option`*"
msgstr "*`originOffset_option`*"

#. type: Plain text
#: src/gui/qtvcp-widgets.adoc:2048
msgid "Sets up the origin display/editor dialog."
msgstr "Richtet das Dialogfeld für die Anzeige/Editierung des Ursprungs ein."

#. type: Labeled list
