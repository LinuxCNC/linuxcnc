msgid ""
"*Import `Player` module*\n"
"Add this Python code to your import section:"
msgstr ""
"*Import `Player` module* \n"
"Fügen Sie diesen Python-Code in Ihren Import-Abschnitt ein:"

#. type: delimited block -
#: src/gui/qtvcp-libraries.adoc:1225
#, no-wrap
msgid "from qtvcp.lib.audio_player import Player\n"
msgstr "from qtvcp.lib.audio_player import Player\n"

#. type: Plain text
#: src/gui/qtvcp-libraries.adoc:1229
#, no-wrap
msgid ""
"*Instantiate `Player` module*\n"
"Add this Python code to your instantiated section:"
msgstr ""
