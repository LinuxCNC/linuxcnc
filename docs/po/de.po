#. type: Title =
#: src/man/man1/qtplasmac_gcode.1.adoc:1
#, no-wrap
msgid "qtplasmac_gcode(1)"
msgstr "qtplasmac_gcode(1)"

#. type: Plain text
#: src/man/man1/qtplasmac_gcode.1.adoc:6
msgid ""
"qtplasmac_gcode - Python script shipping with Plasmac, a Plasma cutting "
"system."
msgstr ""
"qtplasmac_gcode - Python-Skript von PlasmaC, ein System zum Schneiden mit "
