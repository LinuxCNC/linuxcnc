"#!/bin/bash\n"
"eog /home/john/linuxcnc/nc_files/message.png\n"
"exit 0\n"
msgstr ""
"#!/bin/bash\n"
"eog /home/john/linuxcnc/nc_files/message.png\n"
"exit 0\n"

#. type: Plain text
#: src/gcode/m-code.adoc:799
msgid ""
"To display a graphic message and continue processing the G-code file suffix "
"an ampersand to the command."
msgstr ""
"Um eine grafische Meldung anzuzeigen und die Bearbeitung der G-Code-Datei "
"fortzusetzen, fügen Sie dem Befehl ein kaufmännisches Und hinzu."

#. type: Block title
#: src/gcode/m-code.adoc:800
#, no-wrap
msgid "M110 Example display and keep going"
msgstr "M110 Beispielanzeige und Weiterfahrt"

#. type: delimited block -
