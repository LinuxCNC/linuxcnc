msgstr "`%T`__xx__`.P` - Timer _xx_ Voreinstellung (ganze Zahl)"

#. type: WARNING
#: src/ladder/classic-ladder.adoc:562
msgid "`%TM`__xxx__`.Q` - Timer _xxx_ done (Boolean, read write)"
msgstr "`%TM`__xxx__`.Q` - Timer _xxx_ fertig (Boolesch, lesen/schreiben)"

#. type: WARNING
#: src/ladder/classic-ladder.adoc:563
