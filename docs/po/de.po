msgstr "images/GM_RefSignals.png"

#. type: Block title
#: src/drivers/gm.adoc:312
#, no-wrap
msgid "Setting StepGen module of axis 0 to generate 1000 step pulse per position unit"
msgstr "Einstellung des StepGen-Moduls der Achse 0 zur Erzeugung von 1000 Schrittimpulsen pro Positionseinheit"

#. type: delimited block -
#: src/drivers/gm.adoc:327
#, no-wrap
msgid ""
"setp gm.0.stepgen.0.step-type 0         # 0:stepDir, 1:UpDown, 2:Quad\n"
"setp gm.0.stepgen.0.control-type 0      # 0:Pos. control, 1:Vel. Control\n"
"setp gm.0.stepgen.0.invert-step1 0\n"
"setp gm.0.stepgen.0.invert-step2 0\n"
"setp gm.0.stepgen.0.maxvel 0            # do not set maxvel for step\n"
"                                        # generator, let interpolator control it.\n"
"setp gm.0.stepgen.0.maxaccel 0          # do not set max acceleration for\n"
"                                        # step generator, let interpolator control it.\n"
"setp gm.0.stepgen.0.position-scale 1000 # 1000 step/position unit\n"
"setp gm.0.stepgen.0.steplen 1000        # 1000 ns = 1 µs\n"
"setp gm.0.stepgen.0.stepspace1000       # 1000 ns = 1 µs\n"
"setp gm.0.stepgen.0.dirdelay 2000       # 2000 ns = 2 µs\n"
msgstr ""
"setp gm.0.stepgen.0.step-type 0         # 0:stepDir, 1:UpDown, 2:Quad\n"
"setp gm.0.stepgen.0.control-type 0      # 0:Pos. Kontrolle, 2:Geschw. Kontrolle\n"
"setp gm.0.stepgen.0.invert-step1 0\n"
"setp gm.0.stepgen.0.invert-step2 0\n"
"setp gm.0.stepgen.0.maxvel 0            # do not set maxvel for step\n"
"                                        # generator, let interpolator control it.\n"
"setp gm.0.stepgen.0.maxaccel 0          # do not set max acceleration for\n"
"                                        # step generator, let interpolator control it.\n"
"setp gm.0.stepgen.0.position-scale 1000 # 1000 step/position unit\n"
"setp gm.0.stepgen.0.steplen 1000        # 1000 ns = 1 µs\n"
"setp gm.0.stepgen.0.stepspace1000       # 1000 ns = 1 µs\n"
"setp gm.0.stepgen.0.dirdelay 2000       # 2000 ns = 2 µs\n"

#. type: Block title
#: src/drivers/gm.adoc:329
#, no-wrap
msgid "Connect StepGen to axis 0 position reference and enable pins"
msgstr "Verbinden Sie StepGen mit den Positionsreferenz- und Freigabepins der Achse 0"

#. type: delimited block -
#: src/drivers/gm.adoc:334
#, no-wrap
msgid ""
"net Xpos-cmd joint.0.motor-pos-cmd => gm.0.stepgen.0.position-cmd\n"
"net Xen joint.0.amp-enable-out => gm.0.stepgen.0.enable\n"
msgstr ""
"net Xpos-cmd joint.0.motor-pos-cmd => gm.0.stepgen.0.position-cmd\n"
"net Xen joint.0.amp-enable-out => gm.0.stepgen.0.enable\n"

#. type: Title ===
#: src/drivers/gm.adoc:336
#, no-wrap
msgid "Enable and Fault signals"
msgstr "Freigabe- und Fehlersignale"

#. type: Plain text
#: src/drivers/gm.adoc:341
msgid ""
"The GM6-PCI motion control card has one enable output and one fault input "
"HAL pins, both are connected to each RJ50 axis connector and to the CAN "
"connector."
msgstr ""
"Die GM6-PCI-Bewegungssteuerungskarte verfügt über einen HAL-Pin als "
"Freigabeausgang und einen als Fehlereingang , die beide mit jedem RJ50-"
"Achsenanschluss und dem CAN-Anschluss verbunden sind."

#. type: Plain text
#: src/drivers/gm.adoc:343 src/drivers/gm.adoc:375 src/drivers/gm.adoc:426
#: src/drivers/gm.adoc:514
msgid "HAL pins are updated by function:"
msgstr "HAL Pins werden durch Funktion aktualisiert:"

#. type: Block title
#: src/drivers/gm.adoc:348
