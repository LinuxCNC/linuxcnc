TARGETS += ../bin/rs274
SAISRCS := $(addprefix emc/sai/, saicanon.cc driver.cc dummyemcstat.cc)
USERSRCS += $(SAISRCS)

../bin/rs274: $(call TOOBJS, $(SAISRCS)) ../lib/librs274.so.0 ../lib/liblinuxcnc.a ../lib/libnml.so.0 \
	../lib/liblinuxcnchal.so.0 ../lib/liblinuxcncini.so.1 ../lib/libtooldata.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) $(PYTHON_EXTRA_LDFLAGS) -o $@ $^ $(ULFLAGS) $(PYTHON_LIBS) $(PYTHON_EXTRA_LIBS) $(READLINE_LIBS) -lfmt $(LDFLAGS)
