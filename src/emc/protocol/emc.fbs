// The LinuxCNC client protocol, prototype.
//
// This file is the contract: a client is written against the schema, not
// against a C header or a wire format of the day.  The transport carries
// frames of these messages and is replaceable (unix socket, TCP, WebSocket).
//
// Rules that keep the versioning promise:
//   - anything that may evolve is a `table` or a `union`, never a `struct`;
//   - field ids are assigned once and never reused, so a field can be
//     deprecated but not reused;
//   - `schema_version` travels in every Envelope and in the Hello, so both
//     ends can refuse a mismatch instead of misreading.
//
// Regenerate with scripts in this directory (flatc --cpp / --rust).

namespace linuxcnc.protocol;

file_identifier "LCNP";

/// Which message the envelope carries.  Kept explicit so an old reader can
/// log a message it does not understand instead of guessing.
enum MessageKind : ubyte {
    NONE = 0,
    HELLO = 1,
    STATUS = 2,
    ERROR = 3,
    COMMAND = 4,
    ACK = 5
}

enum Severity : ubyte {
    INFO = 0,
    WARNING = 1,
    ERROR = 2,
    FATAL = 3
}

enum ErrorSource : ubyte {
    TASK = 0,
    INTERP = 1,
    MOTION = 2,
    IO = 3,
    OPERATOR = 4,
    PROTOCOL = 5
}

/// Machine vocabulary.  Numbering follows LinuxCNC's own enums wherever one
/// exists, so a value crossing the boundary is the value the machine reported
/// and a client never compares against a bare number.
enum TaskMode : byte { UNKNOWN = 0, MANUAL = 1, AUTO = 2, MDI = 3 }

enum TaskState : byte { UNKNOWN = 0, ESTOP = 1, ESTOP_RESET = 2, OFF = 3, ON = 4 }

enum ExecState : byte {
    UNKNOWN = 0,
    ERROR = 1,
    DONE = 2,
    WAITING_FOR_MOTION = 3,
    WAITING_FOR_MOTION_QUEUE = 4,
    WAITING_FOR_IO = 5,
    WAITING_FOR_MOTION_AND_IO = 7,
    WAITING_FOR_DELAY = 8,
    WAITING_FOR_SYSTEM_CMD = 9,
    WAITING_FOR_SPINDLE_ORIENTED = 10,
    WAITING_FOR_KINS_SWITCH = 11,
    WAITING_FOR_HOMING = 12
}

enum InterpState : byte { UNKNOWN = 0, IDLE = 1, READING = 2, PAUSED = 3, WAITING = 4 }

enum TrajMode : byte { UNKNOWN = 0, FREE = 1, COORD = 2, TELEOP = 3 }

enum JointType : byte { UNKNOWN = 0, LINEAR = 1, ANGULAR = 2 }

enum ProgramUnits : byte { UNKNOWN = 0, INCHES = 1, MM = 2, CM = 3 }

enum SpindleDirection : byte { REVERSE = -1, STOPPED = 0, FORWARD = 1 }

/// Whether a jog addresses a joint (free mode) or a world axis (teleop).
enum JogTarget : byte { JOINT = 0, AXIS = 1 }

/// The three things the operator channel carries, kept apart because a UI
/// shows them in three different places.
enum OperatorKind : byte { ERROR = 0, TEXT = 1, DISPLAY = 2 }

/// Completion of one command, as the machine reports it.
enum CommandStatus : int {
    UNINITIALIZED = -1,
    DONE = 1,
    EXEC = 2,
    ERROR = 3
}

table Version {
    protocol_major: int = 1;
    protocol_minor: int = 0;
    schema_version: int = 2;
}

/// First frame from either side.  A client sends the last error sequence it
/// saw, so the server can replay what it missed; -1 means "start from what
/// is in the ring now".
table Hello {
    version: Version;
    client_name: string;
    /// Last error sequence this client saw, so the server replays the gap.
    /// -1 means "start from what is in the ring now".
    last_error_sequence: long = -1;
    /// How often this client wants Status, in milliseconds.  0 asserts no
    /// opinion and takes the server's rate.
    poll_ms: ushort = 0;
    /// The connection watches and does not command.  Declared by the client,
    /// enforced by the server: a machine command from it is refused by name.
    /// Not a security boundary - anything that can open the socket can omit
    /// the flag.
    observe: bool = false;
    /// Abort what this connection started when it drops.  True by default so
    /// a GUI is safe by omission; a one-shot tool sets it false.
    stop_on_disconnect: bool = true;
    /// Filled by the server: how big the machine is, so a client can size
    /// its views before the first Status arrives.
    joints: ubyte = 0;
    axes: ubyte = 0;
    spindles: ubyte = 0;
}

table Pose {
    x: double;
    y: double;
    z: double;
    a: double;
    b: double;
    c: double;
    u: double;
    v: double;
    w: double;
}

table Joint {
    joint: int;
    joint_type: JointType = UNKNOWN;
    homed: bool;
    enabled: bool;
    fault: bool;
    position: double;
    velocity: double;
    min_position_limit: double;
    max_position_limit: double;
}

table Axis {
    axis: int;
    velocity: double;
    min_position_limit: double;
    max_position_limit: double;
}

/// What task, motion and IO report.  A subset for the prototype; fields are
/// added, never renumbered.
table Status {
    valid: bool;
    task_mode: TaskMode = UNKNOWN;
    task_state: TaskState = UNKNOWN;
    exec_state: ExecState = UNKNOWN;
    interp_state: InterpState = UNKNOWN;
    traj_mode: TrajMode = UNKNOWN;
    units: ProgramUnits = UNKNOWN;
    last_command_serial: int;
    command_status: CommandStatus = UNINITIALIZED;
    task_file: string;
    task_line: int;
    position: Pose;
    actual_position: Pose;
    linear_units: double;
    feedrate: double;
    rapidrate: double;
    joints: [Joint];
    axes: [Axis];
    heartbeat: ulong;
    /// Wall clock of the server when the frame was built, seconds.
    timestamp: double;
}

/// One message of the error channel, with the fields NML cannot provide:
/// a monotonic sequence, a source, and the command it belongs to.  A client
/// reads through its own cursor, so nothing is consumed for other clients.
table Error {
    sequence: ulong;
    /// Which operator channel the message came from.
    kind: OperatorKind = ERROR;
    severity: Severity;
    source: ErrorSource;
    command_serial: int;
    text: string;
    timestamp: double;
}

table Ack {
    command_serial: int;
    ok: bool;
    /// Sequence of the error that explains a failed command, 0 if none.
    error_sequence: ulong;
}

table SetMode {
    mode: TaskMode = UNKNOWN;
}

table SetState {
    state: TaskState = UNKNOWN;
}

table Mdi {
    block: string;
}

table SetTeleop {
    enable: bool;
}

table Home {
    joint: int;
}

table JogStop {
    target: JogTarget = JOINT;
    index: int;
}

table Abort {
}

union CommandBody {
    SetMode,
    SetState,
    Mdi,
    SetTeleop,
    Home,
    JogStop,
    Abort
}

table Command {
    /// Client-assigned, unique per connection.
    client_serial: int;
    body: CommandBody;
}

/// One frame.  Exactly one of the message fields is set; kind says which.
table Envelope {
    schema_version: int = 2;
    kind: MessageKind = NONE;
    hello: Hello;
    status: Status;
    error: Error;
    command: Command;
    ack: Ack;
}

root_type Envelope;
