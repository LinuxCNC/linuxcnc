component or "Arbitrary input OR gate";
pin in bool in##[128:personality] = 0 "in";
pin out bool out "output pin; the OR of all inputs";

description """
The *out* pin is set to *TRUE* if any the inputs is *TRUE*; or *FALSE* if all are *FALSE*.

The value for a unconnected pin is FALSE; so it is fine to leave a pin unconnected. 

Set the number of pins via personality. The default value is a single *OR* with 8 inputs; so personality=8. The
maximum number of inputs is 128 (hardcoded). If there are no input pins at all (personality=0); then 
the output is *FALSE*.
"""
;
function _;
see_also """
and(9), and2(9) and or2(9).
""";

option period no;
option default_personality 8;
option default_count 1;

license "ASLv2";
author "Dirk-Willem van Gulik <dirkx(at)webweaving(punto)org";
;;
FUNCTION(_) { 
	bool tmp = 0;
	// we prefer constant time; so do not return 0 on the first true
	for(int i = 0; i < personality; i++)
		tmp = tmp || in(i);
	out_set(tmp);
}
