component and_n "Compute the logical AND of up to 255 inputs.";
pin in bool in##[255:personality] = 1 "inputs (default is TRUE)";
pin out bool out "output pin; the AND of all inputs";

description """
The *out* pin is set to *TRUE* if all the inputs are all *TRUE*; or *FALSE* if one or more are *FALSE*.

The value for a unconnected pin is TRUE; so it is fine to leave a pin unconnected. 

Set the number of pins via personality.  The default value is a single *AND* with 8 
inputs; so personality=8.  The maximum number of inputs is 255 (hardcoded). 
If there are no inputs specified (personality=0); then the output value
is TRUE.
""";

function _ "Logical AND";

see_also """
or(9), and2(9) and or2(9).
""";

option period no;
option default_personality 8;

license "GPL";
author "Dirk-Willem van Gulik <dirkx(at)webweaving(punto)org";
;;
FUNCTION(_) { 
	bool tmp = 1;
	// we prefer constant time; so do not return 0 on the first 0.
	for(int i = 0; i < personality; i++)
		tmp = tmp && in(i);
	out_set(tmp);
}
