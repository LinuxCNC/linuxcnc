component or_n "compute the logical OR of up to 255 inputs.";
pin in bool in##[255:personality] = 0 "in (default is FALSE)";
pin out bool out "output pin; the OR of all inputs";

description """
The *out* pin is set to *TRUE* if any the inputs is *TRUE*; or *FALSE* if all are *FALSE*.

The value for a unconnected pin is FALSE; so it is fine to leave a pin unconnected. 

Set the number of pins via personality. The default value is a single *OR* with 8 
inputs; so personality=8. The maximum number of inputs is 155(hardcoded). If there 
are no input pins at all (personality=0); then the output is *FALSE*.
"""
;
function _;
see_also """
and(9), and2(9) and or2(9).
""";

option period no;
option default_personality 8;

license "GPL";
author "Dirk-Willem van Gulik <dirkx(at)webweaving(punto)org";
;;
FUNCTION(_) { 
	bool tmp = 0;
	// we prefer constant time; so do not return 0 on the first true
	for(int i = 0; i < personality; i++)
		tmp = tmp || in(i);
	out_set(tmp);
}
