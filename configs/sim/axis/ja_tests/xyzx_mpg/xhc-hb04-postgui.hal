# optional postgui hal file to allow MPG wheel jog of joint_3
# using the fourth xhc-hb04 rotary switch position (labeled 'a')

# connect to existing signals:
net pendant-jog-scale    => joint.3.jog-scale
net pendant-wheel-counts => pendant_util.in3

# make new signals and connections for optional joint 3 jogging:
net optional-j3-enable <= xhc-hb04.jog.enable-a
net optional-j3-enable => joint.3.jog-enable

net optional-j3-filtered <= pendant_util.out3
net optional-j3-filtered => joint.3.jog-counts

# scale3 = kvalue * scale for the fourth rotary switch position
# kvalue=100 is set by pendant_util.k in xyzx-xhc-hb04.hal
# the fourth-position scale factor is 1
setp pendant_util.scale3 100

