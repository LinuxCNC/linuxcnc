;M429 by remap: select turn kins
o<429remap>sub
  #<kinstype> = 1        ; turn kins

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion
   M129                                 ; switch limits
   G10 L2 P8 X-160 Y0 Z-290 A0          ; reset home offset
   G59.2                                ; activate home offset
   M66  E0 L0                           ; force synch, M129 changed the limits
   ;(debug, M429: turn)

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M429: Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<429remap>endsub
