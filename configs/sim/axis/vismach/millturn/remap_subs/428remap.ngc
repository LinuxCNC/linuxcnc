;M428 by remap: select mill kins
o<428remap>sub
  #<kinstype> = 0        ; mill

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion
   M128                                 ; switch limits
   G10 L2 P7 X-290 Y0 Z-160 A0          ; reset home offset
   G59.1                                ; activate home offset
   M66  E0 L0                           ; force synch, M128 changed the limits
   ;(debug, M428: mill)

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M428: Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<428remap>endsub
