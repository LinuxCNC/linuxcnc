;M428 by remap: select genserkins
o<428remap>sub
  #<kinstype> = 0        ; genserkins

   G13.1                                ; back to kinstype 0, syncs interp and motion
   G10 L2 P7 X0 Y0 Z0 A-180 B0 C0
   G59.1
;   (debug, M428:genserkins)

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE 0]]
     (debug,M428: Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<428remap>endsub
