;M430 by remap: select gensertool kins
o<430remap>sub
  #<kinstype> = 2        ; gensertool kins

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion
;   (debug, M429:identity kins)

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE 2]]
     (debug,M430:Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<430remap>endsub
