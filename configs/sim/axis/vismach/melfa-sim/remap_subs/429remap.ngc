;M429 by remap: select identity kins
o<429remap>sub
  #<kinstype> = 1        ; identity kins

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion
   G10 L2 P8 X0 Y-90 Z0 A0 B90 C0
   G59.2
;   (debug, M429:identity kins)

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE 1]]
     (debug,M429:Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<429remap>endsub
