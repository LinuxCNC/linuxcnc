;M430 by remap: kinstype==2 userk kins
o<430remap>sub
  #<kinstype> = 2

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M430:Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<430remap>endsub
