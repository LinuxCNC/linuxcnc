;M429 by remap: kinstype==0 Identity kinematics
o<429remap>sub
  #<kinstype> = 0

   G13.1                                ; back to kinstype 0, syncs interp and motion

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M429: Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<429remap>endsub
