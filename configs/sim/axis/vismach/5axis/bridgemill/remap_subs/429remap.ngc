;M429 by remap: select kinstype==1 Identity kinematics
o<429remap>sub
  #<kinstype> = 1

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M429:Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<429remap>endsub
