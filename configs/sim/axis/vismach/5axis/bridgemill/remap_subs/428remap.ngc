;M428 by remap: select kinstype=0 genhexkins
o<428remap>sub
  #<kinstype> = 0

   G12.1 P#<kinstype>                   ; select kinstype, syncs interp and motion

o2 if [[#<_task> EQ 1] AND [#<_kins_type> NE #<kinstype>]]
     (debug,M428: Wrong kinematics type)
     (debug,STOP)
     M2
o2 endif

o<428remap>endsub
