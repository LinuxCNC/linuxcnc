; g535-quill.ngc - same sphere, drilled with the quill itself.
; The program aims the head with B and C words and puts the tool tip
; on the safe sphere directly (no tilted work planes).  A W word
; cannot drill under TCP kinematics (see README), so the quill stroke
; is a point-to-point move: g53.5 reads its axis words as joints,
; 'g53.5 g1 w10' extends only the quill and the head stands still.
; ('g53.7 g1 j5=10' names the joint by number and does the same.)
;
; Geometry: ball radius #<r> centered on the word origin, holes normal
; to the surface in rings of polar angle #<b>.  The safe point is at
; radius #<r> + #<rdelta> from the center, the tool axis through the
; center (B = -b, C = c).

        #<r>  =   60 ; sphere radius
  #<rdelta>   =    5 ; safe distance
#<drilldepth> =   -5
   #<zsafe>   =   20 ; clearance above the ball for start and stop
    #<zstart> =    0
    #<bctmax> =    8
    #<cctmax> =   16
    #<toolno> =  100
    #<frate>  = 1000

#<bct>    = 0
#<cct>    = 0
#<cdelta> = [360/#<cctmax>]
#<bdelta> = [90/#<bctmax>]

g49
g13.1 ; kinematics 0 (TCP), in case a previous run left a switch active
m65 p0 ; quill unlocked, in case a previous run locked it
t#<toolno>m6g43

g53 g0 x0y0z#<zstart>b0c0 w0
g10l20 p0 x0 y0 z[#<r>+#<rdelta>+#<zsafe>] b0 c0 w0 ; ball center at program origin, we park above it
f#<frate>
o100 while [#<bct> lt #<bctmax>]
       #<b> = [[#<bct>+1]*#<bdelta>] ; top ring first, the way in stays outside the ball, no pole hole
       #<cct> = 0
o200   while [#<cct> lt #<cctmax>]
o210      if [[#<bct> mod 2] eq 0]
              #<c> = [#<cct> * #<cdelta>]
o210      else
              #<c> = [360 - [1+ #<cct>] * #<cdelta>]
o210      endif
          #<x> = [[#<r>+#<rdelta>]*[sin[#<b>]]*[cos[#<c>]]]
          #<y> = [[#<r>+#<rdelta>]*[sin[#<b>]]*[sin[#<c>]]]
          #<z> = [[#<r>+#<rdelta>]*[cos[#<b>]]]
          g0 x#<x> y#<y> z#<z> b[-#<b>] c#<c>
          m66e0l0 ; force sync
          g53.5 g1 w[#<rdelta> - #<drilldepth>] ; quill joint drills
          g53.5 g0 w0 ; quill back, head never moved
          m66e0l0 ; force sync
          #<cct> = [#<cct>+1]
o200   endwhile
       #<bct> = [#<bct>+1]
o100 endwhile

g0x0y0z[#<r>+#<rdelta>]b0c0w0
g53 g0 x0y0z0
m2
