# HAL setup for the twelve-extra-joints demonstration.
#
# loadrt loads components, addf schedules their realtime functions,
# setp sets parameters and writable pins, and net connects pins.
# HAL basics: https://linuxcnc.org/docs/devel/html/en/hal/basic-hal.html

loadusr -W hal_manualtoolchange

loadrt trivkins coordinates=XYYZ kinstype=both

loadrt motmod num_extrajoints=12 base_period_nsec=0 servo_period_nsec=1000000 num_joints=16
addf motion-command-handler servo-thread
addf motion-controller servo-thread

loadrt pid names=J0_pid,J1_pid,J2_pid,J3_pid,J4_pid,J5_pid,J6_pid,J7_pid,J8_pid,J9_pid,J10_pid,J11_pid,J12_pid,J13_pid,J14_pid,J15_pid
addf J0_pid.do-pid-calcs servo-thread
addf J1_pid.do-pid-calcs servo-thread
addf J2_pid.do-pid-calcs servo-thread
addf J3_pid.do-pid-calcs servo-thread
addf J4_pid.do-pid-calcs servo-thread
addf J5_pid.do-pid-calcs servo-thread
addf J6_pid.do-pid-calcs servo-thread
addf J7_pid.do-pid-calcs servo-thread
addf J8_pid.do-pid-calcs servo-thread
addf J9_pid.do-pid-calcs servo-thread
addf J10_pid.do-pid-calcs servo-thread
addf J11_pid.do-pid-calcs servo-thread
addf J12_pid.do-pid-calcs servo-thread
addf J13_pid.do-pid-calcs servo-thread
addf J14_pid.do-pid-calcs servo-thread
addf J15_pid.do-pid-calcs servo-thread

loadrt mux2 names=J0_mux,J1_mux,J2_mux,J3_mux,J4_mux,J5_mux,J6_mux,J7_mux,J8_mux,J9_mux,J10_mux,J11_mux,J12_mux,J13_mux,J14_mux,J15_mux
addf J0_mux servo-thread
addf J1_mux servo-thread
addf J2_mux servo-thread
addf J3_mux servo-thread
addf J4_mux servo-thread
addf J5_mux servo-thread
addf J6_mux servo-thread
addf J7_mux servo-thread
addf J8_mux servo-thread
addf J9_mux servo-thread
addf J10_mux servo-thread
addf J11_mux servo-thread
addf J12_mux servo-thread
addf J13_mux servo-thread
addf J14_mux servo-thread
addf J15_mux servo-thread

loadrt ddt names=J0_vel,J0_accel,J1_vel,J1_accel,J2_vel,J2_accel,J3_vel,J3_accel,J4_vel,J4_accel,J5_vel,J5_accel,J6_vel,J6_accel,J7_vel,J7_accel,J8_vel,J8_accel,J9_vel,J9_accel,J10_vel,J10_accel,J11_vel,J11_accel,J12_vel,J12_accel,J13_vel,J13_accel,J14_vel,J14_accel,J15_vel,J15_accel
addf J0_vel servo-thread
addf J0_accel servo-thread
addf J1_vel servo-thread
addf J1_accel servo-thread
addf J2_vel servo-thread
addf J2_accel servo-thread
addf J3_vel servo-thread
addf J3_accel servo-thread
addf J4_vel servo-thread
addf J4_accel servo-thread
addf J5_vel servo-thread
addf J5_accel servo-thread
addf J6_vel servo-thread
addf J6_accel servo-thread
addf J7_vel servo-thread
addf J7_accel servo-thread
addf J8_vel servo-thread
addf J8_accel servo-thread
addf J9_vel servo-thread
addf J9_accel servo-thread
addf J10_vel servo-thread
addf J10_accel servo-thread
addf J11_vel servo-thread
addf J11_accel servo-thread
addf J12_vel servo-thread
addf J12_accel servo-thread
addf J13_vel servo-thread
addf J13_accel servo-thread
addf J14_vel servo-thread
addf J14_accel servo-thread
addf J15_vel servo-thread
addf J15_accel servo-thread

loadrt hypot names=hyp_xy,hyp_xyz
addf hyp_xy servo-thread
addf hyp_xyz servo-thread

loadrt sim_home_switch names=J0_switch,J1_switch,J2_switch,J3_switch,J4_switch,J5_switch,J6_switch,J7_switch,J8_switch,J9_switch,J10_switch,J11_switch,J12_switch,J13_switch,J14_switch,J15_switch
addf J0_switch servo-thread
addf J1_switch servo-thread
addf J2_switch servo-thread
addf J3_switch servo-thread
addf J4_switch servo-thread
addf J5_switch servo-thread
addf J6_switch servo-thread
addf J7_switch servo-thread
addf J8_switch servo-thread
addf J9_switch servo-thread
addf J10_switch servo-thread
addf J11_switch servo-thread
addf J12_switch servo-thread
addf J13_switch servo-thread
addf J14_switch servo-thread
addf J15_switch servo-thread

loadrt limit2 names=limit_speed
addf limit_speed servo-thread

loadrt lowpass names=spindle_mass
addf spindle_mass servo-thread

loadrt scale names=rpm_rps
addf rpm_rps servo-thread

loadrt near names=near_speed
addf near_speed servo-thread

loadrt sim_spindle names=sim_spindle
addf sim_spindle servo-thread

loadrt limit3 names=j4.limit3,j5.limit3,j6.limit3,j7.limit3,j8.limit3,j9.limit3,j10.limit3,j11.limit3,j12.limit3,j13.limit3,j14.limit3,j15.limit3
addf j4.limit3 servo-thread
addf j5.limit3 servo-thread
addf j6.limit3 servo-thread
addf j7.limit3 servo-thread
addf j8.limit3 servo-thread
addf j9.limit3 servo-thread
addf j10.limit3 servo-thread
addf j11.limit3 servo-thread
addf j12.limit3 servo-thread
addf j13.limit3 servo-thread
addf j14.limit3 servo-thread
addf j15.limit3 servo-thread

# motion and estop
net estop-loopback iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
net motion-enabled motion.motion-enabled => J0_mux.sel J1_mux.sel J2_mux.sel J3_mux.sel J4_mux.sel J5_mux.sel J6_mux.sel J7_mux.sel J8_mux.sel J9_mux.sel J10_mux.sel J11_mux.sel J12_mux.sel J13_mux.sel J14_mux.sel J15_mux.sel

# joint 0
setp J0_pid.FF0                     1
setp J0_pid.Pgain                   0
setp J0_switch.home-pos             0.1
setp J0_switch.hysteresis           0.05
net j0-enable joint.0.amp-enable-out => J0_pid.enable
net j0-home-sw J0_switch.home-sw => joint.0.home-sw-in
net j0-pid-output J0_pid.output => J0_mux.in1
net j0-pos-cmd joint.0.motor-pos-cmd => J0_pid.command
net j0-pos-fb J0_mux.out => J0_mux.in0 J0_switch.cur-pos J0_vel.in joint.0.motor-pos-fb
net j0-vel J0_vel.out => J0_accel.in hyp_xy.in0 hyp_xyz.in0

# joint 1
setp J1_pid.FF0                     1
setp J1_pid.Pgain                   0
setp J1_switch.home-pos             0.1
setp J1_switch.hysteresis           0.05
net j1-enable joint.1.amp-enable-out => J1_pid.enable
net j1-home-sw J1_switch.home-sw => joint.1.home-sw-in
net j1-pid-output J1_pid.output => J1_mux.in1
net j1-pos-cmd joint.1.motor-pos-cmd => J1_pid.command
net j1-pos-fb J1_mux.out => J1_mux.in0 J1_switch.cur-pos J1_vel.in joint.1.motor-pos-fb
net j1-vel J1_vel.out => J1_accel.in

# joint 2
setp J2_pid.FF0                     1
setp J2_pid.Pgain                   0
setp J2_switch.home-pos             0.1
setp J2_switch.hysteresis           0.05
net j2-enable joint.2.amp-enable-out => J2_pid.enable
net j2-home-sw J2_switch.home-sw => joint.2.home-sw-in
net j2-pid-output J2_pid.output => J2_mux.in1
net j2-pos-cmd joint.2.motor-pos-cmd => J2_pid.command
net j2-pos-fb J2_mux.out => J2_mux.in0 J2_switch.cur-pos J2_vel.in joint.2.motor-pos-fb
net j2-vel J2_vel.out => J2_accel.in hyp_xy.in1 hyp_xyz.in1

# joint 3
setp J3_pid.FF0                     1
setp J3_pid.Pgain                   0
setp J3_switch.home-pos             0.1
setp J3_switch.hysteresis           0.05
net j3-enable joint.3.amp-enable-out => J3_pid.enable
net j3-home-sw J3_switch.home-sw => joint.3.home-sw-in
net j3-pid-output J3_pid.output => J3_mux.in1
net j3-pos-cmd joint.3.motor-pos-cmd => J3_pid.command
net j3-pos-fb J3_mux.out => J3_mux.in0 J3_switch.cur-pos J3_vel.in joint.3.motor-pos-fb
net j3-vel J3_vel.out => J3_accel.in hyp_xyz.in2

# joint 4
setp J4_pid.FF0                     1
setp J4_pid.Pgain                   0
setp J4_switch.home-pos             0.1
setp J4_switch.hysteresis           0.05
setp j4.limit3.max                10
setp j4.limit3.maxa               100
setp j4.limit3.maxv               5
setp j4.limit3.min                -10
net j4-enable joint.4.amp-enable-out => J4_pid.enable
net j4-home-sw J4_switch.home-sw => joint.4.home-sw-in
net j4-homed joint.4.homed => j4.limit3.enable
net j4-pid-output J4_pid.output => J4_mux.in1
net j4-out j4.limit3.out => joint.4.posthome-cmd
net j4-pos-cmd joint.4.motor-pos-cmd => J4_pid.command
net j4-pos-fb J4_mux.out => J4_mux.in0 J4_switch.cur-pos J4_vel.in joint.4.motor-pos-fb
net j4-vel J4_vel.out => J4_accel.in

