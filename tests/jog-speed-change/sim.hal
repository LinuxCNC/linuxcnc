loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# the commanded velocity of joint 0 and of axis X every servo cycle
loadrt sampler depth=4000 cfg=ff

addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf sampler.0 servo-thread

net VJ joint.0.vel-cmd => sampler.0.pin.0
net VX axis.x.teleop-vel-cmd => sampler.0.pin.1
loadusr halsampler -t samples.log

net J0 joint.0.motor-pos-cmd => joint.0.motor-pos-fb
net J1 joint.1.motor-pos-cmd => joint.1.motor-pos-fb
net J2 joint.2.motor-pos-cmd => joint.2.motor-pos-fb

net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in
net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed
