if "USE_TOOL_LENGTH_OFFSET(0.8500 0.0000 2.3000, 0.0000 0.0000 0.0000, 0.0000 0.0000 0.5000" not in text:
    print("T0101 did not apply geometry + accumulated wear (want X=0.85 Z=2.30 W=0.50)")
