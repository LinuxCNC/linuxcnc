#!/usr/bin/env python3
"""G10 L12 must be rejected while cutter radius compensation is on."""
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "Cannot change tool wear with cutter radius compensation on" not in text:
    print("G10 L12 was not rejected with cutter compensation on")
    sys.exit(1)
sys.exit(0)
