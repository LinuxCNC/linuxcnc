# the probe trips when Z goes below the height set with M68 E1
loadrt comp names=probe-comp
addf probe-comp servo-thread
net Zpos => probe-comp.in0
net probe-height motion.analog-out-01 => probe-comp.in1
net probe probe-comp.out => motion.probe-input

# Run the controller before the command handler, so that motion
# acknowledges a command a whole servo period before the controller
# acts on it.
delf motion-command-handler servo-thread
addf motion-command-handler servo-thread 2
