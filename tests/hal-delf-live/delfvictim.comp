component delfvictim "Test component for tests/hal-delf-live: stays inside its function while hold is set";

pin in bool hold;
pin out bool inside;

function _;
license "GPL";
author "SyncTwin";
;;
/* give up after 10 s so a broken test can't wedge the thread forever */
long long t0 = rtapi_get_time();
(void)period;
inside_set(1);
while (hold && rtapi_get_time() - t0 < 10000000000LL) { }
