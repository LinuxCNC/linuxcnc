# offsets set so no term drops out; the tilt to 120, the turn past a
# whole one; the tool offset set on its pin
loadrt xyzbc-trt-kins coordinates=XYZBC
setp xyzbc-trt-kins.x-offset 3
setp xyzbc-trt-kins.z-offset 11
setp xyzbc-trt-kins.tool-offset 7
setp xyzbc-trt-kins.x-rot-point 1
setp xyzbc-trt-kins.y-rot-point 2
setp xyzbc-trt-kins.z-rot-point 5
loadrt walkcheck joints=5 lo=-100,-100,-100,-120,-400 hi=100,100,100,120,400
