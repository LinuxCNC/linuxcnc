# as tool-pin.hal with the conventional directions, and the tool
# offset handed over as motion does
loadrt xyzac-trt-kins coordinates=XYZAC
setp xyzac-trt-kins.conventional-directions 1
setp xyzac-trt-kins.y-offset 3
setp xyzac-trt-kins.z-offset 11
setp xyzac-trt-kins.x-rot-point 1
setp xyzac-trt-kins.y-rot-point 2
setp xyzac-trt-kins.z-rot-point 5
loadrt walkcheck joints=5 tool=4,3,7 lo=-100,-100,-100,-120,-400 hi=100,100,100,120,400
